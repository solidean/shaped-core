// a case picks the first arm whose pattern matches

enum light_kind:
    point
    spot
    sun

fun falloff(k: light_kind) -> float:
    return case k:
        .point => 1.0
        .spot or .sun => 0.5

test falloff(light_kind.point) == 1.0 and falloff(light_kind.sun) == 0.5

fun stepped(n: int) -> float:
    return case n:
        0 => 0.0
        1 or 2 => 0.5
        _ => 1.0

test:
    for n in 0 ..< 4:
        stepped(n) <= 1.0
    stepped 2 == 0.5

// where a type is expected the case is that type, and each arm's value converts to it as a literal does (CHK-166)
test:
    let c = true
    let y: float = case c:
        true => 1
        _ => 2
    y == 1.0

fun halved(n: int) -> float => case n:
    0 => 0
    _ => 0.5

test halved(0) == 0.0 and halved(3) == 0.5

// an arm of a case in a test may be a check
test:
    let k = light_kind.spot
    case k:
        .spot => falloff(k) == 0.5
        _ => false

// a @bitflags value may be several cases or none, so naming every case of it is not exhaustive: it needs a `_`
@expect(error = "non-exhaustive-case")
test:
    let f = ray_flags.force_opaque | ray_flags.cull_back_facing
    let n = case f:
        .none => 0
        .force_opaque => 1
        .force_non_opaque => 2
        .accept_first_hit_and_end_search => 3
        .skip_closest_hit => 4
        .cull_back_facing => 5
        .cull_front_facing => 6
        .cull_opaque => 7
        .cull_non_opaque => 8
        .skip_triangles => 9
        .skip_procedural => 10
    n == 0

// and a combined value, which is none of the cases, takes the `_`
fun flags_code(f: ray_flags) -> int:
    return case f:
        .none => 0
        .force_opaque => 1
        .cull_back_facing => 5
        _ => 10

test flags_code(ray_flags.force_opaque) == 1
test flags_code(ray_flags.force_opaque | ray_flags.cull_back_facing) == 10

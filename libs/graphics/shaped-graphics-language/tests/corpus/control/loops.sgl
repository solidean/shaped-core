// for, loop and while, and the jumps out of them

fun sum_skipping_three(n: int) -> int:
    let mut total = 0
    for i in 0 ..< n:
        if i == 3 => continue
        total += i
    return total

// 0 + 1 + 2 + 4
test sum_skipping_three(5) == 7

fun first_square_over(limit: int) -> int:
    let mut i = 0
    loop:
        if i * i > limit => break
        i += 1
    return i

test first_square_over(50) == 8

fun halvings(x: float) -> int:
    let mut v = x
    let mut n = 0
    while v > 1.0:
        v = v * 0.5
        n += 1
    return n

test halvings(8.0) == 3

// an early return from inside a loop leaves the function, not only the loop
fun first_over(limit: int) -> int:
    for i in 0 ..< 100:
        if i > limit => return i
    return -1

test first_over(7) == 8

// `..=` takes its last value too, and evaluates both bounds once (EVAL-101)
fun sum_to(a: int, b: int) -> int:
    let mut total = 0
    for i in a ..= b:
        total += i
    return total

test sum_to(1, 4) == 10 and sum_to(3, 3) == 3 and sum_to(4, 1) == 0

// a continue reaches the next value, as in a `..<` loop
test:
    let mut odd = 0
    for i in 0 ..= 5:
        if i % 2 == 0 => continue
        odd += 1
    odd == 3

// a range ending at the largest int runs whole: no `last + 1` wraps it away
test sum_to(2147483646, 2147483647) == -3

// a constant range is the `..<` one past it, which @unroll writes out
test:
    let mut s = 0
    @unroll
    for d in -1 ..= 1:
        s += d * d
    s == 2

// a `let mut` without a value is read only once every path to the read assigned it (CHK-55)
fun first_square_above(n: int) -> int:
    let mut found: int
    let mut i = 0
    loop:
        if i * i > n:
            found = i
            break
        i += 1
    return found

test first_square_above(10) == 4

// a range walked backwards or in steps, the two composed in the order written (CHK-415, EVAL-102)
fun digits(walk: int) -> int:
    let mut acc = 0
    if walk == 0:
        for i in (0 ..< 4).reversed:
            acc = acc * 10 + i
    else if walk == 1:
        for i in (1 ..= 9).by(3):
            acc = acc * 10 + i
    else if walk == 2:
        for i in (0 ..< 8).by(3).reversed:
            acc = acc * 10 + i
    else:
        for i in (0 ..< 8).reversed.by(3):
            acc = acc * 10 + i
    return acc

test digits(0) == 3210
test digits(1) == 147
test digits(2) == 630
test digits(3) == 741

// a walk of bounds no constant evaluates them once, and an empty range walks nothing
fun walked_sum(first: int, last: int) -> int:
    let mut total = 0
    for i in (first ..< last).by(2).reversed:
        total = total * 100 + i
    return total

test walked_sum(3, 8) == 70503
test walked_sum(5, 5) == 0 and walked_sum(6, 2) == 0

// unrolled, each copy reads its value of the walk as a literal
test:
    let mut seen = 0
    @unroll
    for i in (0 ..< 3).reversed:
        seen = seen * 10 + i
    seen == 210

@expect(error = "invalid-constant-argument")
test:
    let s = 2
    let mut n = 0
    for i in (0 ..< 8).by(s):
        n += 1
    n == 4

@expect(error = "invalid-constant-argument")
test:
    let mut n = 0
    for i in (0 ..< 8).by(0):
        n += 1
    n == 0

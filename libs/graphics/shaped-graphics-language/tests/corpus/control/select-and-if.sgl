// `if c => a else b` is a value that runs one branch, and `select` is a call that evaluates all three of its arguments

// an `if` with an `else` stands where a value is expected (CHK-375)
test:
    let c = true
    let y = if c => 1.0 else 2.0
    y == 1.0
    let z = if not c => 1 else if y > 0.5 => 2 else 3
    z == 2

fun clamped_root(x: float) => if x > 0.0 => sqrt(x) else 0.0

// a run-time value, since WGSL refuses `sqrt` of a negative constant even in a branch that does not run
test:
    let mut below = -1.0
    clamped_root(4.0) == 2.0 and clamped_root(below) == 0.0

// only the branch the condition takes runs
fun bump(n: mut int) -> int:
    n += 1
    return n

test:
    let mut runs = 0
    let a = if runs == 0 => bump(mut runs) else bump(mut runs) + 10
    a == 1 and runs == 1

// a branch may leave instead of giving a value
fun first_positive(a: float, b: float) -> float:
    let x = if a > 0.0 => a else if b > 0.0 => b else return 0.0
    return x * 2.0

test first_positive(-1.0, 3.0) == 6.0 and first_positive(-1.0, -2.0) == 0.0

// the branches give one type
@expect(error = "type-mismatch")
test (if true => 1.0 else 2) == 1.0

// the condition is a bool
@expect(error = "type-mismatch")
test (if 1 => 1.0 else 2.0) == 1.0

// without an `else` the `if` has no value where its condition is false
@expect(error = "statement-in-expression")
test:
    let y = if true => 1.0
    y == 1.0

// select evaluates every argument and picks by a bool, or per component by a bool vector (CHK-365)
test:
    select(true, 1.0, 2.0) == 1.0
    select(false, int2(1, 2), int2(3, 4)) == int2(3, 4)
    select(bool3(true, false, true), float3(1.0), float3(2.0)) == float3(1.0, 2.0, 1.0)
    select(true, vec3(1.0), vec3(0.0)).x == 1.0

test:
    let mut runs = 0
    let picked = select(runs == 0, bump(mut runs), bump(mut runs) * 10)
    picked == 1 and runs == 2

// a dot call is the same call, its receiver the condition
test:
    let m = float2(1.0, -1.0) > float2(0.0, 0.0)
    m.select(float2(1.0), float2(0.0)) == float2(1.0, 0.0)
    (3 > 2).select(7, 9) == 7

// a bool vector picks among vectors of its width alone
@expect(error = "no-matching-overload")
test select(bool2(true, false), float3(1.0), float3(2.0)).x == 1.0

struct pixel_input:
    @position position: hpos4

@pixel struct target:
    color: float4

@pixel fun bands_ps(p: pixel_input) -> target:
    let x = p.position.x
    let tone = if x > 64.0 => 1.0 else if x > 32.0 => 0.5 else 0.0
    let slope = ddx(x)
    let edge = if fract(x / 8.0) < 0.5 => slope else 0.0
    let side = select(p.position.xy > float2(32.0, 32.0), float2(1.0), float2(0.25))
    return { color = float4(tone, edge, side.x, side.y) }

// a const is a literal, an enum case or another const, and stands for its value wherever it is named

const steps = 4
const scale = -0.5
const also_steps = steps
const mask = 0xff00u
const all_bits = 4294967295u

enum mode:
    low
    high

const default_mode = mode.high

test steps == 4 and also_steps == steps
test scale < 0.0

// a uint const takes its suffix, and every 32-bit value
test mask == 65280u and (mask >> 8u) == 255u
test all_bits == 0xffffffffu and all_bits + 1u == 0u

fun weight(m: mode) -> float:
    return case m:
        .low => 0.25
        .high => 1.0

test weight(default_mode) == 1.0

// a const whose value is a case names that case, so a case over the consts is exhaustive
fun rank(m: mode) -> int:
    return case m:
        default_mode => 2
        mode.low => 1

test rank(mode.low) == 1 and rank(default_mode) == 2

// a const reaches an entry point as the literal it stands for
struct frag:
    a: float

@pixel struct target:
    color: float4

@pixel fun main_ps(p: frag) -> target:
    let w = weight(default_mode) * scale + (steps as float) + ((mask >> 15u) as float)
    return target(float4(w * p.a, 0.0, 0.0, 1.0))

// a workgroup size may name an int const, which the attribute reads as its value (CHK-370)
binding cells:
    values: mut buffer[float]

@compute(steps, also_steps) fun spread(@thread_id id: int3){cells}:
    cells.values[id.x + id.y * steps] = scale

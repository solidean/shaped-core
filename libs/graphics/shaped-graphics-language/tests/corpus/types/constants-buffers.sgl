// `constants[T]`: a constant buffer of its own, which reads as the `T` it holds (CHK-539)

struct view_params:
    scale: float4
    offset: float4

struct light_params:
    color: float3
    intensity: float

binding frame:
    exposure: float
    view: constants[view_params]
    light: constants[light_params]

fun lit(){frame} -> float3 => frame.light.color * frame.light.intensity

// read whole, and by field, beside the plain members; `sgl test` gives nothing, which is zero
test {frame}:
    let v = frame.view
    v.scale == float4(0.0, 0.0, 0.0, 0.0)
    frame.view.offset.w + frame.exposure == 0.0
    lit() == float3(0.0, 0.0, 0.0)

// a constant is only read
@expect(error = "not-assignable")
test {frame}:
    frame.view.scale = float4(1.0, 1.0, 1.0, 1.0)
    frame.view.scale.x == 1.0

// `affine3` is an affine map of space, three rows of four: it translates a position and leaves a direction alone (CHK-408)

// a turn about z, then a move by (1, 2, 3)
fun placed() => affine3.from_rows(float4(0.0, -1.0, 0.0, 1.0), float4(1.0, 0.0, 0.0, 2.0), float4(0.0, 0.0, 1.0, 3.0))

// the type decides the w, so a position moves and a direction only turns
test placed() * pos3(1.0, 0.0, 0.0) == pos3(1.0, 3.0, 3.0)
test placed() * vec3(1.0, 0.0, 0.0) == vec3(0.0, 1.0, 0.0)

// a float4 gives its own w, and a row reads as it was given
test placed() * float4(1.0, 0.0, 0.0, 0.0) == float3(0.0, 1.0, 0.0)
test placed().row(1) == float4(1.0, 0.0, 0.0, 2.0)

// no GPU memory holds one yet, so a shader builds it from the rows memory holds
binding scene:
    rows: buffer[float4]
    points: mut buffer[float3]

@compute(64) fun place(@thread_id id: int3){scene}:
    let xf = affine3.from_rows(scene.rows[0], scene.rows[1], scene.rows[2])
    let p = xf * pos3(..scene.points[id.x])
    scene.points[id.x] = float3(p.x, p.y, p.z) + (xf * vec3(0.0, 0.0, 1.0)).z * xf.row(0).xyz

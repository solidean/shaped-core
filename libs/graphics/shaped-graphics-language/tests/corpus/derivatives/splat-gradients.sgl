// PROTOTYPE (docs/spec/incubator/autodiff.md): the gradient of one Gaussian splat's opacity at a pixel.
// It runs through what 3DGS's preprocessing computes - a covariance from a rotation and a scale, projected to the
// screen - and the falloff a pixel then sees; the gradient of all of it is one `bwd_diff`.
struct splat:
    mean: float3
    log_scale: float3
    rotation: float4
    opacity: float

// a unit quaternion's rotation, `w` first
fun rotation_of(q: float4) -> mat3:
    let n = normalize(q)
    let r = n.x
    let x = n.y
    let y = n.z
    let z = n.w
    let c0 = float3(1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y + r * z), 2.0 * (x * z - r * y))
    let c1 = float3(2.0 * (x * y - r * z), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z + r * x))
    let c2 = float3(2.0 * (x * z + r * y), 2.0 * (y * z - r * x), 1.0 - 2.0 * (x * x + y * y))
    return mat3(c0, c1, c2)

fun covariance(s: splat) -> mat3:
    let scale = exp(s.log_scale)
    let m = rotation_of(s.rotation) * mat3(float3(scale.x, 0.0, 0.0), float3(0.0, scale.y, 0.0), float3(0.0, 0.0, scale.z))
    return m * transpose(m)

// the splat seen through a pinhole of focal length 1, with 3DGS's low-pass of 0.3 on the screen
fun alpha_at(s: splat, pixel: float2) -> float:
    let z = s.mean.z
    let j = mat3(float3(1.0 / z, 0.0, 0.0), float3(0.0, 1.0 / z, 0.0), float3(-s.mean.x / (z * z), -s.mean.y / (z * z), 0.0))
    let cov = j * covariance(s) * transpose(j)
    let a = cov.column(0).x + 0.3
    let b = cov.column(1).x
    let c = cov.column(1).y + 0.3
    let d = pixel - float2(s.mean.x / z, s.mean.y / z)
    let power = -0.5 * (c * d.x * d.x - 2.0 * b * d.x * d.y + a * d.y * d.y) / (a * c - b * b)
    if power > 0.0 => return 0.0
    return exp(power) / (1.0 + exp(-s.opacity))

// `s` moved by `by` times `h`, for a central difference
fun moved(s: splat, by: splat, h: float) => splat(mean = s.mean + by.mean * h, log_scale = s.log_scale + by.log_scale * h, rotation = s.rotation + by.rotation * h, opacity = s.opacity + by.opacity * h)

// the gradient `g` read along the direction `d`
fun along(g: splat, d: splat) => dot(g.mean, d.mean) + dot(g.log_scale, d.log_scale) + dot(g.rotation, d.rotation) + g.opacity * d.opacity

const pixel = float2(0.2, -0.1)
const s0 = splat(mean = float3(0.3, -0.2, 2.0), log_scale = float3(-1.0, -0.5, -1.5), rotation = float4(0.9, 0.2, -0.3, 0.1), opacity = 0.4)
const zero_splat = splat(mean = float3(0.0), log_scale = float3(0.0), rotation = float4(0.0), opacity = 0.0)

// forward and reverse, each against a central difference along `d`
fun agrees(d: splat) -> bool:
    let h = 1e-3
    let numeric = (alpha_at(moved(s0, d, h), pixel) - alpha_at(moved(s0, d, -h), pixel)) / (2.0 * h)
    let forward = fwd_diff(alpha_at, s0, d, pixel, float2(0.0))
    let mut grad = zero_splat
    let mut grad_pixel = float2(0.0)
    bwd_diff(alpha_at, s0, mut grad, pixel, mut grad_pixel, 1.0)
    let tolerance = 1e-3 + 1e-2 * abs(numeric)
    return nearly_equal(forward, numeric, within = tolerance) and nearly_equal(along(grad, d), numeric, within = tolerance)

test agrees(splat(mean = float3(1.0, 0.0, 0.0), log_scale = float3(0.0), rotation = float4(0.0), opacity = 0.0))
test agrees(splat(mean = float3(0.0, 1.0, 0.0), log_scale = float3(0.0), rotation = float4(0.0), opacity = 0.0))
test agrees(splat(mean = float3(0.0, 0.0, 1.0), log_scale = float3(0.0), rotation = float4(0.0), opacity = 0.0))
test agrees(splat(mean = float3(0.0), log_scale = float3(1.0, 0.0, 0.0), rotation = float4(0.0), opacity = 0.0))
test agrees(splat(mean = float3(0.0), log_scale = float3(0.0, 1.0, 0.0), rotation = float4(0.0), opacity = 0.0))
test agrees(splat(mean = float3(0.0), log_scale = float3(0.0, 0.0, 1.0), rotation = float4(0.0), opacity = 0.0))
test agrees(splat(mean = float3(0.0), log_scale = float3(0.0), rotation = float4(1.0, 0.0, 0.0, 0.0), opacity = 0.0))
test agrees(splat(mean = float3(0.0), log_scale = float3(0.0), rotation = float4(0.0, 1.0, 0.0, 0.0), opacity = 0.0))
test agrees(splat(mean = float3(0.0), log_scale = float3(0.0), rotation = float4(0.0, 0.0, 1.0, 0.0), opacity = 0.0))
test agrees(splat(mean = float3(0.0), log_scale = float3(0.0), rotation = float4(0.0, 0.0, 0.0, 1.0), opacity = 0.0))
test agrees(splat(mean = float3(0.0), log_scale = float3(0.0), rotation = float4(0.0), opacity = 1.0))
test agrees(splat(mean = float3(0.3, -0.7, 0.2), log_scale = float3(0.5, -0.1, 0.9), rotation = float4(-0.2, 0.4, 0.1, 0.6), opacity = -0.8))

// the backward kernel a trainer dispatches, which every target writes
binding training:
    splats: buffer[splat]
    gradients: mut buffer[splat]

@compute(64) fun splat_backward(@thread_id id: int3){training}:
    let mut gradient = zero_splat
    let mut pixel_gradient = float2(0.0)
    bwd_diff(alpha_at, training.splats[id.x], mut gradient, pixel, mut pixel_gradient, 1.0)
    training.gradients[id.x] = gradient

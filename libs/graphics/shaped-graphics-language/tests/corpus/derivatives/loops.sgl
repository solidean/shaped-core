// PROTOTYPE (docs/spec/incubator/autodiff.md): loops of constant bounds, kept as loops by both modes.
// Going backward, what each iteration overwrites or decides is kept on a tape, one slot per iteration, and the loop is
// walked back from its last iteration.

// a sum of basis functions, as spherical harmonics evaluate a color: a call with an early return in every iteration
fun basis(k: int, d: float3) -> float:
    if k == 0 => return 0.282095
    if k == 1 => return 0.488603 * d.y
    if k == 2 => return 0.488603 * d.z
    return 0.488603 * d.x

fun shaded(c: float4, d: float3) -> float:
    let n = normalize(d)
    let mut sum = 0.0
    for k in 0 ..< 4:
        sum += c[k] * basis(k, n)
    return max(sum + 0.5, 0.0)

// an accumulator overwritten in every iteration, and a branch that differs between iterations
fun bumpy(x: float2) -> float:
    let mut y = x.x
    for i in 1 ..< 6:
        if i % 2 == 0 => y = y * x.y + sin(y)
        else => y = y * y * 0.5 + x.y
    return y

// nested loops share one tape, one slot per pair of iterations
fun grid(x: float2) -> float:
    let mut acc = 0.0
    for i in 0 ..< 3:
        for j in 0 ..< 2:
            acc = acc * 0.5 + x.x * float(i) + x.y * x.y * float(j + 1)
    return acc

fun shaded_of(v: float4) => shaded(float4(v.x, v.y, v.z, v.w), float3(0.3, -0.5, 0.8))

fun agrees4(v: float4, axis: float4) -> bool:
    let h = 1e-3
    let numeric = (shaded_of(v + axis * h) - shaded_of(v - axis * h)) / (2.0 * h)
    let mut gradient = float4(0.0)
    bwd_diff(shaded_of, v, mut gradient, 1.0)
    let tolerance = 1e-3 + 1e-2 * abs(numeric)
    return nearly_equal(fwd_diff(shaded_of, v, axis), numeric, within = tolerance)
        and nearly_equal(dot(gradient, axis), numeric, within = tolerance)

test agrees4(float4(0.5, 0.2, -0.3, 0.1), float4(1.0, 0.0, 0.0, 0.0))
test agrees4(float4(0.5, 0.2, -0.3, 0.1), float4(0.0, 1.0, 0.0, 0.0))
test agrees4(float4(0.5, 0.2, -0.3, 0.1), float4(0.0, 0.0, 1.0, 0.0))
test agrees4(float4(0.5, 0.2, -0.3, 0.1), float4(0.0, 0.0, 0.0, 1.0))

// the direction too, through the normalization and every basis function
fun shaded_from(d: float3) => shaded(float4(0.5, 0.2, -0.3, 0.1), d)

fun agrees_direction(d: float3, axis: float3) -> bool:
    let h = 1e-3
    let numeric = (shaded_from(d + axis * h) - shaded_from(d - axis * h)) / (2.0 * h)
    let mut gradient = float3(0.0)
    bwd_diff(shaded_from, d, mut gradient, 1.0)
    let tolerance = 1e-3 + 1e-2 * abs(numeric)
    return nearly_equal(fwd_diff(shaded_from, d, axis), numeric, within = tolerance)
        and nearly_equal(dot(gradient, axis), numeric, within = tolerance)

test agrees_direction(float3(0.3, -0.5, 0.8), float3(1.0, 0.0, 0.0))
test agrees_direction(float3(0.3, -0.5, 0.8), float3(0.0, 1.0, 0.0))
test agrees_direction(float3(0.3, -0.5, 0.8), float3(0.0, 0.0, 1.0))

fun bumpy_agrees(x: float2, axis: float2) -> bool:
    let h = 1e-3
    let numeric = (bumpy(x + axis * h) - bumpy(x - axis * h)) / (2.0 * h)
    let mut gradient = float2(0.0)
    bwd_diff(bumpy, x, mut gradient, 1.0)
    let tolerance = 1e-3 + 1e-2 * abs(numeric)
    return nearly_equal(fwd_diff(bumpy, x, axis), numeric, within = tolerance)
        and nearly_equal(dot(gradient, axis), numeric, within = tolerance)

test bumpy_agrees(float2(0.7, 0.4), float2(1.0, 0.0))
test bumpy_agrees(float2(0.7, 0.4), float2(0.0, 1.0))

fun grid_agrees(x: float2, axis: float2) -> bool:
    let h = 1e-3
    let numeric = (grid(x + axis * h) - grid(x - axis * h)) / (2.0 * h)
    let mut gradient = float2(0.0)
    bwd_diff(grid, x, mut gradient, 1.0)
    let tolerance = 1e-3 + 1e-2 * abs(numeric)
    return nearly_equal(fwd_diff(grid, x, axis), numeric, within = tolerance)
        and nearly_equal(dot(gradient, axis), numeric, within = tolerance)

test grid_agrees(float2(0.7, 0.4), float2(1.0, 0.0))
test grid_agrees(float2(0.7, 0.4), float2(0.0, 1.0))

binding colors:
    coefficients: buffer[float4]
    gradients: mut buffer[float4]

@compute(64) fun color_backward(@thread_id id: int3){colors}:
    let mut gradient = float4(0.0)
    bwd_diff(shaded_of, colors.coefficients[id.x], mut gradient, 1.0)
    colors.gradients[id.x] = gradient

// a loop left early: the iterations after the break do nothing, and the tape says so going backward
fun until_large(x: float) -> float:
    let mut y = x
    for i in 0 ..< 8:
        y = y * 1.5
        if y > 10.0 => break
    return y

// 2.0 grows 1.5 times a step and passes 10 after 4 steps, so the derivative is 1.5^4
test nearly_equal(fwd_diff(until_large, 2.0, 1.0), 5.0625, within = 1e-4)
test:
    let mut dx = 0.0
    bwd_diff(until_large, 2.0, mut dx, 1.0)
    nearly_equal(dx, 5.0625, within = 1e-4)

// a loop that breaks in its first iteration runs none after it
test:
    let mut dx = 0.0
    bwd_diff(until_large, 9.0, mut dx, 1.0)
    nearly_equal(dx, 1.5, within = 1e-5)

// a continue skips the rest of its iteration: the odd steps add nothing
fun even_steps(x: float) -> float:
    let mut y = 0.0
    for i in 0 ..< 6:
        if i % 2 == 1 => continue
        y += x * float(i)
    return y

test fwd_diff(even_steps, 1.0, 1.0) == 6.0
test:
    let mut dx = 0.0
    bwd_diff(even_steps, 1.0, mut dx, 1.0)
    dx == 6.0

// a return from inside a loop, which leaves the loop and the function it stands in
fun first_above(x: float2) -> float:
    for i in 0 ..< 5:
        let v = x.x * float(i + 1)
        if v > x.y => return v * v
    return x.y

fun first_above_of(x: float2) => first_above(x) + 1.0

test:
    let mut dx = float2(0.0)
    bwd_diff(first_above_of, float2(0.7, 1.5), mut dx, 1.0)
    // 0.7 * 3 = 2.1 is the first above 1.5, and the result is (3 x)^2, whose derivative is 18 x
    nearly_equal(dx.x, 12.6, within = 1e-4)
    dx.y == 0.0
test nearly_equal(fwd_diff(first_above_of, float2(0.7, 1.5), float2(1.0, 0.0)), 12.6, within = 1e-4)

// a long loop, which unrolled would be 64 copies of its body going backward, and kept is one walked back over a tape
fun march(p: float3) -> float:
    let mut q = p
    let mut acc = 0.0
    for i in 0 ..< 64:
        let s = sin(q.x * 1.3 + float(i)) * cos(q.y * 0.7)
        q = q + float3(s, s * 0.5, -s) * 0.05
        acc = acc + exp(-dot(q, q)) * 0.1
    return acc

fun march_agrees(p: float3, axis: float3) -> bool:
    let h = 1e-3
    let numeric = (march(p + axis * h) - march(p - axis * h)) / (2.0 * h)
    let mut gradient = float3(0.0)
    bwd_diff(march, p, mut gradient, 1.0)
    let tolerance = 1e-3 + 1e-2 * abs(numeric)
    return nearly_equal(fwd_diff(march, p, axis), numeric, within = tolerance)
        and nearly_equal(dot(gradient, axis), numeric, within = tolerance)

test march_agrees(float3(0.2, -0.4, 0.3), float3(1.0, 0.0, 0.0))
test march_agrees(float3(0.2, -0.4, 0.3), float3(0.0, 1.0, 0.0))
test march_agrees(float3(0.2, -0.4, 0.3), float3(0.0, 0.0, 1.0))

binding growth:
    values: buffer[float]
    gradients: mut buffer[float]

@compute(64) fun growth_backward(@thread_id id: int3){growth}:
    let mut dx = 0.0
    bwd_diff(until_large, growth.values[id.x], mut dx, 1.0)
    growth.gradients[id.x] = dx

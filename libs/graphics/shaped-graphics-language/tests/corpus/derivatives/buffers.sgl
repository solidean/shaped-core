// PROTOTYPE (docs/spec/incubator/autodiff.md): what a derivative does with what a shader reads from a binding.
// A constant block's member is a constant: a camera, a setting, what every invocation is handed alike.
// A buffer's element is refused: its gradient would have to be written back, and a derivative never drops one silently.
// `no_diff(x)` reads it as a constant, and a buffer's @gradient and @tangent say where a read's change comes from and
// its gradient goes; a @backward on the function that reads it can say so too.

// `no_diff` holds a value constant: d/dx of x * (3 x), with the second factor held, is 3 x
fun half_held(x: float) => x * no_diff(x * 3.0)

test fwd_diff(half_held, 2.0, 1.0) == 6.0
test:
    let mut dx = 0.0
    bwd_diff(half_held, 2.0, mut dx, 1.0)
    dx == 6.0

binding scene:
    exposure: float
    weights: buffer[float]

binding training:
    gradients: mut buffer[atomic[float]]
    tangents: buffer[float]
    losses: mut buffer[float]

// a constant block's member is read as a constant
fun exposed(x: float){scene} => x * exp(scene.exposure)

@compute(64) fun constant_member(@thread_id id: int3){scene, training}:
    let mut dx = 0.0
    bwd_diff(exposed, training.tangents[id.x], mut dx, 1.0)
    training.losses[id.x] = dx

// a plain read of a buffer is refused
fun weighted(x: float, i: int){scene} => x * scene.weights[i]

@expect(error = "unsupported-yet")
@compute(64) fun refuses_a_buffer_read(@thread_id id: int3){scene, training}:
    let mut dx = 0.0
    bwd_diff(weighted, 1.0, mut dx, id.x, 1.0)
    training.losses[id.x] = dx

// read as no_diff, it is a constant
fun weighted_held(x: float, i: int){scene} => x * no_diff(scene.weights[i])

@compute(64) fun held_buffer_read(@thread_id id: int3){scene, training}:
    let mut dx = 0.0
    bwd_diff(weighted_held, 1.0, mut dx, id.x, 1.0)
    training.losses[id.x] = dx

// A differentiable buffer, written by hand: the function that reads an element says where the element's change comes
// from going forward, and where its gradient goes going backward.
// Many invocations may add to one element, as every pixel a splat covers adds to its gradient, so the add is atomic.
fun weight(i: int){scene} => no_diff(scene.weights[i])

@forward(weight)
fun weight_forward(i: int){training} => training.tangents[i]

@backward(weight)
fun weight_backward(i: int, dr: float){training}:
    training.gradients[i].add(dr)

fun loss(i: int){scene} -> float:
    let w = weight(i)
    return (w - 1.0) * (w - 1.0)

@compute(64) fun loss_backward(@thread_id id: int3){scene, training}:
    bwd_diff(loss, id.x, 1.0)

@compute(64) fun loss_forward(@thread_id id: int3){scene, training}:
    training.losses[id.x] = fwd_diff(loss, id.x)

// A differentiable buffer, by its attributes: going forward a read changes by its @tangent's element, and going
// backward its adjoint is added to its @gradient's element, at the read's index.
binding fitted:
    @gradient(training.gradients) @tangent(training.tangents) weights: buffer[float]
    targets: buffer[float]

fun fitted_loss(i: int){fitted} -> float:
    let d = fitted.weights[i] * fitted.weights[i] - no_diff(fitted.targets[i])
    return d * d

@compute(64) fun fitted_backward(@thread_id id: int3){fitted, training}:
    bwd_diff(fitted_loss, id.x, 1.0)

@compute(64) fun fitted_forward(@thread_id id: int3){fitted, training}:
    training.losses[id.x] = fwd_diff(fitted_loss, id.x)

// a gradient goes into atomics of floats, which many invocations add to at once
binding misfitted:
    @gradient(training.losses) weights: buffer[float]

fun misfitted_read(i: int){misfitted} => misfitted.weights[i] * 2.0

@expect(error = "unsupported-yet")
@compute(64) fun refuses_a_gradient_of_no_atomics(@thread_id id: int3){misfitted, training}:
    bwd_diff(misfitted_read, id.x, 1.0)

// a buffer that only says where its change comes from has nowhere to put its gradient
binding forward_only:
    @tangent(training.tangents) weights: buffer[float]

fun forward_only_read(i: int){forward_only} => forward_only.weights[i] * 2.0

@compute(64) fun forward_only_forward(@thread_id id: int3){forward_only, training}:
    training.losses[id.x] = fwd_diff(forward_only_read, id.x)

@expect(error = "unsupported-yet")
@compute(64) fun refuses_a_gradient_with_no_place(@thread_id id: int3){forward_only, training}:
    bwd_diff(forward_only_read, id.x, 1.0)

// the derivative adds to a binding the function never named, so the entry point lists it
@expect(error = "unsupported-yet")
@compute(64) fun refuses_an_unlisted_gradient(@thread_id id: int3){fitted}:
    bwd_diff(fitted_loss, id.x, 1.0)

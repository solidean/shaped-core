// what a test may not do, each written as a test that expects the error it gets

fun shade(k: float) -> float:
    // a test runs on its own, so the function's parameters have no value in it
    @expect(error = "test-captures-runtime-value")
    test k > 0.0
    return k

// a test ends in a check, or it could pass without having checked anything
@expect(error = "test-must-end-in-check")
test:
    let x = 1

binding frame:
    exposure: float

fun exposed(){frame} -> float => frame.exposure

// a test reads only the bindings it lists
@expect(error = "binding-not-listed")
test exposed() > 0.0

// the driver that runs a test gives what it lists, and `sgl test` gives nothing, which is zero
test {frame}:
    exposed() == 0.0

// a line that computes something and checks nothing is no-effect
@expect(warning = "no-effect")
test:
    1 + 2
    true

// a test that expects an error takes every diagnostic in it, and the unreachable line after the jump is among them
@expect(error = "jump-without-target")
test:
    break
    true

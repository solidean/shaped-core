// the maths builtins; a transcendental is compared within a tolerance, since no two libraries agree on its last bit

fun close(a: float, b: float) => nearly_equal(a, b, within = 0.000001)

test sin(0.0) == 0.0 and cos(0.0) == 1.0
test close(sin(1.5707963), 1.0) and close(cos(3.1415927), -1.0)
test close(tan(0.7853982), 1.0)
test close(atan2(1.0, 1.0), 0.7853982) and close(atan2(-1.0, -1.0), -2.3561945)
test close(asin(1.0), 1.5707963) and close(acos(1.0), 0.0)
test close(exp(1.0), 2.7182817) and close(log(2.7182817), 1.0)
test exp2(10.0) == 1024.0 and log2(8.0) == 3.0
test sqrt(9.0) == 3.0 and inverse_sqrt(4.0) == 0.5
test close(pow(2.0, 0.5), 1.4142135)
test close(tanh(0.5), 0.46211716)

// rounding: `round` is ties to even, `fract` is what `floor` leaves, and both keep the sign rules of every target
test floor(-1.5) == -2.0 and ceil(-1.5) == -1.0 and trunc(-1.5) == -1.0
test round(0.5) == 0.0 and round(1.5) == 2.0 and round(-2.5) == -2.0
test fract(-0.25) == 0.75

// a rounding that lands on zero keeps its argument's sign, as a GPU's does
test:
    let x = -0.4
    round(x).bits == 0x8000'0000 and trunc(x).bits == 0x8000'0000 and ceil(x).bits == 0x8000'0000
test sign(-3.0) == -1.0 and sign(0.0) == 0.0

test:
    let v = floor(float3(1.5, -1.5, 2.0))
    v.x == 1.0 and v.y == -2.0 and v.z == 2.0

test step(0.5, 0.25) == 0.0 and step(0.5, 0.5) == 1.0

// `x >= edge`, as HLSL writes it, so a NaN steps to 0
test:
    let zero = 0.0
    let nan = zero / zero
    step(0.0, nan) == 0.0 and step(nan, 1.0) == 0.0
test smoothstep(0.0, 1.0, 0.5) == 0.5

// `mix` takes one `t` for every component, or a vector of them, one per component, as every target does (CHK-398)
test:
    let m = mix(float3(0.0, 2.0, 4.0), float3(4.0, 6.0, 8.0), 0.25)
    m.x == 1.0 and m.y == 3.0 and m.z == 5.0
test:
    let m = mix(float3(0.0, 2.0, 4.0), float3(4.0, 6.0, 8.0), float3(0.0, 0.5, 1.0))
    m.x == 0.0 and m.y == 4.0 and m.z == 8.0
test:
    let m = mix(float4(0.0), float4(1.0), float4(0.25, 0.5, 0.75, 1.0))
    m.x == 0.25 and m.y == 0.5 and m.z == 0.75 and m.w == 1.0
test:
    let m = mix(half2(0.0, 1.0), half2(2.0, 3.0), half2(0.5, 1.0))
    m.x == 1.0 and m.y == 3.0

// geometry
test:
    let a = cross(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
    a.z == 1.0

test distance(pos3(0.0, 0.0, 0.0), pos3(3.0, 4.0, 0.0)) == 5.0

test:
    let r = reflect(vec3(1.0, -1.0, 0.0), vec3(0.0, 1.0, 0.0))
    r.x == 1.0 and r.y == 1.0

// integer bits: a count, the first set bit from either end, and all ones where there is none
test count_bits(0xff) == 8
test first_bit_high(0x10) == 4 and first_bit_low(0x10) == 4
test first_bit_high(0) == -1 and first_bit_high(-1) == -1
test:
    let u: uint = 0
    first_bit_low(u) == 0xffff'ffff
test reverse_bits(1) == -0x8000'0000

// a float's bits, read and written back
test 1.0.bits == 0x3f80'0000
test float.from_bits(0x3f80'0000) == 1.0
test int.from_bits(0xffff'ffff) == -1

// packing
test pack_unorm4x8(float4(1.0, 0.0, 0.5, 1.0)) == 0xff80'00ff
// a byte midway between two rounds up, WGSL's floor(v + 0.5): 63.5 is 64, and -63.5 is -63
test pack_snorm4x8(float4(-0.5, 0.5, 0.0, 0.0)) == 0x0000'40c1
test:
    let c = unpack_unorm4x8(0xff80'00ff)
    c.x == 1.0 and c.y == 0.0 and c.w == 1.0
test pack_half2x16(float2(1.0, -2.0)) == 0xc000'3c00
test:
    let h = unpack_half2x16(0xc000'3c00)
    h.x == 1.0 and h.y == -2.0

struct pixel_input:
    @position position: hpos4

@pixel struct target:
    color: float4

@pixel fun maths_ps(p: pixel_input) -> target:
    let x = p.position.x
    let wave = sin(x * 0.1) * cos(x * 0.05) + atan2(p.position.y, x)
    let edge = abs(ddx(x)) + abs(ddy(x))
    let bits = count_bits(x as int) + (first_bit_high(x as uint) as int) + reverse_bits(x as int)
    let packed = pack_unorm4x8(float4(fract(wave), round(x), sign(wave), step(0.5, edge)))
    let mixed = float.from_bits(x.bits) + pow(2.0, 0.5) + smoothstep(0.0, 1.0, x)
    let blend = mix(float3(wave), float3(edge), float3(0.0, 0.5, fract(x)))
    return { color = float4(wave, edge + blend.y, (bits + int.from_bits(packed)) as float, mixed + blend.z) }

// mix takes a weight per component as well as one for the whole vector.
test mix(float3(0.0, 2.0, 4.0), float3(4.0, 6.0, 8.0), float3(0.0, 0.5, 1.0)) == float3(0.0, 4.0, 8.0)
test mix(half2(0.0, 4.0), half2(2.0, 8.0), half2(1.0, 0.25)) == half2(2.0, 5.0)

// is_nan and is_inf of anything finite.
// A NaN or an infinity cannot be a constant, which WGSL refuses, so the true cases are a GPU's to show: sr's denoise tests feed both.
test not is_nan(1.0)
test not is_nan(float.from_bits(0x7f7fffffu))
test not is_inf(float.from_bits(0xff7fffffu))
test not is_inf(0.0)
test is_nan(float2(0.0, -2.0)) == bool2(false, false)
test is_inf(float4(0.0, 1.0, -1.0, 3.0e38)) == bool4(false, false, false, false)
// a half is tested as the float it widens to, which keeps a NaN and an infinity, and its largest finite value is neither
test not is_nan(1.0f16)
test not is_inf(-65504.0f16)
test is_nan(half3(0.0, -2.0, 65504.0)) == bool3(false, false, false)
test is_inf(half4(0.0, 1.0, -65504.0, 65504.0)) == bool4(false, false, false, false)

// a vector's min, max and clamp take a scalar bound, which stands for the vector of it (CHK-406)
test max(float3(-1.0, 2.0, 0.5), 0.0) == float3(0.0, 2.0, 0.5)
test min(float4(1.0, 5.0, 2.0, -3.0), 2.0) == float4(1.0, 2.0, 2.0, -3.0)
test clamp(float2(-1.0, 3.0), 0.0, 1.0) == float2(0.0, 1.0)
test clamp(half3(-1.0, 0.5, 3.0), 0.0, 1.0) == half3(0.0, 0.5, 1.0)

// an angle converts by pi, and mod floors where % truncates (CHK-405)
test abs(radians(180.0) - pi) < 0.000001 and abs(degrees(pi) - 180.0) < 0.0001
test radians(float2(90.0, 180.0)).y == pi
test mod(-1.0, 3.0) == 2.0 and (-1.0 % 3.0) == -1.0
test mod(float3(-1.0, 4.0, 5.0), 3.0) == float3(2.0, 1.0, 2.0)

// a bool converts to a number as 1 and 0, componentwise (CHK-197)
test (true as float) == 1.0 and (false as int) == 0 and (bool2(true, false) as uint2) == uint2(1u, 0u)

// smoothstep's edges may be scalars of a vector's element (CHK-406)
test smoothstep(0.0, 1.0, float2(0.5, 2.0)) == float2(0.5, 1.0)

// how a call's arguments fill its parameters: by position, by name, and in its own slot after a name

fun sub(a: int, b: int) => a - b

test sub(5, 3) == 2
test sub(b = 3, a = 5) == 2
test sub(5, b = 3) == 2

// a positional argument after a named one binds where every argument before it is in its own slot
test sub(a = 5, 3) == 2

@expect(error = "no-matching-overload")
test sub(b = 3, 5) == 2

// a named argument may be spelled with a leading dot
test sub(.b = 3, .a = 5) == 2

// a parameter is filled once, by a name it has, and each one without a default is filled
@expect(error = "no-matching-overload")
test sub(5, a = 3) == 2
@expect(error = "no-matching-overload")
test sub(5, c = 3) == 2
@expect(error = "no-matching-overload")
test sub(5) == 5
@expect(error = "no-matching-overload")
test sub(1, 2, 3) == 0

// a named-only parameter binds by name alone
fun scaled(x: float, .by: float) => x * by

test scaled(2.0, by = 3.0) == 6.0
test scaled(by = 3.0, x = 2.0) == 6.0

@expect(error = "no-matching-overload")
test scaled(2.0, 3.0) == 6.0

// names tell overloads apart where the arity alone does not
fun area(width: float, height: float) => width * height
fun area(side: float, .times: float) => side * side * times

test area(width = 2.0, height = 3.0) == 6.0
test area(2.0, times = 3.0) == 12.0

// a constructor binds like any other call
struct span2:
    lo: float
    hi: float

test span2(hi = 2.0, lo = 1.0).hi == 2.0
test span2(1.0, hi = 2.0).lo == 1.0

@expect(error = "no-matching-overload")
test span2(1.0, lo = 2.0).lo == 1.0

// a leading dot as an argument is a case of the enum its parameter is (CHK-152)
enum tone:
    warm
    cold

enum side:
    left
    right
    cold

fun weight(t: tone) -> float => case t:
    .warm => 2.0
    .cold => 0.5

fun weight(s: side, scale: float) -> float => case s:
    .left => scale
    .right => -scale
    .cold => 0.0

test weight(.warm) == 2.0 and weight(t = .cold) == 0.5
test weight(.right, 3.0) == -3.0

// the case must exist in the parameter's enum
@expect(error = "no-matching-overload")
test weight(.hot) == 1.0

fun pick(t: tone) => 1
fun pick(s: side) => 2

// a case two candidates' enums both have does not tell them apart, and one only one has does
@expect(error = "ambiguous-overload")
test pick(.cold) == 1

test pick(.warm) == 1 and pick(.left) == 2

// an extension adds a function to a type's scope from outside the type: a property, a static or a method

struct ray:
    origin: float3
    dir: float3

fun ray.inverted => ray(self.origin, -self.dir)

fun ray.along(.from: float3) -> ray => ray(from, float3(0.0, 0.0, 1.0))

fun ray.at(self, t: float) -> float3 => self.origin + self.dir * t

test ray(float3(0.0, 0.0, 0.0), float3(1.0, 0.0, 0.0)).inverted.dir.x == -1.0
test ray.along(from = float3(1.0, 2.0, 3.0)).dir.z == 1.0
test ray(float3(0.0, 0.0, 0.0), float3(1.0, 0.0, 0.0)).at(2.0).x == 2.0

// its body sees the members of `self` by name, as a member's does
fun ray.reach => dir.x + dir.y + dir.z

test ray(float3(0.0, 0.0, 0.0), float3(1.0, 2.0, 3.0)).reach == 6.0

// a prelude type takes extensions from the program like any other
fun float3.sum => x + y + z

test float3(1.0, 2.0, 3.0).sum == 6.0

// `/` and `%` of integers truncate toward zero, as every target's do, and `%` takes the sign of its left side

fun quotient(a: int, b: int) => a / b
fun remainder(a: int, b: int) => a % b

test quotient(7, 2) == 3
test quotient(-7, 2) == -3
test remainder(7, 3) == 1
test remainder(-7, 3) == -1
test remainder(7, -3) == 1

// over integer literals alone, `/` and `%` say nothing of whether integers or floats are meant (CHK-313)
@expect(error = "literal-needs-type")
test 1 / 3 == 0
@expect(error = "literal-needs-type")
test 7 % 2 == 1
test (7 as int) / 2 == 3
test 7 / 2.0 == 3.5

test:
    let a: uint = 7
    let b: uint = 2
    a / b == 3 and a % b == 1

// componentwise, for every integer vector
test:
    let q = int3(7, -7, 9) / int3(2, 2, 3)
    q.x == 3 and q.y == -3 and q.z == 3

test:
    let r = uint2(7, 9) % uint2(4, 5)
    r.x == 3 and r.y == 4

// a float `%` is `a - b * trunc(a / b)`, so it too takes the sign of its left side
test 7.5 % 2.0 == 1.5
test -7.5 % 2.0 == -1.5

test:
    let v = float2(5.0, -5.0) % float2(3.0, 3.0)
    v.x == 2.0 and v.y == -2.0

// the index arithmetic a flat id needs: a linear thread id split into a column and a row
fun column_of(i: int, width: int) => i % width
fun row_of(i: int, width: int) => i / width

test column_of(13, 4) == 1 and row_of(13, 4) == 3

// a checkerboard of 8-pixel squares, and a stripe that repeats every 3.5 pixels
struct pixel_input:
    @position position: hpos4

@pixel struct target:
    color: float4

@pixel fun checker_ps(p: pixel_input) -> target:
    let x = p.position.x as int
    let y = p.position.y as int
    let square = (column_of(x, 8) + row_of(y, 8)) % 2
    let stripe = p.position.x % 3.5
    return { color = float4(square as float, stripe, 0.0, 1.0) }

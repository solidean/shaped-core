// a @shadowable(false) symbol is hidden by nothing, `true` and `false` among them

@shadowable(false) const answer = 42

test answer == 42

@expect(error = "shadows-unshadowable")
test:
    let answer = 1
    answer == 1

@expect(error = "shadows-unshadowable")
test:
    for true in 0 ..< 2:
        true < 2

// `pi` is a const of the prelude, and a file that declares its own, as most ported shaders do, hides it
test pi > 3.14159 and pi < 3.1416

// a pixel stage may write its own depth and sample mask, members of its @pixel struct that are no color target

struct varyings:
    @position position: hpos4
    uv: float2

@vertex fun fullscreen_vs(@vertex_index v: int) -> varyings:
    let uv = float2(((v << 1) & 2) as float, (v & 2) as float)
    return { position = hpos4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.0, 1.0), uv = uv }

@pixel struct shaded:
    color: float4
    @depth depth: float

// a ramp across the target, which a depth test then compares against
fun ramp(uv: float2) -> float => saturate(uv.x)

test ramp(float2(0.25, 0.0)) == 0.25

@pixel fun ramp_ps(p: varyings) -> shaded:
    return { color = float4(1.0, 1.0, 1.0, 1.0), depth = ramp(p.uv) }

pipeline ramp_depth:
    vertex = fullscreen_vs
    pixel = ramp_ps
    depth_test = true
    depth_write = true
    depth_compare = .always
    depth_stencil_format = .depth32_float
    format = .rgba8_unorm

// depth alone, with the promise that it only moves further away, and the samples it covers
@pixel struct depth_only:
    @depth(.greater_equal) depth: float
    @sample_mask covered: uint

@pixel fun push_back_ps(p: varyings) -> depth_only:
    return { depth = p.position.z + 0.5, covered = 0x1 }

pipeline pushed:
    vertex = fullscreen_vs
    pixel = push_back_ps
    depth_test = true
    depth_write = true
    depth_stencil_format = .host

// what crosses from one shading stage to the next: an array of what crosses an element per location, a matrix a column per location

struct varyings:
    @position position: hpos4
    frame: mat3
    turn: mat2
    weights: float[3]
    @interpolate(.flat) ids: int[2]
    tint: float4

@vertex struct corner:
    position: float2
    color: float4
    // a vertex input reads one as its columns or its elements too, an attribute apiece
    @per_instance placement: mat3
    @format(.rgba8_unorm) shades: float4[2]

@pixel struct target:
    color: float4

fun framed(p: float2) -> mat3 => mat3(float3(p.x, 0.0, 0.0), float3(0.0, p.y, 0.0), float3(0.0, 0.0, 1.0))

test (framed(float2(2.0, 3.0)) * float3(1.0)).y == 3.0

@vertex fun corners_vs(c: corner, @vertex_index v: int) -> varyings:
    let mut link = varyings(
        position = hpos4(c.position.x, c.position.y, 0.0, 1.0)
        frame = c.placement * framed(c.position)
        turn = mat2(float2(1.0, 0.0), float2(0.0, 1.0))
        weights = [0.25, 0.5, 0.25]
        ids = [v, v / 3]
        tint = c.shades[1]
    )
    link.weights[2] = c.color.x
    link.weights[v % 3] += 1.0
    link.turn = mat2(float2(0.0, 1.0), float2(-1.0, 0.0))
    return link

@pixel fun shade_ps(p: varyings) -> target:
    let turned = p.turn * float2(1.0, 0.0)
    let lit = p.frame * float3(p.weights[0], p.weights[1], p.weights[2])
    return {color = float4(lit.x + turned.y, lit.y, (p.ids[0] + p.ids[1]) as float, p.tint.w)}

pipeline linked:
    vertex = corners_vs
    pixel = shade_ps
    format = .rgba8_unorm

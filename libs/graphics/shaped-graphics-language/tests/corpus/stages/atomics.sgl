// an atomic is memory every invocation updates in one step; each update gives the value before it

@workgroup binding counters:
    hits: atomic[uint]
    lowest: atomic[int]
    slots: atomic[uint][4]

fun claim(){counters} -> uint => counters.hits.add(1)

// a run is one invocation, so each update meets only the ones before it
test:
    counters.hits.store(0)
    claim() == 0
    claim() == 1
    counters.hits.load() == 2

test:
    counters.lowest.store(5)
    counters.lowest.min(-3) == 5
    counters.lowest.max(10) == -3
    counters.lowest.exchange(7) == 10
    counters.lowest.subtract(2) == 7
    counters.lowest.load() == 5

test:
    counters.slots[2].store(12)
    counters.slots[2].bit_and(10) == 12
    counters.slots[2].bit_or(1) == 8
    counters.slots[2].bit_xor(3) == 9
    counters.slots[2].load() == 10

// a compare-exchange stores only where the value is the expected one, and gives the value before either way
fun claim_slot(key: uint){counters} -> uint:
    let mut i = key & 3u
    for _ in 0 ..< 4:
        let before = counters.slots[i].compare_exchange(0u, key)
        if before == 0u or before == key => return i
        i = (i + 1u) & 3u
    return 4u

test:
    for i in 0 ..< 4 => counters.slots[i].store(0)
    claim_slot(5u) == 1
    claim_slot(9u) == 2
    claim_slot(5u) == 1
    claim_slot(2u) == 3
    claim_slot(4u) == 0
    claim_slot(7u) == 4
    counters.slots[1].load() == 5
    counters.slots[2].load() == 9
    counters.slots[3].load() == 2

// a run is one invocation, so a compare-exchange that meets the expected value always stores
test:
    counters.lowest.store(-1)
    counters.lowest.compare_exchange(3, 8) == -1
    counters.lowest.load() == -1
    counters.lowest.compare_exchange(-1, 8) == -1
    counters.lowest.load() == 8

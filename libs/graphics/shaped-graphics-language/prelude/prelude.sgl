// The prelude: the file the compiler places in front of every program.
// A tracer: it holds what tests/samples/cube.sgl needs, and nothing the cube does not need.
// Every declaration is @builtin: the compiler and each emitter know what stands behind the name.

// a struct line without a block is opaque: there is no member to name
@builtin struct float

@builtin struct float3:
    x: float
    y: float
    z: float

@builtin struct float4:
    x: float
    y: float
    z: float
    w: float

/// A direction: it has a length, and a translation leaves it alone.
@builtin struct vec3:
    x: float
    y: float
    z: float

/// A position: a translation moves it.
@builtin struct pos3:
    x: float
    y: float
    z: float

/// A position in clip space, before the divide.
@builtin struct hpos4:
    x: float
    y: float
    z: float
    w: float

/// Column-major, and a vector stands to its right.
@builtin struct mat4

@builtin fun normalize(v: vec3) -> vec3
@builtin fun dot(a: vec3, b: vec3) -> float
@builtin fun saturate(x: float) -> float

// An @operator function is found through its operator alone: its name is documentation, and no lookup sees it.
@builtin @operator("*") fun transform_position(m: mat4, p: pos3) -> hpos4
@builtin @operator("*") fun transform_direction(m: mat4, v: vec3) -> vec3
@builtin @operator("*") fun scale_color(c: float3, s: float) -> float3
@builtin @operator("*") fun multiply(a: float, b: float) -> float
@builtin @operator("+") fun add(a: float, b: float) -> float

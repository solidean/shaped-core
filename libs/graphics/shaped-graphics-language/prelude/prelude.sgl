// The prelude: the file the compiler places in front of every program.
// A tracer: it holds what the samples under tests/samples need, and what the tests of the flat tree's two forms need.
// Every declaration is @builtin: the compiler and each emitter know what stands behind the name.

// a struct line without a block is opaque: there is no member to name
@builtin struct float

@builtin struct float3:
    x: float
    y: float
    z: float

@builtin struct float4:
    x: float
    y: float
    z: float
    w: float

/// A direction: it has a length, and a translation leaves it alone.
@builtin struct vec3:
    x: float
    y: float
    z: float

/// A position: a translation moves it.
@builtin struct pos3:
    x: float
    y: float
    z: float

/// A position in clip space, before the divide.
@builtin struct hpos4:
    x: float
    y: float
    z: float
    w: float

/// Column-major, and a vector stands to its right.
@builtin struct mat4

/// 32 bits, signed; its arithmetic wraps.
@builtin struct int

@builtin struct bool

// @pure: a call has no effect, so nobody can tell whether or when it ran.
// A @builtin without it is assumed to have one, and the compiler then keeps its place among its neighbours.
@builtin @pure fun normalize(v: vec3) -> vec3
@builtin @pure fun dot(a: vec3, b: vec3) -> float
@builtin @pure fun saturate(x: float) -> float
@builtin @pure fun length(v: vec3) -> float
@builtin @pure fun abs(x: float) -> float
@builtin @pure fun min(a: float, b: float) -> float
@builtin @pure fun max(a: float, b: float) -> float
@builtin @pure fun clamp(x: float, low: float, high: float) -> float
/// `a` where `t` is 0 and `b` where it is 1.
@builtin @pure fun mix(a: float, b: float, t: float) -> float

// An @operator function is found through its operator alone: its name is documentation, and no lookup sees it.
@builtin @pure @operator("*") fun transform_position(m: mat4, p: pos3) -> hpos4
@builtin @pure @operator("*") fun transform_direction(m: mat4, v: vec3) -> vec3
@builtin @pure @operator("*") fun scale_color(c: float3, s: float) -> float3
@builtin @pure @operator("*") fun multiply(a: float, b: float) -> float
@builtin @pure @operator("+") fun add(a: float, b: float) -> float
@builtin @pure @operator("-") fun subtract(a: float, b: float) -> float
@builtin @pure @operator("/") fun divide(a: float, b: float) -> float
@builtin @pure @operator("-") fun negate(x: float) -> float
@builtin @pure @operator("<") fun less(a: float, b: float) -> bool
@builtin @pure @operator("<=") fun less_equal(a: float, b: float) -> bool
@builtin @pure @operator(">") fun greater(a: float, b: float) -> bool
@builtin @pure @operator(">=") fun greater_equal(a: float, b: float) -> bool
@builtin @pure @operator("==") fun equal(a: float, b: float) -> bool
@builtin @pure @operator("!=") fun not_equal(a: float, b: float) -> bool

@builtin @pure @operator("+") fun add_color(a: float3, b: float3) -> float3
@builtin @pure @operator("*") fun multiply_color(a: float3, b: float3) -> float3
@builtin @pure @operator("+") fun add_vec3(a: vec3, b: vec3) -> vec3
@builtin @pure @operator("-") fun subtract_vec3(a: vec3, b: vec3) -> vec3
@builtin @pure @operator("*") fun scale_vec3(v: vec3, s: float) -> vec3

@builtin @pure @operator("+") fun add_int(a: int, b: int) -> int
@builtin @pure @operator("-") fun subtract_int(a: int, b: int) -> int
@builtin @pure @operator("*") fun multiply_int(a: int, b: int) -> int
@builtin @pure @operator("<") fun less_int(a: int, b: int) -> bool
@builtin @pure @operator("<=") fun less_equal_int(a: int, b: int) -> bool
@builtin @pure @operator(">") fun greater_int(a: int, b: int) -> bool
@builtin @pure @operator(">=") fun greater_equal_int(a: int, b: int) -> bool
@builtin @pure @operator("==") fun equal_int(a: int, b: int) -> bool
@builtin @pure @operator("!=") fun not_equal_int(a: int, b: int) -> bool

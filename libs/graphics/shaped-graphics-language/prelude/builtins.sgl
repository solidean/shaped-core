/// The angle of (x, y), in -pi to pi; `y` comes first, as in every target.
@builtin @pure fun atan2(y: float, x: float) -> float
@builtin @pure fun pow(x: float, y: float) -> float
/// 0 where `x` is below `edge`, and 1 from it on.
@builtin @pure fun step(edge: float, x: float) -> float
/// 0 up to `low`, 1 from `high` on, and a smooth Hermite curve between.
@builtin @pure fun smoothstep(low: float, high: float, x: float) -> float
@builtin @pure fun sin(x: float2) -> float2
@builtin @pure fun cos(x: float2) -> float2
@builtin @pure fun tan(x: float2) -> float2
@builtin @pure fun asin(x: float2) -> float2
@builtin @pure fun acos(x: float2) -> float2
@builtin @pure fun atan(x: float2) -> float2
@builtin @pure fun sinh(x: float2) -> float2
@builtin @pure fun cosh(x: float2) -> float2
@builtin @pure fun tanh(x: float2) -> float2
@builtin @pure fun exp(x: float2) -> float2
@builtin @pure fun exp2(x: float2) -> float2
@builtin @pure fun log(x: float2) -> float2
@builtin @pure fun log2(x: float2) -> float2
@builtin @pure fun sqrt(x: float2) -> float2
@builtin @pure fun inverse_sqrt(x: float2) -> float2
@builtin @pure fun floor(x: float2) -> float2
@builtin @pure fun ceil(x: float2) -> float2
@builtin @pure fun trunc(x: float2) -> float2
@builtin @pure fun round(x: float2) -> float2
@builtin @pure fun fract(x: float2) -> float2

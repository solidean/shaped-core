// derivatives across the 2x2 quad of pixels, which only a pixel stage has;
// a run of one invocation has no neighbours, and reads 0
@builtin @pure @stages(.pixel) fun ddx(x: float) -> float
@builtin @pure @stages(.pixel) fun ddy(x: float) -> float
@builtin @pure @stages(.pixel) fun ddx(x: float2) -> float2
@builtin @pure @stages(.pixel) fun ddy(x: float2) -> float2
@builtin @pure @stages(.pixel) fun ddx(x: float3) -> float3
@builtin @pure @stages(.pixel) fun ddy(x: float3) -> float3
@builtin @pure @stages(.pixel) fun ddx(x: float4) -> float4
@builtin @pure @stages(.pixel) fun ddy(x: float4) -> float4

// geometry
@builtin @pure fun cross(a: vec3, b: vec3) -> vec3
@builtin @pure fun cross(a: float3, b: float3) -> float3
@builtin @pure fun distance(a: pos3, b: pos3) -> float
@builtin @pure fun distance(a: float2, b: float2) -> float
@builtin @pure fun distance(a: float3, b: float3) -> float
@builtin @pure fun distance(a: float4, b: float4) -> float
/// `v` mirrored at the plane whose unit normal is `n`.
@builtin @pure fun reflect(v: vec3, n: vec3) -> vec3
/// `v` bent through a surface of unit normal `n` by the ratio of indices `eta`; zero where it reflects entirely.
@builtin @pure fun refract(v: vec3, n: vec3, eta: float) -> vec3

// integer bits, componentwise; `first_bit_*` gives all ones - -1 for an int - where there is no bit
@builtin @pure fun count_bits(x: int) -> int
/// The highest set bit of a uint; of an int, the highest bit that differs from its sign.
@builtin @pure fun first_bit_high(x: int) -> int
@builtin @pure fun first_bit_low(x: int) -> int
@builtin @pure fun reverse_bits(x: int) -> int
@builtin @pure fun count_bits(x: int2) -> int2
/// The highest set bit of a uint; of an int, the highest bit that differs from its sign.
@builtin @pure fun first_bit_high(x: int2) -> int2
@builtin @pure fun first_bit_low(x: int2) -> int2
@builtin @pure fun reverse_bits(x: int2) -> int2
@builtin @pure fun count_bits(x: int3) -> int3
/// The highest set bit of a uint; of an int, the highest bit that differs from its sign.
@builtin @pure fun first_bit_high(x: int3) -> int3
@builtin @pure fun first_bit_low(x: int3) -> int3
@builtin @pure fun reverse_bits(x: int3) -> int3
@builtin @pure fun count_bits(x: int4) -> int4
/// The highest set bit of a uint; of an int, the highest bit that differs from its sign.
@builtin @pure fun first_bit_high(x: int4) -> int4
@builtin @pure fun first_bit_low(x: int4) -> int4
@builtin @pure fun reverse_bits(x: int4) -> int4
@builtin @pure fun count_bits(x: uint) -> uint
/// The highest set bit of a uint; of an int, the highest bit that differs from its sign.
@builtin @pure fun first_bit_high(x: uint) -> uint
@builtin @pure fun first_bit_low(x: uint) -> uint
@builtin @pure fun reverse_bits(x: uint) -> uint
@builtin @pure fun count_bits(x: uint2) -> uint2
/// The highest set bit of a uint; of an int, the highest bit that differs from its sign.
@builtin @pure fun first_bit_high(x: uint2) -> uint2
@builtin @pure fun first_bit_low(x: uint2) -> uint2
@builtin @pure fun reverse_bits(x: uint2) -> uint2
@builtin @pure fun count_bits(x: uint3) -> uint3
/// The highest set bit of a uint; of an int, the highest bit that differs from its sign.
@builtin @pure fun first_bit_high(x: uint3) -> uint3
@builtin @pure fun first_bit_low(x: uint3) -> uint3
@builtin @pure fun reverse_bits(x: uint3) -> uint3

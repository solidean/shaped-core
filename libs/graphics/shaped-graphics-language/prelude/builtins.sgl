// the bits of a float, read and written; `x.bits` and `float.from_bits(u)` in core.sgl are how a
// program spells them, and `as` stays a numeric conversion
@builtin @pure fun reinterpret_as_uint(x: float) -> uint
@builtin @pure fun reinterpret_as_uint(x: float2) -> uint2
@builtin @pure fun reinterpret_as_uint(x: float3) -> uint3
@builtin @pure fun reinterpret_as_uint(x: float4) -> uint4
@builtin @pure fun reinterpret_as_float(x: uint) -> float
@builtin @pure fun reinterpret_as_float(x: uint2) -> float2
@builtin @pure fun reinterpret_as_float(x: uint3) -> float3
@builtin @pure fun reinterpret_as_float(x: uint4) -> float4
@builtin @pure fun reinterpret_as_int(x: uint) -> int
@builtin @pure fun reinterpret_as_int(x: uint2) -> int2
@builtin @pure fun reinterpret_as_int(x: uint3) -> int3
@builtin @pure fun reinterpret_as_int(x: uint4) -> int4

// packing into a uint and back: bytes rounded to nearest, and halves rounded to even
@builtin @pure fun pack_unorm4x8(v: float4) -> uint
@builtin @pure fun unpack_unorm4x8(u: uint) -> float4
@builtin @pure fun pack_snorm4x8(v: float4) -> uint
@builtin @pure fun unpack_snorm4x8(u: uint) -> float4
@builtin @pure fun pack_half2x16(v: float2) -> uint
@builtin @pure fun unpack_half2x16(u: uint) -> float2

// Textures and images, called as methods: `tex.sample(uv, smp)` is `sample(tex, uv, smp)`.
// A texture samples and loads, an image loads where the shader may read it and stores where it may write it.
// A sample takes its level from derivatives, or from a `level` named at the call.
@builtin @pure @stages(.pixel) fun sample(t: texture_2d[float], coord: float2, smp: sampler) -> float
@builtin @pure fun sample(t: texture_2d[float], coord: float2, smp: sampler, .level: float) -> float
@builtin @pure fun load(t: texture_2d[float], xy: int2, level: int = 0) -> float
@builtin fun load(i: image_2d[float], xy: int2) -> float
@builtin @stages(.pixel, .compute) fun store(i: out image_2d[float], xy: int2, value: float)

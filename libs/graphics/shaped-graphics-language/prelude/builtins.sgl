@builtin @pure fun pack_half2x16(v: float2) -> uint
@builtin @pure fun unpack_half2x16(u: uint) -> float2

// Textures and images, called as methods: `tex.sample(uv, smp)` is `sample(tex, uv, smp)`.
// A texture samples, gathers and loads; an image loads where the shader may read it and stores where it may write it.
// A sample takes its level from derivatives, or from a `level`, `bias` or `grad_x` / `grad_y` named at the call.
// An array's layer is always named, and an offset is a constant from -8 to 7 (CHK-280).
// Each sampling form has a twin without its sampler, which the texture's `@sampler` supplies (CHK-279).
/// Which channel of four texels a `gather` reads.
@shadowable(false)
@builtin enum texel_component:
    x
    y
    z
    w

// `nonuniform i` marks an index into a binding array that differs between invocations (CHK-300).
/// `i`, which the hardware is told may differ between the invocations that index with it.
@builtin @pure fun nonuniform(i: int) -> int
/// `i`, which the hardware is told may differ between the invocations that index with it.
@builtin @pure fun nonuniform(i: uint) -> uint

// Ray tracing: what a shader traces with, and the trace itself.
//
// A trace has two forms, and every target writes exactly one of them.
// The native form steps through the target's own query, HLSL's RayQuery or MSL's intersection_query, through the
// ray_query_* builtins of builtins.sgl.
// The emulated form traverses sg's acceleration pool in software, which is how WebGPU traces; its layout is the internal
// doc libs/graphics/shaped-graphics-language/docs/raytracing-polyfill.md.
// `by_target` holds both, and a target keeps the one it writes; the interpreter runs the emulated form.
//
// Everything `@internal` here is this file's own, and no program finds it.

// ---- the vocabulary -------------------------------------------------------------------------------------------------

/// A ray in world space: the points `origin + t * direction` for `t` from `t_min` to `t_max`.
struct ray:
    origin: pos3
    direction: vec3
    t_min: float = 0.0
    t_max: float = 3.0e38
    /// Where in the frame's interval the ray is cast, 0 at its start and 1 at its end, which moving instances and vertices
    /// is placed at (EVAL-130); a static scene ignores it.
    time: float = 0.0

/// What an any-hit decision says of a candidate.
enum hit_decision:
    /// The candidate is a hit, and traversal goes on looking for a nearer one.
    accept
    /// The candidate is no hit.
    ignore
    /// The candidate is a hit, and traversal stops at it.
    accept_and_end_search

/// A triangle the traversal met and could not decide alone: a non-opaque one, which the any-hit decision is asked about.
struct triangle_candidate:
    t: float
    ray: ray
    /// The id the host gave the instance, 24 bits.
    instance_id: int
    /// The instance's position in its TLAS.
    instance_index: int
    geometry_index: int
    primitive_index: int
    /// The weights of the three vertices: `(1 - u - v, u, v)`.
    barycentrics: float3
    is_front_face: bool
    /// The instance's placement, object space to world space, and its inverse (CHK-408).
    object_to_world: affine3
    world_to_object: affine3
    /// The cluster the hit is in, as its build numbered it; -1 where the BLAS is built from no clusters.
    cluster_id: int = -1

/// The nearest triangle a trace accepted, where `is_hit`; otherwise its `t` is the ray's `t_max` and nothing else is set.
struct triangle_hit:
    is_hit: bool
    t: float
    ray: ray
    instance_id: int
    instance_index: int
    geometry_index: int
    primitive_index: int
    barycentrics: float3
    is_front_face: bool
    /// The instance's placement, object space to world space, and its inverse (CHK-408).
    object_to_world: affine3
    world_to_object: affine3
    /// The cluster the hit is in, as its build numbered it; -1 where the BLAS is built from no clusters.
    cluster_id: int = -1

/// A box of procedural geometry the traversal entered, which an intersection decides by what it reports.
/// Its `object_ray` is the ray in the instance's object space, where the box and its primitive stand.
struct procedural_box:
    /// The nearest hit accepted so far, which a report must not lie beyond.
    t_current: float
    ray: ray
    object_ray: ray
    instance_id: int
    instance_index: int
    geometry_index: int
    primitive_index: int
    /// The instance's placement, object space to world space, and its inverse (CHK-408).
    object_to_world: affine3
    world_to_object: affine3

/// What an intersection reports of a box: a hit at `t` with its `attributes`, or none (`report.none()`).
/// At most one per box; a report beyond the box's `t_current` or before the ray's `t_min` is no hit.
struct report[A]:
    t: float
    attributes: A
    is_hit: bool = true

/// No hit in the box.
fun report.none() -> report => report(0.0, undefined(), false)

/// A primitive an intersection reported, which the any-hit decision is asked about.
struct procedural_candidate[A]:
    t: float
    ray: ray
    instance_id: int
    instance_index: int
    geometry_index: int
    primitive_index: int
    attributes: A
    /// The instance's placement, object space to world space, and its inverse (CHK-408).
    object_to_world: affine3
    world_to_object: affine3

/// The nearest procedural primitive a trace accepted, where `is_hit`; otherwise its `t` is the ray's `t_max`, and its
/// attributes are undefined.
struct procedural_hit[A]:
    is_hit: bool
    t: float
    ray: ray
    instance_id: int
    instance_index: int
    geometry_index: int
    primitive_index: int
    attributes: A
    /// The instance's placement, object space to world space, and its inverse (CHK-408).
    object_to_world: affine3
    world_to_object: affine3

@internal fun procedural_hit.none(r: ray) -> procedural_hit:
    let zero = float4(0.0, 0.0, 0.0, 0.0)
    return procedural_hit(false, r.t_max, r, 0, 0, 0, 0, undefined(), affine3.from_rows(zero, zero, zero), affine3.from_rows(zero, zero, zero))

/// What a trace of a mixed structure hit: nothing, a triangle or a procedural primitive.
enum hit_kind:
    none
    triangle
    procedural

/// The nearest primitive a trace of a mixed structure accepted, of either kind, where `is_hit`.
/// Its `barycentrics` and `is_front_face` are a triangle's, and mean nothing for a procedural primitive.
/// Its `attributes` are a procedural primitive's, and undefined for a triangle.
/// Without a hit its `kind` is `none`, its `t` is the ray's `t_max`, and nothing else is set.
struct mixed_hit[A]:
    kind: hit_kind
    is_hit: bool
    t: float
    ray: ray
    instance_id: int
    instance_index: int
    geometry_index: int
    primitive_index: int
    barycentrics: float3
    is_front_face: bool
    attributes: A
    /// The instance's placement, object space to world space, and its inverse (CHK-408).
    object_to_world: affine3
    world_to_object: affine3

@internal fun mixed_hit.none(r: ray) -> mixed_hit:
    let zero = float4(0.0, 0.0, 0.0, 0.0)
    return mixed_hit(
        hit_kind.none
        false
        r.t_max
        r
        0
        0
        0
        0
        float3(0.0, 0.0, 0.0)
        false
        undefined()
        affine3.from_rows(zero, zero, zero)
        affine3.from_rows(zero, zero, zero)
    )

/// The hit as a triangle's, which `is_hit` only where the kind is `triangle`.
fun mixed_hit.triangle(self) -> triangle_hit:
    return triangle_hit(
        self.kind == hit_kind.triangle
        self.t
        self.ray
        self.instance_id
        self.instance_index
        self.geometry_index
        self.primitive_index
        self.barycentrics
        self.is_front_face
        self.object_to_world
        self.world_to_object
    )

/// The hit as a procedural primitive's, which `is_hit` only where the kind is `procedural`.
fun mixed_hit.procedural(self) -> procedural_hit[A]:
    return procedural_hit(
        self.kind == hit_kind.procedural
        self.t
        self.ray
        self.instance_id
        self.instance_index
        self.geometry_index
        self.primitive_index
        self.attributes
        self.object_to_world
        self.world_to_object
    )

@internal fun mixed_of_triangle[A](h: triangle_hit, attributes: A) -> mixed_hit[A]:
    let mut kind = hit_kind.none
    if h.is_hit => kind = hit_kind.triangle
    return mixed_hit(
        kind
        h.is_hit
        h.t
        h.ray
        h.instance_id
        h.instance_index
        h.geometry_index
        h.primitive_index
        h.barycentrics
        h.is_front_face
        attributes
        h.object_to_world
        h.world_to_object
    )

@internal fun mixed_of_procedural[A](h: procedural_hit[A]) -> mixed_hit[A]:
    let mut kind = hit_kind.none
    if h.is_hit => kind = hit_kind.procedural
    return mixed_hit(
        kind
        h.is_hit
        h.t
        h.ray
        h.instance_id
        h.instance_index
        h.geometry_index
        h.primitive_index
        float3(0.0, 0.0, 0.0)
        false
        h.attributes
        h.object_to_world
        h.world_to_object
    )

// ---- the transforms of a hit, typed by what they move ---------------------------------------------------------------

@internal fun apply_point(a: affine3, p: float3) -> float3:
    let x = a.row(0)
    let y = a.row(1)
    let z = a.row(2)
    return float3(
        x.x * p.x + x.y * p.y + x.z * p.z + x.w
        y.x * p.x + y.y * p.y + y.z * p.z + y.w
        z.x * p.x + z.y * p.y + z.z * p.z + z.w
    )

/// The rows without their translation, which a direction never takes: no `w * 0.0` a compiler cannot fold away.
@internal fun apply_vector(a: affine3, v: float3) -> float3:
    let x = a.row(0)
    let y = a.row(1)
    let z = a.row(2)
    return float3(
        x.x * v.x + x.y * v.y + x.z * v.z
        y.x * v.x + y.y * v.y + y.z * v.z
        z.x * v.x + z.y * v.y + z.z * v.z
    )

@internal fun apply_transposed(a: affine3, n: float3) -> float3:
    let x = a.row(0)
    let y = a.row(1)
    let z = a.row(2)
    return float3(
        x.x * n.x + y.x * n.y + z.x * n.z
        x.y * n.x + y.y * n.y + z.y * n.z
        x.z * n.x + y.z * n.y + z.z * n.z
    )

/// An object-space point of the hit's instance, in world space.
fun triangle_hit.to_world(self, p: pos3) -> pos3:
    let m = apply_point(self.object_to_world, float3(p.x, p.y, p.z))
    return pos3(m.x, m.y, m.z)

/// An object-space direction, in world space: the linear part alone.
fun triangle_hit.to_world(self, v: vec3) -> vec3:
    let m = apply_vector(self.object_to_world, float3(v.x, v.y, v.z))
    return vec3(m.x, m.y, m.z)

/// An object-space normal, in world space: by the inverse transpose, so it stays perpendicular to the surface.
fun triangle_hit.normal_to_world(self, n: vec3) -> vec3:
    let m = apply_transposed(self.world_to_object, float3(n.x, n.y, n.z))
    return vec3(m.x, m.y, m.z)

/// A world-space point, in the hit's object space.
fun triangle_hit.to_object(self, p: pos3) -> pos3:
    let m = apply_point(self.world_to_object, float3(p.x, p.y, p.z))
    return pos3(m.x, m.y, m.z)

/// A world-space direction, in the hit's object space.
fun triangle_hit.to_object(self, v: vec3) -> vec3:
    let m = apply_vector(self.world_to_object, float3(v.x, v.y, v.z))
    return vec3(m.x, m.y, m.z)

/// An object-space point of the candidate's instance, in world space.
fun triangle_candidate.to_world(self, p: pos3) -> pos3:
    let m = apply_point(self.object_to_world, float3(p.x, p.y, p.z))
    return pos3(m.x, m.y, m.z)

/// An object-space direction of the candidate's instance, in world space.
fun triangle_candidate.to_world(self, v: vec3) -> vec3:
    let m = apply_vector(self.object_to_world, float3(v.x, v.y, v.z))
    return vec3(m.x, m.y, m.z)

/// An object-space point of the hit's instance, in world space.
fun procedural_hit.to_world(self, p: pos3) -> pos3:
    let m = apply_point(self.object_to_world, float3(p.x, p.y, p.z))
    return pos3(m.x, m.y, m.z)

/// An object-space direction, in world space: the linear part alone.
fun procedural_hit.to_world(self, v: vec3) -> vec3:
    let m = apply_vector(self.object_to_world, float3(v.x, v.y, v.z))
    return vec3(m.x, m.y, m.z)

/// An object-space normal, in world space: by the inverse transpose, so it stays perpendicular to the surface.
fun procedural_hit.normal_to_world(self, n: vec3) -> vec3:
    let m = apply_transposed(self.world_to_object, float3(n.x, n.y, n.z))
    return vec3(m.x, m.y, m.z)

/// A world-space point, in the hit's object space.
fun procedural_hit.to_object(self, p: pos3) -> pos3:
    let m = apply_point(self.world_to_object, float3(p.x, p.y, p.z))
    return pos3(m.x, m.y, m.z)

/// A world-space direction, in the hit's object space.
fun procedural_hit.to_object(self, v: vec3) -> vec3:
    let m = apply_vector(self.world_to_object, float3(v.x, v.y, v.z))
    return vec3(m.x, m.y, m.z)

/// An object-space point of the hit's instance, in world space.
fun mixed_hit.to_world(self, p: pos3) -> pos3:
    let m = apply_point(self.object_to_world, float3(p.x, p.y, p.z))
    return pos3(m.x, m.y, m.z)

/// An object-space direction, in world space: the linear part alone.
fun mixed_hit.to_world(self, v: vec3) -> vec3:
    let m = apply_vector(self.object_to_world, float3(v.x, v.y, v.z))
    return vec3(m.x, m.y, m.z)

/// An object-space normal, in world space: by the inverse transpose, so it stays perpendicular to the surface.
fun mixed_hit.normal_to_world(self, n: vec3) -> vec3:
    let m = apply_transposed(self.world_to_object, float3(n.x, n.y, n.z))
    return vec3(m.x, m.y, m.z)

/// A world-space point, in the hit's object space.
fun mixed_hit.to_object(self, p: pos3) -> pos3:
    let m = apply_point(self.world_to_object, float3(p.x, p.y, p.z))
    return pos3(m.x, m.y, m.z)

/// A world-space direction, in the hit's object space.
fun mixed_hit.to_object(self, v: vec3) -> vec3:
    let m = apply_vector(self.world_to_object, float3(v.x, v.y, v.z))
    return vec3(m.x, m.y, m.z)

/// An object-space point of the candidate's instance, in world space.
fun procedural_candidate.to_world(self, p: pos3) -> pos3:
    let m = apply_point(self.object_to_world, float3(p.x, p.y, p.z))
    return pos3(m.x, m.y, m.z)

/// An object-space point of the box's instance, in world space.
fun procedural_box.to_world(self, p: pos3) -> pos3:
    let m = apply_point(self.object_to_world, float3(p.x, p.y, p.z))
    return pos3(m.x, m.y, m.z)

// ---- the trace ------------------------------------------------------------------------------------------------------

/// Traces `r` against `world`, deciding every non-opaque triangle by `any_hit`, and gives the nearest accepted hit.
fun trace(
    world: acceleration_structure[.triangles]
    r: ray
    any_hit: (triangle_candidate) -> hit_decision
    .flags: ray_flags = ray_flags.none
    .mask: int = 255
) -> triangle_hit:
    // a structure of triangles holds nothing else, and the target forbids both skip flags together
    if flags.has(ray_flags.skip_triangles) => return no_triangle_hit(r)
    return by_target(
        () => trace_native(world, r, flags, mask, any_hit)
        () => trace_emulated(acceleration_root(world), r, flags, mask, any_hit)
    )

/// Traces `r` against `world`, accepting every triangle it meets, and gives the nearest.
fun trace(
    world: acceleration_structure[.triangles]
    r: ray
    .flags: ray_flags = ray_flags.none
    .mask: int = 255
) -> triangle_hit:
    return trace(world, r, accept_every_triangle, flags = flags, mask = mask)

/// Traces `r` against boxes of procedural geometry: `intersection` reports what each box holds, `any_hit` decides every
/// report of a non-opaque one, and the nearest accepted is the hit.
fun trace[A](
    world: acceleration_structure[.procedural]
    r: ray
    intersection: (procedural_box) -> report[A]
    any_hit: (procedural_candidate[A]) -> hit_decision
    .flags: ray_flags = ray_flags.none
    .mask: int = 255
) -> procedural_hit[A]:
    // a structure of boxes holds nothing else, and the target forbids both skip flags together
    if flags.has(ray_flags.skip_procedural) => return procedural_hit.none(r)
    return by_target(
        () => trace_native_procedural(world, r, flags, mask, intersection, any_hit)
        () => trace_emulated_procedural(acceleration_root(world), r, flags, mask, intersection, any_hit)
    )

/// Traces `r` against boxes of procedural geometry, accepting every report.
fun trace[A](
    world: acceleration_structure[.procedural]
    r: ray
    intersection: (procedural_box) -> report[A]
    .flags: ray_flags = ray_flags.none
    .mask: int = 255
) -> procedural_hit[A]:
    return trace(world, r, intersection, c => hit_decision.accept, flags = flags, mask = mask)

/// Traces `r` against a structure of triangles and procedural boxes both, and gives the nearest accepted hit of either.
/// `any_hit` decides every non-opaque triangle.
/// `intersection` reports what each box holds, and `procedural_any_hit` decides every report of a non-opaque one.
fun trace[A](
    world: acceleration_structure[.mixed]
    r: ray
    any_hit: (triangle_candidate) -> hit_decision
    intersection: (procedural_box) -> report[A]
    procedural_any_hit: (procedural_candidate[A]) -> hit_decision
    .flags: ray_flags = ray_flags.none
    .mask: int = 255
) -> mixed_hit[A]:
    // skipping both kinds meets nothing, and the target forbids the two flags together
    if flags.has(ray_flags.skip_triangles | ray_flags.skip_procedural) => return mixed_hit.none(r)
    return by_target(
        () => trace_native_mixed(world, r, flags, mask, any_hit, intersection, procedural_any_hit)
        () => trace_emulated_mixed(acceleration_root(world), r, flags, mask, any_hit, intersection, procedural_any_hit)
    )

/// Traces `r` against a structure of triangles and procedural boxes both, accepting every triangle and every report.
fun trace[A](
    world: acceleration_structure[.mixed]
    r: ray
    intersection: (procedural_box) -> report[A]
    .flags: ray_flags = ray_flags.none
    .mask: int = 255
) -> mixed_hit[A]:
    return trace(world, r, accept_every_triangle, intersection, c => hit_decision.accept, flags = flags, mask = mask)

/// Whether anything lies on `r`: the shadow ray, which stops at the first hit it accepts.
fun is_occluded(world: acceleration_structure[.triangles], r: ray, .mask: int = 255) -> bool:
    let h = trace(world, r, flags = ray_flags.accept_first_hit_and_end_search, mask = mask)
    return h.is_hit

@internal fun accept_every_triangle(c: triangle_candidate) -> hit_decision => hit_decision.accept

/// Which form of a trace a target writes: the native one, or the emulated one where the device has no query.
@internal fun by_target[H](native: () -> H, emulated: () -> H) -> H => native()

@internal fun no_triangle_hit(r: ray) -> triangle_hit:
    let zero = float4(0.0, 0.0, 0.0, 0.0)
    return triangle_hit(false, r.t_max, r, 0, 0, 0, 0, float3(0.0, 0.0, 0.0), false, affine3.from_rows(zero, zero, zero), affine3.from_rows(zero, zero, zero))

// ---- reordering -----------------------------------------------------------------------------------------------------

/// Lets the target regroup a ray-generation stage's invocations so those agreeing on the low `bits` bits of `hint` run
/// together, as the traces they go on to make are likelier to run alike.
/// A hint: each invocation goes on as it was, and only which ones share a wave changes.
/// It is dx12's `MaybeReorderThread` and vulkan's `OpReorderThreadWithHintEXT` where the device has `shader_execution_reordering`, and nothing elsewhere.
/// Under dx12's `nvapi` fill of the feature it is NVAPI's `NvReorderThread` (EMIT-265).
@stages(.raygen)
fun maybe_reorder(hint: uint, bits: int):
    const if has(.shader_execution_reordering):
        reorder_thread_by_hint(hint, bits)
    else:
        return

// ---- hit objects ----------------------------------------------------------------------------------------------------
//
// `let h = trace_hit(world, r, set.ray, mut p)` traces without running the closest hit or the miss, and `h.invoke(mut p)`
// runs them (CHK-434).
// Only a device with `shader_execution_reordering` has them, so they stand under `has(.shader_execution_reordering)`.

fun hit_object.is_hit => hit_object_is_hit(self)
fun hit_object.is_miss => hit_object_is_miss(self)
fun hit_object.t => hit_object_t(self)
fun hit_object.instance_id => hit_object_instance_id(self)
fun hit_object.instance_index => hit_object_instance_index(self)
fun hit_object.geometry_index => hit_object_geometry_index(self)
fun hit_object.primitive_index => hit_object_primitive_index(self)

/// Regroups the invocations so those whose hit objects run the same shaders run together.
fun hit_object.reorder(self) => hit_object_reorder(self)

/// Regroups them by what their hit objects run, then by the low `bits` bits of `hint`.
fun hit_object.reorder(self, hint: uint, bits: int) => hit_object_reorder_by_hint(self, hint, bits)

// ---- what a ray-tracing stage is handed -----------------------------------------------------------------------------
//
// A stage's parameter of these types is its ray, its hit or its candidate, which its entry point reads from the target.

@internal fun current_ray() -> ray:
    let o = world_ray_origin()
    let d = world_ray_direction()
    return ray(origin = o, direction = d, t_min = ray_t_min(), t_max = ray_t_current())

// A hit's cluster, read only where the device builds a BLAS from clusters, so no other device needs the capability.
@internal fun current_cluster_id() -> int:
    const if has(.clustered_geometry):
        return hit_cluster_id()
    else:
        return -1

@internal fun current_triangle_hit() -> triangle_hit:
    let b = hit_barycentrics()
    return triangle_hit(
        true
        ray_t_current()
        current_ray()
        hit_instance_id()
        hit_instance_index()
        hit_geometry_index()
        hit_primitive_index()
        float3(1.0 - b.x - b.y, b.x, b.y)
        hit_is_front_face()
        affine3.from_rows(hit_object_to_world_row(0), hit_object_to_world_row(1), hit_object_to_world_row(2))
        affine3.from_rows(hit_world_to_object_row(0), hit_world_to_object_row(1), hit_world_to_object_row(2))
        current_cluster_id()
    )

@internal fun current_triangle_candidate() -> triangle_candidate:
    let b = hit_barycentrics()
    return triangle_candidate(
        ray_t_current()
        current_ray()
        hit_instance_id()
        hit_instance_index()
        hit_geometry_index()
        hit_primitive_index()
        float3(1.0 - b.x - b.y, b.x, b.y)
        hit_is_front_face()
        affine3.from_rows(hit_object_to_world_row(0), hit_object_to_world_row(1), hit_object_to_world_row(2))
        affine3.from_rows(hit_world_to_object_row(0), hit_world_to_object_row(1), hit_world_to_object_row(2))
        current_cluster_id()
    )

@internal fun current_procedural_box() -> procedural_box:
    let o = hit_object_ray_origin()
    let d = hit_object_ray_direction()
    return procedural_box(
        ray_t_current()
        current_ray()
        ray(origin = pos3(o.x, o.y, o.z), direction = vec3(d.x, d.y, d.z), t_min = ray_t_min(), t_max = ray_t_current())
        hit_instance_id()
        hit_instance_index()
        hit_geometry_index()
        hit_primitive_index()
        affine3.from_rows(hit_object_to_world_row(0), hit_object_to_world_row(1), hit_object_to_world_row(2))
        affine3.from_rows(hit_world_to_object_row(0), hit_world_to_object_row(1), hit_world_to_object_row(2))
    )

@internal fun current_procedural_hit[A](attributes: A) -> procedural_hit[A]:
    return procedural_hit(
        true
        ray_t_current()
        current_ray()
        hit_instance_id()
        hit_instance_index()
        hit_geometry_index()
        hit_primitive_index()
        attributes
        affine3.from_rows(hit_object_to_world_row(0), hit_object_to_world_row(1), hit_object_to_world_row(2))
        affine3.from_rows(hit_world_to_object_row(0), hit_world_to_object_row(1), hit_world_to_object_row(2))
    )

@internal fun current_procedural_candidate[A](attributes: A) -> procedural_candidate[A]:
    return procedural_candidate(
        ray_t_current()
        current_ray()
        hit_instance_id()
        hit_instance_index()
        hit_geometry_index()
        hit_primitive_index()
        attributes
        affine3.from_rows(hit_object_to_world_row(0), hit_object_to_world_row(1), hit_object_to_world_row(2))
        affine3.from_rows(hit_world_to_object_row(0), hit_world_to_object_row(1), hit_world_to_object_row(2))
    )

// ---- the native form ------------------------------------------------------------------------------------------------

@internal fun candidate_cluster_id(q: ray_query) -> int:
    const if has(.clustered_geometry):
        return ray_query_candidate_cluster_id(q)
    else:
        return -1

@internal fun committed_cluster_id(q: ray_query) -> int:
    const if has(.clustered_geometry):
        return ray_query_committed_cluster_id(q)
    else:
        return -1

@internal fun candidate_of(q: ray_query, r: ray) -> triangle_candidate:
    let b = ray_query_candidate_barycentrics(q)
    return triangle_candidate(
        ray_query_candidate_t(q)
        r
        ray_query_candidate_instance_id(q)
        ray_query_candidate_instance_index(q)
        ray_query_candidate_geometry_index(q)
        ray_query_candidate_primitive_index(q)
        float3(1.0 - b.x - b.y, b.x, b.y)
        ray_query_candidate_is_front_face(q)
        affine3.from_rows(ray_query_candidate_object_to_world_row(q, 0), ray_query_candidate_object_to_world_row(q, 1), ray_query_candidate_object_to_world_row(q, 2))
        affine3.from_rows(ray_query_candidate_world_to_object_row(q, 0), ray_query_candidate_world_to_object_row(q, 1), ray_query_candidate_world_to_object_row(q, 2))
        candidate_cluster_id(q)
    )

@internal fun committed_of(q: ray_query, r: ray) -> triangle_hit:
    if ray_query_committed_kind(q) == 0 => return no_triangle_hit(r)
    let b = ray_query_committed_barycentrics(q)
    return triangle_hit(
        true
        ray_query_committed_t(q)
        r
        ray_query_committed_instance_id(q)
        ray_query_committed_instance_index(q)
        ray_query_committed_geometry_index(q)
        ray_query_committed_primitive_index(q)
        float3(1.0 - b.x - b.y, b.x, b.y)
        ray_query_committed_is_front_face(q)
        affine3.from_rows(ray_query_committed_object_to_world_row(q, 0), ray_query_committed_object_to_world_row(q, 1), ray_query_committed_object_to_world_row(q, 2))
        affine3.from_rows(ray_query_committed_world_to_object_row(q, 0), ray_query_committed_world_to_object_row(q, 1), ray_query_committed_world_to_object_row(q, 2))
        committed_cluster_id(q)
    )

@internal fun trace_native(
    world: acceleration_structure[.triangles]
    r: ray
    flags: ray_flags
    mask: int
    any_hit: (triangle_candidate) -> hit_decision
) -> triangle_hit:
    let q = ray_query_begin()
    // a structure of triangles holds no box, and the target skips the procedural path whole
    ray_query_trace(q, world, r.origin, r.direction, r.t_min, r.t_max, flags | ray_flags.skip_procedural, mask, r.time)
    // Forced opaque, every candidate is committed by the target itself, and the query is only stepped to its end.
    if flags.has(ray_flags.force_opaque):
        while ray_query_proceed(q) => continue
    else:
        while ray_query_proceed(q):
            if ray_query_candidate_is_triangle(q):
                let d = any_hit(candidate_of(q, r))
                if d != hit_decision.ignore => ray_query_commit_triangle(q)
                if d == hit_decision.accept_and_end_search => ray_query_abort(q)
    return committed_of(q, r)

/// `flags` without the facing culls, which the target forbids beside `skip_triangles` and which mean nothing for a box.
@internal fun without_facing(flags: ray_flags) -> ray_flags:
    let opacity = ray_flags.force_opaque | ray_flags.force_non_opaque | ray_flags.cull_opaque | ray_flags.cull_non_opaque
    let search = ray_flags.accept_first_hit_and_end_search | ray_flags.skip_closest_hit
    return flags & (opacity | search | ray_flags.skip_triangles | ray_flags.skip_procedural)

@internal fun box_of(q: ray_query, r: ray, t_current: float) -> procedural_box:
    let o = ray_query_candidate_object_ray_origin(q)
    let d = ray_query_candidate_object_ray_direction(q)
    return procedural_box(
        t_current
        r
        ray(origin = pos3(o.x, o.y, o.z), direction = vec3(d.x, d.y, d.z), t_min = r.t_min, t_max = t_current)
        ray_query_candidate_instance_id(q)
        ray_query_candidate_instance_index(q)
        ray_query_candidate_geometry_index(q)
        ray_query_candidate_primitive_index(q)
        affine3.from_rows(ray_query_candidate_object_to_world_row(q, 0), ray_query_candidate_object_to_world_row(q, 1), ray_query_candidate_object_to_world_row(q, 2))
        affine3.from_rows(ray_query_candidate_world_to_object_row(q, 0), ray_query_candidate_world_to_object_row(q, 1), ray_query_candidate_world_to_object_row(q, 2))
    )

@internal fun candidate_of_box[A](b: procedural_box, reported: report[A]) -> procedural_candidate[A]:
    return procedural_candidate(
        reported.t
        b.ray
        b.instance_id
        b.instance_index
        b.geometry_index
        b.primitive_index
        reported.attributes
        b.object_to_world
        b.world_to_object
    )

@internal fun hit_of_box[A](b: procedural_box, reported: report[A]) -> procedural_hit[A]:
    return procedural_hit(
        true
        reported.t
        b.ray
        b.instance_id
        b.instance_index
        b.geometry_index
        b.primitive_index
        reported.attributes
        b.object_to_world
        b.world_to_object
    )

@internal fun trace_native_procedural[A](
    world: acceleration_structure[.procedural]
    r: ray
    flags: ray_flags
    mask: int
    intersection: (procedural_box) -> report[A]
    any_hit: (procedural_candidate[A]) -> hit_decision
) -> procedural_hit[A]:
    let q = ray_query_begin()
    // a structure of boxes holds no triangle, and the target skips the triangle path whole
    let kept = without_facing(flags)
    ray_query_trace(q, world, r.origin, r.direction, r.t_min, r.t_max, kept | ray_flags.skip_triangles, mask, r.time)
    // the query keeps the committed box's distance and ids, and the trace keeps what it reported
    let mut best: procedural_hit[A] = procedural_hit.none(r)
    while ray_query_proceed(q):
        if not ray_query_candidate_is_triangle(q):
            let mut t_current = r.t_max
            if ray_query_committed_kind(q) != 0 => t_current = ray_query_committed_t(q)
            let b = box_of(q, r, t_current)
            let reported = intersection(b)
            if reported.is_hit and reported.t >= r.t_min and reported.t <= t_current:
                let mut d = hit_decision.accept
                if not ray_query_candidate_is_opaque_box(q) => d = any_hit(candidate_of_box(b, reported))
                if d != hit_decision.ignore:
                    ray_query_commit_procedural(q, reported.t)
                    best = hit_of_box(b, reported)
                if d == hit_decision.accept_and_end_search or (d != hit_decision.ignore and flags.has(ray_flags.accept_first_hit_and_end_search)):
                    ray_query_abort(q)
    return best

@internal fun trace_native_mixed[A](
    world: acceleration_structure[.mixed]
    r: ray
    flags: ray_flags
    mask: int
    any_hit: (triangle_candidate) -> hit_decision
    intersection: (procedural_box) -> report[A]
    procedural_any_hit: (procedural_candidate[A]) -> hit_decision
) -> mixed_hit[A]:
    let q = ray_query_begin()
    let mut given = flags
    if flags.has(ray_flags.skip_triangles) => given = without_facing(flags)
    ray_query_trace(q, world, r.origin, r.direction, r.t_min, r.t_max, given, mask, r.time)
    // the query keeps the committed hit's distance and ids, and the trace keeps what the last committed box reported
    let mut best: procedural_hit[A] = procedural_hit.none(r)
    while ray_query_proceed(q):
        if ray_query_candidate_is_triangle(q):
            let d = any_hit(candidate_of(q, r))
            if d != hit_decision.ignore => ray_query_commit_triangle(q)
            if d == hit_decision.accept_and_end_search => ray_query_abort(q)
        else:
            let mut t_current = r.t_max
            if ray_query_committed_kind(q) != 0 => t_current = ray_query_committed_t(q)
            let b = box_of(q, r, t_current)
            let reported = intersection(b)
            if reported.is_hit and reported.t >= r.t_min and reported.t <= t_current:
                let mut d = hit_decision.accept
                if not ray_query_candidate_is_opaque_box(q) => d = procedural_any_hit(candidate_of_box(b, reported))
                if d != hit_decision.ignore:
                    ray_query_commit_procedural(q, reported.t)
                    best = hit_of_box(b, reported)
                if d == hit_decision.accept_and_end_search or (d != hit_decision.ignore and flags.has(ray_flags.accept_first_hit_and_end_search)):
                    ray_query_abort(q)
    // a triangle committed after the last box replaces it, and the attributes it carries are then undefined
    let kind = ray_query_committed_kind(q)
    if kind == 1 => return mixed_of_triangle(committed_of(q, r), best.attributes)
    if kind == 2 => return mixed_of_procedural(best)
    return mixed_hit.none(r)

// ---- the emulated form ----------------------------------------------------------------------------------------------
//
// A two-level BVH2 in sg's pool, walked with one stack; its layout is the internal doc raytracing-polyfill.md.

@internal fun pool_float3(u: uint4) -> float3 => float3(float.from_bits(u.x), float.from_bits(u.y), float.from_bits(u.z))

@internal fun pool_float4(u: uint4) -> float4 => float4.from_bits(u)

/// Whether the ray meets the closed box between `t_near` and `t_far`: the slab test.
/// It holds a little past the box, by the rounding of its products, and a ray along a box's face enters it.
/// So a box's sides stand a little apart from the ray's plane: a side the ray runs along would give 0 times `inverse`.
@internal fun is_box_entered(lo: float3, hi: float3, origin: float3, inverse: float3, t_near: float, t_far: float) -> bool:
    let a = (lo - origin - float3(1.0e-20)) * inverse
    let b = (hi - origin + float3(1.0e-20)) * inverse
    let near = min(a, b)
    let far = max(a, b)
    let enter = max(max(max(near.x, near.y), near.z), t_near)
    let leave = min(min(min(far.x, far.y), far.z), t_far)
    return enter <= leave + abs(leave) * 4.0e-7

/// `1 / x`, large and finite where `x` is 0.
@internal fun slab_inverse(x: float) -> float:
    if abs(x) < 1.0e-30 => return 1.0e30
    return 1.0 / x

/// The ray's axes and shear, which take it to +z through the origin: Woop, Benthin and Wald's watertight test.
/// `z` is its longest axis, and `x` and `y` swap on a ray along -z, so a triangle's winding reads the same.
@internal struct ray_shear:
    x: int
    y: int
    z: int
    along: float3

@internal fun ray_shear_of(d: float3) -> ray_shear:
    let length = abs(d)
    let mut z = 2
    if length.x >= length.y and length.x >= length.z:
        z = 0
    else if length.y >= length.z:
        z = 1
    let mut x = (z + 1) % 3
    let mut y = (x + 1) % 3
    if d[z] < 0.0:
        let swapped = x
        x = y
        y = swapped
    return ray_shear(x, y, z, float3(d[x] / d[z], d[y] / d[z], 1.0 / d[z]))

/// `p`, relative to the ray's origin, in the plane the ray pierces at the origin.
@internal fun sheared(p: float3, s: ray_shear) -> float2 => float2(p[s.x] - s.along.x * p[s.z], p[s.y] - s.along.y * p[s.z])

/// The side of the edge from `p` to `q` the ray's point stands on: never 0, and exactly negated for the edge from `q` to `p`.
/// A rounded difference of rounded products is 0 or has the true sign, so only a tie is left to decide.
/// A tie goes one way for an edge taken in its sorted direction, as if the point stood infinitesimally beside it.
/// So two triangles sharing an edge take a ray through it exactly once, and a fan around a vertex one through the vertex.
/// Sorting also has both triangles evaluate one expression in one order, whatever a target fuses of it.
@internal fun edge_side(p: float2, q: float2) -> float:
    let is_sorted = p.x < q.x or (p.x == q.x and p.y <= q.y)
    let mut side = 0.0
    if is_sorted:
        side = p.x * q.y - p.y * q.x
    else:
        side = q.x * p.y - q.y * p.x
    if side == 0.0 => side = 1.0e-37
    if is_sorted => return side
    return -side

/// The triangle's `(t, u, v, det)` along the ray, and `det == 0` where the ray misses it.
/// The determinant's sign says which side the ray sees: DXR's front face is clockwise as the ray sees it.
/// `a`, `b` and `c` are relative to the ray's origin.
@internal fun triangle_entry(a: float3, b: float3, c: float3, s: ray_shear) -> float4:
    let pa = sheared(a, s)
    let pb = sheared(b, s)
    let pc = sheared(c, s)
    let ea = edge_side(pc, pb)
    let eb = edge_side(pa, pc)
    let ec = edge_side(pb, pa)
    let is_inside = (ea > 0.0 and eb > 0.0 and ec > 0.0) or (ea < 0.0 and eb < 0.0 and ec < 0.0)
    if not is_inside => return float4(0.0, 0.0, 0.0, 0.0)
    let det = ea + eb + ec
    let t = (ea * a[s.z] + eb * b[s.z] + ec * c[s.z]) * s.along.z / det
    return float4(t, eb / det, ec / det, det)

/// Whether the candidate is opaque, after the instance's and the ray's forcing.
@internal fun is_opaque_candidate(geometry_opaque: bool, instance_flags: uint, flags: ray_flags) -> bool:
    let mut is_opaque = geometry_opaque
    if (instance_flags & 1) != 0 => is_opaque = true
    if (instance_flags & 2) != 0 => is_opaque = false
    if flags.has(ray_flags.force_opaque) => is_opaque = true
    if flags.has(ray_flags.force_non_opaque) => is_opaque = false
    return is_opaque

/// Whether the ray's flags and the instance's cull mode drop the candidate before anyone decides it.
@internal fun is_culled(is_opaque: bool, is_front: bool, instance_flags: uint, flags: ray_flags) -> bool:
    if flags.has(ray_flags.cull_opaque) and is_opaque => return true
    if flags.has(ray_flags.cull_non_opaque) and not is_opaque => return true
    // cull mode 2 is none: that instance is drawn from both sides whatever the ray asks
    if ((instance_flags >> 2) & 3) == 2 => return false
    if flags.has(ray_flags.cull_back_facing) and not is_front => return true
    if flags.has(ray_flags.cull_front_facing) and is_front => return true
    return false

/// How many units each instance of a TLAS takes: 10 where its header says one of them moves, 7 otherwise.
@internal fun instance_stride(header: uint4) -> uint:
    if (header.w & 4) != 0 => return 10
    return 7

/// Whether the instance moves over the frame: flag bit 28, whose end transform stands in units 7 to 9.
@internal fun is_moving_instance(instance: uint4) -> bool => ((instance.z >> 28) & 1) != 0

/// How far through the frame's interval `time` is: a time below 0, and a NaN, is 0, and one above 1 is 1.
@internal fun motion_fraction(time: float) -> float:
    let mut s = 0.0
    if time > 0.0 => s = min(time, 1.0)
    return s

/// The units a triangle of a BLAS takes: 6 where its header's bit 2 says it moves, the pose at time 1 in the last 3.
@internal fun triangle_stride(region_header: uint4) -> uint:
    if (region_header.w & 4) != 0 => return 6
    return 3

/// A vertex at `time`: `start`, mixed with its pose at time 1 in unit `at_end` where the BLAS moves (EVAL-132).
@internal fun vertex_at(region_header: uint4, start: uint4, at_end: uint, time: float) -> float3:
    let v = pool_float3(start)
    if (region_header.w & 4) == 0 => return v
    return v + (pool_float3(acceleration_pool_load(at_end)) - v) * motion_fraction(time)

/// The instance's object-to-world map at `time`: its two transforms mixed element by element (EVAL-130).
@internal fun instance_to_world(unit: uint, instance: uint4, time: float) -> affine3:
    let r0 = pool_float4(acceleration_pool_load(unit + 3))
    let r1 = pool_float4(acceleration_pool_load(unit + 4))
    let r2 = pool_float4(acceleration_pool_load(unit + 5))
    if not is_moving_instance(instance) => return affine3.from_rows(r0, r1, r2)
    let s = motion_fraction(time)
    let e0 = pool_float4(acceleration_pool_load(unit + 7))
    let e1 = pool_float4(acceleration_pool_load(unit + 8))
    let e2 = pool_float4(acceleration_pool_load(unit + 9))
    return affine3.from_rows(r0 + (e0 - r0) * s, r1 + (e1 - r1) * s, r2 + (e2 - r2) * s)

/// The inverse of an affine map: its linear part's inverse, by the cofactors, and the translation taken back through it.
@internal fun inverse_of_affine(m: affine3) -> affine3:
    let a = m.row(0).xyz
    let b = m.row(1).xyz
    let c = m.row(2).xyz
    let t = float3(m.row(0).w, m.row(1).w, m.row(2).w)
    let bc = cross(b, c)
    let ca = cross(c, a)
    let ab = cross(a, b)
    let scale = 1.0 / dot(a, bc)
    let i0 = float3(bc.x, ca.x, ab.x) * scale
    let i1 = float3(bc.y, ca.y, ab.y) * scale
    let i2 = float3(bc.z, ca.z, ab.z) * scale
    let r0 = float4(i0.x, i0.y, i0.z, -dot(i0, t))
    let r1 = float4(i1.x, i1.y, i1.z, -dot(i1, t))
    let r2 = float4(i2.x, i2.y, i2.z, -dot(i2, t))
    return affine3.from_rows(r0, r1, r2)

/// The ray in the space a walk is in, and the instance that space belongs to; a TLAS's is the ray's own.
@internal struct walk_space:
    origin: float3
    direction: float3
    inverse: float3
    shear: ray_shear
    instance: uint4
    to_world: affine3
    to_object: affine3

@internal fun walk_space_of_ray(origin: float3, direction: float3) -> walk_space:
    let none = float4(0.0, 0.0, 0.0, 0.0)
    return walk_space(
        origin
        direction
        float3(slab_inverse(direction.x), slab_inverse(direction.y), slab_inverse(direction.z))
        ray_shear_of(direction)
        uint4(0, 0, 0, 0)
        affine3.from_rows(none, none, none)
        affine3.from_rows(none, none, none)
    )

/// The space of the instance at `unit`, a static instance's inverse read and a moving one's taken at the ray's time.
@internal fun walk_space_of_instance(unit: uint, origin: float3, direction: float3, time: float) -> walk_space:
    let instance = acceleration_pool_load(unit + 6)
    let to_world = instance_to_world(unit, instance, time)
    let mut to_object = to_world
    if is_moving_instance(instance):
        to_object = inverse_of_affine(to_world)
    else:
        to_object = affine3.from_rows(
            pool_float4(acceleration_pool_load(unit))
            pool_float4(acceleration_pool_load(unit + 1))
            pool_float4(acceleration_pool_load(unit + 2))
        )
    let o = apply_point(to_object, origin)
    let d = apply_vector(to_object, direction)
    return walk_space(
        o
        d
        float3(slab_inverse(d.x), slab_inverse(d.y), slab_inverse(d.z))
        ray_shear_of(d)
        instance
        to_world
        to_object
    )

/// What a leaf hands back to the walk: how far the ray still reaches, and whether the search ends.
@internal struct walk_step:
    t_far: float
    is_done: bool

/// Walks the pool from `root`, handing `leaf` each primitive of a BLAS leaf the ray enters.
/// `leaf` takes the space, its BLAS's header, the primitive and how far the ray reaches, which starts at `t_far`.
@internal fun walk_pool(
    root: uint
    r: ray
    mask: int
    t_far: float
    leaf: (walk_space, uint4, uint, float) -> walk_step
):
    let header = acceleration_pool_load(root)
    if header.x == 0 => return
    let origin = float3(r.origin.x, r.origin.y, r.origin.z)
    let direction = float3(r.direction.x, r.direction.y, r.direction.z)

    // one stack for both levels: a node, and the instance whose BLAS it belongs to, -1 for the TLAS
    // It holds at most a TLAS's depth, a BLAS's depth and 4 more: a walk pushes one node per level it descends, and a
    // TLAS leaf at most four instances.
    // A pool's trees are balanced and share its 2^23 units, two a node, so the two depths sum to at most 42.
    // So the stack holds at most 46 entries, and the guards on each push are never false.
    // Only what `top` covers is ever read, so neither array is filled.
    let mut nodes: uint[64] = undefined()
    let mut owners: int[64] = undefined()
    nodes[0] = 0
    owners[0] = -1
    let mut top = 1
    let mut reach = t_far
    let mut is_done = false
    // The instance the walk is in, -1 for the TLAS, and what it computed of it.
    // A walk pops one instance's nodes one after another, since a TLAS leaf pushes the BLAS roots it lets in on top.
    let mut current = -1
    let mut region = root
    let ray_space = walk_space_of_ray(origin, direction)
    let mut space = ray_space
    while top > 0 and not is_done:
        top -= 1
        let owner = owners[top]
        let node = nodes[top]

        // the region and the ray in its space change only where the walk crosses into another instance
        if owner != current:
            current = owner
            if owner >= 0:
                let unit = header.y + instance_stride(header) * (owner as uint)
                space = walk_space_of_instance(unit, origin, direction, r.time)
                region = space.instance.x
            else:
                space = ray_space
                region = root

        let lo = acceleration_pool_load(region + 1 + 2 * node)
        let hi = acceleration_pool_load(region + 2 + 2 * node)
        if not is_box_entered(pool_float3(lo), pool_float3(hi), space.origin, space.inverse, r.t_min, reach) => continue

        if (hi.w & 2147483648) == 0:
            // an inner node: both children, the right one first so the left is taken next
            if top + 2 <= 64:
                nodes[top] = hi.w
                owners[top] = owner
                nodes[top + 1] = lo.w
                owners[top + 1] = owner
                top += 2
            continue

        let count = hi.w & 2147483647
        let region_header = acceleration_pool_load(region)
        for k in 0 ..< (count as int):
            let primitive = lo.w + (k as uint)
            if owner < 0:
                // a TLAS leaf holds instances, whose BLAS root is pushed where the instance's mask lets the ray in
                let entry = acceleration_pool_load(header.y + instance_stride(header) * primitive + 6)
                let instance_mask = ((entry.y >> 24) & 255) as int
                if (instance_mask & mask) != 0 and top < 64:
                    nodes[top] = 0
                    owners[top] = primitive as int
                    top += 1
                continue

            let step = leaf(space, region_header, primitive, reach)
            reach = step.t_far
            if step.is_done:
                is_done = true
                break

/// Hands `taken` the triangle `primitive` as a hit and whether it is opaque, where the ray meets it and nothing drops it.
@internal fun with_triangle(
    space: walk_space
    region_header: uint4
    primitive: uint
    t_far: float
    r: ray
    flags: ray_flags
    taken: (triangle_hit, bool) -> walk_step
) -> walk_step:
    let at = region_header.y + triangle_stride(region_header) * primitive
    let a = acceleration_pool_load(at)
    let b = acceleration_pool_load(at + 1)
    let c = acceleration_pool_load(at + 2)
    let v0 = vertex_at(region_header, a, at + 3, r.time)
    let v1 = vertex_at(region_header, b, at + 4, r.time)
    let v2 = vertex_at(region_header, c, at + 5, r.time)
    let found = triangle_entry(v0 - space.origin, v1 - space.origin, v2 - space.origin, space.shear)
    // written to fail on a NaN too, which a sliver's rounding can make of its t
    if found.w == 0.0 or not (found.x >= r.t_min and found.x <= t_far) => return walk_step(t_far, false)

    let instance_flags = space.instance.z >> 24
    // cull mode 1 is front: that instance flips its winding, as every native backend does
    let is_front = (found.w < 0.0) != (((instance_flags >> 2) & 3) == 1)
    let is_opaque = is_opaque_candidate(c.w == 1, instance_flags, flags)
    if is_culled(is_opaque, is_front, instance_flags, flags) => return walk_step(t_far, false)

    let hit = triangle_hit(
        true
        found.x
        r
        (space.instance.y & 16777215) as int
        space.instance.w as int
        b.w as int
        a.w as int
        float3(1.0 - found.y - found.z, found.y, found.z)
        is_front
        space.to_world
        space.to_object
    )
    return taken(hit, is_opaque)

/// Hands `taken` the box `primitive`, what `intersection` reported of it and whether it is opaque, where nothing drops it.
@internal fun with_box[A](
    space: walk_space
    region_header: uint4
    primitive: uint
    t_far: float
    r: ray
    flags: ray_flags
    intersection: (procedural_box) -> report[A]
    taken: (procedural_box, report[A], bool) -> walk_step
) -> walk_step:
    let at = region_header.y + 2 * primitive
    let box_lo = acceleration_pool_load(at)
    let box_hi = acceleration_pool_load(at + 1)
    if not is_box_entered(pool_float3(box_lo), pool_float3(box_hi), space.origin, space.inverse, r.t_min, t_far):
        return walk_step(t_far, false)

    let b = procedural_box(
        t_far
        r
        ray(
            origin = pos3(space.origin.x, space.origin.y, space.origin.z)
            direction = vec3(space.direction.x, space.direction.y, space.direction.z)
            t_min = r.t_min
            t_max = t_far
        )
        (space.instance.y & 16777215) as int
        space.instance.w as int
        (box_hi.w & 2147483647) as int
        box_lo.w as int
        space.to_world
        space.to_object
    )
    let reported = intersection(b)
    if reported.t < r.t_min or reported.t > t_far or not reported.is_hit => return walk_step(t_far, false)

    let is_opaque = is_opaque_candidate((box_hi.w & 2147483648) != 0, space.instance.z >> 24, flags)
    if flags.has(ray_flags.cull_opaque) and is_opaque => return walk_step(t_far, false)
    if flags.has(ray_flags.cull_non_opaque) and not is_opaque => return walk_step(t_far, false)
    return taken(b, reported, is_opaque)

/// Whether the search ends at a hit its decision accepted.
@internal fun ends_search(decision: hit_decision, flags: ray_flags) -> bool:
    return decision == hit_decision.accept_and_end_search or flags.has(ray_flags.accept_first_hit_and_end_search)

@internal fun take_triangle(
    best: mut triangle_hit
    hit: triangle_hit
    is_opaque: bool
    flags: ray_flags
    any_hit: (triangle_candidate) -> hit_decision
) -> walk_step:
    let mut decision = hit_decision.accept
    if not is_opaque => decision = any_hit(candidate_of_triangle_hit(hit))
    if decision == hit_decision.ignore => return walk_step(best.t, false)
    best = hit
    return walk_step(hit.t, ends_search(decision, flags))

@internal fun take_box[A](
    best: mut procedural_hit[A]
    b: procedural_box
    reported: report[A]
    is_opaque: bool
    flags: ray_flags
    any_hit: (procedural_candidate[A]) -> hit_decision
) -> walk_step:
    let mut decision = hit_decision.accept
    if not is_opaque => decision = any_hit(candidate_of_box(b, reported))
    if decision == hit_decision.ignore => return walk_step(best.t, false)
    best = hit_of_box(b, reported)
    return walk_step(best.t, ends_search(decision, flags))

@internal fun take_mixed_triangle[A](
    best: mut mixed_hit[A]
    hit: triangle_hit
    is_opaque: bool
    flags: ray_flags
    any_hit: (triangle_candidate) -> hit_decision
) -> walk_step:
    let mut decision = hit_decision.accept
    if not is_opaque => decision = any_hit(candidate_of_triangle_hit(hit))
    if decision == hit_decision.ignore => return walk_step(best.t, false)
    // a triangle has no attributes, and the ones it carries on are undefined
    best = mixed_of_triangle(hit, best.attributes)
    return walk_step(hit.t, ends_search(decision, flags))

@internal fun take_mixed_box[A](
    best: mut mixed_hit[A]
    b: procedural_box
    reported: report[A]
    is_opaque: bool
    flags: ray_flags
    any_hit: (procedural_candidate[A]) -> hit_decision
) -> walk_step:
    let mut decision = hit_decision.accept
    if not is_opaque => decision = any_hit(candidate_of_box(b, reported))
    if decision == hit_decision.ignore => return walk_step(best.t, false)
    best = mixed_of_procedural(hit_of_box(b, reported))
    return walk_step(best.t, ends_search(decision, flags))

@internal fun trace_emulated(
    root: uint
    r: ray
    flags: ray_flags
    mask: int
    any_hit: (triangle_candidate) -> hit_decision
) -> triangle_hit:
    let mut best = no_triangle_hit(r)
    walk_pool(
        root
        r
        mask
        best.t
        (space, region_header, primitive, t_far) => with_triangle(
            space
            region_header
            primitive
            t_far
            r
            flags
            (hit, is_opaque) => take_triangle(mut best, hit, is_opaque, flags, any_hit)
        )
    )
    return best

/// A leaf of a procedural trace: a BLAS of triangles holds nothing it sees.
@internal fun box_leaf[A](
    best: mut procedural_hit[A]
    space: walk_space
    region_header: uint4
    primitive: uint
    t_far: float
    r: ray
    flags: ray_flags
    intersection: (procedural_box) -> report[A]
    any_hit: (procedural_candidate[A]) -> hit_decision
) -> walk_step:
    if region_header.w != 1 => return walk_step(t_far, false)
    return with_box(
        space
        region_header
        primitive
        t_far
        r
        flags
        intersection
        (b, reported, is_opaque) => take_box(mut best, b, reported, is_opaque, flags, any_hit)
    )

@internal fun trace_emulated_procedural[A](
    root: uint
    r: ray
    flags: ray_flags
    mask: int
    intersection: (procedural_box) -> report[A]
    any_hit: (procedural_candidate[A]) -> hit_decision
) -> procedural_hit[A]:
    let mut best: procedural_hit[A] = procedural_hit.none(r)
    walk_pool(
        root
        r
        mask
        best.t
        (space, region_header, primitive, t_far) => box_leaf(
            mut best
            space
            region_header
            primitive
            t_far
            r
            flags
            intersection
            any_hit
        )
    )
    return best

/// A leaf of a mixed trace; the BLAS header's w says what its leaves hold: 0 triangles, 1 boxes.
@internal fun mixed_leaf[A](
    best: mut mixed_hit[A]
    space: walk_space
    region_header: uint4
    primitive: uint
    t_far: float
    r: ray
    flags: ray_flags
    any_hit: (triangle_candidate) -> hit_decision
    intersection: (procedural_box) -> report[A]
    procedural_any_hit: (procedural_candidate[A]) -> hit_decision
) -> walk_step:
    if region_header.w == 1:
        if flags.has(ray_flags.skip_procedural) => return walk_step(t_far, false)
        return with_box(
            space
            region_header
            primitive
            t_far
            r
            flags
            intersection
            (b, reported, is_opaque) => take_mixed_box(mut best, b, reported, is_opaque, flags, procedural_any_hit)
        )
    if flags.has(ray_flags.skip_triangles) => return walk_step(t_far, false)
    return with_triangle(
        space
        region_header
        primitive
        t_far
        r
        flags
        (hit, is_opaque) => take_mixed_triangle(mut best, hit, is_opaque, flags, any_hit)
    )

@internal fun trace_emulated_mixed[A](
    root: uint
    r: ray
    flags: ray_flags
    mask: int
    any_hit: (triangle_candidate) -> hit_decision
    intersection: (procedural_box) -> report[A]
    procedural_any_hit: (procedural_candidate[A]) -> hit_decision
) -> mixed_hit[A]:
    let mut best: mixed_hit[A] = mixed_hit.none(r)
    walk_pool(
        root
        r
        mask
        best.t
        (space, region_header, primitive, t_far) => mixed_leaf(
            mut best
            space
            region_header
            primitive
            t_far
            r
            flags
            any_hit
            intersection
            procedural_any_hit
        )
    )
    return best

@internal fun candidate_of_triangle_hit(hit: triangle_hit) -> triangle_candidate:
    return triangle_candidate(
        hit.t
        hit.ray
        hit.instance_id
        hit.instance_index
        hit.geometry_index
        hit.primitive_index
        hit.barycentrics
        hit.is_front_face
        hit.object_to_world
        hit.world_to_object
    )

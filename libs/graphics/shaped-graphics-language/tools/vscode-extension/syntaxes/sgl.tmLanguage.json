{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Shaped Graphics Language",
    "scopeName": "source.sgl",
    "information_for_contributors": [
        "TextMate JSON has no variables, so a few fragments repeat in many patterns; change every copy.",
        "The symbol-continue class is [0-9A-Za-z_@#\\\\'\\x{80}-\\x{10FFFF}]: '-' is not in it, and a quote mark continues a symbol but never starts one.",
        "(?<![…]) and (?![…]) over that class are the word boundaries; \\b would split x' and \\phi.",
        "The keyword lists live in #keywords, and one negative lookahead that names all of them repeats wherever a plain name is expected.",
        "Lookbehinds stay fixed-width, which is all Oniguruma promises."
    ],
    "patterns": [
        { "include": "#doc-comment-block" },
        { "include": "#comment-block" },
        { "include": "#multiline-raw-string" },
        { "include": "#multiline-string" },
        { "include": "#block" }
    ],
    "repository": {
        "block": {
            "comment": "One block of the line tree: a line plus every following line indented deeper than it. Each while consumes only its own block's indent, so a nested block's indent capture is relative to its parent.",
            "begin": "^([ \\t]*)(?=\\S)",
            "while": "(?:^|\\G)\\1(?=[ \\t]+\\S)|(?:^|\\G)(?=[ \\t]*$)",
            "patterns": [
                { "include": "#doc-comment-block" },
                { "include": "#comment-block" },
                { "include": "#multiline-raw-string" },
                { "include": "#multiline-string" },
                { "include": "#block-child" },
                { "include": "#code" }
            ]
        },
        "block-child": {
            "comment": "Needs at least one space past the parent's indent, which also keeps it from re-matching on its parent's own line.",
            "begin": "\\G([ \\t]+)(?=\\S)",
            "while": "(?:^|\\G)\\1(?=[ \\t]+\\S)|(?:^|\\G)(?=[ \\t]*$)",
            "patterns": [
                { "include": "#doc-comment-block" },
                { "include": "#comment-block" },
                { "include": "#multiline-raw-string" },
                { "include": "#multiline-string" },
                { "include": "#block-child" },
                { "include": "#code" }
            ]
        },
        "doc-comment-block": {
            "comment": "Listed before #comment-block, which would take a '///' line too.",
            "name": "comment.line.documentation.sgl",
            "begin": "(?:^|\\G)([ \\t]*)(///)",
            "beginCaptures": {
                "2": { "name": "punctuation.definition.comment.sgl" }
            },
            "while": "(?:^|\\G)\\1(?=[ \\t]+\\S)|(?:^|\\G)(?=[ \\t]*$)"
        },
        "comment-block": {
            "comment": "A line that is only a comment owns its children: they are comment text whatever they hold. It stands in for #block on that line, so it is listed before it.",
            "name": "comment.line.double-slash.sgl",
            "begin": "(?:^|\\G)([ \\t]*)(//)",
            "beginCaptures": {
                "2": { "name": "punctuation.definition.comment.sgl" }
            },
            "while": "(?:^|\\G)\\1(?=[ \\t]+\\S)|(?:^|\\G)(?=[ \\t]*$)"
        },
        "multiline-raw-string": {
            "comment": "The reserved raw opener: no interpolation, closed by three quotes leading the next sibling line. Listed before #multiline-string, which would read it as an empty string and an opener.",
            "begin": "(?:^|\\G)([ \\t]*)((?:[^\"/\\n]|/(?!/)|\"(?:[^\"\\\\\\n]|\\\\.)*\")*)(\"\"\")[ \\t]*$",
            "beginCaptures": {
                "2": {
                    "patterns": [
                        { "include": "#code" }
                    ]
                },
                "3": { "name": "string.quoted.triple.sgl punctuation.definition.string.begin.sgl" }
            },
            "end": "(?:^|\\G)\\1(\"\"\")(.*)$|(?:^|\\G)(?!\\1[ \\t]+\\S|[ \\t]*$)",
            "endCaptures": {
                "1": { "name": "string.quoted.triple.sgl punctuation.definition.string.end.sgl" },
                "2": {
                    "patterns": [
                        { "include": "#code" }
                    ]
                }
            },
            "contentName": "string.quoted.triple.sgl"
        },
        "multiline-string": {
            "comment": "A line whose last token is an open quote, with an optional fused tag name. It stands in for #block on that line, so it is listed before it. Both delimiter lines are matched whole, so their code is tokenized through captures. The closer is a quote leading the next sibling line; a closer line that ends in an open quote again is #multiline-string-bridge, which keeps this rule open. A sibling that leads with no quote ends the string zero-width (the 'missing-string-end' case).",
            "begin": "(?:^|\\G)([ \\t]*)((?:[^\"/\\n]|/(?!/)|\"(?:[^\"\\\\\\n]|\\\\.)*\")*)(\")([A-Za-z_\\x{80}-\\x{10FFFF}][0-9A-Za-z_\\x{80}-\\x{10FFFF}]*)?[ \\t]*$",
            "beginCaptures": {
                "2": {
                    "patterns": [
                        { "include": "#code" }
                    ]
                },
                "3": { "name": "string.quoted.double.sgl punctuation.definition.string.begin.sgl" },
                "4": { "name": "storage.modifier.string-tag.sgl" }
            },
            "end": "(?:^|\\G)\\1(\")(?!(?:[^\"/\\n]|/(?!/)|\"(?:[^\"\\\\\\n]|\\\\.)*\")*\"(?:[A-Za-z_\\x{80}-\\x{10FFFF}][0-9A-Za-z_\\x{80}-\\x{10FFFF}]*)?[ \\t]*$)(.*)$|(?:^|\\G)(?!\\1[ \\t]+\\S|[ \\t]*$|\\1\")",
            "endCaptures": {
                "1": { "name": "string.quoted.double.sgl punctuation.definition.string.end.sgl" },
                "2": {
                    "patterns": [
                        { "include": "#code" }
                    ]
                }
            },
            "patterns": [
                { "include": "#multiline-string-bridge" },
                { "include": "#multiline-string-content" }
            ]
        },
        "multiline-string-bridge": {
            "comment": "Closes one multi-line string and opens the next on the same line. It cannot compare its indent with the opener's; #multiline-string-content owns the deeper lines before this rule sees them.",
            "match": "(?:^|\\G)[ \\t]*(\")((?:[^\"/\\n]|/(?!/)|\"(?:[^\"\\\\\\n]|\\\\.)*\")*)(\")([A-Za-z_\\x{80}-\\x{10FFFF}][0-9A-Za-z_\\x{80}-\\x{10FFFF}]*)?[ \\t]*$",
            "captures": {
                "1": { "name": "string.quoted.double.sgl punctuation.definition.string.end.sgl" },
                "2": {
                    "patterns": [
                        { "include": "#code" }
                    ]
                },
                "3": { "name": "string.quoted.double.sgl punctuation.definition.string.begin.sgl" },
                "4": { "name": "storage.modifier.string-tag.sgl" }
            }
        },
        "multiline-string-content": {
            "comment": "The content lines: everything at least as deep as the first one. No backslash escapes in here, only interpolation.",
            "name": "string.quoted.double.sgl",
            "begin": "(?:^|\\G)([ \\t]+)(?=\\S)",
            "while": "(?:^|\\G)\\1|(?:^|\\G)(?=[ \\t]*$)",
            "patterns": [
                { "include": "#interpolation" }
            ]
        },
        "code": {
            "patterns": [
                { "include": "#comment" },
                { "include": "#strings" },
                { "include": "#attribute" },
                { "include": "#declarations" },
                { "include": "#types-and-arrows" },
                { "include": "#fields" },
                { "include": "#prelude-type" },
                { "include": "#application" },
                { "include": "#keywords" },
                { "include": "#numbers" },
                { "include": "#symbols" },
                { "include": "#operators" },
                { "include": "#punctuation" }
            ]
        },
        "comment": {
            "comment": "A comment trailing code ends with its line; the children of that line stay code.",
            "patterns": [
                {
                    "name": "comment.line.documentation.sgl",
                    "match": "(///).*$",
                    "captures": {
                        "1": { "name": "punctuation.definition.comment.sgl" }
                    }
                },
                {
                    "name": "comment.line.double-slash.sgl",
                    "match": "(//).*$",
                    "captures": {
                        "1": { "name": "punctuation.definition.comment.sgl" }
                    }
                }
            ]
        },
        "strings": {
            "comment": "One-line literals. Each begin looks ahead for its closer and each end also gives up at the end of the line, so none of them can leak into the next line.",
            "patterns": [
                {
                    "name": "string.quoted.double.sgl",
                    "begin": "\"(?=(?:[^\"\\\\\\n]|\\\\.)*\")",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.string.begin.sgl" }
                    },
                    "end": "(\")|$",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.string.end.sgl" }
                    },
                    "patterns": [
                        { "include": "#string-escape" },
                        { "include": "#interpolation" }
                    ]
                },
                {
                    "comment": "Undelimited string: an error the compiler recovers from, so the body stays a string and the opener is flagged.",
                    "match": "(\")((?:[^\"\\\\\\n]|\\\\.)*\\\\?)$",
                    "captures": {
                        "1": { "name": "invalid.illegal.unterminated-string.sgl" },
                        "2": { "name": "string.quoted.double.sgl" }
                    }
                },
                {
                    "name": "string.quoted.single.sgl",
                    "begin": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])'(?=(?:[^'\\\\\\n]|\\\\.)*')",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.string.begin.sgl" }
                    },
                    "end": "(')|$",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.string.end.sgl" }
                    },
                    "patterns": [
                        { "include": "#string-escape" }
                    ]
                },
                {
                    "comment": "Undelimited string: an error the compiler recovers from, so the body stays a string and the opener is flagged.",
                    "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])(')((?:[^'\\\\\\n]|\\\\.)*\\\\?)$",
                    "captures": {
                        "1": { "name": "invalid.illegal.unterminated-string.sgl" },
                        "2": { "name": "string.quoted.single.sgl" }
                    }
                },
                {
                    "name": "string.quoted.other.backtick.sgl",
                    "begin": "`(?=(?:[^`\\\\\\n]|\\\\.)*`)",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.string.begin.sgl" }
                    },
                    "end": "(`)|$",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.string.end.sgl" }
                    },
                    "patterns": [
                        { "include": "#string-escape" }
                    ]
                },
                {
                    "comment": "Undelimited string: an error the compiler recovers from, so the body stays a string and the opener is flagged.",
                    "match": "(`)((?:[^`\\\\\\n]|\\\\.)*\\\\?)$",
                    "captures": {
                        "1": { "name": "invalid.illegal.unterminated-string.sgl" },
                        "2": { "name": "string.quoted.other.backtick.sgl" }
                    }
                }
            ]
        },
        "string-escape": {
            "patterns": [
                {
                    "name": "constant.character.escape.sgl",
                    "match": "\\\\(?:[\\\\\\\"'`nrt0]|u\\{[0-9A-Fa-f]{1,6}\\})"
                },
                { "name": "invalid.illegal.escape.sgl", "match": "\\\\." }
            ]
        },
        "interpolation": {
            "comment": "Double-quoted strings only. '$$' is a literal dollar, and a name here is narrower than a symbol: no quote mark, '@', '#' or backslash.",
            "patterns": [
                { "name": "constant.character.escape.dollar.sgl", "match": "\\$\\$" },
                {
                    "name": "meta.interpolation.sgl",
                    "match": "(\\$)([A-Za-z_\\x{80}-\\x{10FFFF}][0-9A-Za-z_\\x{80}-\\x{10FFFF}]*(?:\\.[A-Za-z_\\x{80}-\\x{10FFFF}][0-9A-Za-z_\\x{80}-\\x{10FFFF}]*)*)",
                    "captures": {
                        "1": { "name": "punctuation.section.embedded.sgl" },
                        "2": {
                            "patterns": [
                                { "name": "punctuation.accessor.sgl", "match": "\\." },
                                {
                                    "name": "variable.other.member.sgl",
                                    "match": "(?<=\\.)[A-Za-z_\\x{80}-\\x{10FFFF}][0-9A-Za-z_\\x{80}-\\x{10FFFF}]*"
                                },
                                {
                                    "name": "variable.other.sgl",
                                    "match": "[A-Za-z_\\x{80}-\\x{10FFFF}][0-9A-Za-z_\\x{80}-\\x{10FFFF}]*"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "meta.interpolation.sgl",
                    "contentName": "meta.embedded.line.sgl",
                    "begin": "\\$\\(",
                    "beginCaptures": {
                        "0": { "name": "punctuation.section.embedded.begin.sgl" }
                    },
                    "end": "(\\))|$",
                    "endCaptures": {
                        "1": { "name": "punctuation.section.embedded.end.sgl" }
                    },
                    "patterns": [
                        { "include": "#nested-parens" },
                        { "include": "#code" }
                    ]
                },
                { "name": "invalid.illegal.stray-dollar.sgl", "match": "\\$" }
            ]
        },
        "nested-parens": {
            "comment": "Only used where a closing parenthesis ends an enclosing rule, so that an inner pair does not. It gives up at the end of the line like its users do.",
            "begin": "\\(",
            "beginCaptures": {
                "0": { "name": "punctuation.section.parens.begin.sgl" }
            },
            "end": "(\\))|$",
            "endCaptures": {
                "1": { "name": "punctuation.section.parens.end.sgl" }
            },
            "patterns": [
                { "include": "#nested-parens" },
                { "include": "#named-argument" },
                { "include": "#code" }
            ]
        },
        "attribute": {
            "patterns": [
                {
                    "comment": "Arguments are a fused round group only. They are scoped up to the end of the line; element lines below are plain code.",
                    "name": "meta.attribute.sgl",
                    "begin": "((?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])@[0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)(\\()",
                    "beginCaptures": {
                        "1": { "name": "entity.name.function.decorator.sgl" },
                        "2": { "name": "punctuation.section.parens.begin.sgl" }
                    },
                    "end": "(\\))|$",
                    "endCaptures": {
                        "1": { "name": "punctuation.section.parens.end.sgl" }
                    },
                    "patterns": [
                        { "include": "#nested-parens" },
                        { "include": "#named-argument" },
                        { "include": "#code" }
                    ]
                },
                { "include": "#attribute-name" }
            ]
        },
        "attribute-name": {
            "name": "entity.name.function.decorator.sgl",
            "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])@[0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*"
        },
        "named-argument": {
            "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)(?=[ \\t]*=(?![=>]))",
            "captures": {
                "1": { "name": "variable.other.member.sgl" }
            }
        },
        "declarations": {
            "patterns": [
                {
                    "comment": "An anonymous 'fun (x) => …' has no name and falls through to #keywords.",
                    "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])(fun)[ \\t]+(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)",
                    "captures": {
                        "1": { "name": "storage.type.function.sgl" },
                        "2": { "name": "entity.name.function.sgl" }
                    }
                },
                {
                    "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])(struct|enum|binding|sampler|type)[ \\t]+(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)",
                    "captures": {
                        "1": { "name": "storage.type.$1.sgl" },
                        "2": { "name": "entity.name.type.sgl" }
                    }
                },
                {
                    "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])(module)[ \\t]+(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)",
                    "captures": {
                        "1": { "name": "storage.type.module.sgl" },
                        "2": { "name": "entity.name.namespace.sgl" }
                    }
                },
                {
                    "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])(use)[ \\t]+(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)(?:[ \\t]+(as)[ \\t]+(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*))?",
                    "captures": {
                        "1": { "name": "keyword.control.import.sgl" },
                        "2": { "name": "entity.name.namespace.sgl" },
                        "3": { "name": "keyword.operator.wordlike.sgl" },
                        "4": { "name": "entity.name.namespace.sgl" }
                    }
                },
                {
                    "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])(let)(?:[ \\t]+(mut))?[ \\t]+(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))(?!_(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)",
                    "captures": {
                        "1": { "name": "storage.type.let.sgl" },
                        "2": { "name": "storage.modifier.sgl" },
                        "3": { "name": "variable.other.readwrite.sgl" }
                    }
                },
                {
                    "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])(const)[ \\t]+(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)",
                    "captures": {
                        "1": { "name": "storage.type.const.sgl" },
                        "2": { "name": "variable.other.constant.sgl" }
                    }
                },
                {
                    "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])(for)[ \\t]+(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))(?!_(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)",
                    "captures": {
                        "1": { "name": "keyword.control.sgl" },
                        "2": { "name": "variable.other.readwrite.sgl" }
                    }
                }
            ]
        },
        "types-and-arrows": {
            "comment": "A simple name after '->', ':' or 'as' stands in a type position; anything more complex is left to the other rules.",
            "patterns": [
                {
                    "match": "(?<![!+\\-*/%=<>?&^|~])(->)(?!(?:[!+\\-*%=<>?&^|~]|/(?!/)))[ \\t]*((?:(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])@[0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*[ \\t]+)*)(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)",
                    "captures": {
                        "1": { "name": "keyword.operator.arrow.sgl" },
                        "2": {
                            "patterns": [
                                { "include": "#attribute-name" }
                            ]
                        },
                        "3": { "name": "entity.name.type.sgl" }
                    }
                },
                {
                    "match": "(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])(as)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])[ \\t]*((?:(?<![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}'])@[0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*[ \\t]+)*)(?!(?:fun|let|mut|struct|enum|binding|sampler|const|use|module|type|notation|if|else|for|while|loop|return|yield|continue|break|case|assert|print|and|or|not|as|in)(?![0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']))([A-Za-z_\\\\\\x{80}-\\x{10FFFF}][0-9A-Za-z_@#\\\\\\x{80}-\\x{10FFFF}']*)",
                    "captures": {
                        "1": { "name": "keyword.operator.wordlike.sgl" },
                        "2": {
                            "patterns": [
                                { "include": "#attribute-name" }
                            ]
                        },
                        "3": { "name": "entity.name.type.sgl" }
                    }
                },
                {

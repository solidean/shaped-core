{
    "comments": {
        "lineComment": "//"
    },
    "brackets": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "{", "close": "}" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "`", "close": "`", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"],
        ["\"", "\""],
        ["`", "`"]
    ],
    "wordPattern": "[^\\s.;:,()\\[\\]{}\"`!+*/%=<>?&^|~]+",
    "onEnterRules": [
        {
            "beforeText": "^(?!\\s*//).*(?::|\")\\s*$",
            "action": { "indent": "indent" }
        }
    ]
}

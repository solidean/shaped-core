{
    "name": "sgl",
    "displayName": "Shaped Graphics Language",
    "description": "Shaped Graphics Language (.sgl): syntax highlighting, and a client for the `sgl lsp` language server.",
    "version": "0.1.0",
    "publisher": "shapedcode",
    "private": true,
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onLanguage:sgl"
    ],
    "contributes": {
        "languages": [
            {
                "id": "sgl",
                "aliases": [
                    "Shaped Graphics Language",
                    "SGL",
                    "sgl"
                ],
                "extensions": [
                    ".sgl"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "sgl",
                "scopeName": "source.sgl",
                "path": "./syntaxes/sgl.tmLanguage.json"
            }
        ],
        "configurationDefaults": {
            "[sgl]": {
                "editor.insertSpaces": true,
                "editor.tabSize": 4,
                "editor.detectIndentation": false
            },
            "editor.semanticTokenColorCustomizations": {
                "rules": {
                    "*.mutable:sgl": {
                        "underline": true
                    }
                }
            }
        },
        "commands": [
            {
                "command": "sgl.restartServer",
                "title": "Restart Language Server",
                "category": "SGL"
            }
        ],
        "configuration": {
            "title": "SGL",
            "properties": {
                "sgl.server.path": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "The `sgl` binary to run as the language server. Empty takes the default preset's build, else the newest native one a workspace build's `nexus-binaries.json` names."
                },
                "sgl.server.logLevel": {
                    "type": "string",
                    "enum": [
                        "trace",
                        "debug",
                        "info",
                        "warning",
                        "error"
                    ],
                    "default": "info",
                    "description": "How much the language server logs to the \"SGL Language Server\" output channel."
                },
                "sgl.moduleDirs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Directories whose `.sgl` files are modules a file may `use`, relative to the workspace folder or absolute. A shader package's `SOURCE_DIR` and `MODULE_DIRS` are what its build reads."
                }
            }
        },
        "semanticTokenModifiers": [
            {
                "id": "mutable",
                "description": "A binding that can change: a `let mut` local."
            }
        ],
        "semanticTokenTypes": [
            {
                "id": "controlBuiltin",
                "superType": "function",
                "description": "A call of a builtin that constrains control flow: a derivative, a barrier, an atomic."
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "sgl",
                "scopes": {
                    "controlBuiltin": [
                        "keyword.control.sgl"
                    ]
                }
            }
        ]
    },
    "scripts": {
        "bundle": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --minify --outfile=dist/extension.js"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "vscode-languageclient": "^9.0.1"
    }
}

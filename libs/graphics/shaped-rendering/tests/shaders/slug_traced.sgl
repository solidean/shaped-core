// Inline traces against sr::build_slug_blas' quads, one ray per pixel of a grid, read back by slug-traced-test.cc.
// The quads lie at z = 0 in pixel space; each ray runs along +z through its pixel's centre.
require ray_query
use slug

binding probe:
    world: acceleration_structure[.triangles]
    width: int
    hits: mut buffer[float4]

fun pixel_ray(id: int3) -> ray => ray(
    origin = pos3((id.x as float) + 0.5, (id.y as float) + 0.5, -1.0)
    direction = vec3(0.0, 0.0, 1.0)
)

// The shapes as geometry: whether the ray met one, and which quad, with the em point the decision tested
@compute(8, 8) fun trace_shapes(@thread_id id: int3){slug.tables, slug.shapes, probe}:
    let h = probe.world.trace(pixel_ray(id), c => slug.decide(c))
    let mut is_hit = 0.0
    if h.is_hit => is_hit = 1.0
    probe.hits[id.x + id.y * probe.width] = float4(is_hit, h.primitive_index as float, h.t, 0.0)

// The shapes as a decal: every quad met whole, and covered at the hit with the footprint one pixel spans in em space
@compute(8, 8) fun cover_hits(@thread_id id: int3){slug.tables, slug.shapes, probe}:
    let h = probe.world.trace(pixel_ray(id), flags = ray_flags.force_opaque)
    let mut value = float4(0.0, 0.0, 0.0, 0.0)
    if h.is_hit:
        let shape = slug.shapes.instances[h.instance_id + h.primitive_index / 2]
        let em = slug.quad_em(shape, h.primitive_index, h.barycentrics)
        let x_axis = float2(shape.em_to_object.x, shape.em_to_object.y)
        let y_axis = float2(shape.em_to_object.z, shape.em_to_object.w)
        let em_per_pixel = float2(1.0 / length(x_axis), 1.0 / length(y_axis))
        let coverage = slug.coverage(em, em_per_pixel, shape.banding, slug.glyph_of(shape.glyph), false)
        value = float4(coverage, em.x, em.y, 1.0)
    probe.hits[id.x + id.y * probe.width] = value

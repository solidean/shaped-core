// One pass of edge-avoiding à-trous wavelet denoising (Dammertz et al. 2010).
// Paired with sr::atrous_denoise_routine, which dispatches this once per pass with the tap spacing doubling each time.
//
// Every pass is a 5x5 B3-spline kernel whose taps sit `step` pixels apart, each weighted down by how much its normal, depth and luminance disagree with the center's.
// A tap across an edge in any of the three counts for nothing, which keeps edges sharp while flat regions average wide.
//
// The luminance edge-stop is relative to the noise the input is expected to carry.
// `luminance_scale` is the caller's sigma times 1/sqrt(sample count).
// So a one-sample frame is smoothed hard and a deep mean is averaged only across differences a few of its own, much smaller, noise widths wide.
// With `has_sample_counts` the count is per pixel instead, and the 1/sqrt is taken here at the center pixel.
//
// Guides are optional.
// A missing one is bound to the color texture as a stand-in with its flag clear, so every slot of the binding is filled and the shader never reads what the flag says is not there.

require extended_image_formats

// the format of the image a pass writes: the routine's scratch between passes, the caller's output on the last
@option const target_format: pixel_format = .rgba32_float

const has_albedo = 1u
const has_normal = 2u
const has_depth = 4u
// this pass reads raw color and divides the albedo out
const demodulate_in = 8u
// this pass multiplies the albedo back in before writing
const remodulate_out = 16u
const has_specular_albedo = 32u
// `sample_counts` holds each pixel's sample count in red
const has_sample_counts = 64u
// this pass's source alpha is the mean of each sample's luminance squared, which the variance of the mean is measured from
const moment_in = 128u
// this pass's source alpha is the variance the pass before it carried forward
const variance_in = 256u
// this pass writes `input`'s alpha rather than its source's
const keeps_input_alpha = 512u

// Below this many samples a pixel's measured moment says too little, and its variance is the one-noise-width-per-sample model instead.
const measured_from = 4.0

// A pixel's window is its 3x3-blurred variance, each of the nine capped at this many times their median.
// One firefly's variance would otherwise widen every neighbor's window until they take it in, which is how one sample spreads.
// A cap at the pixel's own variance would close the window of a pixel whose few samples all came out black, which then stays black.
const blur_ceiling = 4.0

// A zero albedo would make demodulation divide by zero, and clamping both directions by the same floor keeps the round trip exact.
const albedo_floor = 0.001

@inline binding atrous_constants:
    // tap spacing in pixels: 1, 2, 4, ...
    step: int
    // the bits above
    flags: uint
    // the luminance edge-stop's width, relative to the pixel's own luminance
    luminance_scale: float
    // exponent on dot(n_p, n_q)
    normal_power: float
    // allowed depth difference, as a fraction of the center's depth per pixel of tap distance
    depth_sigma: float
    // the largest magnitude `target_format` holds, which a brighter result saturates at rather than becoming infinity
    ceiling: float
    // the luminance edge-stop's width in measured noise widths, where the variance is measured
    luminance_sigma: float
    // how many samples every pixel averages, where `has_sample_counts` is clear
    sample_count: float

binding atrous_images:
    @unfilterable
    source: texture_2d[float4]
    @unfilterable
    albedo: texture_2d[float4]
    @unfilterable
    specular_albedo: texture_2d[float4]
    @unfilterable
    normal: texture_2d[float4]
    @unfilterable
    depth: texture_2d[float4]
    @unfilterable
    sample_counts: texture_2d[float4]
    // the call's own color, read only by the pass that `keeps_input_alpha`
    @unfilterable
    input: texture_2d[float4]
    target: out image_2d[target_format]

fun is_set(flag: uint){atrous_constants} => (atrous_constants.flags & flag) != 0u

fun luminance(c: float3) => dot(c, float3(0.2126, 0.7152, 0.0722))

// Below this reflectance in every channel a surface reflects nothing worth demodulating: what it shows is its own emission.
// It sits above a dielectric's 0.04 at normal incidence, since a black base under the default specular layer is such a surface, a lamp's included.
const reflects_nothing_below = 0.06

// The surface's total reflectance: this filters unsplit radiance, so a metal's color is in the specular half.
fun total_reflectance_at(p: int2){atrous_images, atrous_constants} -> float3:
    let mut a = atrous_images.albedo.load(p).xyz
    if is_set(has_specular_albedo):
        a += atrous_images.specular_albedo.load(p).xyz
    return a

// Whether `p` shows a surface that reflects nothing, an emitter's own radiance, which is filtered as it is and apart from every reflecting surface.
// Demodulated, a lamp of zero albedo is its radiance over the floor, a thousand times brighter than any wall beside it.
fun reflects_nothing_at(p: int2){atrous_images, atrous_constants} -> bool:
    if not is_set(has_albedo) => return false
    return all(total_reflectance_at(p) < float3(reflects_nothing_below))

// What color is demodulated by: the total reflectance, or 1 where the surface reflects nothing.
fun albedo_at(p: int2){atrous_images, atrous_constants} -> float3:
    if reflects_nothing_at(p) => return float3(1.0)
    return max(total_reflectance_at(p), float3(albedo_floor))

// The source's color at `p`, in the space this pass filters in: divided by the albedo on the first pass when asked.
// A channel that is not a finite number reads as black: a half-float target holds nothing past 65504, so a bright enough
// sample arrives as infinity, and taken in by any tap it would turn the whole footprint into NaN.
fun source_at(p: int2){atrous_images, atrous_constants} -> float4:
    let raw = atrous_images.source.load(p)
    let c = if any(is_nan(raw.xyz)) or any(is_inf(raw.xyz)) => float4(0.0, 0.0, 0.0, raw.w) else raw
    if is_set(demodulate_in):
        return float4(..(c.xyz / albedo_at(p)), c.w)
    return c

fun is_measured(){atrous_constants} => is_set(moment_in) or is_set(variance_in)

// How many samples the mean at `q` averages.
fun samples_at(q: int2){atrous_images, atrous_constants} -> float:
    if is_set(has_sample_counts) => return max(atrous_images.sample_counts.load(q).x, 1.0)
    return max(atrous_constants.sample_count, 1.0)

// The variance of the mean at `q`, in the space this pass filters in, demodulated where it is.
// From the moment where the mean holds enough samples to measure it, and from the model a young pixel keeps otherwise:
// one noise width per sample, as wide as the pixel's luminance.
fun variance_at(q: int2){atrous_images, atrous_constants} -> float:
    let raw = atrous_images.source.load(q)
    if not (pt_is_finite(raw)) => return 0.0
    if is_set(variance_in) => return max(raw.w, 0.0)
    let n = samples_at(q)
    let l = luminance(raw.xyz)
    let mut v = if n >= measured_from => max(raw.w - l * l, 0.0) / n else (abs(l) + 0.01) * (abs(l) + 0.01) / n
    if is_set(demodulate_in):
        let a = luminance(albedo_at(q))
        v /= a * a
    return v

fun pt_is_finite(c: float4) => not (any(is_nan(c)) or any(is_inf(c)))

@compute(8, 8) fun main_cs(@thread_id id: int3){atrous_images, atrous_constants}:
    let size = atrous_images.target.size()
    if id.x >= size.x or id.y >= size.y => return

    let p = id.xy
    let center = source_at(p)
    let center_lum = luminance(center.xyz)

    // A zero normal is a pixel with no surface (a missed ray): it averages only with other such pixels, as depth does.
    let mut center_normal = float3(0.0)
    let mut center_has_normal = false
    if is_set(has_normal):
        let n = atrous_images.normal.load(p).xyz
        center_has_normal = dot(n, n) > 0.0
        center_normal = if center_has_normal => normalize(n) else n

    let mut center_depth = 0.0
    if is_set(has_depth):
        center_depth = atrous_images.depth.load(p).x

    // Relative to the center, so the edge-stop means the same thing for a dim corner and a bright highlight.
    // The additive floor keeps a black pixel from refusing every neighbor.
    // A window sized by the brighter of the two would weigh a pair alike from either end, but it can never refuse a tap
    // brighter than the center: a one-sample frame's brightest sample spread over half the image, issue: bug-sr-atrous-flattens-young-contrast.
    let mut luminance_scale = atrous_constants.luminance_scale
    if is_set(has_sample_counts):
        luminance_scale /= sqrt(max(atrous_images.sample_counts.load(p).x, 1.0))
    let mut lum_width = luminance_scale * (abs(center_lum) + 0.01) + 0.000001
    let mut center_variance = 0.0
    let mut tap_cap = 0.0

    // Measured: the window is the luminance stop's sigma in the mean's own noise widths, as SVGF steers it.
    // Blurred over 3x3, so one pixel whose samples happened to agree is still filtered, each tap capped against the median.
    if is_measured():
        let mut taps = float[9].filled(0.0)
        for k in 0 ..< 9:
            let q = clamp(p + int2(k % 3 - 1, k / 3 - 1), int2(0), size - int2(1))
            taps[k] = variance_at(q)
        // The median of the nine, by an insertion sort of a copy.
        let mut sorted = taps
        for i in 1 ..< 9:
            let mut j = i
            while j > 0 and sorted[j - 1] > sorted[j]:
                let swap = sorted[j]
                sorted[j] = sorted[j - 1]
                sorted[j - 1] = swap
                j -= 1
        let cap = blur_ceiling * sorted[4]
        tap_cap = cap
        let mut blurred = 0.0
        let mut blur_weight = 0.0
        for k in 0 ..< 9:
            let w = (if k % 3 == 1 => 0.5 else 0.25) * (if k / 3 == 1 => 0.5 else 0.25)
            blurred += min(taps[k], cap) * w
            blur_weight += w
        center_variance = blurred / blur_weight
        lum_width = atrous_constants.luminance_sigma * sqrt(center_variance) + 0.000001
    let center_emits = reflects_nothing_at(p)

    let kernel = [1.0 / 16.0, 1.0 / 4.0, 3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0]

    let mut sum = float3(0.0)
    let mut weight_sum = 0.0
    let mut variance_sum = 0.0
    // a loop: its 25 copies made it 2% slower on vulkan's Arc driver, and no faster anywhere else (2026-11-06)
    for dy in -2 ..< 3:
        for dx in -2 ..< 3:
            let offset = int2(dx, dy) * atrous_constants.step
            let q = p + offset
            if any(q < int2(0)) or any(q >= size) => continue

            let c = source_at(q)
            let mut w = kernel[dx + 2] * kernel[dy + 2]
            let tap_variance = if is_measured() => variance_at(q) else 0.0
            // Measured, the window is the pair's, both pixels' noise: sized by the center alone, a dark pixel's narrow window refuses
            // its bright neighbors while a bright one's takes its dark neighbors in, so energy would only ever move down.
            // The tap's variance is capped as the blur's taps are, so a firefly still widens nothing.
            let pair_width = if is_measured() => atrous_constants.luminance_sigma * sqrt(0.5 * (center_variance + min(tap_variance, tap_cap))) + 0.000001 else lum_width

            // Modeled, Gaussian in the difference: a tap several modeled widths away must count for nothing, or a converged
            // mean's detail is averaged away by the long tail of many such taps.
            // Measured, exponential as SVGF's: path-tracing noise is heavy-tailed, and the width itself shrinks to nothing as the mean converges.
            let lum_ratio = (luminance(c.xyz) - center_lum) / pair_width
            w *= if is_measured() => exp(-abs(lum_ratio)) else exp(-lum_ratio * lum_ratio)

            // An emitter and a surface it lights never average into each other, as the sky and geometry do not.
            if reflects_nothing_at(q) != center_emits:
                w = 0.0

            if is_set(has_normal):
                let n = atrous_images.normal.load(q).xyz
                let tap_has_normal = dot(n, n) > 0.0
                if center_has_normal != tap_has_normal:
                    w = 0.0
                else if center_has_normal:
                    w *= pow(saturate(dot(center_normal, normalize(n))), atrous_constants.normal_power)

            if is_set(has_depth):
                let d = atrous_images.depth.load(q).x
                let center_missed = center_depth <= 0.0
                let tap_missed = d <= 0.0
                if center_missed != tap_missed:
                    // the sky and a surface never average into each other
                    w = 0.0
                else if not center_missed:
                    let distance = length(float2(offset.x as float, offset.y as float))
                    let allowed = atrous_constants.depth_sigma * center_depth * distance + 0.00001
                    w *= exp(-abs(d - center_depth) / allowed)

            sum += c.xyz * w
            weight_sum += w
            if is_measured():
                variance_sum += tap_variance * w * w

    // The center always passes its own edge-stops, so it contributes at least kernel[2]^2 and weight_sum is never zero.
    let mut result = sum / weight_sum

    if is_set(remodulate_out):
        result *= albedo_at(p)

    // The variance of this pass's average is what the next, at twice the spacing, filters by.
    let mut out_alpha = center.w
    if is_measured():
        out_alpha = variance_sum / (weight_sum * weight_sum)
    if is_set(keeps_input_alpha):
        out_alpha = atrous_images.input.load(p).w

    let c = atrous_constants.ceiling
    atrous_images.target[id.xy] = float4(..clamp(result, float3(-c), float3(c)), out_alpha) as texel[target_format]

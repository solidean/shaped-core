// `destination = mix(destination, source, weight)`, per pixel.
// Paired with sr::mix_routine, which compiles one variant per destination format.
//
// The destination is read AND written, which is what lets one extra image carry a crossfade rather than two: a per-pixel read-modify-write of an image needs no copy and no second target to land in.
// Alpha crosses with the color, so fading between two images of the same thing leaves the alpha alone.

require readwrite_image_formats
require extended_image_formats

// the destination's format, which the routine sets to the image it is handed: a float or normalized one
@option const destination_format: pixel_format = .rgba16_float

@inline binding mix_constants:
    // 0 keeps the destination, 1 replaces it with the source
    weight: float
    // the largest magnitude the destination's format holds, which the source saturates at rather than becoming infinity
    ceiling: float

binding mix_images:
    @unfilterable
    source: texture_2d[float4]
    destination: mut image_2d[destination_format]

@compute(8, 8) fun main_cs(@thread_id id: int3){mix_images, mix_constants}:
    let size = mix_images.destination.size()
    if id.x >= size.x or id.y >= size.y => return

    // A half float holds nothing past 65504, and a bright sample converted to one becomes infinity, which a denoiser reading it turns into NaN.
    let c = mix_constants.ceiling
    let source = clamp(mix_images.source.load(id.xy), float4(-c), float4(c))
    let blended = mix(mix_images.destination[id.xy], source as texel[destination_format], mix_constants.weight)
    mix_images.destination[id.xy] = blended

// Slug: the coverage of a shape bounded by quadratic Bézier curves, evaluated at one sample, from its outline alone.
//
// Eric Lengyel's algorithm, after the reference shaders at github.com/EricLengyel/Slug (MIT OR Apache-2.0).
// A shape is drawn from two textures: `curves` holds control points, two texels per curve, and `bands` splits the shape
// into horizontal and vertical strips, each listing only the curves that cross it, sorted so a loop can stop early.
// sr's glyph compilation writes both, and an `sr::slug_atlas` holds them.
//
// A module, so any shader can cover a shape: sr::slug_routine's quads `use slug`, and so can a mesh's pixel shader that
// carries an em coordinate like a UV, drawing the shape as part of its surface.
// The host binds `slug.tables` from the atlas as one group, `sgl_modules::slug::tables`, shared by every pipeline.
//
// `glyph` is the reference's packed per-shape data:
//     x, y   where the shape's band header starts in `bands`
//     z      the last vertical band's index
//     w      the last horizontal band's index in its low byte, and the flags above it: 0x1000 is the even-odd rule
module slug

binding tables:
    curves: texture_2d[float4]
    bands: texture_2d[uint4]

/// Which of a curve's two roots contribute, from the signs of its three control points' heights above the ray.
/// Bit 0 is the first root and bit 8 the second.
fun root_code(y1: float, y2: float, y3: float) -> uint:
    let i1 = y1.bits >> 31
    let i2 = y2.bits >> 30
    let i3 = y3.bits >> 29
    let shift = (i3 & 4) | (((i2 & 2) | (i1 & 0xffff'fffd)) & 0xffff'fffb)
    return (0x2e74 >> shift) & 0x0101

/// Where a sample-relative curve crosses y = 0, as the two x coordinates of its roots.
/// Imaginary roots meet as a double root at the parabola's extremum, and a near-linear curve is solved as a line.
fun solve_horizontal(p12: float4, p3: float2) -> float2:
    let ax = p12.x - p12.z * 2.0 + p3.x
    let ay = p12.y - p12.w * 2.0 + p3.y
    let bx = p12.x - p12.z
    let by = p12.y - p12.w
    let mut t1 = 0.0
    let mut t2 = 0.0
    if abs(ay) < 1.0 / 65536.0:
        t1 = p12.y * (0.5 / by)
        t2 = t1
    else:
        let ra = 1.0 / ay
        let d = sqrt(max(by * by - ay * p12.y, 0.0))
        t1 = (by - d) * ra
        t2 = (by + d) * ra
    return float2((ax * t1 - bx * 2.0) * t1 + p12.x, (ax * t2 - bx * 2.0) * t2 + p12.x)

/// Where a sample-relative curve crosses x = 0, as the two y coordinates of its roots.
fun solve_vertical(p12: float4, p3: float2) -> float2:
    let ax = p12.x - p12.z * 2.0 + p3.x
    let ay = p12.y - p12.w * 2.0 + p3.y
    let bx = p12.x - p12.z
    let by = p12.y - p12.w
    let mut t1 = 0.0
    let mut t2 = 0.0
    if abs(ax) < 1.0 / 65536.0:
        t1 = p12.x * (0.5 / bx)
        t2 = t1
    else:
        let ra = 1.0 / ax
        let d = sqrt(max(bx * bx - ax * p12.x, 0.0))
        t1 = (bx - d) * ra
        t2 = (bx + d) * ra
    return float2((ay * t1 - by * 2.0) * t1 + p12.y, (ay * t2 - by * 2.0) * t2 + p12.y)

/// Where a band's curve list starts: an offset past the shape's header, wrapping onto the next row of a 4096-wide texture.
fun band_location(glyph_location: int2, offset: uint) -> int2:
    let x = glyph_location.x + (offset as int)
    return int2(x & 4095, glyph_location.y + (x >> 12))

/// The two rays' coverages, weighted by how close each came to a curve, under the shape's fill rule.
/// `weight_boost` takes the square root, which makes thin shapes optically heavier.
fun combine(xcov: float, ycov: float, xwgt: float, ywgt: float, even_odd: bool, weight_boost: bool) -> float:
    let raw = max(abs(xcov * xwgt + ycov * ywgt) / max(xwgt + ywgt, 1.0 / 65536.0), min(abs(xcov), abs(ycov)))
    let filled = case even_odd:
        true => 1.0 - abs(1.0 - fract(raw * 0.5) * 2.0)
        false => saturate(raw)
    return case weight_boost:
        true => sqrt(filled)
        false => filled

/// The coverage of the shape `glyph` names, at `em`, 0 outside it and 1 inside.
/// `em` is in the shape's stored space, the space of `sr::slug_shape_ref::em_bounds`, not outline units.
/// `glyph` is `sr::slug_shape_ref::glyph()`.
/// `em_per_pixel` is how much em space one pixel spans along each axis: what a raster caller takes from derivatives and a
/// traced one from its ray's footprint.
/// `banding` is the shape's band scale in xy and band offset in zw.
fun coverage(em: float2, em_per_pixel: float2, banding: float4, glyph: int4, weight_boost: bool){tables} -> float:
    let pixels_per_em = float2(1.0 / em_per_pixel.x, 1.0 / em_per_pixel.y)
    let band_max = int2(glyph.z, glyph.w & 0xff)
    let unclamped = int2((em.x * banding.x + banding.z) as int, (em.y * banding.y + banding.w) as int)
    let band_index = clamp(unclamped, int2(0, 0), band_max)
    let glyph_location = int2(glyph.x, glyph.y)
    let origin = float4(em.x, em.y, em.x, em.y)

    // The horizontal ray: curves sorted by descending maximum x, so the first wholly left of the sample ends the band.
    let mut xcov = 0.0
    let mut xwgt = 0.0
    let hband = tables.bands.load(int2(glyph_location.x + band_index.y, glyph_location.y))
    let hband_location = band_location(glyph_location, hband.y)
    for i in 0 ..< (hband.x as int):
        let entry = tables.bands.load(int2(hband_location.x + i, hband_location.y))
        let curve_location = int2(entry.x as int, entry.y as int)
        let p12 = tables.curves.load(curve_location) - origin
        let next = tables.curves.load(int2(curve_location.x + 1, curve_location.y))
        let p3 = float2(next.x - em.x, next.y - em.y)
        if max(max(p12.x, p12.z), p3.x) * pixels_per_em.x < -0.5 => break
        let code = root_code(p12.y, p12.w, p3.y)
        if code != 0:
            let r = solve_horizontal(p12, p3) * pixels_per_em.x
            if (code & 1) != 0:
                xcov += saturate(r.x + 0.5)
                xwgt = max(xwgt, saturate(1.0 - abs(r.x) * 2.0))
            if code > 1:
                xcov -= saturate(r.y + 0.5)
                xwgt = max(xwgt, saturate(1.0 - abs(r.y) * 2.0))

    // The vertical ray: its bands follow the horizontal ones in the header.
    let mut ycov = 0.0
    let mut ywgt = 0.0
    let vband = tables.bands.load(int2(glyph_location.x + band_max.y + 1 + band_index.x, glyph_location.y))
    let vband_location = band_location(glyph_location, vband.y)
    for i in 0 ..< (vband.x as int):
        let entry = tables.bands.load(int2(vband_location.x + i, vband_location.y))
        let curve_location = int2(entry.x as int, entry.y as int)
        let p12 = tables.curves.load(curve_location) - origin
        let next = tables.curves.load(int2(curve_location.x + 1, curve_location.y))
        let p3 = float2(next.x - em.x, next.y - em.y)
        if max(max(p12.y, p12.w), p3.y) * pixels_per_em.y < -0.5 => break
        let code = root_code(p12.x, p12.z, p3.x)
        if code != 0:
            let r = solve_vertical(p12, p3) * pixels_per_em.y
            if (code & 1) != 0:
                ycov -= saturate(r.x + 0.5)
                ywgt = max(ywgt, saturate(1.0 - abs(r.x) * 2.0))
            if code > 1:
                ycov += saturate(r.y + 0.5)
                ywgt = max(ywgt, saturate(1.0 - abs(r.y) * 2.0))

    return combine(xcov, ycov, xwgt, ywgt, (glyph.w & 0x1000) != 0, weight_boost)

/// The raster form: one pixel's em span is the em coordinate's change across the pixel, which `ddx` and `ddy` give.
/// `em` is in stored space, as for the form above.
/// So it must be called in uniform control flow, as every derivative must.
fun coverage(em: float2, banding: float4, glyph: int4, weight_boost: bool){tables} -> float:
    let em_per_pixel = abs(ddx(em)) + abs(ddy(em))
    return coverage(em, em_per_pixel, banding, glyph, weight_boost)

// ---- tests: run when this file is compiled on its own, as sr's slug-module test does ----

// The root code reads the signs of a curve's three heights: bit 0 when the first root counts, bit 8 the second.
// Wholly above or wholly below the ray: neither root.
test root_code(1.0, 2.0, 3.0) == 0
test root_code(-1.0, -2.0, -3.0) == 0
// Crossing upward from below: the second root alone.
test root_code(-1.0, 0.0, 1.0) == 0x0100
// Crossing downward: the first alone.
test root_code(1.0, 0.0, -1.0) == 0x0001
// Dipping below and coming back: both.
test root_code(1.0, -1.0, 1.0) == 0x0101

// A line from (-1, -1) to (3, 1) as the quadratic {p1, p2, p2} crosses y = 0 at x = 1, twice over.
test:
    let r = solve_horizontal(float4(-1.0, -1.0, 3.0, 1.0), float2(3.0, 1.0))
    nearly_equal(r.x, 1.0, within = 0.0001) and nearly_equal(r.y, 1.0, within = 0.0001)

// The parabola from (-2, 1) to (2, 1) with its control point at (0, -3) crosses y = 0 at x = -sqrt(2) and x = sqrt(2).
test:
    let r = solve_horizontal(float4(-2.0, 1.0, 0.0, -3.0), float2(2.0, 1.0))
    nearly_equal(r.x, -1.41421, within = 0.0001) and nearly_equal(r.y, 1.41421, within = 0.0001)

// The same curve turned on its side, for the vertical ray.
test:
    let r = solve_vertical(float4(1.0, -2.0, -3.0, 0.0), float2(1.0, 2.0))
    nearly_equal(r.x, -1.41421, within = 0.0001) and nearly_equal(r.y, 1.41421, within = 0.0001)

// A band list past the row's end continues on the next row of the 4096-wide texture.
test:
    let a = band_location(int2(4000, 7), 50)
    let b = band_location(int2(4000, 7), 200)
    a.x == 4050 and a.y == 7 and b.x == 104 and b.y == 8

// Inside under the nonzero rule is 1 however many times the ray crossed; under even-odd, twice in is outside.
test combine(1.0, 1.0, 1.0, 1.0, false, false) == 1.0
test combine(2.0, 2.0, 1.0, 1.0, false, false) == 1.0
test combine(2.0, 2.0, 1.0, 1.0, true, false) == 0.0
test combine(0.25, 0.25, 1.0, 1.0, false, true) == 0.5

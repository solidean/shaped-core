// One mip of an unsigned-integer image set to a constant: FSR 3.1's clear job, for sr::fsr_upscale_routine.
//
// FSR clears these with a float, and AMD's own backend writes that float's BITS: its depth images hold `asuint(depth)`, so clearing to 1.0 has to store 0x3f800000 rather than 1.
// The routine hands over the bits of the first component, which an image of more channels stores in its first, the rest filled from (0, 0, 1).

require extended_image_formats

// the cleared image's format, which the routine sets to each one FSR clears
@option const target_format: pixel_format = .r32_uint

@inline binding fsr_clear_uint_constants:
    value: uint

binding fsr_clear_uint_target:
    target: out image_2d[target_format]

@compute(8, 8) fun main_cs(@thread_id id: int3){fsr_clear_uint_target, fsr_clear_uint_constants}:
    if any(id.xy >= fsr_clear_uint_target.target.size()) => return

    fsr_clear_uint_target.target[id.xy] = fsr_clear_uint_constants.value as texel[target_format]

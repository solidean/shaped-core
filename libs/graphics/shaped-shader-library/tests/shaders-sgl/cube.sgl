// The cube, as slib's tests compile it: one SGL source through every edge this build has.
// A copy of libs/graphics/shaped-graphics-language/tests/samples/cube.sgl, kept here so the package needs no path out of slib.

@inline binding constants:
    view_projection: mat4

@vertex struct cube_vertex:
    position: pos3
    normal: vec3
    color: float3

@pixel struct target:
    color: float4

struct pixel_input:
    @position position: hpos4
    normal: vec3
    color: float3

@vertex fun main_vs(v: cube_vertex){constants} -> pixel_input:
    return {
        position = constants.view_projection * v.position
        normal = v.normal
        color = v.color
    }

@pixel fun main_ps(p: pixel_input) -> target:
    let n = normalize p.normal
    let key = saturate dot(n, normalize vec3(0.45, 0.8, -0.4))
    let fill = saturate dot(n, normalize vec3(-0.7, 0.15, 0.6))

    let lit = p.color * (0.25 + 0.8 * key + 0.25 * fill)
    return {
        color = float4(..lit, 1.0)
    }

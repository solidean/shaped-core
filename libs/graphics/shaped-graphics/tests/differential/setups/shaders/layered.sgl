// The `targets` setup's vertex stage: two triangles from nothing but the vertex index, as diff_targets.sgl describes them.
use diff_targets

@vertex fun layered(@vertex_index v: int) -> diff_targets.varyings:
    let layer = v / 3
    let k = v % 3
    let mut uv = float2(((k << 1) & 2) as float, (k & 2) as float)
    let mut depth = 0.5
    if layer == 1:
        if k == 0 => uv = float2(0.05, 0.1)
        else if k == 1 => uv = float2(0.95, 0.2)
        else => uv = float2(0.3, 0.95)
        depth = 0.2 + 0.6 * uv.x
    return {
        position = hpos4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0)
        uv = uv
        layer = layer as float
    }

// differential: setup texels
// Sampling as a material or a post pass does: nearest and bilinear at a level, trilinear between two, and an address mode.
// Every coordinate sits a quarter texel off an edge, so no nearest sample is a tie a device may break either way.
use diff_texels

@compute(64) fun sample_levels(@thread_id id: int3){diff_texels.io}:
    let i = id.x
    let uv = float2((((i % 16) as float) + 0.25) / 16.0, (((i / 16) as float) + 0.75) / 16.0)
    diff_texels.io.output[4 * i] = diff_texels.io.source.sample(uv, diff_texels.io.nearest, level = 0.0)
    diff_texels.io.output[4 * i + 1] = diff_texels.io.source.sample(uv * 1.7 - float2(0.3, 0.3), diff_texels.io.linear, level = 0.0)
    diff_texels.io.output[4 * i + 2] = diff_texels.io.source.sample(uv, diff_texels.io.linear, level = 1.5)
    diff_texels.io.output[4 * i + 3] = diff_texels.io.source.sample(uv * 3.0 - float2(1.0, 1.0), diff_texels.io.nearest, level = 0.0)

// differential: setup floats
// differential: across exact
// EVAL-96 rounds a float converted to a half once, to nearest, ties to even, at every level, so a conversion agrees to the bit everywhere.
// AMD's dx12 and vulkan drivers convert a float to a half toward zero instead; issue: bug-sgl-half-conversion-rounds-toward-zero-on-amd
// Half-precision math as a bandwidth-bound or mobile shader writes it starts here: floats converted to halves, read and computed.
// The operations on halves are half_arithmetic.sgl's, since `.fast` lets them keep a float's precision.
require shader_f16
use diff_floats

@compute(64) fun halves(@thread_id id: int3){diff_floats.io}:
    let i = id.x
    let x = diff_floats.io.input[i]
    let y = diff_floats.io.input[(i + 29) & 255]
    diff_floats.io.output[4 * i] = (abs(x) as half) as float
    diff_floats.io.output[4 * i + 1] = ((x * 0.1) as half) as float
    diff_floats.io.output[4 * i + 2] = ((x / 3.0) as half) as float
    diff_floats.io.output[4 * i + 3] = ((y * 1.7) as half) as float

// differential: setup floats
// differential: across exact
// differential: known amd dx12 debt-sg-diff-gpu-comparisons-hold-a-conversion-to-one-rounding across
// differential: known amd vulkan debt-sg-diff-gpu-comparisons-hold-a-conversion-to-one-rounding across
// differential: known intel dx12 bug-sg-diff-half-corpus-fails-on-intel
// differential: known intel dx12 bug-sg-diff-half-corpus-fails-on-intel precise
// differential: known nvidia vulkan bug-sg-diff-half-math-unrounded-on-nvidia-vulkan
// EVAL-96 rounds a float converted to a half once, to nearest or toward zero as the target does, at every level: one of two halves.
// AMD converts toward zero, as D3D and Vulkan allow, and Intel's dx12 and NVIDIA's vulkan fold the round trip away, which neither allows.
// Half-precision math as a bandwidth-bound or mobile shader writes it starts here: floats converted to halves, read and computed.
// The operations on halves are half_arithmetic.sgl's, since `.fast` lets them keep a float's precision.
require shader_f16
use diff_floats

@compute(64) fun halves(@thread_id id: int3){diff_floats.io}:
    let i = id.x
    let x = diff_floats.io.input[i]
    let y = diff_floats.io.input[(i + 29) & 255]
    diff_floats.io.output[4 * i] = (abs(x) as half) as float
    diff_floats.io.output[4 * i + 1] = ((x * 0.1) as half) as float
    diff_floats.io.output[4 * i + 2] = ((x / 3.0) as half) as float
    diff_floats.io.output[4 * i + 3] = ((y * 1.7) as half) as float

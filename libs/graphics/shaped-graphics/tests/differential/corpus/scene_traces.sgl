// differential: setup scene
// Inline traces as a renderer writes them: primary rays, an alpha-tested surface, and rays from the side meeting faces of both windings, culled and not.
// Every ray is hashed from its thread with no transcendental in it, so every route and machine traces the same rays.
require ray_query
use diff_scene

fun hashed(x: uint) -> uint:
    let mut h = x ^ (x >> 16u)
    h = h * 0x7feb'352du
    h = h ^ (h >> 15u)
    h = h * 0x846c'a68bu
    return h ^ (h >> 16u)

/// Thread `i`'s `k`-th draw, in [0, 1).
fun unit(i: int, k: uint) -> float => ((hashed((i as uint) * 8u + k) >> 8u) as float) / 16777216.0

/// A hit as two float4; a miss is -1 throughout, since no route sets a missed hit's other fields.
fun store(slot: int, h: triangle_hit){diff_scene.io}:
    if not h.is_hit:
        diff_scene.io.hits[slot] = float4(-1.0, -1.0, -1.0, -1.0)
        diff_scene.io.ids[slot] = float4(-1.0, -1.0, -1.0, -1.0)
        return
    let mut front = 0.0
    if h.is_front_face => front = 1.0
    diff_scene.io.hits[slot] = float4(h.t, h.barycentrics.y, h.barycentrics.z, front)
    diff_scene.io.ids[slot] = float4(h.instance_id as float, h.primitive_index as float, h.geometry_index as float, h.instance_index as float)

/// Every third triangle of the non-opaque geometry is cut out, as an alpha test would.
fun alpha_tested(c: triangle_candidate) -> hit_decision:
    if c.primitive_index % 3 == 0 => return hit_decision.ignore
    return hit_decision.accept

/// Primary rays straight down over the whole world: forced opaque, then alpha tested.
@compute(64) fun downward(@thread_id id: int3){diff_scene.io}:
    let i = id.x
    let r = ray(origin = pos3(unit(i, 0u) * 8.0, unit(i, 1u) * 8.0, 5.0), direction = vec3(0.0, 0.0, -1.0))
    store(2 * i, diff_scene.io.world.trace(r, flags = ray_flags.force_opaque))
    store(2 * i + 1, diff_scene.io.world.trace(r, alpha_tested))

/// Rays from a square around the world toward its middle, low and slanted, their direction unnormalized so `t` is 1 at the target.
/// They meet octahedron faces of both windings, the mirrored instance's included, and some miss everything; then the same ray culls back faces.
@compute(64) fun from_the_side(@thread_id id: int3){diff_scene.io}:
    let i = id.x
    let along = unit(i, 0u) * 12.0 - 2.0
    let side = i % 4
    let mut x = along
    let mut y = -2.0
    if side == 1:
        x = 10.0
        y = along
    else if side == 2:
        y = 10.0
    else if side == 3:
        x = -2.0
        y = along
    let origin = pos3(x, y, 1.5 + 2.0 * unit(i, 1u))
    let target = pos3(1.0 + 6.0 * unit(i, 2u), 1.0 + 6.0 * unit(i, 3u), 1.0 + 2.0 * unit(i, 4u))
    let r = ray(origin = origin, direction = target - origin)
    store(2 * i, diff_scene.io.world.trace(r, flags = ray_flags.force_opaque))
    store(2 * i + 1, diff_scene.io.world.trace(r, flags = ray_flags.force_opaque | ray_flags.cull_back_facing))

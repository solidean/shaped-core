// differential: setup floats
// differential: across relative 0.001
// differential: known amd dx12 debt-sg-diff-gpu-comparisons-hold-a-conversion-to-one-rounding across
// differential: known amd vulkan debt-sg-diff-gpu-comparisons-hold-a-conversion-to-one-rounding across
// EVAL-96 rounds each operation of halves once, to nearest, ties to even; at `.fast` and `.specials` a GPU may keep a float's precision instead (CHK-435).
// Apple's compiler does under Metal's fast math, and Intel's does too; the interpreter's range for each result holds both answers.
// 0.001, about an ulp of a half, is the slack around that range, and what two GPUs that round differently are held to.
// `a * b - a` cancels where `b` is near 1, and there two such GPUs may differ by more, which only the interpreter's range allows for.
// A conversion's direction is half_math.sgl's to hold exactly.
require shader_f16
use diff_floats

@compute(64) fun half_operations(@thread_id id: int3){diff_floats.io}:
    let i = id.x
    let a = abs(diff_floats.io.input[i]) as half
    let b = abs(diff_floats.io.input[(i + 29) & 255]) as half
    diff_floats.io.output[4 * i] = (a * b) as float
    diff_floats.io.output[4 * i + 1] = (a + b) as float
    diff_floats.io.output[4 * i + 2] = (a - b) as float
    diff_floats.io.output[4 * i + 3] = (a * b - a) as float

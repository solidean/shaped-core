// differential: setup raster
// Screen-space derivatives of what is linear across the target, and of what bends, which a quad's coarse and fine differences tell apart.
use diff_raster

@pixel fun derivatives_ps(p: diff_raster.varyings) -> diff_raster.target:
    let bent = p.weight * p.weight
    return {color = float4(ddx(p.weight), ddy(p.uv.y), ddx(bent) + ddy(bent), fwidth(p.uv.x * 7.0))}

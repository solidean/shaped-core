// Pipelines whose code does less than their bindings allow, which is what the barrier tests count against.
// Most bindings here are writable, so without a footprint each op would order against every other one that binds them.

binding traffic:
    values: mut buffer[float]
    result: mut buffer[float]

// Loads `values` and stores `result`: a read and a write, though the binding lets it write both.
@compute(64) fun scale(@thread_id id: int3){traffic}:
    traffic.result[id.x] = traffic.values[id.x] * 2.0

// Writes `values`, which `scale` then reads.
@compute(64) fun fill(@thread_id id: int3){traffic}:
    traffic.values[id.x] = id.x as float

// A draw whose vertex stage reads a buffer, and whose group also holds a texture neither stage samples.
binding shift:
    offsets: buffer[float]
    unsampled: texture_2d[float4]

@vertex struct shift_corner:
    position: float3

struct shift_varyings:
    @position position: hpos4

@pixel struct shift_target:
    color: float4

@vertex fun shifted_vs(v: shift_corner){shift} -> shift_varyings:
    return { position = hpos4(v.position.x + shift.offsets[0], v.position.y, 0.0, 1.0) }

@pixel fun flat_ps(p: shift_varyings){shift} -> shift_target:
    return { color = float4(1.0, 0.0, 0.0, 1.0) }

pipeline shifted:
    vertex = shifted_vs
    pixel = flat_ps
    cull = .none
    format = .rgba8_unorm

// One draw's pixel shader writes a buffer and the next one's reads it, inside one rendering: the hazard a backend can
// only order by leaving the pass, except dx12, which has none to leave.
// Every pixel owns the element its own position maps to, so a read that raced ahead of the write finds a zero.
binding marks:
    hits: mut buffer[float]

@vertex fun marks_vs(v: shift_corner){marks} -> shift_varyings:
    return { position = hpos4(v.position.x, v.position.y, 0.0, 1.0) }

fun pixel_index(p: shift_varyings) -> int => (p.position.y as int) * 4 + (p.position.x as int)

@pixel fun mark_ps(p: shift_varyings){marks} -> shift_target:
    let i = pixel_index(p)
    marks.hits[i] = (i + 1) as float
    return { color = float4(0.0, 1.0, 0.0, 1.0) }

@pixel fun read_ps(p: shift_varyings){marks} -> shift_target:
    let v = marks.hits[pixel_index(p)] / 255.0
    return { color = float4(v, v, v, 1.0) }

pipeline marking:
    vertex = marks_vs
    pixel = mark_ps
    cull = .none
    format = .rgba8_unorm

pipeline reading:
    vertex = marks_vs
    pixel = read_ps
    cull = .none
    format = .rgba8_unorm

// Loads its element of `hits` and stores it back one higher: a draw that reads and writes what the one before it wrote.
@pixel fun accumulate_ps(p: shift_varyings){marks} -> shift_target:
    let i = pixel_index(p)
    marks.hits[i] = marks.hits[i] + 1.0
    return { color = float4(0.0, 1.0, 0.0, 1.0) }

pipeline accumulating:
    vertex = marks_vs
    pixel = accumulate_ps
    cull = .none
    format = .rgba8_unorm

// `hits` through a read-only binding, copied into `seen`: a draw that reads what the next one overwrites.
// A write that raced ahead of the read shows up in `seen`.
binding peek:
    hits: buffer[float]
    seen: mut buffer[float]

@vertex fun peek_vs(v: shift_corner){peek} -> shift_varyings:
    return { position = hpos4(v.position.x, v.position.y, 0.0, 1.0) }

@pixel fun peek_ps(p: shift_varyings){peek} -> shift_target:
    let i = pixel_index(p)
    peek.seen[i] = peek.hits[i]
    return { color = float4(0.0, 1.0, 0.0, 1.0) }

pipeline peeking:
    vertex = peek_vs
    pixel = peek_ps
    cull = .none
    format = .rgba8_unorm

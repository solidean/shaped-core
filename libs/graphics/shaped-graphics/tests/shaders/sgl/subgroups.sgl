// Subgroup and quad operations and the uniform load, as the GPU runs them: each holds whatever size the subgroup is.

require subgroups
require shader_f16

binding wave_io:
    values: buffer[uint]
    swapped: mut buffer[uint]
    sums: mut buffer[uint]

@workgroup binding wave_tally:
    partial: atomic[uint]
    total: uint

// Each subgroup sums its values and its first invocation adds that to the workgroup's, which every thread then loads.
@compute(64) @preferred_subgroup_size(32) fun reduce(@thread_id id: int3, @local_thread_index local: int, @subgroup_invocation_id lane: int){wave_io, wave_tally}:
    if local == 0 => wave_tally.partial.store(0u)
    workgroup_barrier()
    // a quad's horizontal neighbour is the invocation whose index differs in its lowest bit
    let own = lane as uint
    wave_io.swapped[id.x] = quad_swap_x(own) ^ own
    let sum = subgroup_add(wave_io.values[id.x])
    let leader = subgroup_broadcast_first(lane)
    if lane == leader => wave_tally.partial.add(sum)
    workgroup_barrier()
    if local == 0 => wave_tally.total = wave_tally.partial.load()
    let total = workgroup_uniform_load(wave_tally.total)
    // a branch on the loaded value is uniform, so a barrier may stand in it
    if total > 0u:
        workgroup_barrier()
    wave_io.sums[id.x] = total

// A subgroup sum over halves, which vulkan runs only where the device turns on its subgroup operations over 16-bit types.
// A workgroup of 128 holds every subgroup a device has whole, so each sum covers exactly the subgroup's size.
binding wave_halves:
    values: buffer[half2]
    sums: mut buffer[float4]

@compute(128) fun reduce_halves(@thread_id id: int3, @subgroup_size size: int){wave_halves}:
    let total = subgroup_add(wave_halves.values[id.x])
    wave_halves.sums[id.x] = float4(total.x as float, total.y as float, size as float, 0.0)

// Each invocation leaves the loop at an iteration of its own, and every one of them is back for the sum after it.
// A workgroup of 128 holds every subgroup a device has whole.
binding wave_staggered:
    sums: mut buffer[uint]
    sizes: mut buffer[uint]

@compute(128) fun reduce_after_loop(@thread_id id: int3, @subgroup_invocation_id lane: int, @subgroup_size size: int){wave_staggered}:
    let mut n = 0u
    for i in 0 ..< 128:
        if i == lane => break
        n += 1u
    wave_staggered.sums[id.x] = subgroup_add(n)
    wave_staggered.sizes[id.x] = size as uint

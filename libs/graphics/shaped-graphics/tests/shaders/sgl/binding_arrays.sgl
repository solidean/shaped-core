// A binding array is one binding the host fills with a view per element, indexed by a value each thread picks.

require binding_arrays

binding lanes:
    sources: buffer[int][3]
    merged: mut buffer[int]

@compute(64) fun gather(@thread_id id: int3){lanes}:
    lanes.merged[id.x] = lanes.sources[nonuniform (id.x % 3)][id.x]

// An element of a binding array of atomic buffers is updated as a buffer of its own is.
binding tallies:
    slots: mut buffer[atomic[uint]][2]

@compute(64) fun tally(@thread_id id: int3){tallies}:
    tallies.slots[nonuniform (id.x % 2)][0].add(1u)
    tallies.slots[nonuniform (id.x % 2)][1].min(uint(id.x))

// The same updates, each thread keeping the value before its own, which a driver workaround must hand each lane alike.
binding counted:
    slots: mut buffer[atomic[uint]][2]
    before: mut buffer[uint]

@compute(64) fun count_off(@thread_id id: int3){counted}:
    counted.before[id.x] = counted.slots[nonuniform (id.x % 2)][0].add(1u)
    counted.before[64 + id.x] = counted.slots[nonuniform (id.x % 2)][1].min(uint(id.x))

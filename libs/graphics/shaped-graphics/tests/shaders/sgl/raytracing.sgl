// Inline ray queries against a known scene, as every backend traces them: natively, or through webgpu's polyfill.
require ray_query

binding scene:
    world: acceleration_structure[.triangles]
    hits: mut buffer[float4]
    ids: mut buffer[int4]

// primitive 1 of every instance is cut out, which the any-hit decision alone knows
fun cutout(c: triangle_candidate) -> hit_decision:
    if c.primitive_index == 1 => return hit_decision.ignore
    return hit_decision.accept

// One ray per cell of an 8 × 8 grid, along +z from z = -1, a quarter cell off each cell's centre in x.
// So no ray passes through an edge two triangles share.
fun cell_ray(id: int3) -> ray => ray(
    origin = pos3((id.x as float) + 0.25, (id.y as float) + 0.5, -1.0)
    direction = vec3(0.0, 0.0, 1.0)
)

fun store(id: int3, h: triangle_hit){scene}:
    let at = id.x + id.y * 8
    let mut is_hit = 0
    if h.is_hit => is_hit = 1
    scene.hits[at] = float4(h.t, h.barycentrics.y, h.barycentrics.z, 0.0)
    scene.ids[at] = int4(is_hit, h.instance_id, h.primitive_index, h.instance_index)

@compute(8, 8) fun trace_cells(@thread_id id: int3){scene}:
    store(id, scene.world.trace(cell_ray(id), cutout))

// the same rays, deciding nothing: the cut-out triangle is hit as any other
@compute(8, 8) fun trace_cells_opaque(@thread_id id: int3){scene}:
    store(id, scene.world.trace(cell_ray(id), flags = ray_flags.force_opaque))

// ---- procedural geometry: a unit sphere in each box --------------------------------------------------------------
//
// Box k spans x from 2k to 2k + 2 and y and z from 0 to 2, and holds the sphere of radius 1 at its centre.

binding sphere_scene:
    world: acceleration_structure[.procedural]
    hits: mut buffer[float4]
    ids: mut buffer[int4]

struct sphere_attributes:
    normal: vec3

fun sphere_report(b: procedural_box) -> report[sphere_attributes]:
    let centre = float3(2.0 * (b.primitive_index as float) + 1.0, 1.0, 1.0)
    let o = float3(b.object_ray.origin.x, b.object_ray.origin.y, b.object_ray.origin.z)
    let d = float3(b.object_ray.direction.x, b.object_ray.direction.y, b.object_ray.direction.z)
    let oc = o - centre
    let a = dot(d, d)
    let half_b = dot(oc, d)
    let disc = half_b * half_b - a * (dot(oc, oc) - 1.0)
    if disc < 0.0 => return report.none()
    let t = (-half_b - sqrt(disc)) / a
    let p = o + d * t - centre
    return report(t = t, attributes = sphere_attributes(vec3(p.x, p.y, p.z)))

// the sphere of box 1 is cut out
fun cutout_sphere(c: procedural_candidate[sphere_attributes]) -> hit_decision:
    if c.primitive_index == 1 => return hit_decision.ignore
    return hit_decision.accept

// One ray per cell of an 8 × 8 grid over [0, 4]², along +z from z = -1.
fun sphere_ray(id: int3) -> ray => ray(
    origin = pos3(0.5 * (id.x as float) + 0.25, 0.5 * (id.y as float) + 0.25, -1.0)
    direction = vec3(0.0, 0.0, 1.0)
)

fun store_sphere(id: int3, h: procedural_hit[sphere_attributes]){sphere_scene}:
    let at = id.x + id.y * 8
    let mut is_hit = 0
    if h.is_hit => is_hit = 1
    let mut n = h.attributes.normal
    if not h.is_hit => n = vec3(0.0, 0.0, 0.0)
    sphere_scene.hits[at] = float4(h.t, n.x, n.y, n.z)
    sphere_scene.ids[at] = int4(is_hit, h.instance_id, h.primitive_index, h.instance_index)

@compute(8, 8) fun trace_spheres(@thread_id id: int3){sphere_scene}:
    store_sphere(id, sphere_scene.world.trace(sphere_ray(id), sphere_report, cutout_sphere))

// every sphere, deciding nothing
@compute(8, 8) fun trace_spheres_all(@thread_id id: int3){sphere_scene}:
    store_sphere(id, sphere_scene.world.trace(sphere_ray(id), b => sphere_report(b)))

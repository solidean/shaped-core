// Mesh stages that hand the rasterizer what they write (CHK-480): one full-screen triangle, and a target split between
// two workgroups, each covering its half and coloring it by its own index.

require mesh_shader

struct corner:
    @position position: hpos4
    color: float4

@pixel struct painted:
    color: float4

@mesh(1, vertices = 3, triangles = 1) fun covering(output: mut mesh_output[corner]):
    output.set_counts(3u, 1u)
    let green = float4(0.0, 1.0, 0.0, 1.0)
    output.vertex(0u, {position = hpos4(-1.0, -1.0, 0.0, 1.0), color = green})
    output.vertex(1u, {position = hpos4(3.0, -1.0, 0.0, 1.0), color = green})
    output.vertex(2u, {position = hpos4(-1.0, 3.0, 0.0, 1.0), color = green})
    output.triangle(0u, uint3(0u, 1u, 2u))

// Four invocations, each writing one corner of its workgroup's half; the first writes both triangles.
@mesh(4, vertices = 4, triangles = 2)
fun halves(@workgroup_id group: int3, @local_thread_index k: int, output: mut mesh_output[corner]):
    output.set_counts(4u, 2u)
    let left = if group.x == 0 => -1.0 else 0.0
    let x = if (k & 1) == (k >> 1) => left else left + 1.0
    let y = if k < 2 => -1.0 else 1.0
    output.vertex(k as uint, {position = hpos4(x, y, 0.0, 1.0), color = float4(group.x as float, 0.0, 1.0, 1.0)})
    if k == 0:
        output.triangle(0u, uint3(0u, 1u, 2u))
        output.triangle(1u, uint3(0u, 2u, 3u))

@pixel fun painting(c: corner) -> painted:
    return {color = c.color}

pipeline covered:
    mesh = covering
    pixel = painting
    cull = .none
    format = .rgba8_unorm

pipeline split:
    mesh = halves
    pixel = painting
    cull = .none
    format = .rgba8_unorm

// A task stage that launches two mesh workgroups and hands both one payload (CHK-484 to CHK-487).
struct halving:
    blue: float

@task(1) fun launching():
    let handed: halving = {blue = 1.0}
    dispatch_mesh(2u, 1u, 1u, handed)

@mesh(1, vertices = 4, triangles = 2)
fun launched_half(@workgroup_id group: int3, handed: halving, output: mut mesh_output[corner]):
    output.set_counts(4u, 2u)
    let left = if group.x == 0 => -1.0 else 0.0
    let color = float4(group.x as float, 0.0, handed.blue, 1.0)
    output.vertex(0u, {position = hpos4(left, -1.0, 0.0, 1.0), color = color})
    output.vertex(1u, {position = hpos4(left + 1.0, -1.0, 0.0, 1.0), color = color})
    output.vertex(2u, {position = hpos4(left + 1.0, 1.0, 0.0, 1.0), color = color})
    output.vertex(3u, {position = hpos4(left, 1.0, 0.0, 1.0), color = color})
    output.triangle(0u, uint3(0u, 1u, 2u))
    output.triangle(1u, uint3(0u, 2u, 3u))

pipeline launched:
    task = launching
    mesh = launched_half
    pixel = painting
    cull = .none
    format = .rgba8_unorm

// A quad of two triangles, each tinted by what the mesh stage wrote for it alone (CHK-488, CHK-489).
struct face:
    tint: float4

@mesh(1, vertices = 4, triangles = 2)
fun faces(output: mut mesh_output[corner, face]):
    output.set_counts(4u, 2u)
    let black = float4(0.0, 0.0, 0.0, 1.0)
    output.vertex(0u, {position = hpos4(-1.0, -1.0, 0.0, 1.0), color = black})
    output.vertex(1u, {position = hpos4(1.0, -1.0, 0.0, 1.0), color = black})
    output.vertex(2u, {position = hpos4(1.0, 1.0, 0.0, 1.0), color = black})
    output.vertex(3u, {position = hpos4(-1.0, 1.0, 0.0, 1.0), color = black})
    output.triangle(0u, uint3(0u, 1u, 2u))
    output.triangle(1u, uint3(0u, 2u, 3u))
    output.primitive(0u, {tint = float4(1.0, 0.0, 0.0, 0.0)})
    output.primitive(1u, {tint = float4(0.0, 0.0, 1.0, 0.0)})

@pixel fun tinting(c: corner, f: face) -> painted:
    return {color = c.color + f.tint}

pipeline tinted:
    mesh = faces
    pixel = tinting
    cull = .none
    format = .rgba8_unorm

// Two lines through the centres of row 3 and column 5 of an 8 × 8 target, red and green (CHK-480's `lines`).
@mesh(1, vertices = 4, lines = 2)
fun crossing(output: mut mesh_output[corner]):
    output.set_counts(4u, 2u)
    let red = float4(1.0, 0.0, 0.0, 1.0)
    let green = float4(0.0, 1.0, 0.0, 1.0)
    output.vertex(0u, {position = hpos4(-1.0, 0.125, 0.0, 1.0), color = red})
    output.vertex(1u, {position = hpos4(1.0, 0.125, 0.0, 1.0), color = red})
    output.vertex(2u, {position = hpos4(0.375, -1.0, 0.0, 1.0), color = green})
    output.vertex(3u, {position = hpos4(0.375, 1.0, 0.0, 1.0), color = green})
    output.line(0u, uint2(0u, 1u))
    output.line(1u, uint2(2u, 3u))

pipeline crossed:
    mesh = crossing
    pixel = painting
    cull = .none
    format = .rgba8_unorm

// Two workgroups of two full-screen triangles each, in a mesh stage of three slots: the last triangle drawn is the
// one seen, by workgroup and then by index, and the third slot, past the count, draws nothing.
@mesh(1, vertices = 6, triangles = 3)
fun layering(@workgroup_id group: int3, output: mut mesh_output[corner]):
    output.set_counts(6u, 2u)
    let first = if group.x == 0 => float4(1.0, 0.0, 0.0, 1.0) else float4(0.0, 0.0, 1.0, 1.0)
    let second = if group.x == 0 => float4(0.0, 1.0, 0.0, 1.0) else float4(1.0, 1.0, 1.0, 1.0)
    output.vertex(0u, {position = hpos4(-1.0, -1.0, 0.0, 1.0), color = first})
    output.vertex(1u, {position = hpos4(3.0, -1.0, 0.0, 1.0), color = first})
    output.vertex(2u, {position = hpos4(-1.0, 3.0, 0.0, 1.0), color = first})
    output.vertex(3u, {position = hpos4(-1.0, -1.0, 0.0, 1.0), color = second})
    output.vertex(4u, {position = hpos4(3.0, -1.0, 0.0, 1.0), color = second})
    output.vertex(5u, {position = hpos4(-1.0, 3.0, 0.0, 1.0), color = second})
    output.triangle(0u, uint3(0u, 1u, 2u))
    output.triangle(1u, uint3(3u, 4u, 5u))

pipeline layered:
    mesh = layering
    pixel = painting
    cull = .none
    format = .rgba8_unorm

// A buffer differentiable by its @gradient and @tangent, as the GPU runs it: every invocation's `bwd_diff` adds into one
// gradient buffer through its float atomic, and `fwd_diff` reads each weight's change from the tangent buffer.

binding params:
    @gradient(training.gradients) @tangent(training.tangents) weights: buffer[float]

binding training:
    gradients: mut buffer[atomic[float]]
    tangents: buffer[float]
    forward: mut buffer[float]

// (w_k x - 1)^2 for one weight k
fun loss(k: int, x: float){params} -> float:
    let d = params.weights[k] * x - 1.0
    return d * d

@compute(64) fun loss_backward(@thread_id id: int3){params, training}:
    let mut dx = 0.0
    bwd_diff(loss, id.x % 4, 0.5, mut dx, 1.0)

@compute(64) fun loss_forward(@thread_id id: int3){params, training}:
    training.forward[id.x] = fwd_diff(loss, id.x % 4, 0.5, 0.0)

// a buffer of structs: an atomic per float of the element's tangent, a position's three and the weight's one
struct mark:
    at: pos3
    weight: float

binding marked:
    @gradient(mark_training.gradients) marks: buffer[mark]

binding mark_training:
    gradients: mut buffer[atomic[float]]

fun mark_loss(k: int){marked} -> float:
    let m = marked.marks[k]
    let d = m.at - pos3(1.0, 0.0, 0.0)
    return m.weight * dot(d, d)

@compute(64) fun marks_backward(@thread_id id: int3){marked, mark_training}:
    bwd_diff(mark_loss, id.x % 2, 1.0)

// the same gradient, shared through the subgroup first: an entry point that declares `subgroups` sums a subgroup's
// adjoints where every invocation that reaches the add adds to one element, and only its first adds them
@compute(64) fun marks_backward_reduced(@thread_id id: int3){marked, mark_training}:
    require subgroups
    // a third of the invocations never reach the add, so the sum is over those that do
    if id.x % 3 != 0:
        bwd_diff(mark_loss, (id.x / 64) % 2, 1.0)

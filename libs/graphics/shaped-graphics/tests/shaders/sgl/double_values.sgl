// The tier-1 compute fixture, written once for every backend.
// Its point is not what it computes but that ONE source reaches dxil, spirv and wgsl alike:
// the HLSL fixture beside it needs DXC to exist at all, and on a WebGPU context this one needs nothing.

binding work:
    values: mut buffer[float]

@compute(64) fun main(@thread_id id: int3){work}:
    work.values[id.x] = work.values[id.x] * 2.0

binding factor:
    by: buffer[float]

// The same `work`, listed second: here it is group 1, and nothing about its declaration changed.
@compute(64) fun scaled(@thread_id id: int3){factor, work}:
    work.values[id.x] = work.values[id.x] * factor.by[0]

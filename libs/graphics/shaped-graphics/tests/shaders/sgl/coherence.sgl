// Atomic images and coherent memory, as the GPU runs them: neither has a WGSL text, so WebGPU skips both.

require image_atomics
require device_coherence

binding texel_maxima:
    values: buffer[uint]
    @atomic maxima: mut image_2d[.r32_uint]
    @atomic counts: mut image_2d[.r32_uint]

// Each of 16 texels takes every 16th invocation's value, so it ends at the largest of its 64 and has counted all of them.
@compute(64) fun reduce_max(@thread_id id: int3){texel_maxima}:
    let t = id.x % 16
    let xy = int2(t % 4, t / 4)
    texel_maxima.maxima[xy].max(texel_maxima.values[id.x])
    texel_maxima.counts[xy].add(1u)

binding handoff:
    @coherent partials: mut buffer[uint]
    @coherent counter: mut buffer[atomic[uint]]
    @coherent mip: mut image_2d[.r32_float]

// Every invocation publishes its value and its texel, and each workgroup counts itself in once both are visible.
@compute(64) fun publish(@thread_id id: int3, @local_thread_index li: int){handoff}:
    handoff.partials[id.x] = (id.x as uint) * 3u
    handoff.mip[int2(id.x % 16, id.x / 16)] = id.x as float
    storage_barrier()
    texture_barrier()
    if li == 0 => handoff.counter[0].add(1u)

binding last_arrival:
    @coherent values: mut buffer[uint]
    @coherent arrivals: mut buffer[atomic[uint]]
    sums: mut buffer[uint]
    groups: uint

@workgroup binding arrival:
    order: uint

// Every workgroup publishes its values and counts itself in, and the last to arrive sums what all of them published.
// So a write another workgroup's barrier failed to publish is a sum that comes out short.
@compute(64) fun sum_on_last_arrival(@thread_id id: int3, @local_thread_index li: int){last_arrival, arrival}:
    last_arrival.values[id.x] = (id.x as uint) * 3u + 1u
    storage_barrier()
    if li == 0 => arrival.order = last_arrival.arrivals[0].add(1u)
    if workgroup_uniform_load(arrival.order) == last_arrival.groups - 1u:
        storage_barrier()
        let mut total = 0u
        for g in 0 ..< (last_arrival.groups as int):
            total += last_arrival.values[g * 64 + li]
        last_arrival.sums[li] = total

binding texel_shapes_of:
    @atomic flat: mut image_1d[.r32_sint]
    @atomic layered: mut image_2d_array[.r32_uint]
    @atomic deep: mut image_3d[.r32_uint]
    @atomic plain: mut image_2d[.r32_uint]
    seen: mut buffer[uint]

// Each invocation owns its texels, so what every atomic gives back and leaves behind is known exactly.
// A layer or a depth of its own beside each one shows the coordinate reached the texel it names.
@compute fun texel_shapes(@thread_id id: int3){texel_shapes_of}:
    let i = id.x
    let u = i as uint
    let at = i * 10
    let xy = int2(i, 0)
    texel_shapes_of.flat[i].store(9)
    texel_shapes_of.seen[at] = texel_shapes_of.flat[i].min(i) as uint
    texel_shapes_of.seen[at + 1] = texel_shapes_of.flat[i].load() as uint
    texel_shapes_of.layered[xy, layer = 0].store(77u)
    texel_shapes_of.layered[xy, layer = 1].store(10u)
    texel_shapes_of.seen[at + 2] = texel_shapes_of.layered[xy, layer = 1].add(u)
    texel_shapes_of.seen[at + 3] = texel_shapes_of.layered[xy, layer = 1].load()
    texel_shapes_of.deep[int3(i, 1, 0)].store(88u)
    texel_shapes_of.deep[int3(i, 1, 2)].store(20u)
    texel_shapes_of.seen[at + 4] = texel_shapes_of.deep[int3(i, 1, 2)].exchange(30u + u)
    texel_shapes_of.seen[at + 5] = texel_shapes_of.deep[int3(i, 1, 2)].load()
    texel_shapes_of.plain[xy].store(u)
    texel_shapes_of.seen[at + 6] = texel_shapes_of.plain[xy].compare_exchange_strong(u, 40u + u)
    let weak = texel_shapes_of.plain[xy].compare_exchange_weak(7u, 50u)
    texel_shapes_of.seen[at + 7] = weak.old
    if weak.exchanged => texel_shapes_of.seen[at + 7] = 999u
    texel_shapes_of.seen[at + 8] = texel_shapes_of.layered[xy, layer = 0].load()
    texel_shapes_of.seen[at + 9] = texel_shapes_of.deep[int3(i, 1, 0)].load()

// What SGL states for every target and only a GPU shows each backend doing.
// Flat interpolation, discard beside a derivative, a written depth and a written sample mask.

@vertex struct tagged_corner:
    position: float2
    tag: int
    depth: float

struct tagged:
    @position position: hpos4
    @interpolate(.flat) tag: int

@pixel struct tag_target:
    value: float4

@vertex fun tagged_vs(v: tagged_corner) -> tagged:
    return {
        position = hpos4(v.position.x, v.position.y, v.depth, 1.0)
        tag = v.tag
    }

// A flat member takes the first vertex of its primitive, whichever target draws it.
@pixel fun flat_ps(p: tagged) -> tag_target:
    return {
        value = float4(p.tag as float, 0.0, 0.0, 1.0)
    }

pipeline flat_tags:
    vertex = tagged_vs
    pixel = flat_ps
    cull = .none
    format = .rgba32_float

// The pixels of column 0 discard, and their right-hand neighbours then take a derivative across them.
// x² at pixel centres steps by 2 between columns 0 and 1 and by 6 between 2 and 3.
// So only a derivative that still saw the discarded pixel's value reads 2.
@pixel fun derivative_ps(p: tagged) -> tag_target:
    let x = p.position.x
    if x < 1.0 => discard
    return {
        value = float4(ddx(x * x), p.tag as float, 0.0, 1.0)
    }

pipeline discard_derivative:
    vertex = tagged_vs
    pixel = derivative_ps
    cull = .none
    format = .rgba32_float

// x·y at pixel centres, so a derivative along x reads its row's y and one along y its column's x.
// Coarse ones read one row or column for the whole quad, fine ones the pixel's own, whatever the @float level (EVAL-144).
// The tag, 0 on the test's corners, is added so the stage reads what the vertex stage writes: an output nothing reads is
// a warning of vulkan's validation once DXC drops the input.
@pixel fun quad_derivatives_ps(p: tagged) -> tag_target:
    let v = p.position.x * p.position.y
    return {
        value = float4(ddx(v), ddy(v), ddx_fine(v), ddy_fine(v) + (p.tag as float))
    }

@float(.fast) @pixel fun fast_quad_derivatives_ps(p: tagged) -> tag_target:
    let v = p.position.x * p.position.y
    return {
        value = float4(ddx(v), ddy(v), ddx_fine(v), ddy_fine(v) + (p.tag as float))
    }

pipeline quad_derivatives:
    vertex = tagged_vs
    pixel = quad_derivatives_ps
    cull = .none
    format = .rgba32_float

pipeline fast_quad_derivatives:
    vertex = tagged_vs
    pixel = fast_quad_derivatives_ps
    cull = .none
    format = .rgba32_float

binding pixel_claims:
    owners: mut buffer[atomic[uint]]

// As `derivative_ps`, and each pixel claims its own slot first: the discarded column 0 goes on as helpers.
// A helper's atomics store nothing and read what they please, so the strong compare-exchange's loop must not trap one.
// The slots of column 0 stay 0, every other slot holds its pixel's tag plus one, and the draw ends.
@pixel fun claiming_ps(p: tagged){pixel_claims} -> tag_target:
    require helper_lane_query
    let x = p.position.x
    if x < 1.0 => discard
    let slot = (p.position.x as int) + 4 * (p.position.y as int)
    let before = pixel_claims.owners[slot].compare_exchange_strong(0u, (p.tag as uint) + 1u)
    return {
        value = float4(ddx(x * x), before as float, 0.0, 1.0)
    }

pipeline discard_claim:
    vertex = tagged_vs
    pixel = claiming_ps
    cull = .none
    format = .rgba32_float

// The tag, over 100, is the depth written, whatever depth the position rasterized at.
@pixel struct written_depth:
    value: float4
    @depth depth: float

@pixel fun depth_ps(p: tagged) -> written_depth:
    return {
        value = float4(1.0, 0.0, 0.0, 1.0)
        depth = (p.tag as float) * 0.01
    }

pipeline depth_written:
    vertex = tagged_vs
    pixel = depth_ps
    cull = .none
    format = .rgba32_float
    depth_test = true
    depth_compare = .less
    depth_stencil_format = .depth32_float

// The same, promising the written depth is never nearer than the rasterized one.
@pixel struct pushed_depth:
    value: float4
    @depth(.greater_equal) depth: float

@pixel fun push_ps(p: tagged) -> pushed_depth:
    return {
        value = float4(1.0, 0.0, 0.0, 1.0)
        depth = (p.tag as float) * 0.01
    }

pipeline depth_pushed:
    vertex = tagged_vs
    pixel = push_ps
    cull = .none
    format = .rgba32_float
    depth_test = true
    depth_compare = .less
    depth_stencil_format = .depth32_float

// The tag is the sample mask, so a pixel writes only the samples it names.
@pixel struct masked:
    value: float4
    @sample_mask covered: uint

@pixel fun mask_ps(p: tagged) -> masked:
    return {
        value = float4(1.0, 0.0, 0.0, 1.0)
        covered = p.tag as uint
    }

pipeline sample_masked:
    vertex = tagged_vs
    pixel = mask_ps
    cull = .none
    format = .rgba8_unorm
    sample_count = 4

// Every sample of a multisampled target, read into a buffer for the host.
binding samples:
    target: texture_2d_ms[float4]
    values: mut buffer[float]

@compute(1) fun read_samples(@thread_id id: int3){samples}:
    let size = samples.target.size()
    let pixel = int2(id.x % size.x, id.x / size.x)
    for s in 0 ..< 4:
        samples.values[id.x * 4 + s] = samples.target.load(pixel, sample = s).x

// The four texels `gather` returns, at the centre of a 2 × 2 texture.
binding gathered:
    source: texture_2d[float]
    values: mut buffer[float4]
    sampler nearest:
        filter = .nearest

@compute(1) fun gather_centre(@thread_id id: int3){gathered}:
    gathered.values[0] = gathered.source.gather(float2(0.5, 0.5), gathered.nearest)

// One color value needs no @pixel struct: it is the stage's one target, named `color` (CHK-418).
@pixel fun direct_ps(p: tagged) -> float4 => float4(p.tag as float, 1.0, 0.0, 1.0)

pipeline direct_tags:
    vertex = tagged_vs
    pixel = direct_ps
    cull = .none
    format = .rgba32_float

binding pixel_marks:
    marks: mut buffer[uint]

// A pixel stage that writes memory alone returns nothing, and its pipeline has no color target (CHK-418).
@pixel fun marking_ps(p: tagged){pixel_marks}:
    let slot = (p.position.x as int) + 4 * (p.position.y as int)
    pixel_marks.marks[slot] = (p.tag as uint) + 1u

pipeline marked:
    vertex = tagged_vs
    pixel = marking_ps
    cull = .none
    depth_stencil_format = .depth32_float

struct layered:
    @position position: hpos4
    @layer layer: uint
    @interpolate(.flat) tag: int

// One draw fills both layers of an array target: each instance sends its triangles to its own layer (CHK-419).
@vertex fun layered_vs(v: tagged_corner, @instance_index i: int) -> layered:
    require vertex_layer_output
    return {
        position = hpos4(v.position.x, v.position.y, v.depth, 1.0)
        layer = i as uint
        tag = v.tag + 10 * i
    }

@pixel fun layered_ps(p: layered) -> float4:
    require vertex_layer_output
    return float4(p.tag as float, p.layer as float, 0.0, 1.0)

pipeline layered_tags:
    vertex = layered_vs
    pixel = layered_ps
    cull = .none
    format = .rgba32_float

struct viewed:
    @position position: hpos4
    @interpolate(.flat) tag: int

// One draw renders both views, each into its own layer, and both stages read which view they run for (CHK-437).
@vertex fun viewed_vs(v: tagged_corner, @view_index view: int) -> viewed:
    require view_instancing
    return {
        position = hpos4(v.position.x, v.position.y, v.depth, 1.0)
        tag = v.tag + 10 * view
    }

@pixel fun viewed_ps(p: viewed, @view_index view: int) -> float4:
    require view_instancing
    return float4(p.tag as float, view as float, 0.0, 1.0)

// The position depends on the view, as a per-eye matrix makes it: view 0 lands left of centre, view 1 right of it.
@vertex fun moved_vs(v: tagged_corner, @view_index view: int) -> viewed:
    require view_instancing
    let shift = if view == 0 => -0.5 else 0.5
    return {
        position = hpos4(v.position.x * 0.5 + shift, v.position.y, v.depth, 1.0)
        tag = v.tag
    }

pipeline moved_views:
    vertex = moved_vs
    pixel = viewed_ps
    cull = .none
    format = .rgba32_float
    view_count = 2

// The same with no vertex input at all, as a shape drawn from its vertex index is: a strip over the whole target.
@vertex fun moved_index_vs(@vertex_index vertex: int, @view_index view: int) -> viewed:
    require view_instancing
    let x = if (vertex & 1) != 0 => 1.0 else -1.0
    let y = if (vertex & 2) != 0 => 1.0 else -1.0
    let shift = if view == 0 => -0.5 else 0.5
    return {
        position = hpos4(x * 0.5 + shift, y, 0.5, 1.0)
        tag = 7
    }

pipeline moved_index_views:
    vertex = moved_index_vs
    pixel = viewed_ps
    cull = .none
    topology = .triangle_strip
    format = .rgba32_float
    view_count = 2

pipeline moved_views_depth:
    vertex = moved_vs
    pixel = viewed_ps
    cull = .none
    format = .rgba32_float
    depth_test = true
    depth_write = true
    depth_stencil_format = .depth32_float
    view_count = 2

pipeline viewed_tags:
    vertex = viewed_vs
    pixel = viewed_ps
    cull = .none
    format = .rgba32_float
    view_count = 2

// A quad vote is its quad's whole answer, helpers included, so a derivative stands under a branch on one (CHK-533).
// Pixel (5, 2) alone asks, so its quad, columns 4 and 5 of rows 2 and 3, takes ddx of x, 1 in each of its pixels.
// `quad_all` of x < 5 holds in the quads left of column 4, and in no quad that holds column 5.
@pixel fun quad_vote_ps(p: tagged) -> tag_target:
    require subgroups, quad_control
    let x = p.position.x
    let y = p.position.y
    let asked = x > 5.0 and x < 6.0 and y > 2.0 and y < 3.0
    let mut slope = 0.0
    if quad_any(asked):
        slope = ddx(x)
    return {
        value = float4(slope, if quad_all(x < 5.0) => 1.0 else 0.0, p.tag as float, 1.0)
    }

pipeline quad_votes:
    vertex = tagged_vs
    pixel = quad_vote_ps
    cull = .none
    format = .rgba32_float

struct placed:
    @position position: hpos4
    @viewport_index viewport: uint
    @interpolate(.flat) tag: int

// One draw of two instances, each sent to the viewport its instance names (CHK-534).
@vertex fun placed_vs(v: tagged_corner, @instance_index i: int) -> placed:
    require multi_viewport
    return {
        position = hpos4(v.position.x, v.position.y, v.depth, 1.0)
        viewport = i as uint
        tag = v.tag + 10 * i
    }

@pixel fun placed_ps(p: placed) -> float4:
    require multi_viewport
    return float4(p.tag as float, p.viewport as float, 0.0, 1.0)

pipeline placed_tags:
    vertex = placed_vs
    pixel = placed_ps
    cull = .none
    format = .rgba32_float

// The level of detail a sample would read, clamped and not (CHK-535).
// A 64 x 64 texture over a 16 x 16 target at uv = position / 16 is 4 texels a pixel, level 2.
// An eighth of that uv is half a texel a pixel, level -1, which `lod` clamps to 0.
binding detail:
    source: texture_2d[float4]
    sampler trilinear:
        filter = .linear
        mip_filter = .linear

@pixel fun lod_ps(p: tagged){detail} -> tag_target:
    let uv = float2(p.position.x, p.position.y) / 16.0
    let near = uv * 0.125
    let at = detail.source.lod(uv, detail.trilinear)
    let at_unclamped = detail.source.lod_unclamped(uv, detail.trilinear)
    let below = detail.source.lod(near, detail.trilinear)
    let below_unclamped = detail.source.lod_unclamped(near, detail.trilinear)
    return {
        value = float4(at, at_unclamped, below, below_unclamped + (p.tag as float))
    }

pipeline lod_query:
    vertex = tagged_vs
    pixel = lod_ps
    cull = .none
    format = .rgba32_float

// The depth test before a stage that writes memory: with `@early_depth_test` a pixel that fails it runs none of the
// stage, and without it the stage runs, writes, and the test then drops its color (CHK-564, CHK-567).
binding early_counts:
    counted: mut buffer[atomic[uint]]

@early_depth_test
@pixel fun counted_early_ps(p: tagged){early_counts} -> tag_target:
    require early_depth_test
    early_counts.counted[0].add(1u)
    return {value = float4(p.tag as float, 0.0, 0.0, 1.0)}

@pixel fun counted_late_ps(p: tagged){early_counts} -> tag_target:
    early_counts.counted[1].add(1u)
    return {value = float4(p.tag as float, 0.0, 0.0, 1.0)}

pipeline counted_early:
    vertex = tagged_vs
    pixel = counted_early_ps
    cull = .none
    format = .rgba32_float
    depth_test = true
    depth_compare = .less
    depth_stencil_format = .depth32_float

pipeline counted_late:
    vertex = tagged_vs
    pixel = counted_late_ps
    cull = .none
    format = .rgba32_float
    depth_test = true
    depth_compare = .less
    depth_stencil_format = .depth32_float

// Clip distances (CHK-571, EMIT-290): six lanes, the last of which is the vertex's x in clip space, so the rasterizer
// keeps the right half of what is drawn; the other five are 1 and keep everything.
struct clipped:
    @position position: hpos4
    @clip_distances planes: float[6]

@vertex fun clipped_vs(v: tagged_corner) -> clipped:
    require clip_distances
    // the tag is 0 here, and read so the vertex attribute it is in is consumed
    let mut planes = float[6].filled(1.0 + (v.tag as float))
    planes[5] = v.position.x
    return {position = hpos4(v.position.x, v.position.y, v.depth, 1.0), planes = planes}

@pixel fun clipped_ps(p: clipped) -> tag_target:
    return {value = float4(1.0, 0.0, 0.0, 1.0)}

pipeline clipped_draw:
    vertex = clipped_vs
    pixel = clipped_ps
    cull = .none
    format = .rgba32_float

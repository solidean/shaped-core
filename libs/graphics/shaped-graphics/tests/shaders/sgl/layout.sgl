// Every value in GPU memory is placed by SGL's own rule, and each target is made to follow it (the spec's layout rules).
// The host fills these through the structs the package generates, byte for byte, and reads them back the same way.

// A buffer's element packs tight, as a tg struct does: `velocity` sits at 4 and `alive` at 32, 36 bytes in all.
struct particle:
    mass: float
    velocity: float3
    color: float4
    alive: bool32

// In a constant block a nested struct starts a row, and what follows packs against its last member.
struct glow:
    color: float3

binding step:
    dt: float
    push: float3
    shade: glow
    after: float
    items: mut buffer[particle]

@compute(64) fun advance(@thread_id id: int3){step}:
    let p = step.items[id.x]
    if p.alive as bool:
        let velocity = p.velocity + step.push * step.dt
        let color = p.color * step.shade.color.x
        step.items[id.x] = particle(p.mass + step.after, velocity, color, false as bool32)

// Tight packing puts `b` at 8, across a 16-byte row, and a buffer of float3 strides by 12.
struct pair:
    a: float2
    b: float3

binding stretch:
    pairs: mut buffer[pair]
    dirs: mut buffer[float3]

@compute(64) fun spread(@thread_id id: int3){stretch}:
    let p = stretch.pairs[id.x]
    let d = stretch.dirs[id.x]
    stretch.pairs[id.x] = pair(p.a * 2.0, p.b + d)
    stretch.dirs[id.x] = d * 3.0

// `@layout(.cpp)` places a block as C++ places a struct of tg types, so a host fills it from a struct of its own.
// `tint` sits at 4 and `bias` right behind it at 16, and `weights` crosses a row from 28: 48 bytes in all.
@layout(.cpp) @inline binding host_params:
    scale: float
    tint: float3
    bias: float
    shift: float2
    weights: float4
    count: uint

// A group's block follows the same rule: `dir` at 4, `after` at 16 and `to_world` at 20, column by column as tg holds it.
@layout(.cpp)
binding host_echo:
    gain: float
    dir: float3
    after: float
    to_world: mat4
    values: mut buffer[float]

@compute(1) fun echo(){host_echo, host_params}:
    host_echo.values[0] = host_params.scale
    host_echo.values[1] = host_params.tint.x
    host_echo.values[2] = host_params.tint.y
    host_echo.values[3] = host_params.tint.z
    host_echo.values[4] = host_params.bias
    host_echo.values[5] = host_params.shift.x
    host_echo.values[6] = host_params.shift.y
    let w = host_params.weights
    host_echo.values[7] = w.x
    host_echo.values[8] = w.y
    host_echo.values[9] = w.z
    host_echo.values[10] = w.w
    host_echo.values[11] = host_params.count as float
    host_echo.values[12] = host_echo.gain
    host_echo.values[13] = host_echo.dir.x
    host_echo.values[14] = host_echo.dir.y
    host_echo.values[15] = host_echo.dir.z
    host_echo.values[16] = host_echo.after
    // a matrix times a unit vector is that column
    let c0 = host_echo.to_world * float4(1.0, 0.0, 0.0, 0.0)
    let c1 = host_echo.to_world * float4(0.0, 1.0, 0.0, 0.0)
    let c2 = host_echo.to_world * float4(0.0, 0.0, 1.0, 0.0)
    let c3 = host_echo.to_world * float4(0.0, 0.0, 0.0, 1.0)
    host_echo.values[17] = c0.x
    host_echo.values[18] = c0.y
    host_echo.values[19] = c0.z
    host_echo.values[20] = c0.w
    host_echo.values[21] = c1.x
    host_echo.values[22] = c1.y
    host_echo.values[23] = c1.z
    host_echo.values[24] = c1.w
    host_echo.values[25] = c2.x
    host_echo.values[26] = c2.y
    host_echo.values[27] = c2.z
    host_echo.values[28] = c2.w
    host_echo.values[29] = c3.x
    host_echo.values[30] = c3.y
    host_echo.values[31] = c3.z
    host_echo.values[32] = c3.w

// 16-bit members pack at 2 bytes, as tg's do: `h` at 4, `tint` at 6, `count` at 12 and `after` at 16, 20 bytes in all.
// A group's block, since an @inline binding holds no 16-bit value.
@layout(.cpp)
binding host_halves:
    require shader_f16, shader_int16
    gain: float
    h: half
    tint: half3
    count: ushort
    after: float
    values: mut buffer[float]

@compute(1) fun echo_halves(){host_halves}:
    host_halves.values[0] = host_halves.gain
    host_halves.values[1] = host_halves.h as float
    host_halves.values[2] = host_halves.tint.x as float
    host_halves.values[3] = host_halves.tint.y as float
    host_halves.values[4] = host_halves.tint.z as float
    host_halves.values[5] = (host_halves.count as uint) as float
    host_halves.values[6] = host_halves.after

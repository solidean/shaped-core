// Every value in GPU memory is placed by SGL's own rule, and each target is made to follow it (the spec's layout rules).
// The host fills these through the structs the package generates, byte for byte, and reads them back the same way.

// A buffer's element aligns every vector to its size, a float3 to 16: `velocity` sits at 16, `color` at 32 and `alive`
// at 48, 64 bytes in all.
struct particle:
    mass: float
    velocity: float3
    color: float4
    alive: bool32

// In a constant block a nested struct starts a row, and what follows it starts the next one.
struct glow:
    color: float3

binding step:
    dt: float
    push: float3
    shade: glow
    after: float
    items: mut buffer[particle]

@compute(64) fun advance(@thread_id id: int3){step}:
    let p = step.items[id.x]
    if p.alive as bool:
        let velocity = p.velocity + step.push * step.dt
        let color = p.color * step.shade.color.x
        step.items[id.x] = particle(p.mass + step.after, velocity, color, false as bool32)

// The natural rule puts `b` at 16, and a buffer of float3 strides by 16.
struct pair:
    a: float2
    b: float3

// `@padding(.none)` packs as C++ does: `b` at 8, across a 16-byte row, and a buffer of float3 strides by 12.
struct flat_pair:
    a: float2
    b: float3

binding stretch:
    pairs: mut buffer[pair]
    dirs: mut buffer[float3]
    @padding(.none) flat_pairs: mut buffer[flat_pair]
    @padding(.none) flat_dirs: mut buffer[float3]

@compute(64) fun spread(@thread_id id: int3){stretch}:
    let p = stretch.pairs[id.x]
    let d = stretch.dirs[id.x]
    stretch.pairs[id.x] = pair(p.a * 2.0, p.b + d)
    stretch.dirs[id.x] = d * 3.0
    let f = stretch.flat_pairs[id.x]
    let g = stretch.flat_dirs[id.x]
    stretch.flat_pairs[id.x] = flat_pair(f.a * 2.0, f.b + g)
    stretch.flat_dirs[id.x] = g * 3.0

// A mat3's columns stand 16 bytes apart, 48 bytes in all, in a block, a struct and a buffer alike.
// `@padding(.none)` packs them into the 36 bytes of a tg::mat3f.
struct framed:
    basis: mat3
    scale: float

binding turn:
    xf: mat3
    after: float
    frames: mut buffer[framed]
    mats: mut buffer[mat3]
    @padding(.none) flat: mut buffer[mat3]
    dirs: mut buffer[float4]

@compute(64) fun rotate(@thread_id id: int3){turn}:
    let f = turn.frames[id.x]
    let v = turn.xf * (f.basis * float3(1.0, 2.0, 3.0))
    turn.dirs[id.x] = float4(v.x, v.y, v.z, f.scale + turn.after)
    turn.frames[id.x] = framed(turn.mats[id.x], f.scale * 2.0)
    turn.mats[id.x] = turn.flat[id.x]
    turn.flat[id.x] = f.basis

// An array strides by its element rounded up to the element's alignment: a float3 by 16, a float by 4, a struct by its
// size, here 32 with `radius` in `color`'s tail.
struct lamp:
    pos: float4
    color: float3
    radius: float

// a constant block places its own struct, since one struct has one layout (EMIT-114)
struct beacon:
    pos: float4
    color: float3
    radius: float

struct track:
    corners: float3[3]
    weights: float[4]
    lamps: lamp[2]

binding lit:
    lamps: beacon[2]
    tints: float3[2]
    tracks: mut buffer[track]
    sums: mut buffer[float4]

@compute(64) fun light_up(@thread_id id: int3){lit}:
    let t = lit.tracks[id.x]
    let l = lit.lamps[id.x % 2]
    let s = t.corners[0] + t.corners[2] * t.weights[3] + lit.tints[1] * l.radius + t.lamps[1].color
    lit.sums[id.x] = float4(s.x, s.y, s.z, l.color.y + t.lamps[0].radius)
    let mut u = t
    u.corners[1] = l.color
    u.weights[0] = l.radius
    lit.tracks[id.x] = u

// `@padding(.none)` places a block as C++ places a struct of tg types, so a host fills it from a struct of its own.
// `tint` sits at 4 and `bias` right behind it at 16, and `weights` crosses a row from 28: 48 bytes in all.
@padding(.none) @inline binding host_params:
    scale: float
    tint: float3
    bias: float
    shift: float2
    weights: float4
    count: uint

// A group's block follows the same rule: `dir` at 4, `after` at 16 and `to_world` at 20, column by column as tg holds it.
@padding(.none)
binding host_echo:
    gain: float
    dir: float3
    after: float
    to_world: mat4
    values: mut buffer[float]

@compute(1) fun echo(){host_echo, host_params}:
    host_echo.values[0] = host_params.scale
    host_echo.values[1] = host_params.tint.x
    host_echo.values[2] = host_params.tint.y
    host_echo.values[3] = host_params.tint.z
    host_echo.values[4] = host_params.bias
    host_echo.values[5] = host_params.shift.x
    host_echo.values[6] = host_params.shift.y
    let w = host_params.weights
    host_echo.values[7] = w.x
    host_echo.values[8] = w.y
    host_echo.values[9] = w.z
    host_echo.values[10] = w.w
    host_echo.values[11] = host_params.count as float
    host_echo.values[12] = host_echo.gain
    host_echo.values[13] = host_echo.dir.x
    host_echo.values[14] = host_echo.dir.y
    host_echo.values[15] = host_echo.dir.z
    host_echo.values[16] = host_echo.after
    // a matrix times a unit vector is that column
    let c0 = host_echo.to_world * float4(1.0, 0.0, 0.0, 0.0)
    let c1 = host_echo.to_world * float4(0.0, 1.0, 0.0, 0.0)
    let c2 = host_echo.to_world * float4(0.0, 0.0, 1.0, 0.0)
    let c3 = host_echo.to_world * float4(0.0, 0.0, 0.0, 1.0)
    host_echo.values[17] = c0.x
    host_echo.values[18] = c0.y
    host_echo.values[19] = c0.z
    host_echo.values[20] = c0.w
    host_echo.values[21] = c1.x
    host_echo.values[22] = c1.y
    host_echo.values[23] = c1.z
    host_echo.values[24] = c1.w
    host_echo.values[25] = c2.x
    host_echo.values[26] = c2.y
    host_echo.values[27] = c2.z
    host_echo.values[28] = c2.w
    host_echo.values[29] = c3.x
    host_echo.values[30] = c3.y
    host_echo.values[31] = c3.z
    host_echo.values[32] = c3.w

// 16-bit members pack at 2 bytes, as tg's do: `h` at 4, `tint` at 6, `count` at 12 and `after` at 16, 20 bytes in all.
// A group's block, since an @inline binding holds no 16-bit value.
@padding(.none)
binding host_halves:
    require shader_f16, shader_int16
    gain: float
    h: half
    tint: half3
    count: ushort
    after: float
    values: mut buffer[float]

@compute(1) fun echo_halves(){host_halves}:
    host_halves.values[0] = host_halves.gain
    host_halves.values[1] = host_halves.h as float
    host_halves.values[2] = host_halves.tint.x as float
    host_halves.values[3] = host_halves.tint.y as float
    host_halves.values[4] = host_halves.tint.z as float
    host_halves.values[5] = (host_halves.count as uint) as float
    host_halves.values[6] = host_halves.after

const last_values = [22.0, 23.0, 24.0]

// An array of whole rows starts a row and strides by its element: `rows` at 16, `xf` at 64 and `ids` at 192.
// `shift` aligns to its size, at 8, so every target reads the block as it is.
binding rows_echo:
    scale: float
    shift: float2
    rows: float4[3]
    xf: mat4[2]
    ids: int4[2]
    values: mut buffer[float]

@compute(1) fun echo_rows(){rows_echo}:
    rows_echo.values[0] = rows_echo.scale
    rows_echo.values[1] = rows_echo.shift.x
    rows_echo.values[2] = rows_echo.shift.y
    // a runtime index walks into the block in place
    for i in 0 ..< rows_echo.ids[0].x:
        let r = rows_echo.rows[i]
        rows_echo.values[3 + 4 * i] = r.x
        rows_echo.values[4 + 4 * i] = r.y
        rows_echo.values[5 + 4 * i] = r.z
        rows_echo.values[6 + 4 * i] = r.w
    // column 3 of each matrix, its translation, at an index the shader reads from the block (CHK-407)
    for m in 0 ..< 2:
        let t = rows_echo.xf[m].column(rows_echo.ids[0].x)
        rows_echo.values[15 + 4 * m] = t.x
        rows_echo.values[16 + 4 * m] = t.y
        rows_echo.values[17 + 4 * m] = t.z
        rows_echo.values[18 + 4 * m] = t.w
    // a const array is bound once and indexed where it is read, here at an index the block holds (EMIT-165)
    rows_echo.values[23] = last_values[rows_echo.ids[0].x - 1] + (rows_echo.ids[1].w as float) - 24.0

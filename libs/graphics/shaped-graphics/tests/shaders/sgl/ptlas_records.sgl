// The records of a GPU-written partitioned tlas update, as partitioned-tlas-test.cc's scene needs them.
// Each thread appends its own record and bumps the count sg copies into the operation it builds.
use accel

binding records:
    blases: buffer[accel.blas_ref]
    writes: mut buffer[accel.ptlas_write]
    translations: mut buffer[accel.ptlas_translation]
    counts: mut buffer[atomic[uint]]

// The scene's two instances: id 10 in slot 0 of partition 0 at z = 0, and id 20 in slot 1 of the global one at x + 4, z = 2.
@compute fun write_instances(@thread_id id: int3){records}:
    if id.x >= 2 => return
    let is_first = id.x == 0
    let x = if is_first => 0.0 else 4.0
    let z = if is_first => 0.0 else 2.0
    let placed = affine3.from_rows(float4(1.0, 0.0, 0.0, x), float4(0.0, 1.0, 0.0, 0.0), float4(0.0, 0.0, 1.0, z))
    let mut w = accel.ptlas_write(index = id.x as uint, blas = records.blases[0], transform = placed)
    w.partition = if is_first => 0u else accel.global_partition
    w.instance_id = if is_first => 10u else 20u
    let at = records.counts[0].add(1u)
    records.writes[at] = w

// Partition 0 moves by 4 in x, which carries instance 0 without writing it.
@compute fun translate_partition(@thread_id id: int3){records}:
    if id.x >= 1 => return
    let at = records.counts[1].add(1u)
    records.translations[at] = accel.ptlas_translation(partition = 0u, translation = [4.0, 0.0, 0.0])

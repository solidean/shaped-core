// Points placed by a column per vertex and a row per instance, each writing the indices it was drawn with.
// The draw-parameter tests read those back, so a base a backend dropped shows as a wrong number rather than a missing pixel.

@vertex struct indexed_point:
    column: float
    @per_instance row: float

struct drawn_indices:
    @position position: hpos4
    @interpolate(.flat) vertex: int
    @interpolate(.flat) instance: int

@pixel struct index_target:
    indices: float4

// `column` and `row` are clip-space x and y, at a pixel's centre.
@vertex fun index_vs(p: indexed_point, @vertex_index v: int, @instance_index i: int) -> drawn_indices:
    return {
        position = hpos4(p.column, p.row, 0.5, 1.0)
        vertex = v
        instance = i
    }

@pixel fun index_ps(p: drawn_indices) -> index_target:
    return {
        indices = float4(p.vertex as float, p.instance as float, 0.0, 1.0)
    }

pipeline indexed_points:
    vertex = index_vs
    pixel = index_ps
    topology = .point_list
    format = .rgba32_float

// The same points, each draw tagged by inline constants the host sets between draws.
@inline binding draw_tag:
    tag: float

@pixel fun tagged_ps(p: drawn_indices){draw_tag} -> index_target:
    return {
        indices = float4(p.vertex as float, p.instance as float, draw_tag.tag, 1.0)
    }

pipeline tagged_points:
    vertex = index_vs
    pixel = tagged_ps
    topology = .point_list
    format = .rgba32_float

// A block that ends short of its 16-byte alignment, which WGSL rounds a uniform's size up to.
@inline binding tinted_tag:
    tint: float4
    tag: float

@pixel fun tinted_ps(p: drawn_indices){tinted_tag} -> index_target:
    return {
        indices = float4(p.vertex as float, p.instance as float, tinted_tag.tag, tinted_tag.tint.w)
    }

pipeline tinted_points:
    vertex = index_vs
    pixel = tinted_ps
    topology = .point_list
    format = .rgba32_float

// The same points, each carrying a matrix, an array written at a runtime index, and a flat array across the link.
// Every one crosses as its columns or its elements (CHK-422), so a piece a backend lost or swapped shows as a wrong number.
struct linked_indices:
    @position position: hpos4
    frame: mat3
    turn: mat2
    weights: float[3]
    @interpolate(.flat) ids: int[2]

@vertex fun linked_vs(p: indexed_point, @vertex_index v: int, @instance_index i: int) -> linked_indices:
    let mut link = linked_indices(
        position = hpos4(p.column, p.row, 0.5, 1.0)
        frame = mat3(float3(v as float, 0.0, 0.0), float3(0.0, i as float, 0.0), float3(1.0, 2.0, 3.0))
        turn = mat2(float2(0.0, 1.0), float2(-1.0, 0.0))
        weights = [v as float, i as float, 0.5]
        ids = [v, i]
    )
    link.weights[v % 3] += 10.0
    return link

// (2c + 1, 2 + weights[1], weights[c % 3], c - r) for the point at column c of row r, the matrices undone by the arithmetic.
@pixel fun linked_ps(p: linked_indices) -> index_target:
    let lit = p.frame * float3(1.0)
    let turned = p.turn * float2(p.ids[0] as float, p.ids[1] as float)
    return {
        indices = float4(lit.x + turned.y, lit.y + turned.x + p.weights[1], p.weights[p.ids[0] % 3], (p.ids[0] - p.ids[1]) as float)
    }

pipeline linked_points:
    vertex = linked_vs
    pixel = linked_ps
    topology = .point_list
    format = .rgba32_float

// The same points, read from vertex buffers that hold an array per vertex and a matrix per instance.
// Each is read as its elements or its columns, an attribute apiece (CHK-422, EMIT-174).
@vertex struct framed_point:
    column: float
    tags: float[3]
    @per_instance row: float
    @per_instance frame: mat3

struct framed_value:
    @position position: hpos4
    @interpolate(.flat) value: float4

@vertex fun framed_vs(p: framed_point) -> framed_value:
    let framed = p.frame * float3(p.tags[0], p.tags[1], p.tags[2])
    return {
        position = hpos4(p.column, p.row, 0.5, 1.0)
        value = float4(framed.x, framed.y, framed.z, p.tags[2])
    }

@pixel fun framed_ps(p: framed_value) -> index_target:
    return {indices = p.value}

pipeline framed_points:
    vertex = framed_vs
    pixel = framed_ps
    topology = .point_list
    format = .rgba32_float

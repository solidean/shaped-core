// The bound raster mode's shadow pass: one occlusion ray a half-size pixel, which module `raster_bound` accumulates.
//
// Apart from raster_bound_pass.sgl because it needs `ray_query`, which a device without it lacks; that file's passes do not.
// sv::raster_bound_routine builds it only where the device has the feature.

require ray_query

use raster_bound_shadows

struct shadow_varyings:
    @position position: hpos4

/// Vertices 0, 1 and 2 land at (0,0), (2,0) and (0,2): one triangle covering the target.
@vertex fun bound_shadow_vs(@vertex_index vertex: int) -> shadow_varyings:
    let t = float2(((vertex << 1) & 2) as float, (vertex & 2) as float)
    let clip = t * float2(2.0, -2.0) + float2(-1.0, 1.0)
    return { position = hpos4(clip.x, clip.y, 0.0, 1.0) }

/// Whether one random point of a light chosen in proportion to its light is visible, at half the image's size.
@pixel fun bound_shadow_ps(p: shadow_varyings){raster_bound_shadows.shadow_scene} -> raster_bound_shadows.shadow_target:
    return { visibility = raster_bound_shadows.visibility(int2(p.position.x as int, p.position.y as int)) }

// The hybrid's fixed stages: the vertex stage a forward frame draws with, and the kernel that lights a deferred frame's thin G-buffer.
//
// A forward frame's pixel stage is generated per material permutation, `sv_hybrid`, and compiled at run time, so it has no entry here.
// sv::hybrid_routine runs both, and libs/graphics/shaped-viewer/docs/plans/hybrid-renderer.md is the design.
require first_instance
require ray_query
require raytracing_pipeline

use hybrid
use openpbr
use raster
use scene
use tracer

/// `raster_pass.surface_vs` over `tracer.traced`, which a forward frame's pixel stage lists as group 0 in place of `raster.drawn`.
@vertex fun hybrid_vs(@vertex_index vertex: int, @first_instance row: int){tracer.traced, tracer.bindless, hybrid.pass} -> raster.varyings:
    return hybrid.vertex_of(vertex, row as uint)

/// `quadric_vs` of raster_pass.sgl, reading `tracer.traced`.
@vertex fun hybrid_quadric_vs(@vertex_index vertex: int, @instance_index index: int, @first_instance row: int){tracer.traced, tracer.bindless, hybrid.pass} -> raster.quadric_varyings:
    return hybrid.quadric_vertex_of(vertex, row as uint, (index - row) as uint)

/// The thin G-buffer a deferred frame's raster pass wrote, `raster.thin_targets` but the guide slots it wrote in place.
binding thin_io:
    @unfilterable
    emission: texture_2d[float4]
    @unfilterable
    normals: texture_2d[float4]
    @unfilterable
    base: texture_2d[float4]
    @unfilterable
    specular: texture_2d[float4]
    @unfilterable
    extra: texture_2d[float4]
    @unfilterable
    depth: texture_2d[float]
    @unfilterable
    primary_depth: texture_2d[float]

/// Lights one pixel of the thin G-buffer into `traced.output`, and writes the guides the G-buffer does not hold already.
///
/// The point is placed by the linear depth along the pixel's camera ray, through the center the raster sampled.
/// The shading frame is rebuilt around the shading normal alone, since the reduced closure is isotropic.
/// A pixel no surface covers is the environment the G-buffer holds as its emission, with every guide zero.
@compute(8, 8) fun light_thin(@thread_id id: int3){tracer.traced, tracer.bindless, thin_io, hybrid.pass}:
    let size = thin_io.depth.size()
    if id.x >= size.x or id.y >= size.y => return
    let px = int2(id.x, id.y)
    let emission = thin_io.emission.load(px)

    if thin_io.primary_depth.load(px) >= 1.0:
        tracer.traced.output.store(px, float4(emission.x, emission.y, emission.z, 1.0))
        tracer.traced.guide_normal.store(px, float4(0.0))
        tracer.traced.guide_albedo.store(px, float4(0.0))
        tracer.traced.guide_specular_albedo.store(px, float4(0.0))
        tracer.traced.guide_roughness.store(px, 0.0)
        return

    let f = tracer.traced.frame[0]
    let cam = scene.camera(..f.camera)
    // Where the raster sampled the pixel, which is off its center on a frame drawn for an upscaler.
    let pixel = float2((id.x as float) + 0.5, (id.y as float) + 0.5) + hybrid.jitter_of(f)
    let ray = scene.camera_ray_offset(cam, pixel, hybrid.pass.size)
    let origin = scene.camera_origin(cam, pixel, hybrid.pass.size)
    let t = thin_io.depth.load(px) / dot(ray, normalize(cam.forward))

    let normals = thin_io.normals.load(px)
    let shading_n = raster.oct_decode(float2(normals.x, normals.y))
    let n = raster.oct_decode(float2(normals.z, normals.w))
    // The point is rounded as `origin + ray * t` is, to a scale of the camera's distance from the origin plus the ray's length.
    // `pt.offset_ray` sizes its offset from the point's own coordinates, as an interpolated point is rounded, which is far less on a floor near y = 0.
    // So the point is lifted off the surface by that rounding first, or a row of it starts under the floor and its bounce rays hit the floor.
    let reach = max(abs(origin.x), max(abs(origin.y), abs(origin.z))) + length(ray) * t
    let lift = reach * (1.0 / 1048576.0)
    let surface_p = origin + ray * t
    // Reflections and light samples leave on the viewer's side; a refraction leaves through the surface, which `bounce_from` lifts toward itself.
    let p = surface_p + n * lift
    let surface = raster.thin_surface(thin_io.base.load(px), thin_io.specular.load(px), thin_io.extra.load(px))
    let shading = openpbr.make_frame(shading_n)
    let v = normalize(scene.camera_eye_of(cam, p) - p)
    // The normals were turned toward the viewer, so the viewer is outside.
    let b = openpbr.bsdf_prepare(surface, false, 3u)
    let wo_local = openpbr.to_local(shading, v)

    let mut rng = hybrid.pixel_rng(uint2(id.x as uint, id.y as uint), size.x as uint)
    let lit = hybrid.direct(b, shading, n, wo_local, p, true, mut rng)
    let bounced = hybrid.bounce_from(b, shading, n, wo_local, surface_p, lift, mut rng)
    let followed = hybrid.is_followed(bounced)
    let s2 = hybrid.secondary_of(bounced, followed)
    let bounce_lit = hybrid.direct(s2.b, s2.f, bounced.n, s2.wo_local, bounced.at, followed, mut rng)
        + hybrid.secondary_environment(s2.b, s2.f, bounced.n, hybrid.unless_followed(followed, s2.wo_local), bounced.at, mut rng)
    let next = hybrid.bounce_plain(s2.b, s2.f, bounced.n, hybrid.if_followed(followed, s2.wo_local), bounced.at, mut rng)
    let s3 = hybrid.secondary_of(next, false)
    let next_lit = hybrid.direct(s3.b, s3.f, next.n, s3.wo_local, next.at, false, mut rng)
        + hybrid.secondary_environment(s3.b, s3.f, next.n, s3.wo_local, next.at, mut rng)
    let beyond = next.throughput * (next.escaped + next.lights + next_lit)
    let color = hybrid.finite(float3(emission.x, emission.y, emission.z) + lit + bounced.throughput * (bounced.escaped + bounced.lights + bounce_lit + beyond))

    tracer.traced.output.store(px, float4(..color, 1.0))
    // Where the bounce went, in its lobe's half, as the tracer writes it: 1e4 for an escape, and 0 for the half no direction was drawn from.
    if f.write_hit_distance != 0u:
        let distance = if not bounced.drawn => 0.0 else (if bounced.hit => length(bounced.at - p) else 1e4)
        tracer.traced.guide_hit_distance[px] = if bounced.specular => float2(0.0, distance) else float2(distance, 0.0)
    tracer.traced.guide_normal.store(px, float4(..n, 0.0))
    tracer.traced.guide_albedo.store(px, float4(..openpbr.pt_diffuse_albedo(surface), 0.0))
    tracer.traced.guide_specular_albedo.store(px, float4(..openpbr.pt_specular_albedo(surface), 0.0))
    tracer.traced.guide_roughness.store(px, openpbr.pt_roughness(surface))

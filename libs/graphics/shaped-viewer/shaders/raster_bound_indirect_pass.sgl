// The bound raster mode's traced indirect light: one ray a pixel at a reduced size, which module `raster_bound` blurs.
//
// Apart from raster_bound_pass.sgl because it needs `ray_query`, which a device without it lacks.
// sv::raster_bound_routine builds it only where the device has the feature.

require ray_query

use raster_bound_indirect

struct indirect_varyings:
    @position position: hpos4

/// Vertices 0, 1 and 2 land at (0,0), (2,0) and (0,2): one triangle covering the target.
@vertex fun bound_indirect_vs(@vertex_index vertex: int) -> indirect_varyings:
    let t = float2(((vertex << 1) & 2) as float, (vertex & 2) as float)
    let clip = t * float2(2.0, -2.0) + float2(-1.0, 1.0)
    return { position = hpos4(clip.x, clip.y, 0.0, 1.0) }

/// The radiance one ray brings back to a traced pixel, and the view depth it left from.
@pixel fun bound_indirect_ps(p: indirect_varyings){raster_bound_indirect.indirect_scene} -> raster_bound_indirect.indirect_target:
    return { radiance = raster_bound_indirect.indirect(int2(p.position.x as int, p.position.y as int)) }

/// The reflection traced where the screen lost or missed its own, at half the image's size.
@pixel fun bound_reflection_trace_ps(p: indirect_varyings){raster_bound_indirect.indirect_scene, raster_bound_indirect.reflection_trace_source} -> raster_bound_indirect.traced_reflection_target:
    return raster_bound_indirect.traced_reflection(int2(p.position.x as int, p.position.y as int))

/// The traced radiance averaged into last frame's.
@pixel fun bound_indirect_accumulate_ps(p: indirect_varyings){raster_bound_indirect.indirect_accumulate_source} -> raster_bound_indirect.indirect_history_target:
    return raster_bound_indirect.indirect_accumulated(int2(p.position.x as int, p.position.y as int))

/// The accumulated radiance blurred within its surfaces.
@pixel fun bound_indirect_blur_ps(p: indirect_varyings){raster_bound_indirect.indirect_blur_source} -> raster_bound_indirect.indirect_target:
    return { radiance = raster_bound_indirect.indirect_blurred(int2(p.position.x as int, p.position.y as int)) }

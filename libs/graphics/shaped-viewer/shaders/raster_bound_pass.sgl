// The bound raster mode's fixed stages: the vertex stage every material's draw shares, and the environment behind the surfaces.
//
// The pixel stage of a surface is generated per material permutation, spelled `bound`, and compiled at run time.
// No `first_instance`, which WGSL has no builtin for: a draw is one instance, so `@instance_index` is its first one, its row.
// sv::raster_bound_routine builds the pipelines; libs/graphics/shaped-viewer/docs/plans/raster-bound.md is the design.

use raster
use raster_bound
use raster_bound_reflections
use scene

/// One vertex of the draw's row: an indexed draw through the index pool, with the mesh's base vertex, and no vertex buffer.
@vertex fun bound_vs(@vertex_index vertex: int, @instance_index row: int){raster_bound.bound} -> raster_bound.varyings:
    return raster_bound.vertex_of(vertex, row as uint)

/// One corner of the draw's row on a device without `primitive_index`: a draw of three corners a triangle, with no index buffer.
@vertex fun bound_pulled_vs(@vertex_index corner: int, @instance_index row: int){raster_bound.bound} -> raster_bound.varyings:
    return raster_bound.pulled_vertex_of(corner, row as uint)

/// The prepass's pixel stage: which instance the pixel shows, for the passes that need its material.
/// A quadric batch's boxes: 36 vertices a box, one instance a primitive.
/// The draw's vertex range starts at 36 times the batch's row, which is how its row arrives without `first_instance`,
/// a feature WebGPU lacks: `@vertex_index` counts from the range's start on every backend.
@vertex fun bound_quadric_vs(@vertex_index vertex: int, @instance_index primitive: int){raster_bound.bound} -> raster_bound.quadric_varyings:
    return raster_bound.quadric_vertex_of(vertex % 36, (vertex / 36) as uint, primitive as uint)

/// The prepass of a quadric's pixel: the surface its camera ray solves, where it meets one, whatever its material.
@pixel fun bound_quadric_prepass_ps(p: raster_bound.quadric_varyings){raster_bound.bound} -> raster_bound.quadric_prepass_target:
    let hit = raster_bound.quadric_pixel_of(p)
    if not hit.valid => discard
    return raster_bound.quadric_prepass(p, hit)

@pixel fun bound_prepass_ps(p: raster_bound.varyings){raster_bound.bound} -> raster_bound.prepass_target:
    let eye = scene.camera(..raster_bound.bound.frame[0].camera).position
    let mut n = normalize(cross(ddx(p.world), ddy(p.world)))
    if dot(n, eye - p.world) < 0.0:
        n = -n
    return { instance = p.instance + 1u, normal = float4(..n, 0.0) }

/// What the environment pass hands its pixel stage: the position alone, whose pixel is the camera ray.
struct environment_varyings:
    @position position: hpos4

/// Vertices 0, 1 and 2 land at (0,0), (2,0) and (0,2): one triangle covering the target, on the far plane, depth 0 reversed.
@vertex fun bound_environment_vs(@vertex_index vertex: int) -> environment_varyings:
    let t = float2(((vertex << 1) & 2) as float, (vertex & 2) as float)
    let clip = t * float2(2.0, -2.0) + float2(-1.0, 1.0)
    return { position = hpos4(clip.x, clip.y, 0.0, 1.0) }

/// The ambient occlusion at half the image's size, over the prepass's depth; noisy, which `bound_ao_blur_ps` resolves.
@pixel fun bound_ao_ps(p: environment_varyings){raster_bound.bound, raster_bound.ao_source} -> raster_bound.ao_target:
    return { ao = raster_bound.ambient_occlusion(int2(p.position.x as int, p.position.y as int)) }

/// The AO pass's result blended into last frame's, which turns a few samples a frame into many.
@pixel fun bound_ao_accumulate_ps(p: environment_varyings){raster_bound.bound, raster_bound.ao_accumulate_source} -> raster_bound.ao_history_target:
    return { ao = raster_bound.ao_accumulated(int2(p.position.x as int, p.position.y as int)) }

/// The AO pass's result blurred over the 4x4 its noise repeats in, stopping at depth edges.
@pixel fun bound_ao_blur_ps(p: environment_varyings){raster_bound.bound, raster_bound.ao_blur_source} -> raster_bound.ao_resolved_target:
    return { ao = raster_bound.ao_blurred(int2(p.position.x as int, p.position.y as int)) }

/// The environment where no surface was drawn, which the depth test against the far plane decides.
@pixel fun bound_environment_ps(p: environment_varyings){raster_bound.bound} -> raster_bound.targets:
    return raster_bound.environment(float2(p.position.x, p.position.y))

/// The mirror reflection at half the image's size, from last frame's image where the depth shows what it meets.
@pixel fun bound_reflection_ps(p: environment_varyings){raster_bound.bound, raster_bound_reflections.reflection_source} -> raster_bound_reflections.reflection_target:
    return raster_bound_reflections.reflection(int2(p.position.x as int, p.position.y as int))

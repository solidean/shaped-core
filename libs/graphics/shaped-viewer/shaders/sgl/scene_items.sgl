// What the path tracer reads about the scene it traces: one light, one scene item, and the environment a missed ray sees.
//
// `light` and `instance` are byte layouts the host writes, placed as a buffer's element is (EMIT-111): tightly, every value aligned to 4.
module scene

// ---- Lights ---------------------------------------------------------------------------------------------------------

// The path a light takes through the integrator — mirrors `sv::light_path` (scene/light.hh), whose values these are.
const light_path_point = 0u
const light_path_area = 1u
const light_path_distant_point = 2u
const light_path_distant_disc = 3u
/// An emissive instance: a record no `sv::light` makes, which the renderer appends after every analytic light.
/// Its `emission` is an estimate of the instance's radiance, and its `area` an estimate of its world area, both read by selection alone.
/// `tracer.traced.emitters` holds the rest, at the record's index past `frame_constants::emitter_offset`.
const light_path_mesh = 4u

// Bits of `light.flags`, which `sv::light_flag_*` restates, since slib generates no const; 0 is the default for each.
// Written as their values, `1 << 0` to `1 << 3`, since a `const` holds a literal.
const light_flag_two_sided = 1u
const light_flag_visible_to_camera = 2u
const light_flag_casts_no_shadow = 4u
/// `light_path_mesh` only: the `emission` is a stand-in for one no read saw above zero, which the host's selection alone reads.
const light_flag_unseen_emission = 8u

/// One light, tagged by `path` — `tracer.light_record`, which `sv::light_record_of` fills (scene/light.hh), 96 bytes.
///
/// Keep the two in lockstep: this is a byte layout, not a description of one.
/// Units are resolved on the CPU, so `emission` is one canonical quantity per path.
/// That is a point's intensity, an area's radiance per face, a distant point's irradiance, a disc's radiance.
struct light:
    /// point: the source; area: the rect's center
    position: float3
    /// a `light_path_*` value
    path: uint
    /// area: world half-extent spanning the rect's first axis
    u: float3
    /// area: the world area of one face
    area: float
    /// area: world half-extent spanning the rect's second axis
    v: float3
    /// `light_flag_*` bits
    flags: uint
    /// the canonical quantity of the path
    emission: float3
    cone_scale: float
    /// the light's -Z: a rect's front face, a spot's axis, the direction a distant light travels
    normal: float3
    cone_offset: float
    /// distant_disc: 1 - cos of the disc's angular radius, precise for a small disc
    one_minus_cos_angular_radius: float
    /// RESERVED for light linking, read by nothing yet
    link_mask: uint
    /// The probability next-event estimation picks this light, and the cumulative one up to and including it in the table's order.
    /// `sv::pt_light_table::grouped` writes them, half by power and half uniformly over the lights with light to offer; 0 in both is a table that picks uniformly.
    select_pdf: float
    select_cdf: float

/// Whether geometry between `l` and a surface blocks it.
fun light_casts_shadows(l: light) -> bool:
    return (l.flags & light_flag_casts_no_shadow) == 0

/// Whether a camera ray reaching `l` sees it.
fun light_visible_to_camera(l: light) -> bool:
    return (l.flags & light_flag_visible_to_camera) != 0

/// How much of a light survives its cone along a direction making cosine `cos_axis` with the light's axis.
///
/// glTF's falloff, `saturate(cos * scale + offset)^2`, which an unshaped light turns into a constant 1.
/// Both estimators call this, so the density they share and the emission they weight agree on what the cone removed.
fun light_cone(l: light, cos_axis: float) -> float:
    let a = saturate(cos_axis * l.cone_scale + l.cone_offset)
    return a * a

// ---- Scene items ----------------------------------------------------------------------------------------------------

/// How a value of a material is read, the cutout opacity's `instance.opacity_kind` and each emission factor's kind; `sv::material_value_kind` mirrors these.
/// `value_none` reads nothing: the consumer takes its identity value.
/// `value_zero` reads nothing either, and is 0 whatever that identity is.
const value_none = 0u
const value_constant = 1u
const value_attribute = 2u
const value_texture = 3u
const value_zero = 4u

/// What `instance.opacity_offset` and `opacity_uv_offset` name when they are not a parameter-block offset.
const no_offset = 0xffffffffu

/// One scene item, as a hit reads it by its instance id — `tracer.instance_record`, 256 bytes.
/// `gpu_resource_manager::describe_instance` fills the first seven fields, and `view_renderer` the opacity and the placement.
///
/// Keep the two in lockstep: this is a byte layout, not a description of one.
struct instance:
    param_buffer: uint
    param_offset: uint
    /// The central vertex pool for a mesh, its positions at `base_vertex`; a quadric batch's primitives instead.
    vertices: uint
    /// The central index pool, the mesh's indices at `first_index` and relative to `base_vertex`.
    indices: uint
    base_vertex: uint
    first_index: uint
    /// RESERVED for light linking, read by nothing yet
    link_mask: uint

    /// Where the cutout opacity lives in the parameter block and how it is read — `sv::material_opacity` says per field.
    /// `value_none` never cuts out.
    opacity_kind: uint
    opacity_offset: uint
    opacity_uv_offset: uint
    opacity_frequency: uint
    opacity_channel: uint
    opacity_sampler: uint
    opacity_transform: uint
    opacity_cutoff: uint
    /// the index of the permutation the instance shades with in this trace, which a wavefront hit is sorted by
    shade_group: uint
    /// The index of the instance's own record in `tracer.traced.lights`, or `no_offset` where it lights nothing.
    /// A bounce ray that meets an instance with one weighs its emission against next-event estimation.
    emitter: uint

    /// Where the secondary material lives in the parameter block and how each value is read, as an emitter record reads its color.
    /// `sv::material_emission_factor` says per field, and `sv::material_secondary` is the whole.
    /// A hybrid's secondary hit is lit through it, `tracer.instance_base_color` and its neighbors; `value_none` reads each value's default.
    base_kind: uint
    base_offset: uint
    base_uv_offset: uint
    base_frequency: uint
    base_channels: uint
    base_sampler: uint
    base_transform: uint
    rough_kind: uint
    rough_offset: uint
    rough_uv_offset: uint
    rough_frequency: uint
    rough_channels: uint
    rough_sampler: uint
    rough_transform: uint
    metal_kind: uint
    metal_offset: uint
    metal_uv_offset: uint
    metal_frequency: uint
    metal_channels: uint
    metal_sampler: uint
    metal_transform: uint
    spec_kind: uint
    spec_offset: uint
    spec_uv_offset: uint
    spec_frequency: uint
    spec_channels: uint
    spec_sampler: uint
    spec_transform: uint
    /// Where the tangent frame's attribute descriptor sits in the parameter block, or `no_offset` where nothing supplied one per vertex or corner, and its frequency.
    /// A bounce reads its +z as the smooth normal, `tracer.instance_shading_normal`.
    frame_offset: uint
    frame_frequency: uint
    /// 1 where the instance is solid glass, which a hybrid bounce refracts through on its way to what lies beyond, `hybrid.passage_of`; 0 elsewhere.
    /// A pane is never met by a hybrid ray at all, so it is 0.
    glass: uint

    /// The rows of the object-to-world transform the instance is placed by, which a hit stored for later shading needs.
    to_world_x: float4
    to_world_y: float4
    to_world_z: float4

    /// The rows of the transform the instance was placed by last frame, which a raster frame's motion reprojects through;
    /// the current rows where nothing remembers one, or where nothing reads them.
    previous_to_world_x: float4
    previous_to_world_y: float4
    previous_to_world_z: float4

// ---- The environment ------------------------------------------------------------------------------------------------
//
// The view's environment probe: an order-3 real spherical-harmonics radiance function, 16 RGB coefficients, mirroring `sv::background_gpu`.
// Each coefficient is a `float4` whose `xyz` is radiance and whose `w` is unused, and index 0 is the constant (DC) term.
//
// The coefficients are a PARAMETER, `sh: float4[16]`, because a binding belongs to one group and several pipelines evaluate them.
// SGL places no array in a constant block yet, so the tracer declares a `buffer[float4]` of 16 elements, which is `sv::background_gpu` byte for byte.
// A caller copies it into the array before it calls these; every call is inlined, so the copy costs what an array argument would.

// ---- The environment's kinds ----------------------------------------------------------------------------------------
//
// The whole environment, `sv::background_gpu` byte for byte, as the array `env: float4[28]`: the 16 SH lanes, then the dome.
// Lane 16 is the header (x: 1 for a dome, 0 for a probe; y: the lobe count; z: the sine of the elevation the rise starts at;
// w: the backdrop scale), 17 the horizon, 18 the zenith, 19 to 22 each lobe's direction and concentration, 23 to 26 each lobe's
// peak radiance and its share of the samples, and 27's x the gradient's share.
// Every miss, environment sample and MIS weight against the environment goes through the four functions below, whatever its kind.

const two_pi = 6.28318530717958647692
const four_pi = 12.56637061435917295384

/// Whether `env` is an analytic dome rather than an SH probe.
fun environment_is_dome(env: float4[28]) -> bool:
    return env[16].x > 0.5

/// Whether `env` sends nothing from any direction: a probe whose every coefficient is zero, as a scene lit by its own lights alone leaves it.
/// A sampler then has nothing to draw toward, and skips the closure it would weigh the direction by.
fun environment_is_black(env: float4[28]) -> bool:
    if environment_is_dome(env) => return false
    for k in 0 ..< 16:
        if env[k].x != 0.0 or env[k].y != 0.0 or env[k].z != 0.0 => return false
    return true

/// The 16 SH lanes of `env`, as `background_radiance` takes them.
fun environment_sh(env: float4[28]) -> float4[16]:
    let mut sh = float4[16].filled(float4(0.0))
    for k in 0 ..< 16:
        sh[k] = env[k]
    return sh

/// A dome's gradient alone along unit direction `d`: the horizon up to the rise's start, then a smoothstep to the zenith.
fun dome_gradient(env: float4[28], d: float3) -> float3:
    let rise = env[16].z
    let t = saturate((d.y - rise) / max(1.0 - rise, 1e-6))
    return mix(env[17].xyz, env[18].xyz, t * t * (3.0 - 2.0 * t))

/// The density over solid angle of the von Mises-Fisher lobe of concentration `k` about `axis`, at unit direction `d`.
fun vmf_pdf(axis: float3, k: float, d: float3) -> float:
    return k / (two_pi * (1.0 - exp(-2.0 * k))) * exp(k * (dot(d, axis) - 1.0))

/// The radiance `env` sends along unit direction `d`, toward the point it lights.
fun environment_radiance(env: float4[28], d: float3) -> float3:
    if not environment_is_dome(env) => return background_radiance(environment_sh(env), d)
    let count = env[16].y as int
    let mut radiance = dome_gradient(env, d)
    for i in 0 ..< 4:
        if i < count:
            let lobe = env[19 + i]
            radiance += env[23 + i].xyz * exp(lobe.w * (dot(d, lobe.xyz) - 1.0))
    return radiance

/// What a ray that left the camera sees where it meets nothing: a dome's gradient times its backdrop scale, without its lobes, and a probe as it is.
fun environment_backdrop(env: float4[28], d: float3) -> float3:
    if not environment_is_dome(env) => return background_radiance(environment_sh(env), d)
    return dome_gradient(env, d) * env[16].w

/// The density over solid angle `sample_environment_direction` draws unit direction `d` with.
/// A dome's is its mixture's over the whole sphere; a probe's is the uniform hemisphere's, which holds for a direction on the side it was drawn on.
fun environment_pdf(env: float4[28], d: float3) -> float:
    if not environment_is_dome(env) => return 1.0 / two_pi
    let count = env[16].y as int
    let mut pdf = env[27].x / four_pi
    for i in 0 ..< 4:
        if i < count:
            let lobe = env[19 + i]
            pdf += env[23 + i].w * vmf_pdf(lobe.xyz, lobe.w, d)
    return pdf

/// A unit direction drawn from an environment, and the density it was drawn with.
struct environment_direction:
    wi: float3
    pdf: float

/// `local` in the orthonormal frame about the unit normal `n`, `local.z` along it.
fun around(n: float3, local: float3) -> float3:
    let s = if n.z < 0.0 => -1.0 else 1.0
    let a = -1.0 / (s + n.z)
    let b = n.x * n.y * a
    let t = float3(1.0 + s * n.x * n.x * a, s * b, -s * n.x)
    let bt = float3(b, s + n.y * n.y * a, -n.y)
    return t * local.x + bt * local.y + n * local.z

/// A direction drawn from `env` with the three uniform numbers `u`, and its density.
/// A probe draws uniformly over the hemisphere about `n`.
/// A dome picks a lobe or its gradient by their shares, `u.z` choosing, and draws from it: a lobe by its vMF, the gradient uniformly over the sphere.
fun sample_environment_direction(env: float4[28], n: float3, u: float3) -> environment_direction:
    if not environment_is_dome(env):
        let r = sqrt(max(0.0, 1.0 - u.x * u.x))
        let phi = two_pi * u.y
        return environment_direction(around(n, float3(r * cos(phi), r * sin(phi), u.x)), 1.0 / two_pi)

    let count = env[16].y as int
    // The gradient's draw, which a pick of no lobe keeps: uniform over the sphere.
    let z = 1.0 - 2.0 * u.x
    let rz = sqrt(max(0.0, 1.0 - z * z))
    let mut wi = float3(rz * cos(two_pi * u.y), rz * sin(two_pi * u.y), z)
    let mut pick = u.z
    let mut chosen = false
    for i in 0 ..< 4:
        if i < count and not chosen:
            let share = env[23 + i].w
            if pick < share:
                let lobe = env[19 + i]
                let k = lobe.w
                let w = 1.0 + log(u.x + (1.0 - u.x) * exp(-2.0 * k)) / k
                let rw = sqrt(max(0.0, 1.0 - w * w))
                wi = around(lobe.xyz, float3(rw * cos(two_pi * u.y), rw * sin(two_pi * u.y), w))
                chosen = true
            else:
                pick -= share
    return environment_direction(wi, environment_pdf(env, wi))

/// Radiance L(d) = sum_i sh[i] * Y_i(d) from the standard real-SH basis up to order 3.
/// `d` must be a unit direction.
/// Negative lobes are clamped away, since radiance cannot go below zero.
fun background_radiance(sh: float4[16], d: float3) -> float3:
    return max(background_radiance_signed(sh, d), float3(0.0, 0.0, 0.0))

/// `background_radiance` before its clamp: the function `background_irradiance` integrates exactly.
fun background_radiance_signed(sh: float4[16], d: float3) -> float3:
    let x = d.x
    let y = d.y
    let z = d.z

    // Real-SH basis Y_i(d), band by band (l = 0..3): the constants fold in the Condon-Shortley phase.
    let mut y_basis = float[16].filled(0.0)
    y_basis[0] = 0.282095

    y_basis[1] = 0.488603 * y
    y_basis[2] = 0.488603 * z
    y_basis[3] = 0.488603 * x

    y_basis[4] = 1.092548 * x * y
    y_basis[5] = 1.092548 * y * z
    y_basis[6] = 0.315392 * (3.0 * z * z - 1.0)
    y_basis[7] = 1.092548 * x * z
    y_basis[8] = 0.546274 * (x * x - y * y)

    y_basis[9] = 0.590044 * y * (3.0 * x * x - y * y)
    y_basis[10] = 2.890611 * x * y * z
    y_basis[11] = 0.457046 * y * (5.0 * z * z - 1.0)
    y_basis[12] = 0.373176 * z * (5.0 * z * z - 3.0)
    y_basis[13] = 0.457046 * x * (5.0 * z * z - 1.0)
    y_basis[14] = 1.445306 * z * (x * x - y * y)
    y_basis[15] = 0.590044 * x * (x * x - 3.0 * y * y)

    let mut radiance = float3(0.0, 0.0, 0.0)
    for i in 0 ..< 16:
        radiance += sh[i].xyz * y_basis[i]
    return radiance

/// Diffuse irradiance E(n) from the SH environment, via the clamped-cosine convolution.
/// That is Ramamoorthi and Hanrahan, "An Efficient Representation for Irradiance Environment Maps", 2001.
/// Only bands 0..2 contribute, since the cosine kernel's band-3 term vanishes.
/// For the Lambertian exitance, multiply by albedo and divide by pi.
fun background_irradiance(sh: float4[16], n: float3) -> float3:
    // Convolution constants: the clamped-cosine SH coefficients folded with the basis normalization.
    let c1 = 0.429043
    let c2 = 0.511664
    let c3 = 0.743125
    let c4 = 0.886227
    let c5 = 0.247708

    let l00 = sh[0].xyz
    // y
    let l1m1 = sh[1].xyz
    // z
    let l10 = sh[2].xyz
    // x
    let l11 = sh[3].xyz
    // x*y
    let l2m2 = sh[4].xyz
    // y*z
    let l2m1 = sh[5].xyz
    // 3z^2 - 1
    let l20 = sh[6].xyz
    // x*z
    let l21 = sh[7].xyz
    // x^2 - y^2
    let l22 = sh[8].xyz

    let x = n.x
    let y = n.y
    let z = n.z

    // band 0, band 1, then band 2
    return c4 * l00 + 2.0 * c2 * (l11 * x + l1m1 * y + l10 * z) + c1 * l22 * (x * x - y * y) + c3 * l20 * (z * z) - c5 * l20 + 2.0 * c1 * (l2m2 * x * y + l21 * x * z + l2m1 * y * z)

// The camera the primary rays leave from, a pinhole or orthographic, and the projection a reprojection inverts it by.
//
// The camera probe (tests/shaders/camera_probe.sgl) holds the projection to what the primary ray inverts.
module scene

/// A camera's basis, as `sv::camera_record_of` fills `tracer.camera_record`, lane for lane.
///
/// Each `float3` is followed by a scalar, so it fills one 16-byte row of a constant block and the same 16 bytes of a buffer's element.
/// The two unused ones are named pads rather than left to the layout, since this is a byte layout the host writes, not a description of one.
struct camera:
    position: float3
    /// 1 for an orthographic camera, whose rays all run along `forward`; 0 for a pinhole, whose rays all leave `position`
    orthographic: float
    forward: float3
    /// where an orthographic camera's raster depth ends, in meters along `forward`; a pinhole's has no end
    far_plane: float
    /// A pinhole's right * aspect * tan(fov_y / 2); an orthographic camera's right * half the image's width in meters.
    right_scaled: float3
    pad2: float
    /// A pinhole's true_up * tan(fov_y / 2); an orthographic camera's true_up * half the image's height in meters.
    up_scaled: float3
    pad3: float

/// Whether `cam` is orthographic.
fun camera_is_orthographic(cam: camera) -> bool:
    return cam.orthographic > 0.5

/// Where the primary ray through a continuous pixel position over `dim` leaves from: a pinhole's position, or a point on
/// an orthographic camera's image plane.
fun camera_origin(cam: camera, pixel: float2, dim: float2) -> float3:
    if not camera_is_orthographic(cam) => return cam.position
    let ndc = pixel / dim * 2.0 - 1.0
    return cam.position + cam.right_scaled * ndc.x - cam.up_scaled * ndc.y

/// The origin of the primary ray that reaches world point `p`: a pinhole's position, or the point of an orthographic
/// camera's image plane straight behind `p`, so `p` minus it runs along `forward`.
fun camera_eye_of(cam: camera, p: float3) -> float3:
    if not camera_is_orthographic(cam) => return cam.position
    let f = normalize(cam.forward)
    return p - f * dot(p - cam.position, f)

/// The depth a primary hit `view_depth` along `forward` writes as `primary_depth`: 0 at the near plane and 1 at infinity
/// for a pinhole, `1 - near / depth`; 0 at the near plane and 1 at the far one for an orthographic camera, linearly.
fun camera_primary_depth(cam: camera, near: float, view_depth: float) -> float:
    if camera_is_orthographic(cam) => return clamp((view_depth - near) / max(cam.far_plane - near, 1e-6), 0.0, 1.0)
    return max(1.0 - near / view_depth, 0.0)

/// The raster pass's own reversed depth at `view_depth`: one minus `camera_primary_depth`, 1 at the near plane.
/// A pinhole's is `near / depth`, whose float spacing shrinks as fast as it does; an orthographic camera's is linear.
fun camera_reversed_depth(cam: camera, near: float, view_depth: float) -> float:
    if camera_is_orthographic(cam) => return clamp((cam.far_plane - view_depth) / max(cam.far_plane - near, 1e-6), 0.0, 1.0)
    return near / view_depth

/// The primary ray's direction from `camera_origin`, for a continuous pixel position over `dim`.
///
/// `pixel` carries whatever sub-pixel jitter the caller drew, so a pixel's center is its integer coordinate plus 0.5.
/// A pinhole's is unnormalized, because `camera_project` inverts exactly this and the length is the view depth it divides by.
/// An orthographic camera's is `forward` for every pixel.
fun camera_ray_offset(cam: camera, pixel: float2, dim: float2) -> float3:
    if camera_is_orthographic(cam) => return cam.forward
    // [-1, 1], y down
    let ndc = pixel / dim * 2.0 - 1.0
    return cam.forward + cam.right_scaled * ndc.x - cam.up_scaled * ndc.y

/// Where `offset` lands on `cam`'s image, as a continuous pixel position over `dim`.
/// `offset` is a point relative to the camera's position, or a direction for a point at infinity.
///
/// The inverse of `camera_ray_offset` and `camera_origin`, and a reprojection is only as good as that: they describe one camera, so a change to one is a change to all.
/// Behind the camera is reported far off the image, which a reprojection reads as "not visible last frame".
/// An orthographic camera divides by no depth, and a direction, a point at infinity, lands where its offset does.
fun camera_project(cam: camera, offset: float3, dim: float2) -> float2:
    let z = dot(offset, normalize(cam.forward))
    let ndc = float2(dot(offset, cam.right_scaled) / dot(cam.right_scaled, cam.right_scaled), -dot(offset, cam.up_scaled) / dot(cam.up_scaled, cam.up_scaled))
    if camera_is_orthographic(cam) => return (ndc + 1.0) * 0.5 * dim
    if z <= 1e-6 => return float2(-1e6, -1e6)
    return (ndc / z + 1.0) * 0.5 * dim

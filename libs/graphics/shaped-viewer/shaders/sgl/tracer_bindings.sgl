// What the path tracer's ray-tracing stages share: the frame constants, the two binding groups, the payloads and the ray set.
//
// A module rather than the pipeline's own file, because a hit group the host compiles at run time lists the same groups and traces the same rays.
module tracer

use scene

require raytracing_pipeline

// ---- What the host writes ------------------------------------------------------------------------------------------
//
// A struct a binding places in memory is generated into C++ by the module that declares it, and module `scene` declares no binding, so it generates none.
// So the three below restate `scene.camera`, `scene.light` and `scene.instance` field for field, and a reader converts with `scene.light(..record)`.
// TEMPORARY: a module whose structs another module's binding places should generate them, which is slib's host-code generator to grow.

/// `scene.camera` as the frame constants carry it, 64 bytes; the host fills it through `sv::camera_record_of`.
struct camera_record:
    position: float3
    pad0: float
    forward: float3
    pad1: float
    right_scaled: float3
    pad2: float
    up_scaled: float3
    pad3: float

/// `scene.light` as `traced.lights` holds it, 96 bytes; the host fills it through `sv::light_record_of`.
struct light_record:
    position: float3
    path: uint
    u: float3
    area: float
    v: float3
    flags: uint
    emission: float3
    cone_scale: float
    normal: float3
    cone_offset: float
    one_minus_cos_angular_radius: float
    link_mask: uint
    pad0: float2

/// `scene.instance` as `traced.instances` holds it, 32 bytes; the host fills it through `gpu_resource_manager::describe_instance`.
struct instance_record:
    param_buffer: uint
    param_offset: uint
    vertices: uint
    indices: uint
    is_indexed: uint
    link_mask: uint
    padding: uint2

/// The per-frame constants, 256 bytes; the host starts from `sv::default_frame_constants` (rendering/pathtrace_routine.hh).
///
/// A buffer's single element rather than a constant block, which `sv::pt_trace_desc::frame` is created as.
/// Placed as a buffer element is (EMIT-111): tightly, every value aligned to 4, which is why every pad of the C++ struct is named here.
struct frame_constants:
    /// the pinhole camera the primary rays leave from
    camera: camera_record

    // path-tracer controls (accum_frame drives progressive accumulation: 0 restarts, above 0 blends in place)
    samples_per_pixel: int
    max_bounces: int
    rng_seed: uint
    accum_frame: uint

    /// How many lights `traced.lights` holds, and where each path's run starts in it, indexed by the `scene.light_path_*` values.
    light_count: uint
    pad0: uint3
    path_offset: uint4
    path_count: uint4

    /// whether to write the diffuse guides, and how many frames they already average
    write_guides: uint
    guide_frame: uint
    /// whether to write `frame_output` and `guide_motion`, for a temporal denoiser
    write_temporal: uint
    /// whether to write `guide_specular_albedo` and `guide_roughness`, which only some denoisers read
    write_specular_guides: uint

    /// whether to write `frame_diffuse`, `frame_specular` and `guide_hit_distance`, for a split-signal denoiser
    write_split: uint
    /// whether to write `primary_depth`, at the camera's `near_plane`
    write_primary_depth: uint
    near_plane: float
    split_pad: uint

    /// the camera the previous frame of this layer was traced from, which motion vectors reproject into
    previous_camera: camera_record

    /// How many decals `traced.decals` holds.
    decal_count: uint
    /// The angle one pixel spans at the image's center, in radians: a hit's footprint is this times its distance.
    pixel_spread: float
    decal_pad: uint2

    reserved1: float4

/// One decal as `traced.decals` holds it, 96 bytes; the host fills it through `sv::impl::decal_record_of`.
///
/// The rows take a world point (x, y, z, 1) to the drawing's own units and to the projection's depth.
/// That depth is -1 to 1 where the projection reaches.
struct decal_record:
    to_x: float4
    to_y: float4
    to_depth: float4
    /// the drawing's extent in its own units: min in xy, max in zw
    bounds: float4
    /// the unit direction the drawing is projected along, its y axis crossed with its x axis
    direction: float3
    first_shape: uint
    /// the world length of one drawing unit along each axis, which turns a world footprint into the drawing's units
    unit_length: float2
    shape_count: uint
    /// rgba8, sRGB-encoded, straight, red in the low byte
    tint: uint

/// One shape a decal covers, as `traced.decal_shapes` holds it — `sr::slug_instance` laid out for a buffer, 80 bytes; the host fills it through `sv::impl::decal_shape_of`.
struct decal_shape:
    em_to_object: float4
    em_bounds: float4
    banding: float4
    origin: float2
    glyph: uint2
    color: uint
    pad: uint3

/// Every resource the pipeline's stages share — group 0.
///
/// The images' formats are the ones sv allocates them in (view/view_data.cc), and the stand-ins `sv::pathtrace_routine` binds when a target is absent.
binding traced:
    require readwrite_image_formats
    require extended_image_formats

    /// Triangle meshes and quadric batches both: a quadric batch is a BLAS of boxes, which its hit group's intersection decides.
    world: acceleration_structure[.mixed]

    /// The view's accumulator: the running mean of every sample this estimate has drawn, read back and blended into at the dispatch's own pixel.
    output: mut image_2d[.rgba32_float]

    /// One element, the frame constants.
    frame: buffer[frame_constants]

    /// The per-item table, indexed by a hit's instance id.
    instances: buffer[instance_record]

    /// The environment's 16 SH coefficients, `sv::background_gpu` byte for byte.
    background: buffer[float4]

    /// The primary hit's facing normal, linear view depth and diffuse albedo, as running means, written while `frame.write_guides` is set.
    guide_normal: mut image_2d[.rgba16_float]
    guide_depth: mut image_2d[.r32_float]
    guide_albedo: mut image_2d[.rgba16_float]

    /// The specular half of the guides, written while `frame.write_specular_guides` is set.
    guide_specular_albedo: mut image_2d[.rgba16_float]
    guide_roughness: mut image_2d[.r16_float]

    /// This frame's samples alone, and where each pixel's primary hit sat on the previous frame's screen, written while `frame.write_temporal` is set.
    frame_output: out image_2d[.rgba16_float]
    guide_motion: out image_2d[.rg32_float]

    /// This frame's samples split into their diffuse and specular halves, and the first secondary hit distance of each, written while `frame.write_split` is set.
    frame_diffuse: out image_2d[.rgba16_float]
    frame_specular: out image_2d[.rgba16_float]
    guide_hit_distance: out image_2d[.rg32_float]

    /// Every light the trace samples, grouped by path — what `sv::pt_light_table` builds.
    lights: buffer[light_record]

    /// The clip-space depth of the first primary hit per pixel, 1 where it escaped, written while `frame.write_primary_depth` is set.
    primary_depth: out image_2d[.r32_float]

    /// The decals every hit is painted with, `frame.decal_count` of them, and the shapes they cover in the atlas bound as `slug.tables`.
    decals: buffer[decal_record]
    decal_shapes: buffer[decal_shape]

    // ---- The material sampler palette ----------------------------------------------------------------------------------
    //
    // Every texture a material samples goes through one of these, picked per texture by `sv::sgl_palette_sampler` (material/shader_generator.hh).
    // One per magnification filter and address mode of each axis: a hit samples level 0 explicitly, where only the magnification filter decides.
    // So the minification and mip filters, the third axis and the level clamps of an `sg::sampler` do not reach the palette; the generator's header says so at length.

    sampler palette_nearest_repeat_repeat:
        filter = .nearest
        address_u = .repeat
        address_v = .repeat
    sampler palette_nearest_repeat_mirror:
        filter = .nearest
        address_u = .repeat
        address_v = .mirror_repeat
    sampler palette_nearest_repeat_clamp:
        filter = .nearest
        address_u = .repeat
        address_v = .clamp_edge
    sampler palette_nearest_mirror_repeat:
        filter = .nearest
        address_u = .mirror_repeat
        address_v = .repeat
    sampler palette_nearest_mirror_mirror:
        filter = .nearest
        address_u = .mirror_repeat
        address_v = .mirror_repeat
    sampler palette_nearest_mirror_clamp:
        filter = .nearest
        address_u = .mirror_repeat
        address_v = .clamp_edge
    sampler palette_nearest_clamp_repeat:
        filter = .nearest
        address_u = .clamp_edge
        address_v = .repeat
    sampler palette_nearest_clamp_mirror:
        filter = .nearest
        address_u = .clamp_edge
        address_v = .mirror_repeat
    sampler palette_nearest_clamp_clamp:
        filter = .nearest
        address_u = .clamp_edge
        address_v = .clamp_edge
    sampler palette_linear_repeat_repeat:
        filter = .linear
        address_u = .repeat
        address_v = .repeat
    sampler palette_linear_repeat_mirror:
        filter = .linear
        address_u = .repeat
        address_v = .mirror_repeat
    sampler palette_linear_repeat_clamp:
        filter = .linear
        address_u = .repeat
        address_v = .clamp_edge
    sampler palette_linear_mirror_repeat:
        filter = .linear
        address_u = .mirror_repeat
        address_v = .repeat
    sampler palette_linear_mirror_mirror:
        filter = .linear
        address_u = .mirror_repeat
        address_v = .mirror_repeat
    sampler palette_linear_mirror_clamp:
        filter = .linear
        address_u = .mirror_repeat
        address_v = .clamp_edge
    sampler palette_linear_clamp_repeat:
        filter = .linear
        address_u = .clamp_edge
        address_v = .repeat
    sampler palette_linear_clamp_mirror:
        filter = .linear
        address_u = .clamp_edge
        address_v = .mirror_repeat
    sampler palette_linear_clamp_clamp:
        filter = .linear
        address_u = .clamp_edge
        address_v = .clamp_edge

/// The manager's bindless tables — group 1, which the host binds as the manager's own group.
///
/// This is THE declaration of them: `sv::gpu_resource_manager` lays its staging group out from this binding's reflection (resources/bindless_tables.hh).
/// So a table's size is changed here, and the order must stay `sv::bindless_table`'s, which the host asserts.
binding bindless:
    require binding_arrays

    textures_1d: texture_1d[float4][64]
    textures_1d_array: texture_1d_array[float4][32]
    textures_2d: texture_2d[float4][4096]
    textures_2d_array: texture_2d_array[float4][256]
    textures_cube: texture_cube[float4][64]
    textures_cube_array: texture_cube_array[float4][16]
    textures_3d: texture_3d[float4][128]

    /// Raw buffers: vertices, indices, attributes and parameter blocks, which a hit reads through `scene.instance`.
    buffers: bytes[4096]

/// One path segment, in and out.
///
/// The closest hit does the shading, so the payload carries the segment's RESULT rather than its surface.
/// `rng`, the medium and `channel` round-trip: the caller writes what the current segment travels in, and the hit what the continuation will.
/// Every result field is written by both the closest hit and the miss, so the caller reads them all unconditionally and branches on `hit_t`.
struct surface_payload:
    rng: uint

    /// the medium the ray travels through; zero extinction is vacuum
    medium_sigma_t: float3
    medium_albedo: float3
    medium_g: float

    /// which wavelength the path has been collapsed onto, or 3 while it still carries all three
    channel: uint

    /// whether this is the path's last surface hit, so no bounce ray follows it — written by the caller only
    last_bounce: uint

    /// the next-event estimate at this hit, BSDF folded in, split the way `bsdf_eval_split` splits the closure
    direct_diffuse: float3
    direct_specular: float3
    /// the surface's own emission, or the sky on a miss
    emission: float3
    /// f * cos / pdf for the sampled continuation
    throughput: float3
    /// where the path goes next
    direction: float3
    /// the geometric normal turned to face the ray, for the offset off the surface
    normal: float3
    /// diffuse reflectance here, for the denoiser's guide
    albedo: float3
    /// normal-incidence specular reflectance (F0), for the specular guide
    specular_albedo: float3
    /// perceptual roughness of the sharpest specular lobe
    roughness: float

    /// which lobe the continuation was drawn from, one of `openpbr.bsdf_lobe_*`
    lobe: uint

    /// the pdf of `direction`, for the escaped-environment MIS weight
    bsdf_pdf: float
    /// below 0 where the ray escaped
    hit_t: float

/// A shadow ray reads only visibility: the caller seeds `visible` with 0, and the shadow miss sets it to 1.
struct shadow_payload:
    visible: float

/// The tracer's two rays, in the order their miss shaders and hit records stand.
rays path_rays:
    surface: surface_payload
    occlusion: shadow_payload

/// The payload the caller hands a surface ray, with every result zeroed until the miss or the closest hit writes it.
fun surface_payload_for(rng: uint, sigma_t: float3, albedo: float3, g: float, channel: uint, last_bounce: uint) -> surface_payload:
    let zero = float3(0.0)
    return surface_payload(rng, sigma_t, albedo, g, channel, last_bounce, zero, zero, zero, zero, zero, zero, zero, zero, 0.0, 0u, 0.0, 0.0)

/// The 16 SH coefficients of the environment, copied out of their buffer into the array `scene.background_radiance` takes.
fun background_sh(){traced} -> float4[16]:
    let mut sh = float4[16].filled(float4(0.0))
    for k in 0 ..< 16:
        sh[k] = traced.background[k]
    return sh

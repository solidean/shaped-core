// The hybrid's LIGHTING: a primary hit the raster found, lit by the tracer's own next-event estimate with its shadow rays traced inline, and one bounce.
//
// Two callers, measured against each other.
// A material's forward pixel stage, `sv_hybrid`, lights its full closure where it evaluated it.
// The deferred kernel `light_thin` (hybrid_pass.sgl) lights the closure the thin G-buffer reduced it to.
// Both list `tracer.traced` as group 0: it holds the TLAS, the lights, the emitters, the instance table and the decals, which `raster.drawn` cannot.
// libs/graphics/shaped-viewer/docs/plans/hybrid-renderer.md is the design.
module hybrid

use material
use openpbr
use pt
use raster
use scene
use slug
use tracer

/// What a hybrid stage takes beside `tracer.traced`, whose frame block carries no image size.
@inline binding pass:
    /// the image's size in pixels
    size: float2
    pad: float2

/// How far this frame's samples sit from the pixels' centers, in pixels, as `raster.frame_constants::jitter` says.
fun jitter_of(f: tracer.frame_constants) -> float2:
    let offset = if f.fixed_jitter != 0u => f.jitter - float2(0.5, 0.5) else float2(0.0)
    return offset

/// The random stream of pixel `px` this frame, seeded as the megakernel seeds its primary ray's.
fun pixel_rng(px: uint2, width: uint){tracer.traced} -> uint:
    return pt.hash(px.x + px.y * width + tracer.traced.frame[0].rng_seed * 9781u)

/// Direct light at `p` through the closure `b` in frame `f`, over the face whose turned geometric normal is `n`.
///
/// One light the tracer's selection picks and one environment sample, each with its shadow ray traced inline: an unbiased estimate of every light at once.
/// Where `continues`, a `bounce_from` follows, and both samples weigh against it, which reaches the same lights and sky.
/// Nothing where the viewer is behind the shading frame, which `shading_frame` leaves only a degenerate input to.
fun direct(b: openpbr.bsdf, f: openpbr.frame, n: float3, wo_local: float3, p: float3, continues: bool, rng: mut uint){tracer.traced, tracer.bindless} -> float3:
    if wo_local.z <= 0.0 => return float3(0.0)
    let mut sum = float3(0.0)
    let l = tracer.sample_light(b, f, wo_local, p, n, not continues, mut rng)
    if tracer.reaches(l, tracer.cutout_seed(rng, tracer.cutout_ray_light)):
        sum += l.diffuse + l.specular
    let e = tracer.sample_environment(b, f, wo_local, p, n, not continues, mut rng)
    if tracer.reaches(e, tracer.cutout_seed(rng, tracer.cutout_ray_environment)):
        sum += e.diffuse + e.specular
    return sum

/// Where one bounce from a primary hit went: what it carries there, and either the environment it escaped into or the surface it met.
struct bounce:
    /// the BSDF and the cosine over the pdf the direction was drawn with; zero where no bounce was drawn
    throughput: float3
    /// the environment along an escape, weighed against `direct`'s environment sample; zero where it met a surface
    escaped: float3
    /// the lights the bounce reached before what it met, each weighed against `direct`'s light sample
    lights: float3
    /// whether it met a surface, which `at`, `n` and `albedo` then describe
    hit: bool
    at: float3
    /// the met face's normal, turned toward where the bounce came from
    n: float3
    /// the direction the bounce left in
    wi: float3
    /// the met instance's base color, `tracer.instance_base_color`; mid-gray on a quadric, which has no triangle context to read it through
    albedo: float3
    /// its specular roughness, or -1 for none, which leaves it matte; and its metalness
    roughness: float
    metalness: float

/// One bounce from `p`: a direction drawn from the closure `b`, traced inline to what it meets.
/// Only a reflection continues: a refracted direction would have to follow the ray through the surface, which nothing here does yet.
fun bounce_from(b: openpbr.bsdf, f: openpbr.frame, n: float3, wo_local: float3, p: float3, rng: mut uint){tracer.traced, tracer.bindless} -> bounce:
    let mut result = bounce(float3(0.0), float3(0.0), float3(0.0), false, float3(0.0), float3(0.0, 1.0, 0.0), float3(0.0, 0.0, 1.0), float3(0.5), -1.0, 0.0)
    let u = float3(pt.rand(mut rng), pt.rand(mut rng), pt.rand(mut rng))
    let s = openpbr.bsdf_sample_direction(b, wo_local, u)
    if s.pdf <= 0.0 or s.direction.z <= 0.0 or not s.valid => return result
    let wi = openpbr.to_world(f, s.direction)
    if dot(wi, n) <= 0.0 => return result
    result.throughput = s.value * (s.direction.z / s.pdf)
    result.wi = wi

    let origin = p + n * 1e-3
    let h = tracer.trace_hit(origin, wi, tracer.cutout_seed(rng, tracer.cutout_ray_surface))
    result.lights = lights_along(origin, wi, h.t, s.pdf)
    if h.kind == tracer.hit_none:
        result.escaped = scene.background_radiance(tracer.background_sh(), wi) * pt.mis_weight(s.pdf, pt.env_pdf())
        return result

    let inst = scene.instance(..tracer.traced.instances[h.instance as int])
    result.hit = true
    result.at = origin + wi * h.t
    if h.kind == tracer.hit_triangle:
        let indices = inst.indices as int
        let ctx = material.make_context(inst, tracer.bindless.buffers[nonuniform indices], h.primitive, h.barycentrics)
        let w0 = raster.to_world_point(inst, tracer.instance_position(inst, ctx.corner.x))
        let w1 = raster.to_world_point(inst, tracer.instance_position(inst, ctx.corner.y))
        let w2 = raster.to_world_point(inst, tracer.instance_position(inst, ctx.corner.z))
        result.n = normalize(cross(w1 - w0, w2 - w0))
        result.albedo = tracer.instance_base_color(inst, ctx)
        result.roughness = tracer.instance_roughness(inst, ctx)
        result.metalness = tracer.instance_metalness(inst, ctx)
        result.lights += emitter_light(inst, ctx, w1 - w0, w2 - w0, wi, h.t, s.pdf)
    else:
        result.n = normalize(raster.to_world_vector(inst, h.normal))
    if dot(result.n, wi) > 0.0 => result.n = -result.n
    return result

/// The analytic lights a bounce from `origin` along `wi` reaches, drawn at `bsdf_pdf`: the rects it crosses before `hit_t`, and on an escape, a negative `hit_t`, the discs it points into.
/// Each is weighed against `direct`'s light sample, which draws the same direction at the light's own density.
/// A light that casts no shadow is reached through anything, as its sample is.
fun lights_along(origin: float3, wi: float3, hit_t: float, bsdf_pdf: float){tracer.traced} -> float3:
    let f = tracer.traced.frame[0]
    let mut sum = float3(0.0)
    let begin_area = f.path_offset.y
    for i in (begin_area as int) ..< ((begin_area + f.path_count.y) as int):
        let l = scene.light(..tracer.traced.lights[i])
        let mut t_light = 0.0
        let mut cos_light = 0.0
        if not pt.rect_intersect(l, origin, wi, mut t_light, mut cos_light) => continue
        if hit_t >= 0.0 and t_light >= hit_t and scene.light_casts_shadows(l) => continue
        let w = pt.mis_weight(bsdf_pdf, pt.light_pdf(l, f.light_count, t_light * t_light, cos_light))
        sum += l.emission * scene.light_cone(l, cos_light) * w
    let begin_disc = f.path_offset.w
    for i in (begin_disc as int) ..< ((begin_disc + f.path_count.w) as int):
        let l = scene.light(..tracer.traced.lights[i])
        if not pt.in_disc(l, wi) => continue
        if hit_t >= 0.0 and scene.light_casts_shadows(l) => continue
        sum += l.emission * pt.mis_weight(bsdf_pdf, pt.disc_pdf(l, f.light_count))
    return sum

/// What an emissive instance `inst` sends back along a bounce that met it at `ctx`, `t` along the unit direction `wi`.
/// `edge1` and `edge2` are the met triangle's world edges from its first corner.
/// Weighed against `direct`'s light sample where the trace's light table holds the instance, and nothing where it does not, since then its light reaches the camera alone.
fun emitter_light(inst: scene.instance, ctx: material.shading_context, edge1: float3, edge2: float3, wi: float3, t: float, bsdf_pdf: float){tracer.traced, tracer.bindless} -> float3:
    if inst.emitter == scene.no_offset => return float3(0.0)
    let e = tracer.traced.emitters[(inst.emitter - tracer.traced.frame[0].emitter_offset) as int]
    let light_pdf = tracer.emitter_pdf(inst, ctx.primitive, edge1, edge2, wi, t)
    let w = if light_pdf > 0.0 => pt.mis_weight(bsdf_pdf, light_pdf) else 1.0
    return tracer.emitter_radiance(e, ctx) * w

/// The surface a bounce met, as `direct` lights it: a closure of its base color, roughness and metalness, its frame, and the direction back along the bounce.
/// That is the secondary material the plan reads from data rather than from the material's code, so no permutation's code runs past the primary hit.
struct secondary:
    b: openpbr.bsdf
    f: openpbr.frame
    /// the direction back along the bounce in `f`; below it where the bounce met nothing, which `direct` then lights as nothing
    wo_local: float3

/// What `direct` lights where `bounced` landed.
///
/// A caller lights the primary hit and this side by side, `direct` for each, rather than one inside the other.
/// Every call is inlined and the nesting has a limit, which a generated pixel stage around them sits close to.
fun secondary_of(bounced: bounce) -> secondary:
    let mut surface = openpbr.default_surface()
    surface.base_color = bounced.albedo
    surface.base_metalness = bounced.metalness
    // A type that names no roughness keeps the matte secondary it always had.
    surface.specular_weight = if bounced.roughness < 0.0 => 0.0 else 1.0
    surface.specular_roughness = max(bounced.roughness, 0.0)
    let f = openpbr.make_frame(bounced.n)
    let wo_local = if bounced.hit => openpbr.to_local(f, -bounced.wi) else float3(0.0, 0.0, -1.0)
    return { b = openpbr.bsdf_prepare(surface, false, 3u), f = f, wo_local = wo_local }

/// `raster.vertex_of`, reading the frame and the instance table of `tracer.traced`, and the image's size from `pass`.
fun vertex_of(vertex: int, instance: uint){tracer.traced, tracer.bindless, pass} -> raster.varyings:
    let f = tracer.traced.frame[0]
    let inst = scene.instance(..tracer.traced.instances[instance as int])
    return raster.vertex_from(inst, instance, vertex, scene.camera(..f.camera), f.near_plane, raster.jitter_shift(jitter_of(f), pass.size))

/// `raster.pixel_context`, reading the instance table of `tracer.traced`.
fun pixel_context(p: raster.varyings, primitive: uint){tracer.traced, tracer.bindless} -> material.shading_context:
    return raster.context_from(scene.instance(..tracer.traced.instances[p.instance as int]), p, primitive)

/// `raster.is_cut`, reading the instance table of `tracer.traced`.
fun is_cut(p: raster.varyings, ctx: material.shading_context){tracer.traced, tracer.bindless} -> bool:
    let inst = scene.instance(..tracer.traced.instances[p.instance as int])
    return tracer.instance_opacity(inst, ctx) < 0.5

/// The forward lighting: the pixel `p` covers, whose material evaluated to `surface_in`, lit through its full closure by `direct` and one bounce.
///
/// The surface is described as `raster.shade` describes it, and the targets are the same.
/// Baked occlusion is not applied, since the environment's light is shadowed by its own ray here.
fun shade(p: raster.varyings, ctx: material.shading_context, surface_in: openpbr.surface, supplied_tangent_frame: bool){tracer.traced, tracer.bindless, slug.tables, pass} -> raster.targets:
    let f = tracer.traced.frame[0]
    let cam = scene.camera(..f.camera)
    let inst = scene.instance(..tracer.traced.instances[p.instance as int])
    let face = raster.face_of(inst, ctx, p.world, cam.position, surface_in, supplied_tangent_frame)
    let v = normalize(cam.position - p.world)
    let to_point = p.world - cam.position
    let view_depth = dot(to_point, normalize(cam.forward))

    let mut surface = surface_in
    tracer.apply_decals(mut surface, p.world, face.n, f.pixel_spread * length(to_point))
    let shading = openpbr.shading_frame(mut surface, face.n, v, face.authored, supplied_tangent_frame)
    let b = openpbr.bsdf_prepare(surface, face.exiting, 3u)
    let wo_local = openpbr.to_local(shading, v)

    let pixel = float2(p.position.x, p.position.y)
    let mut rng = pixel_rng(uint2(pixel.x as uint, pixel.y as uint), pass.size.x as uint)
    let lit = direct(b, shading, face.n, wo_local, p.world, true, mut rng)
    let bounced = bounce_from(b, shading, face.n, wo_local, p.world, mut rng)
    let s2 = secondary_of(bounced)
    let bounce_lit = direct(s2.b, s2.f, bounced.n, s2.wo_local, bounced.at, false, mut rng)
    let color = b.emission + lit + bounced.throughput * (bounced.escaped + bounced.lights + bounce_lit)

    let prev = scene.camera(..f.previous_camera)
    let motion = pixel + jitter_of(f) - scene.camera_project(prev, p.world - prev.position, pass.size)
    return raster.lit_targets(color, face.n, view_depth, surface, motion, f.near_plane)

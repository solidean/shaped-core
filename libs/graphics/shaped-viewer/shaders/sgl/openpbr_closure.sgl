// The OpenPBR closure's vocabulary: the surface a material describes, the lobes `bsdf_prepare` makes of it, and the
// layer couplings between them.
//
// The SGL port of shaders/openpbr.hlsli and shaders/bsdf_lobe.hlsli; openpbr_microfacet.sgl says what the model is.
module openpbr

// ---- Lobes ----------------------------------------------------------------------------------------------------------
//
// Which lobe of the closure a path took, and the one rule that says whether that makes it specular.
// The closest-hit names the lobe its continuation was drawn from, and the raygen reads that name to decide which denoiser signal the rest of the path belongs to.

/// Which lobe a sample was drawn from, so a caller can tell a sharp bounce from a matte one.
///
/// `bsdf_lobe_diffuse` and `bsdf_lobe_subsurface` belong to the diffuse half of `bsdf_eval_split`.
/// Everything else is specular, glass included, for the reason that function gives.
/// `bsdf_lobe_subsurface` is a refraction into a subsurface interior, and only one that crossed.
/// The transmission slice reports `bsdf_lobe_transmission` for glass and for a total internal reflection.
/// The lobes are `int`s where the HLSL closure's are `uint`s, since a `const` holds an `int` or a `float`.
const bsdf_lobe_fuzz = 0
const bsdf_lobe_coat = 1
const bsdf_lobe_metal = 2
const bsdf_lobe_spec = 3
const bsdf_lobe_diffuse = 4
const bsdf_lobe_transmission = 5
const bsdf_lobe_subsurface = 6

/// Whether a drawn lobe belongs to the specular half, which is every lobe but the diffuse substrate and the subsurface.
/// The one rule, in one place, so the sampler and the evaluator cannot disagree about what a path is.
fun bsdf_lobe_is_specular(lobe: int) -> bool => lobe != bsdf_lobe_diffuse and lobe != bsdf_lobe_subsurface

// ---- The prepared closure -------------------------------------------------------------------------------------------

/// One surface's lobes in the local frame, with everything independent of `wi` already folded in.
///
/// Preparing once per hit is what stops the three calls a path vertex makes from rebuilding the layer coupling three times over.
/// Those are sample, evaluate for next-event estimation, and pdf for the multiple-importance weight.
struct bsdf:
    diffuse_albedo: float3
    diffuse_roughness: float

    metal_f0: float3
    metal_tint: float3
    metal_alpha: float2

    spec_f0: float3
    spec_alpha: float2
    spec_weight: float

    /// The transparent base, which replaces the diffuse substrate under the same interface by `trans_weight`.
    ///
    /// `trans_eta` is the index on the far side of that interface over the index on this one.
    /// So it is the reciprocal on the way out, which is why `bsdf_prepare` has to be told which side it is on.
    /// `trans_tint` is what the crossing costs: `transmission_color` when the depth is 0 or the wall is thin, and white when a medium is doing the absorbing instead.
    trans_weight: float
    trans_tint: float3
    trans_eta: float
    thin_walled: float

    /// The interior the transparent base refracts into, which the INTEGRATOR walks rather than the closure.
    ///
    /// `sigma_t` is extinction per unit length and `albedo` the fraction of it that scatters rather than absorbs.
    /// So an albedo of 0 is the pure Beer-Lambert interior `transmission_depth` describes, and anything above it is a random walk.
    /// Zero extinction is vacuum, which is every surface that does not transmit.
    medium_sigma_t: float3
    medium_albedo: float3
    medium_g: float

    /// The subsurface interior, and how much of the OPAQUE base is it rather than the diffuse substrate.
    /// A separate medium because the two are chosen between per sample: they refract through the same interface and differ only in what lies beyond it.
    sss_weight: float
    sss_sigma_t: float3
    sss_albedo: float3
    sss_g: float

    coat_f0: float
    coat_alpha: float2

    /// The coat's own frame, in the closure's local coordinates — its normal plus a tangent carried over from the base's.
    ///
    /// Identity when the coat shares the base's normal, which is the overwhelmingly common case and the one every cosine below is written for.
    coat_n: float3
    coat_t: float3
    coat_b: float3
    coat_tint: float3
    coat_weight: float
    coat_darkening: float

    fuzz_color: float3
    fuzz_alpha: float
    fuzz_weight: float

    metalness: float

    thin_film_weight: float
    thin_film_thickness: float
    thin_film_ior: float

    emission: float3

/// How likely each lobe is to be picked for one outgoing direction, in the order the evaluator sums them.
/// The six always add to 1: `bsdf_lobe_probs` normalizes, and falls back to the diffuse lobe when every weight is zero.
struct lobe_probs:
    fuzz: float
    coat: float
    metal: float
    spec: float
    diffuse: float
    transmission: float

/// The continuation entered no interior, so the caller keeps whatever the incoming segment was already traveling through.
const medium_none = 0
const medium_transmission = 1
const medium_subsurface = 2

/// What one sampled direction carries back: the direction itself, the BSDF value there, and the pdf that produced it.
/// `pdf` is the FULL closure pdf rather than the chosen lobe's, so a caller can weight it against a light sampler directly.
/// The defaults are an invalid sample, which is what a branch that fails returns.
struct bsdf_sample:
    /// may point BELOW the surface, which is a refraction rather than a failure
    direction: float3 = float3(0.0, 0.0, 1.0)
    /// the BSDF at (wo, direction), cosine NOT folded in
    value: float3 = float3(0.0)
    pdf: float = 0.0
    /// false when the direction grazed the surface, total internal reflection ended it, or the pdf collapsed
    valid: bool = false

    /// Which lobe drew it — one of the `bsdf_lobe_*` constants above.
    /// Meaningful only when `valid`: a branch names its lobe before it can fail, so an invalid sample reports whichever lobe was being drawn from.
    lobe: int = bsdf_lobe_diffuse

    /// Which interior the direction crossed into: `medium_none`, `medium_transmission` or `medium_subsurface`.
    ///
    /// The two refracting bases share one lobe, so this is the only thing that says which of them a sample belongs to.
    /// The integrator needs it, because what happens beyond the interface is entirely a property of the medium.
    ///
    /// On a solid, `medium_none` requires `direction.z > 0`, because a direction crossing the interface always enters one of the two interiors.
    /// A thin wall is the exception and the only one: it encloses nothing, so it transmits and still reports `medium_none`, with a direction below the surface.
    /// `probe_medium` asserts both halves, which is what catches a reflective lobe leaking a below-horizon direction.
    medium: int = medium_none

/// The perceptual-to-microfacet roughness mapping OpenPBR specifies, floored so no lobe becomes a delta.
///
/// `anisotropy` stretches the lobe along the frame's tangent and squeezes it along the bitangent.
/// The pair is scaled so the two together cover about the solid angle the isotropic lobe did.
/// That keeps turning anisotropy up from also making the surface look rougher.
/// 0 is isotropic and 1 is as stretched as the model goes.
fun alpha_of(roughness: float, anisotropy: float) -> float2:
    let r = saturate(roughness)
    let a = max(min_alpha, r * r)

    let t = 1.0 - saturate(anisotropy)
    let ax = a * sqrt(2.0 / (1.0 + t * t))
    return float2(max(min_alpha, ax), max(min_alpha, t * ax))

/// The scalar a lobe's selection probability is ranked by; the closure only needs relative magnitudes, never a color.
fun luminance(c: float3) -> float:
    return dot(c, float3(0.2126, 0.7152, 0.0722))

/// The average Fresnel reflectance of a Schlick lobe over the hemisphere.
fun fresnel_average(f0: float) -> float:
    return (1.0 + 20.0 * f0) / 21.0

/// One surface point in OpenPBR's parameter vocabulary, prepared into lobes by `bsdf_prepare`.
///
/// This is the subset the viewer models, and the names are the specification's.
/// Transmission and subsurface are absent rather than defaulted, so a material cannot ask for one and silently get something else.
/// The field defaults are OpenPBR's own, so `surface()` is the specification's default surface rather than an arbitrary gray.
///
/// `geometry_normal` is TANGENT space, so (0, 0, 1) is the shading normal the hit already has.
struct surface:
    // base
    base_weight: float = 1.0
    base_color: float3 = float3(0.8, 0.8, 0.8)
    base_metalness: float = 0.0
    base_diffuse_roughness: float = 0.0

    // specular
    specular_weight: float = 1.0
    specular_color: float3 = float3(1.0)
    specular_roughness: float = 0.3
    specular_roughness_anisotropy: float = 0.0
    specular_ior: float = 1.5

    // transmission
    transmission_weight: float = 0.0
    transmission_color: float3 = float3(1.0)
    /// the distance `transmission_color` is the color AT; 0 tints the interface instead
    transmission_depth: float = 0.0

    /// What the interior SCATTERS, as a coefficient per unit of `transmission_depth`.
    ///
    /// Black is clear glass: the interior only absorbs, and a ray crosses it in a straight line.
    /// Anything above it makes the interior milky, and light spreads sideways through it the way it does through jade or a thick liquid.
    /// It needs a positive `transmission_depth` to mean anything: at 0 there is no volume for it to happen in.
    transmission_scatter: float3 = float3(0.0)

    /// The Henyey-Greenstein g for that scattering: forward at +1, back at -1, isotropic at 0.
    transmission_scatter_anisotropy: float = 0.0

    /// How far apart the wavelengths are bent, as a multiple of what `transmission_dispersion_abbe_number` implies.
    /// 0 is no dispersion at all, which is what keeps a path from being collapsed onto one wavelength for nothing.
    transmission_dispersion_scale: float = 0.0

    /// The Abbe number: how little a real glass disperses, so SMALLER means more.
    /// Around 64 for crown glass and 30 for flint; 0 is treated as no dispersion.
    transmission_dispersion_abbe_number: float = 20.0

    // subsurface
    subsurface_weight: float = 0.0
    /// the albedo the random walk is inverted to reproduce
    subsurface_color: float3 = float3(0.8, 0.8, 0.8)
    /// the mean free path per channel, before `subsurface_radius_scale`
    subsurface_radius: float3 = float3(1.0, 0.5, 0.25)
    subsurface_radius_scale: float = 0.1
    /// the Henyey-Greenstein g: forward at +1, back at -1, isotropic at 0
    subsurface_scatter_anisotropy: float = 0.0

    // coat
    coat_weight: float = 0.0
    coat_color: float3 = float3(1.0)
    coat_roughness: float = 0.0
    coat_roughness_anisotropy: float = 0.0
    coat_ior: float = 1.6
    coat_darkening: float = 1.0

    // fuzz
    fuzz_weight: float = 0.0
    fuzz_color: float3 = float3(1.0)
    fuzz_roughness: float = 0.5

    // thin film
    thin_film_weight: float = 0.0
    /// nanometers
    thin_film_thickness: float = 500.0
    thin_film_ior: float = 1.4

    // emission
    emission_luminance: float = 0.0
    emission_color: float3 = float3(1.0)

    // geometry

    /// whether the surface is a shell with no interior — a leaf, a bubble, a pane
    ///
    /// A thin wall does not refract and encloses no medium.
    /// So light passes straight through and `transmission_color` tints it at the crossing whatever `transmission_depth` says.
    /// Nonzero is thin-walled; the parameter is a float because the generated parameter block carries no bools.
    geometry_thin_walled: float = 0.0

    geometry_normal: float3 = float3(0.0, 0.0, 1.0)

    /// the coat's own shading normal, expressed in the frame the closure works in
    ///
    /// (0, 0, 1) means the coat shares the base's normal, which is what an unbound coat normal must come out as.
    /// So the hit carries an authored one through the base's normal map first, rather than handing it over in the authored tangent space the base's `geometry_normal` is written in.
    /// A coat with its own bumps over a smooth base is the case this exists for.
    geometry_coat_normal: float3 = float3(0.0, 0.0, 1.0)
    geometry_opacity: float = 1.0

    /// the surface's tangent frame as a unit quaternion, taking tangent space to OBJECT space
    ///
    /// Tangent space is +x tangent, +y bitangent, +z normal, so the identity rotation is object-space +z — a frame belonging to no particular surface.
    /// That is why the hit consults whether the frame was supplied rather than comparing against the identity.
    /// An unsupplied frame must fall back to the geometric one, and an authored identity is a legitimate value.
    geometry_tangent_frame: float4 = float4(0.0, 0.0, 0.0, 1.0)

    /// the direction the anisotropic lobes are stretched along, in TANGENT space
    ///
    /// (1, 0, 0) is the frame's own tangent, which is what an unrotated anisotropic highlight follows.
    /// Only the component in the tangent plane is used, so a caller may hand over an object-space direction transformed into the frame without projecting it first.
    /// A vector that lands on the normal leaves the frame alone rather than producing an arbitrary one.
    geometry_tangent: float3 = float3(1.0, 0.0, 0.0)

    /// +1 for a right-handed frame, -1 where the uv parameterization is mirrored
    ///
    /// Its own value rather than the sign of the quaternion's w, because the packed encodings canonicalize that sign away.
    /// A frame that hid handedness there could not be quantized without a content migration.
    geometry_handedness: float = 1.0

/// The surface a material fragment starts from: OpenPBR's own defaults, so one that writes nothing is the specification's default surface.
fun default_surface() -> surface => surface()

/// The lobes `s` describes, with every quantity that does not depend on the incoming direction folded in.
///
/// `exiting` is whether the path is LEAVING the surface's interior rather than entering it.
/// The shading frame is always turned to face the incoming ray, so the closure cannot read that off the geometry.
/// And it changes the direction of every refraction, which is why it is a parameter rather than something inferred.
/// It means nothing for a surface that does not transmit.
///
/// `channel` is which wavelength the path has been collapsed onto, or 3 for one that still carries all of them.
/// It only reaches the refraction index, and only when the material actually disperses.
/// A path that never met a dispersive interface keeps its three channels and pays nothing.
fun bsdf_prepare(s: surface, exiting: bool, channel: uint) -> bsdf:
    let metalness = saturate(s.base_metalness)

    let diffuse_albedo = saturate(s.base_weight) * saturate(s.base_color)
    let diffuse_roughness = saturate(s.base_diffuse_roughness)

    // The metal's normal-incidence reflectance is the base color itself, and the specular color is its tint at 82 degrees.
    let metal_f0 = saturate(s.base_weight * s.base_color)
    let metal_tint = saturate(s.specular_weight * s.specular_color)
    let metal_alpha = alpha_of(s.specular_roughness, s.specular_roughness_anisotropy)

    // The dielectric's reflectance comes from its IOR and `specular_color` tints it, while grazing incidence still goes to white.
    // That is what makes a tinted dielectric read as coated rather than metallic.
    //
    // `specular_weight` scales the whole LOBE rather than only `f0`.
    // Folding it into `f0` would leave Schlick's grazing tail at full strength.
    // A surface asking for no specular at all would still reflect white at the horizon, and the diffuse below it would still be charged for the crossing.
    let ior = max(1.0 + 1e-3, s.specular_ior)
    let r0 = (ior - 1.0) / (ior + 1.0)
    let spec_f0 = saturate(saturate(s.specular_color) * (r0 * r0))
    let spec_weight = saturate(s.specular_weight)
    let spec_alpha = alpha_of(s.specular_roughness, s.specular_roughness_anisotropy)

    // The coat's frame: its normal, with the base's tangent spun onto it so an anisotropic coat still follows the uv layout.
    // `geometry_coat_tangent` would let the coat point its own way; nothing needs that yet.
    let coat_n = normalize(s.geometry_coat_normal)
    let coat_tangent = float3(1.0, 0.0, 0.0) - coat_n * coat_n.x
    let coat_tangent_len = length(coat_tangent)
    let coat_t = if coat_tangent_len > 1e-6 => coat_tangent / coat_tangent_len else float3(0.0, 1.0, 0.0)
    let coat_b = cross(coat_n, coat_t)

    // The transparent base, under the same dielectric interface the diffuse substrate sits under.
    let trans_weight = saturate(s.transmission_weight)
    let thin_walled = if s.geometry_thin_walled != 0.0 => 1.0 else 0.0

    // A collapsed path refracts at ITS wavelength's index, which is the whole of dispersion.
    // The lobe is unchanged, and only the angle it bends through differs between the channels.
    let mut interface_ior = max(1.0 + 1e-3, s.specular_ior)
    if channel < 3 and s.transmission_dispersion_scale > 0.0:
        let wavelength = channel_wavelength(channel)
        let abbe = s.transmission_dispersion_abbe_number
        interface_ior = dispersive_ior(interface_ior, abbe, s.transmission_dispersion_scale, wavelength)

    let trans_eta = if exiting => 1.0 / interface_ior else interface_ior

    // A positive depth makes the color a property of the VOLUME, so the crossing costs nothing and the integrator attenuates over the distance instead.
    // A thin wall encloses no volume at all, so it always pays at the crossing however the depth is authored.
    let volumetric = s.transmission_depth > 0.0 and thin_walled == 0.0

    let trans_tint = if volumetric => float3(1.0) else saturate(s.transmission_color)

    // Beer-Lambert, solved so that `transmission_color` is what survives exactly `transmission_depth` of travel.
    // The scattering coefficient is over that same depth, so the two are read against one scale.
    let c = clamp(saturate(s.transmission_color), float3(1e-4), float3(1.0))
    let depth = max(s.transmission_depth, 1e-6)

    let sigma_a = if volumetric => -log(c) / depth else float3(0.0)
    let sigma_s = if volumetric => max(float3(0.0), s.transmission_scatter) / depth else float3(0.0)

    // Extinction is what the two do together, and the albedo is scattering's share of it.
    // A clear interior leaves that share at zero, which is what tells the integrator it can cross in a straight line rather than walking.
    let medium_sigma_t = sigma_a + sigma_s
    let medium_albedo = sigma_s / max(medium_sigma_t, float3(1e-9))
    let medium_g = clamp(s.transmission_scatter_anisotropy, -0.95, 0.95)

    // The subsurface interior: a dense scattering medium under the same interface, which the integrator random-walks.
    let sss_weight = if thin_walled != 0.0 => 0.0 else saturate(s.subsurface_weight)

    // The mean free path is what `subsurface_radius` states, scaled, so extinction is its reciprocal.
    let mfp = max(saturate(s.subsurface_radius) * max(s.subsurface_radius_scale, 0.0), float3(1e-4))
    let sss_sigma_t = 1.0 / mfp

    // Chiang's inversion: the single-scattering albedo whose random walk comes back out the color that was ASKED for.
    // Without it `subsurface_color` would be the albedo of one scattering event.
    // A walk of dozens of them would return something far darker than the value the author typed.
    let a = saturate(s.subsurface_color)
    let sss_albedo = saturate(1.0 - exp(-5.09406 * a + 2.61188 * a * a - 4.31805 * a * a * a))
    let sss_g = clamp(s.subsurface_scatter_anisotropy, -0.95, 0.95)

    let cior = max(1.0 + 1e-3, s.coat_ior)
    let cr0 = (cior - 1.0) / (cior + 1.0)

    return {
        diffuse_albedo = diffuse_albedo
        diffuse_roughness = diffuse_roughness
        metal_f0 = metal_f0
        metal_tint = metal_tint
        metal_alpha = metal_alpha
        spec_f0 = spec_f0
        spec_alpha = spec_alpha
        spec_weight = spec_weight
        trans_weight = trans_weight
        trans_tint = trans_tint
        trans_eta = trans_eta
        thin_walled = thin_walled
        medium_sigma_t = medium_sigma_t
        medium_albedo = medium_albedo
        medium_g = medium_g
        sss_weight = sss_weight
        sss_sigma_t = sss_sigma_t
        sss_albedo = sss_albedo
        sss_g = sss_g
        coat_f0 = cr0 * cr0
        coat_alpha = alpha_of(s.coat_roughness, s.coat_roughness_anisotropy)
        coat_n = coat_n
        coat_t = coat_t
        coat_b = coat_b
        coat_tint = saturate(s.coat_color)
        coat_weight = saturate(s.coat_weight)
        coat_darkening = saturate(s.coat_darkening)
        fuzz_color = saturate(s.fuzz_color)
        fuzz_alpha = clamp(s.fuzz_roughness, min_alpha, 1.0)
        fuzz_weight = saturate(s.fuzz_weight)
        metalness = metalness
        thin_film_weight = saturate(s.thin_film_weight)
        thin_film_thickness = max(0.0, s.thin_film_thickness)
        thin_film_ior = max(1.0 + 1e-3, s.thin_film_ior)
        emission = max(float3(0.0), s.emission_luminance * s.emission_color)
    }

// ---- Layer coupling -------------------------------------------------------------------------------------------------

/// What the fuzz layer transmits to everything below it, in one direction.
fun fuzz_transmission(b: bsdf, mu: float) -> float:
    return 1.0 - b.fuzz_weight * sheen_albedo(mu, b.fuzz_alpha)

/// `w` expressed in the coat's own frame, which is where its lobe is evaluated and sampled.
fun to_coat(b: bsdf, w: float3) -> float3:
    return float3(dot(w, b.coat_t), dot(w, b.coat_b), dot(w, b.coat_n))

/// A direction in the coat's frame, back in the closure's own.
fun from_coat(b: bsdf, w: float3) -> float3:
    return w.x * b.coat_t + w.y * b.coat_b + w.z * b.coat_n

/// What the coat transmits to the base, in one direction.
fun coat_transmission(b: bsdf, mu: float) -> float:
    let ab = ggx_albedo_split(mu, alpha_iso(b.coat_alpha))
    return 1.0 - b.coat_weight * (b.coat_f0 * ab.x + ab.y)

/// Whether a refraction about a microfacet at cosine `mu_h` is impossible — the microfacet is past the critical angle.
///
/// Only ever true on the way OUT of a denser interior, where `trans_eta` is below 1.
/// From outside, Snell's law always has a solution and this is false at every angle.
/// Schlick cannot express it — it has no critical angle and its tail never reaches 1.
/// That is why the reflectance at such a microfacet is stated here rather than left to `fresnel_schlick`.
fun interface_is_tir(b: bsdf, mu_h: float) -> bool:
    let c = saturate(mu_h)
    return (1.0 - c * c) / max(b.trans_eta * b.trans_eta, 1e-9) >= 1.0

/// What the dielectric specular layer transmits to the diffuse substrate, in one direction.
fun spec_transmission(b: bsdf, mu: float) -> float3:
    return float3(1.0) - b.spec_weight * ggx_albedo(mu, b.spec_alpha, b.spec_f0)

/// How much the base is darkened by sitting under the coat, beyond the transmission the two crossings already cost.
///
/// Light that reaches the base and comes back up meets the coat's inner interface.
/// Most of it is past the critical angle there, and is reflected back DOWN for another chance to be absorbed.
/// The factor is that series: a bright base survives the extra bounces and loses little, a dark one loses nearly all of it.
/// That is why the effect is a shift in saturation rather than a uniform dimming.
///
/// `coat_darkening` 1 is the physical result and 0 compensates it away, so the factor runs from 1 toward the series rather than the other way round.
/// It is bounded ABOVE by 1 in every channel, which is what keeps a coated surface from returning more light than it received.
fun coat_darkening_factor(b: bsdf) -> float3:
    if b.coat_weight <= 0.0 => return float3(1.0)

    // The average reflectance seen from INSIDE the coat, which is what drives the internal-reflection series.
    let f_avg = fresnel_average(b.coat_f0)
    let ior = (1.0 + sqrt(b.coat_f0)) / max(1e-3, 1.0 - sqrt(b.coat_f0))
    let f_avg_internal = saturate(1.0 - (1.0 - f_avg) / max(ior * ior, 1e-3))

    let base_albedo = saturate(mix(b.diffuse_albedo, b.metal_f0, b.metalness))

    // What escapes per attempt over what the series recovers.
    // Both carry the same internal reflectance, which is what makes the ratio conserve energy.
    // It is 1 for a white base and falls toward `1 - f_avg_internal` for a black one.
    let escaped = (1.0 - f_avg_internal) / max(float3(1e-3), float3(1.0) - f_avg_internal * base_albedo)

    // At `coat_darkening` 0 nothing is darkened; at 1 the series applies in full.
    // A coat that is only partly there darkens only that far, so the weight rides along.
    return mix(float3(1.0), saturate(escaped), b.coat_darkening * b.coat_weight)

/// What two crossings of the coat cost, for a pair that may straddle the surface.
///
/// A transmitted direction leaves on the far side, where the coat is not.
/// But the model has no better exit cosine than the mirrored one, so both crossings are charged and the exit uses `abs(wi.z)`.
fun coat_crossing(b: bsdf, wo: float3, wi: float3) -> float:
    let wo_c = to_coat(b, wo)
    let mu_o = if wo_c.z > 0.0 => wo_c.z else 0.0
    let mu_i = abs(to_coat(b, wi).z)

    if mu_o <= 0.0 => return 1.0

    return coat_transmission(b, mu_o) * coat_transmission(b, mu_i)

/// What the dielectric interface lets THROUGH at one incidence — exactly the complement of what its reflection lobe keeps.
///
/// Reading it off the reflection rather than computing a Fresnel of its own is the point.
/// The two halves of one interface have to sum to 1, or the surface invents or destroys light.
/// Schlick and the exact dielectric relation agree closely at the indices real glass has.
/// But they diverge completely as the index approaches 1, where Schlick's grazing tail still climbs to white and the exact relation correctly goes to nothing.
///
/// Past the critical angle Schlick understates the internal reflection, since it has no critical angle and its tail never reaches 1.
/// `interface_is_tir` is what states the difference: at such a microfacet there is no transmitted direction at all and the reflection is total.
/// `bsdf_eval` returns the full lobe there rather than Schlick's share of it.
fun interface_transmittance(b: bsdf, mu: float) -> float3:
    return saturate(float3(1.0) - b.spec_weight * fresnel_schlick(max(mu, 1e-6), b.spec_f0))

/// The rough-refraction BTDF through the dielectric interface (Walter 2007), Fresnel included and UNTINTED.
///
/// The tint belongs to the caller: the transparent base and the subsurface base refract through this same interface and differ only in what lies beyond it.
/// One tints at the crossing, the other does not.
///
/// The radiance-compression factor is deliberately ABSENT.
///
/// A beam entering a denser medium is squeezed into a narrower cone, so the radiance along it rises by the square of the index ratio.
/// A path traced from the LIGHT would have to carry that.
/// This one is traced from the camera, which transports importance rather than radiance, and the two conventions differ by exactly that factor.
/// Including it here would have a lossless interface return 2.25 times the light it received, which is what the probe's energy bound caught.
///
/// A BTDF is not reciprocal either way: `f(wo, wi)` and `f(wi, wo)` differ by that same ratio.
/// That is a property of radiance rather than an error, so the probe compares only directions on one side.
fun transmission_btdf(b: bsdf, wo: float3, wi: float3) -> float3:
    // A thin wall has no interior to refract into: light goes straight on through, spread by the interface's roughness.
    // So the lobe is the reflection lobe mirrored about the surface, which is what `-wi` recovers.
    if b.thin_walled != 0.0:
        let wi_mirror = float3(wi.x, wi.y, -wi.z)
        let hm = normalize(wo + wi_mirror)
        let mu_hm = max(dot(wo, hm), 1e-6)
        let dm = ggx_d(hm, b.spec_alpha)
        let gm = ggx_g2(wo, wi_mirror, b.spec_alpha)

        return interface_transmittance(b, mu_hm) * (dm * gm / (4.0 * wo.z * max(wi_mirror.z, 1e-6)))

    let eta = b.trans_eta
    let h = refraction_half_vector(wo, wi, eta)

    let dot_o = dot(wo, h)
    let dot_i = dot(wi, h)
    // the pair does not correspond to a refraction about any microfacet
    if dot_o <= 0.0 or dot_i >= 0.0 => return float3(0.0)

    let d = ggx_d(h, b.spec_alpha)
    let g = ggx_g2(wo, float3(wi.x, wi.y, -wi.z), b.spec_alpha)

    let denom = dot_o + eta * dot_i
    let scale = abs(dot_o) * abs(dot_i) / max(wo.z * abs(wi.z) * denom * denom, 1e-9)

    return interface_transmittance(b, dot_o) * d * g * scale

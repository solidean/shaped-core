// The raster path's SHADING: how a draw pulls its triangles, how a pixel finds the surface a traced hit would, and how that surface is lit without tracing.
//
// A generated material pixel shader evaluates its material itself and hands `shade` the surface it got, as a closest hit hands `tracer.shade` one.
// Everything from there is the same for every material: the frame, the closure, the lights, the environment and the G-buffer.
module raster

use material
use openpbr
use pt
use quadric
use scene
use slug
use tracer

/// The side of the grid `rect_light_by_grid` integrates a rect over: `area_grid` squared fixed points per light and pixel.
const area_grid = 4

/// Whether a rect is integrated over that grid -- the reference, sixteen closure evaluations a light and pixel -- rather
/// than `rect_light`'s closed form, which is two.
const rect_lights_by_grid = false

/// The 16 SH coefficients of the environment, copied out of their buffer into the array `scene.background_radiance` takes.
fun background_sh(){drawn} -> float4[16]:
    let mut sh = float4[16].filled(float4(0.0))
    @unroll
    for k in 0 ..< 16:
        sh[k] = drawn.background[k]
    return sh

/// The whole environment, copied out of its buffer into the array `scene.environment_*` take.
fun background_lanes(){drawn} -> float4[28]:
    let mut env = float4[28].filled(float4(0.0))
    @unroll
    for k in 0 ..< 28:
        env[k] = drawn.background[k]
    return env

/// An object-space point of `inst` in the world.
fun to_world_point(inst: scene.instance, p: float3) -> float3:
    let q = float4(p.x, p.y, p.z, 1.0)
    return float3(dot(inst.to_world_x, q), dot(inst.to_world_y, q), dot(inst.to_world_z, q))

/// An object-space direction of `inst` in the world, by the linear part of its placement alone.
fun to_world_vector(inst: scene.instance, v: float3) -> float3:
    let q = float4(v.x, v.y, v.z, 0.0)
    return float3(dot(inst.to_world_x, q), dot(inst.to_world_y, q), dot(inst.to_world_z, q))

/// The columns of `inst`'s linear part, `to_world_vector` of the three axes.
struct linear_columns:
    a: float3
    b: float3
    c: float3

fun columns_of(inst: scene.instance) -> linear_columns:
    let a = float3(inst.to_world_x.x, inst.to_world_y.x, inst.to_world_z.x)
    let b = float3(inst.to_world_x.y, inst.to_world_y.y, inst.to_world_z.y)
    let c = float3(inst.to_world_x.z, inst.to_world_y.z, inst.to_world_z.z)
    return linear_columns(a, b, c)

/// A world direction in `inst`'s object space: the inverse of `to_world_vector`, by the cross products of its columns.
fun to_object_vector(inst: scene.instance, v: float3) -> float3:
    let m = columns_of(inst)
    let det = dot(m.a, cross(m.b, m.c))
    return float3(dot(cross(m.b, m.c), v), dot(cross(m.c, m.a), v), dot(cross(m.a, m.b), v)) / det

/// A world point in `inst`'s object space: the inverse of `to_world_point`.
fun to_object_point(inst: scene.instance, p: float3) -> float3:
    return to_object_vector(inst, p - float3(inst.to_world_x.w, inst.to_world_y.w, inst.to_world_z.w))

/// An object-space normal of `inst` in the world, by the inverse transpose of its linear part, normalized.
/// A non-uniform scale tilts a normal as it does not tilt a tangent, which is why this is not `to_world_vector`.
fun normal_to_world(inst: scene.instance, n: float3) -> float3:
    let m = columns_of(inst)
    let det = dot(m.a, cross(m.b, m.c))
    let sign = if det < 0.0 => -1.0 else 1.0
    return normalize(cross(m.b, m.c) * n.x + cross(m.c, m.a) * n.y + cross(m.a, m.b) * n.z) * sign

/// -1 where `inst`'s placement mirrors, and 1 where it does not.
///
/// A face normal crossed from world-space corners turns over under a mirror, where the inverse transpose a hit uses does not.
/// So the sign of the determinant is what makes the two agree on which side of a face is its front.
fun mirroring_of(inst: scene.instance) -> float:
    let det = dot(inst.to_world_x.xyz, cross(inst.to_world_y.xyz, inst.to_world_z.xyz))
    let sign = if det < 0.0 => -1.0 else 1.0
    return sign

/// Where world point `p` lands through `cam`, as the clip position of the camera `scene.camera_ray_offset` traces through.
///
/// A pinhole's `w` is the view depth along the camera's forward axis, and `z / w` is `near / w`: reversed, 1 at the near plane and 0 at infinity.
/// A float's spacing shrinks toward 0 as fast as `near / w` does, so the depth test resolves a far surface as finely as a near one.
/// An orthographic camera's `w` is 1, and its `z` is `scene.camera_reversed_depth`, linear from the near plane to the far one.
/// That is the raster pass's own depth alone; `primary_depth` stays `scene.camera_primary_depth`, the depth `sv::matrices_of` builds and the tracer writes.
/// Up is up in clip space, which is the tracer's image read top row first.
/// `shift` moves the image in clip space, `jitter_shift` of a frame's jitter, so a pixel's center lands where its jittered ray would.
fun project(cam: scene.camera, p: float3, near: float, shift: float2) -> hpos4:
    let offset = p - cam.position
    let depth = dot(offset, normalize(cam.forward))
    let x = dot(offset, cam.right_scaled) / dot(cam.right_scaled, cam.right_scaled)
    let y = dot(offset, cam.up_scaled) / dot(cam.up_scaled, cam.up_scaled)
    if scene.camera_is_orthographic(cam) => return hpos4(x + shift.x, y + shift.y, scene.camera_reversed_depth(cam, near, depth), 1.0)
    return hpos4(x + shift.x * depth, y + shift.y * depth, near, depth)

/// The clip-space shift that moves an image of `size` pixels by `-jitter`, so pixel `px` samples the image at `px + 0.5 + jitter`.
/// Clip space's y is up where the image's is down.
fun jitter_shift(jitter: float2, size: float2) -> float2:
    return float2(-2.0 * jitter.x / size.x, 2.0 * jitter.y / size.y)

/// Vertex `vertex` of row `instance` of the instance table, pulled out of the vertex pool.
///
/// The draw is indexed through the index pool, and `vertex` already carries the mesh's base vertex, so it is the pool's own index.
/// No vertex buffer is bound, which is what lets one pipeline draw every mesh, whatever its attributes.
/// `instance` must be the same for the whole draw, which the `@per_draw` member it lands in holds the caller to.
fun vertex_of(vertex: int, instance: uint){drawn, tracer.bindless} -> varyings:
    let f = drawn.frame[0]
    return vertex_from(scene.instance(..drawn.instances[instance as int]), instance, vertex, scene.camera(..f.camera), f.near_plane, jitter_shift(f.jitter, f.size))

/// `vertex_of` for whichever group holds the frame and the instance table: vertex `vertex` of `inst`, row `instance`, seen through `cam`.
fun vertex_from(inst: scene.instance, instance: uint, vertex: int, cam: scene.camera, near: float, shift: float2){tracer.bindless} -> varyings:
    let vertices = inst.vertices as int
    let object = reinterpret_as_float(tracer.bindless.buffers[vertices].load3((vertex as uint) * 12))
    let world = to_world_point(inst, object)
    return {
        position = project(cam, world, near, shift)
        instance = instance
        object = object
        world = world
    }

/// The four corners of box face `face`, counter-clockwise seen from outside, one per nibble; a corner's bits are its x, y and z in that order.
fun box_face(face: int) -> uint:
    if face == 0 => return 0x2640u
    if face == 1 => return 0x7315u
    if face == 2 => return 0x4510u
    if face == 3 => return 0x7623u
    if face == 4 => return 0x3201u
    return 0x6754u

/// Corner `vertex` of the 36 a box draws as, in [0, 1] on each axis: two triangles a face, wound as `box_face` winds it.
fun box_corner(vertex: int) -> float3:
    let face = vertex / 6
    let k = (vertex - face * 6) as uint
    let quad_index = (0x320210u >> (k * 4u)) & 15u
    let corner = (box_face(face) >> (quad_index * 4u)) & 15u
    return float3((corner & 1u) as float, ((corner >> 1u) & 1u) as float, ((corner >> 2u) & 1u) as float)

/// Vertex `vertex` of the box of primitive `primitive` of `inst`'s quadric batch, row `instance`, seen through `cam`.
///
/// `inst.indices` names the vertex pool, whose element `inst.first_index`, 12 bytes each, starts the batch's boxes: one
/// `tg::aabb3f` of 24 bytes each, the same boxes its acceleration structure is built from.
fun quadric_vertex_from(inst: scene.instance, instance: uint, primitive: uint, vertex: int, cam: scene.camera, near: float, shift: float2){tracer.bindless} -> quadric_varyings:
    let boxes = inst.indices as int
    let base = inst.first_index * 12u + primitive * 24u
    let lo = reinterpret_as_float(tracer.bindless.buffers[boxes].load3(base))
    let hi = reinterpret_as_float(tracer.bindless.buffers[boxes].load3(base + 12u))
    let object = mix(lo, hi, box_corner(vertex))
    let world = to_world_point(inst, object)
    return {
        position = project(cam, world, near, shift)
        instance = instance
        primitive = primitive
        object = object
        world = world
    }

/// `quadric_vertex_from` through `drawn`: vertex `vertex` of the box of `primitive`, row `instance`.
fun quadric_vertex_of(vertex: int, instance: uint, primitive: uint){drawn, tracer.bindless} -> quadric_varyings:
    let f = drawn.frame[0]
    return quadric_vertex_from(scene.instance(..drawn.instances[instance as int]), instance, primitive, vertex, scene.camera(..f.camera), f.near_plane, jitter_shift(f.jitter, f.size))

/// Where a pixel's camera ray meets its quadric: the world point, the object-space outward normal, and whether it met it at all.
struct quadric_pixel:
    valid: bool
    world: float3
    object_normal: float3

/// Primitive `primitive` of `inst`'s batch solved along `cam`'s ray through `at`, on an image of `size`.
/// The point is the solve's own, mapped into the world, so it is rounded as an interpolated point is and a ray offset covers it.
fun quadric_pixel_from(inst: scene.instance, primitive: uint, cam: scene.camera, at: float2, size: float2){tracer.bindless} -> quadric_pixel:
    let prim = quadric.load_primitive(tracer.bindless.buffers[inst.vertices as int], inst.base_vertex, primitive)
    let dir = scene.camera_ray_offset(cam, at, size)
    let found = quadric.intersect(prim, to_object_point(inst, scene.camera_origin(cam, at, size)), to_object_vector(inst, dir), 0.0, 3.0e38)
    return quadric_pixel(found.valid, to_world_point(inst, found.point), found.normal)

/// `quadric_pixel_from` for the pixel `p` covers, through `drawn`.
fun quadric_pixel_of(p: quadric_varyings){drawn, tracer.bindless} -> quadric_pixel:
    let f = drawn.frame[0]
    let inst = scene.instance(..drawn.instances[p.instance as int])
    return quadric_pixel_from(inst, p.primitive, scene.camera(..f.camera), float2(p.position.x, p.position.y) + f.jitter, f.size)

/// The shading context of the quadric `p` covers, as `tracer.quadric_context` makes one for a hit there.
fun quadric_context_of(p: quadric_varyings){drawn} -> material.shading_context:
    return quadric.make_context(scene.instance(..drawn.instances[p.instance as int]), p.primitive)

/// The weights of `a`, `b` and `c`, in that order, that put the point of their plane nearest `q` together.
///
/// Through the triangle's normal rather than the edges' dot products, which cancel on a thin triangle.
/// A degenerate triangle covers no pixel, and takes its first corner whole.
fun barycentrics_of(q: float3, a: float3, b: float3, c: float3) -> float3:
    let e0 = b - a
    let e1 = c - a
    let n = cross(e0, e1)
    let nn = dot(n, n)
    if nn <= 0.0 => return float3(1.0, 0.0, 0.0)
    let d = q - a
    let v = dot(cross(d, e1), n) / nn
    let w = dot(cross(e0, d), n) / nn
    return float3(1.0 - v - w, v, w)

/// The shading context of the pixel's triangle `primitive`, as `tracer.triangle_context` makes one for a hit there.
fun pixel_context(p: varyings, primitive: uint){drawn, tracer.bindless} -> material.shading_context:
    return context_from(scene.instance(..drawn.instances[p.instance as int]), p, primitive)

/// `pixel_context` for whichever group holds the instance table, whose row of `p` is `inst`.
fun context_from(inst: scene.instance, p: varyings, primitive: uint){tracer.bindless} -> material.shading_context:
    let indices = inst.indices as int
    let vertices = inst.vertices as int
    let corner = material.triangle_corners(inst, tracer.bindless.buffers[indices], primitive)
    let o0 = material.position_of(inst, tracer.bindless.buffers[vertices], corner.x)
    let o1 = material.position_of(inst, tracer.bindless.buffers[vertices], corner.y)
    let o2 = material.position_of(inst, tracer.bindless.buffers[vertices], corner.z)
    let bary = barycentrics_of(p.object, o0, o1, o2)
    return material.shading_context(inst.param_buffer, inst.param_offset, primitive, corner, bary, material.no_footprint, material.no_footprint, float2(0.0, 0.0))

/// Whether a cutout material removes this pixel, read through `tracer.instance_opacity` as the tracer's any-hit reads it.
///
/// Where the type's cutoff is above 0 that is glTF's MASK, and the pixel is cut exactly where a hit is.
/// A cutoff of 0 is coverage, which a tracer draws stochastically and converges to a partial surface.
/// A frame that accumulates draws it the same way, from its `coverage_seed`; one that does not, a seed of 0, cuts coverage below one half.
fun is_cut(p: varyings, ctx: material.shading_context){drawn, tracer.bindless} -> bool:
    let inst = scene.instance(..drawn.instances[p.instance as int])
    let opacity = tracer.instance_opacity(inst, ctx)
    let f = drawn.frame[0]
    if f.coverage_seed == 0u => return opacity < 0.5
    return coverage_cut(opacity, uint2(p.position.x as uint, p.position.y as uint), f.size.x as uint, f.coverage_seed)

/// Whether coverage `opacity` loses pixel `px` this frame: an opacity of 1 never does, 0 always, and anything between in that share of frames.
fun coverage_cut(opacity: float, px: uint2, width: uint, seed: uint) -> bool:
    let mut rng = pt.hash(px.x + px.y * width + seed * 9781u + 0x2545f491u)
    return opacity <= pt.rand(mut rng)

/// Paints every decal reaching `p` into `surface`'s base, as `tracer.apply_decals` paints a hit.
fun apply_decals(surface: mut openpbr.surface, p: float3, n: float3, footprint: float){drawn, slug.tables}:
    let count = drawn.frame[0].decal_count
    for i in 0 ..< (count as int):
        let d = drawn.decals[i]
        let mut at = float2(0.0)
        let fade = tracer.decal_reach(d, p, n, mut at)
        if fade <= 0.0 => continue
        let first = d.first_shape as int
        for k in 0 ..< (d.shape_count as int):
            tracer.paint_decal_shape(mut surface, d, drawn.decal_shapes[first + k], at, footprint, fade)

/// What arrives along `wi` with radiance-times-solid-angle `incoming` and leaves toward the viewer, BSDF and cosine folded in.
/// `n` is the geometric normal turned toward the viewer.
/// Light reaches only its side, wherever the shading normal leans.
fun reflected(b: openpbr.bsdf, f: openpbr.frame, n: float3, wo_local: float3, wi: float3, incoming: float3) -> float3:
    let wi_local = openpbr.to_local(f, wi)
    if wi_local.z <= 0.0 or dot(wi, n) <= 0.0 => return float3(0.0)
    return openpbr.bsdf_eval(b, wo_local, wi_local) * incoming * wi_local.z

/// A rect's light at `p`, from its diffuse and its specular half one closure evaluation each.
///
/// The diffuse half is exact for a Lambertian lobe: the rect's cosine-weighted solid angle in closed form, a sum over its
/// four edges, with the closure's diffuse half read along the direction that sum points.
/// A rect partly below the horizon is not clipped to it, which overstates its light at grazing angles.
/// The specular half is the most representative point: where the mirror ray meets the rect, or the nearest point of the
/// rect to that, its lobe widened as Karis widens a sphere light's, so a small light does not read as a large one.
/// The widening reads the base's roughness, so a coat's highlight from a small light is too sharp.
fun rect_light(l: scene.light, b: openpbr.bsdf, f: openpbr.frame, n: float3, wo_local: float3, p: float3) -> float3:
    let two_sided = (l.flags & scene.light_flag_two_sided) != 0u
    let facing = dot(l.normal, p - l.position)
    if facing <= 0.0 and not two_sided => return float3(0.0)

    let mut corners = float3[4].filled(float3(0.0))
    corners[0] = normalize(l.position - l.u - l.v - p)
    corners[1] = normalize(l.position + l.u - l.v - p)
    corners[2] = normalize(l.position + l.u + l.v - p)
    corners[3] = normalize(l.position - l.u + l.v - p)

    // The vector form factor: half the sum, over the edges, of each edge's angle times the unit normal of its plane through p.
    let mut field = float3(0.0)
    for i in 0 ..< 4:
        let a = corners[i]
        let c = corners[(i + 1) % 4]
        let edge = cross(a, c)
        let edge_length = length(edge)
        if edge_length > 1e-8:
            field += acos(clamp(dot(a, c), -1.0, 1.0)) * (edge / edge_length)
    field *= 0.5
    // The winding seen from p decides the sign; the field points toward the rect.
    if dot(field, l.position - p) < 0.0:
        field = -field
    let reach = length(field)
    if reach <= 0.0 => return float3(0.0)
    let toward = field / reach

    let mut sum = float3(0.0)
    let mut diffuse = float3(0.0)
    let mut specular = float3(0.0)

    // Diffuse: the projected solid angle onto the face is the field along its normal.
    let wd_local = openpbr.to_local(f, toward)
    let projected = dot(field, f.n)
    if projected > 0.0 and wd_local.z > 0.0 and dot(toward, n) > 0.0:
        openpbr.bsdf_eval_split(b, wo_local, wd_local, mut diffuse, mut specular)
        sum += diffuse * l.emission * scene.light_cone(l, abs(dot(l.normal, -toward))) * projected

    // Specular: the mirror ray's point on the rect, clamped into it.
    let mirror = openpbr.to_world(f, float3(-wo_local.x, -wo_local.y, wo_local.z))
    let across = dot(mirror, l.normal)
    let along = if abs(across) > 1e-6 => dot(l.position - p, l.normal) / across else -1.0
    let hit = if along > 0.0 => p + mirror * along else p + mirror
    let offset = hit - l.position
    let s = clamp(dot(offset, l.u) / max(dot(l.u, l.u), 1e-12), -1.0, 1.0)
    let t = clamp(dot(offset, l.v) / max(dot(l.v, l.v), 1e-12), -1.0, 1.0)
    let to_point = l.position + s * l.u + t * l.v - p
    let dist2 = max(dot(to_point, to_point), 1e-12)
    let ws = to_point / sqrt(dist2)
    let ws_local = openpbr.to_local(f, ws)
    if ws_local.z > 0.0 and dot(ws, n) > 0.0:
        openpbr.bsdf_eval_split(b, wo_local, ws_local, mut diffuse, mut specular)
        // The rect's solid angle: its projected solid angle over the cosine it is seen at.
        let solid_angle = min(reach / max(abs(dot(toward, f.n)), 0.05), 2.0 * pt.pi)
        let base_alpha = mix(0.5 * (b.spec_alpha.x + b.spec_alpha.y), 0.5 * (b.metal_alpha.x + b.metal_alpha.y), b.metalness)
        let radius = sqrt(l.area / pt.pi)
        let widened = saturate(base_alpha + radius / (2.0 * sqrt(dist2)))
        let normalization = if widened > 0.0 => (base_alpha / widened) * (base_alpha / widened) else 1.0
        let cos_light = abs(dot(l.normal, -ws))
        sum += specular * l.emission * scene.light_cone(l, cos_light) * solid_angle * ws_local.z * normalization
    return sum

/// A rect integrated over a fixed `area_grid` by `area_grid` grid of points on it: exact in the limit, and close for a
/// light not much nearer than its own size; the reference `rect_light` is checked against.
fun rect_light_by_grid(l: scene.light, b: openpbr.bsdf, f: openpbr.frame, n: float3, wo_local: float3, p: float3) -> float3:
    let mut sum = float3(0.0)
    let cells = area_grid as float
    for i in 0 ..< area_grid:
        for j in 0 ..< area_grid:
            let s = ((i as float) + 0.5) / cells * 2.0 - 1.0
            let t = ((j as float) + 0.5) / cells * 2.0 - 1.0
            let to_light = l.position + s * l.u + t * l.v - p
            let dist2 = max(dot(to_light, to_light), 1e-12)
            let wi = to_light / sqrt(dist2)
            let cos_face = dot(l.normal, -wi)
            let cos_light = if (l.flags & scene.light_flag_two_sided) != 0u => abs(cos_face) else cos_face
            if cos_light <= 0.0 => continue
            // The solid angle one grid cell subtends, which the tracer's area-to-solid-angle density divides by.
            let solid_angle = l.area * cos_light / (dist2 * cells * cells)
            sum += reflected(b, f, n, wo_local, wi, l.emission * scene.light_cone(l, cos_light) * solid_angle)
    return sum

/// Direct light from `l` at `p`, unoccluded, through the closure `b` in frame `f` over the face whose turned geometric normal is `n`.
///
/// The same quantity the tracer's next-event estimate converges to there, before its shadow ray: evaluated rather than sampled.
/// A point and a parallel light are exact; a rect is `rect_light`'s closed form, or the grid where `rect_lights_by_grid`.
/// A distant disc is its center direction, carrying the whole solid angle the disc subtends.
fun direct_light(l: scene.light, b: openpbr.bsdf, f: openpbr.frame, n: float3, wo_local: float3, p: float3) -> float3:
    if l.path == scene.light_path_area:
        if rect_lights_by_grid => return rect_light_by_grid(l, b, f, n, wo_local, p)
        return rect_light(l, b, f, n, wo_local, p)

    if l.path == scene.light_path_point:
        let to_light = l.position - p
        let dist2 = max(dot(to_light, to_light), 1e-12)
        let wi = to_light / sqrt(dist2)
        return reflected(b, f, n, wo_local, wi, l.emission * (scene.light_cone(l, dot(l.normal, -wi)) / dist2))

    if l.path == scene.light_path_distant_point:
        return reflected(b, f, n, wo_local, -l.normal, l.emission)

    // scene.light_path_distant_disc: radiance over the cone it subtends
    let solid_angle = 2.0 * pt.pi * l.one_minus_cos_angular_radius
    return reflected(b, f, n, wo_local, -l.normal, l.emission * solid_angle)

/// The environment's light at a surface, unoccluded: the SH's irradiance through the diffuse albedo, and its radiance about the mirror direction through the specular one.
///
/// An approximation where the tracer integrates: the diffuse half is exact for a Lambertian base, and the specular half blurs toward the irradiance as the surface roughens.
/// Nothing shadows it but the occlusion an asset baked, which `shade` multiplies in.
fun ambient(surface: openpbr.surface, n: float3, v: float3){drawn} -> float3:
    let sh = background_sh()
    let diffuse = scene.background_irradiance(sh, n) / pt.pi
    let mirror = normalize(openpbr.reflect_about(-v, n))
    let specular = mix(scene.background_radiance(sh, mirror), diffuse, openpbr.pt_roughness(surface))
    return openpbr.pt_diffuse_albedo(surface) * diffuse + openpbr.pt_specular_albedo(surface) * specular

/// The triangle a pixel shades, as `tracer.shade_triangle` describes a hit's.
struct pixel_face:
    /// the flat face normal of the triangle's own corners, turned toward the viewer
    n: float3
    /// whether the viewer was behind the face before it was turned
    exiting: bool
    /// the material's authored frame in the world, where the material supplies one
    authored: openpbr.frame
    /// `pt.corner_reach` of the triangle from the point, which a ray leaving it is lifted by; 0 for a quadric
    reach: float

/// The face of `ctx`'s triangle of `inst` seen from `eye`, at the world point `world` on it, with the authored frame `surface` carries.
/// `supplied_tangent_frame` is whether that frame was authored rather than defaulted, which the generated material knows.
fun face_of(inst: scene.instance, ctx: material.shading_context, world: float3, eye: float3, surface: openpbr.surface, supplied_tangent_frame: bool){tracer.bindless} -> pixel_face:
    let w0 = to_world_point(inst, tracer.instance_position(inst, ctx.corner.x))
    let w1 = to_world_point(inst, tracer.instance_position(inst, ctx.corner.y))
    let w2 = to_world_point(inst, tracer.instance_position(inst, ctx.corner.z))
    let mut n = pt.triangle_normal(w1 - w0, w2 - w0, normalize(eye - world)) * mirroring_of(inst)

    // Which side the viewer is on, read off the geometry BEFORE the normal is turned to face it.
    let exiting = dot(n, eye - world) < 0.0
    if exiting => n = -n

    // The authored frame is in object space, so it moves with the instance the geometry does.
    let mut authored = openpbr.frame(float3(0.0), float3(0.0), float3(0.0))
    if supplied_tangent_frame:
        let local = openpbr.frame_from_quaternion(surface.geometry_tangent_frame, surface.geometry_handedness)
        authored = openpbr.frame(normalize(to_world_vector(inst, local.t)), normalize(to_world_vector(inst, local.b)), normalize(to_world_vector(inst, local.n)))
    return {n = n, exiting = exiting, authored = authored, reach = pt.corner_reach(world, w0, w1, w2)}

/// The face of a quadric whose object-space outward normal at the world point `world` is `object_normal`, as `face_of` describes a triangle's.
fun quadric_face_of(inst: scene.instance, object_normal: float3, world: float3, eye: float3, surface: openpbr.surface, supplied_tangent_frame: bool) -> pixel_face:
    let mut n = normal_to_world(inst, object_normal)
    // A quadric is two-sided in earnest, as `tracer.shade_quadric` says: an open tube's inside wall is seen from behind its gradient.
    let exiting = dot(n, eye - world) < 0.0
    if exiting => n = -n
    let mut authored = openpbr.frame(float3(0.0), float3(0.0), float3(0.0))
    if supplied_tangent_frame:
        let local = openpbr.frame_from_quaternion(surface.geometry_tangent_frame, surface.geometry_handedness)
        authored = openpbr.frame(normalize(to_world_vector(inst, local.t)), normalize(to_world_vector(inst, local.b)), normalize(to_world_vector(inst, local.n)))
    return {n = n, exiting = exiting, authored = authored, reach = 0.0}

/// Shades the pixel `p` covers, whose material evaluated to `surface_in` through `ctx` as `pixel_context` made it, and writes every target.
///
/// The surface is described as `face_of` describes it, and `supplied_tangent_frame` is its parameter.
/// `occlusion` is the material's baked ambient occlusion, 1 for none: it darkens the environment's light and no analytic light's.
fun shade(p: varyings, ctx: material.shading_context, surface_in: openpbr.surface, supplied_tangent_frame: bool, occlusion: float){drawn, tracer.bindless, slug.tables} -> targets:
    let cam = scene.camera(..drawn.frame[0].camera)
    let inst = scene.instance(..drawn.instances[p.instance as int])
    let face = face_of(inst, ctx, p.world, scene.camera_eye_of(cam, p.world), surface_in, supplied_tangent_frame)
    return shade_face(float2(p.position.x, p.position.y), p.world, face, surface_in, supplied_tangent_frame, occlusion)

/// Shades the quadric pixel `p` found at `hit`, whose material evaluated to `surface_in`, and writes every target and its depth.
fun shade_quadric(p: quadric_varyings, hit: quadric_pixel, surface_in: openpbr.surface, supplied_tangent_frame: bool, occlusion: float){drawn, tracer.bindless, slug.tables} -> quadric_targets:
    let f = drawn.frame[0]
    let cam = scene.camera(..f.camera)
    let inst = scene.instance(..drawn.instances[p.instance as int])
    let face = quadric_face_of(inst, hit.object_normal, hit.world, scene.camera_eye_of(cam, hit.world), surface_in, supplied_tangent_frame)
    let lit = shade_face(float2(p.position.x, p.position.y), hit.world, face, surface_in, supplied_tangent_frame, occlusion)
    return with_surface_depth(lit, scene.camera_reversed_depth(cam, f.near_plane, dot(hit.world - cam.position, normalize(cam.forward))))

/// `t` and the reversed depth `surface_depth` of the surface it was shaded at.
fun with_surface_depth(t: targets, surface_depth: float) -> quadric_targets:
    return {
        color = t.color
        normal = t.normal
        depth = t.depth
        albedo = t.albedo
        specular_albedo = t.specular_albedo
        roughness = t.roughness
        motion = t.motion
        primary_depth = t.primary_depth
        surface_depth = surface_depth
    }

/// `shade` for the surface at world point `world` that pixel `pixel` covers, described by `face`.
fun shade_face(pixel: float2, world: float3, face: pixel_face, surface_in: openpbr.surface, supplied_tangent_frame: bool, occlusion: float){drawn, tracer.bindless, slug.tables} -> targets:
    let f = drawn.frame[0]
    let cam = scene.camera(..f.camera)
    let n = face.n
    let exiting = face.exiting
    let eye = scene.camera_eye_of(cam, world)
    let v = normalize(eye - world)

    let to_point = world - eye
    let view_depth = dot(world - cam.position, normalize(cam.forward))

    // Painted before anything reads the base, the G-buffer included.
    let mut surface = surface_in
    apply_decals(mut surface, world, n, f.pixel_width + f.pixel_spread * length(to_point))

    let shading = openpbr.shading_frame(mut surface, n, v, face.authored, supplied_tangent_frame)
    // Every wavelength at once: a dispersive interface has no single path here to collapse onto one.
    let b = openpbr.bsdf_prepare(surface, exiting, 3u)
    let wo_local = openpbr.to_local(shading, v)

    let mut color = b.emission
    // `shading_frame` leaves the viewer in front of the frame, so only a degenerate input fails this.
    if wo_local.z > 0.0:
        for i in 0 ..< (f.light_count as int):
            color += direct_light(scene.light(..drawn.lights[i]), b, shading, n, wo_local, world)
        color += ambient(surface, shading.n, v) * occlusion

    let prev = scene.camera(..f.previous_camera)
    let motion = pixel + f.jitter - scene.camera_project(prev, world - prev.position, f.size)
    return lit_targets(color, n, view_depth, surface, motion, scene.camera_primary_depth(cam, f.near_plane, view_depth))

/// What a lit pixel writes: `color`, and the guides of `surface` at view depth `view_depth`, whose turned geometric normal is `n`.
fun lit_targets(color: float3, n: float3, view_depth: float, surface: openpbr.surface, motion: float2, primary_depth: float) -> targets:
    return {
        color = float4(..color, pt.moment_of(color))
        normal = float4(..n, 0.0)
        depth = view_depth
        albedo = float4(..openpbr.pt_diffuse_albedo(surface), 0.0)
        specular_albedo = float4(..openpbr.pt_specular_albedo(surface), 0.0)
        roughness = openpbr.pt_roughness(surface)
        motion = motion
        primary_depth = primary_depth
    }

/// What a pixel no surface covers holds: the environment along its camera ray, and an empty G-buffer.
///
/// The environment reprojects as a point at infinity, so it moves with the camera's rotation and not with its translation, as the tracer's escaped rays do.
fun environment(pixel: float2){drawn} -> targets:
    let f = drawn.frame[0]
    let cam = scene.camera(..f.camera)
    let at = pixel + f.jitter
    let dir = normalize(scene.camera_ray_offset(cam, at, f.size))
    let prev = scene.camera(..f.previous_camera)
    let backdrop = scene.environment_backdrop(background_lanes(), dir)
    return {
        color = float4(..backdrop, pt.moment_of(backdrop))
        normal = float4(0.0)
        depth = 0.0
        albedo = float4(0.0)
        specular_albedo = float4(0.0)
        roughness = 0.0
        motion = at - scene.camera_project(prev, dir, f.size)
        primary_depth = 1.0
    }

// The contract a GENERATED material shader is written against: the structs both sides agree on, and the loads that are the same whatever the material.
//
// A material fragment reads each attribute its type declares as an already-initialized local and writes `surface`.
// Everything around that — the loads that initialize those locals and the samples through the palette — is emitted per permutation by `sv::generate_material_shader`.
//
// Nothing here declares a resource.
// A helper that reads memory takes it as a `bytes` parameter, which the caller hands an element of its bindless table: `table[nonuniform i]`.
module material

use scene

/// Where one mesh attribute's elements live.
///
/// One stride, not three: the geometric frequency is part of the permutation key, so the generated code already knows whether to index by vertex, by corner or by primitive.
/// It emits that index directly.
/// Carrying three strides and branching would trade a smaller permutation count for a branch per attribute per hit.
struct attribute_desc:
    /// index into the bindless table of raw buffers
    buffer: uint
    /// byte offset of element 0 within that buffer
    offset: uint
    /// bytes between elements
    stride: uint

/// What a hit knows about where it is, filled by the caller rather than by the material.
///
/// `corner` is the three vertex indices of the hit triangle, which is what makes a per-vertex attribute readable without the material knowing whether the mesh is indexed.
/// The caller resolves that when it fills this in.
struct shading_context:
    /// index into the bindless table of the buffer holding this instance's parameter block
    param_buffer: uint
    /// byte offset of that block
    param_offset: uint
    /// the primitive index of the hit
    primitive: uint
    /// the three vertex indices of the hit triangle; zero on a quadric, which has no corners
    corner: uint3
    /// (1 - b.x - b.y, b.x, b.y), so the three weigh the three corners in order
    barycentrics: float3
    /// The ray cone's footprint here, an ellipse on the face, as its two axes in the triangle's barycentrics (b.x, b.y):
    /// across the ray as wide as the cone, along it stretched by one over the cosine it meets the face at.
    /// Each texture maps them through its own uvs to the gradients it samples with, so a sampler filters anisotropically
    /// (Akenine-Moller et al., "Improved Shader and Texture Level of Detail Using Ray Cones", 2021).
    /// `no_footprint` where nothing traced a cone here, which samples level 0.
    footprint_a: float2
    footprint_b: float2
    /// What every texture's uv is moved by: where a relief's parallax found the ray meets it; 0 elsewhere.
    uv_offset: float2

/// One attribute descriptor out of a parameter block.
fun load_attribute_desc(params: bytes, offset: uint) -> attribute_desc:
    let raw = params.load3(offset)
    return attribute_desc(raw.x, raw.y, raw.z)

// Element loads, by component count.

fun load_element_f1(b: bytes, d: attribute_desc, element: uint) -> float:
    return reinterpret_as_float(b.load(d.offset + element * d.stride))

fun load_element_f2(b: bytes, d: attribute_desc, element: uint) -> float2:
    return reinterpret_as_float(b.load2(d.offset + element * d.stride))

fun load_element_f3(b: bytes, d: attribute_desc, element: uint) -> float3:
    return reinterpret_as_float(b.load3(d.offset + element * d.stride))

fun load_element_f4(b: bytes, d: attribute_desc, element: uint) -> float4:
    return reinterpret_as_float(b.load4(d.offset + element * d.stride))

// Barycentric interpolation of the three corners of the hit triangle.
// `e` is the three element indices the generated code resolved from the frequency.
// Those are vertex indices for per_vertex, and `primitive * 3 + k` for per_corner.

/// A context's footprint axis where no cone reached it: no footprint, which samples the base level.
const no_footprint = float2(0.0, 0.0)

/// The uv edges of the triangle at corners `e`, from its first corner to the second (.xy) and to the third (.zw).
fun uv_edges(b: bytes, d: attribute_desc, e: uint3) -> float4:
    let u0 = load_element_f2(b, d, e.x)
    let a = load_element_f2(b, d, e.y) - u0
    let c = load_element_f2(b, d, e.z) - u0
    return float4(a.x, a.y, c.x, c.y)

/// The gradients a texture samples with under `ctx`'s cone, the footprint's two axes in uv, as `grad_x` (.xy) and
/// `grad_y` (.zw); `edges` are the triangle's uv edges as `uv_edges` gives them.
/// No cone, or a flat uv, gives zero gradients, which sample the base level.
fun texture_gradients(ctx: shading_context, edges: float4) -> float4:
    let a = edges.xy * ctx.footprint_a.x + edges.zw * ctx.footprint_a.y
    let b = edges.xy * ctx.footprint_b.x + edges.zw * ctx.footprint_b.y
    return float4(a.x, a.y, b.x, b.y)

/// How a ray's uv moves per meter it sinks below a face: the face's world edges `e1` and `e2` from its first corner
/// span the uv edges `du1` and `du2`, and `d` is the ray's unit direction.
/// .xy is the uv per meter of depth, .z is 1 where the ray enters the face's front, and 0 where it does not, which marches nothing.
/// A ray grazing the face is held at about 85 degrees, so its uv moves a finite way.
fun parallax_velocity(du1: float2, du2: float2, e1: float3, e2: float3, d: float3) -> float3:
    let det = du1.x * du2.y - du1.y * du2.x
    let normal = cross(e1, e2)
    let area = length(normal)
    if abs(det) < 1e-20 or area <= 0.0 => return float3(0.0, 0.0, 0.0)
    let n = normal / area
    let into = -dot(d, n)
    if into <= 0.0 => return float3(0.0, 0.0, 0.0)
    // the world directions of +u and +v, meters per unit of uv
    let tu = (e1 * du2.y - e2 * du1.y) / det
    let tv = (e2 * du1.x - e1 * du2.x) / det
    // the ray's step along the face, as uv: solved against the two, which need not be orthogonal
    let along = d + n * into
    let uu = dot(tu, tu)
    let uv_ = dot(tu, tv)
    let vv = dot(tv, tv)
    let g = uu * vv - uv_ * uv_
    if abs(g) < 1e-30 => return float3(0.0, 0.0, 0.0)
    let pu = dot(along, tu)
    let pv = dot(along, tv)
    let a = (pu * vv - pv * uv_) / g
    let b = (pv * uu - pu * uv_) / g
    let sink = max(into, 0.087)
    return float3(a / sink, b / sink, 1.0)

fun interpolate_f1(b: bytes, d: attribute_desc, e: uint3, w: float3) -> float:
    return load_element_f1(b, d, e.x) * w.x + load_element_f1(b, d, e.y) * w.y + load_element_f1(b, d, e.z) * w.z

fun interpolate_f2(b: bytes, d: attribute_desc, e: uint3, w: float3) -> float2:
    return load_element_f2(b, d, e.x) * w.x + load_element_f2(b, d, e.y) * w.y + load_element_f2(b, d, e.z) * w.z

fun interpolate_f3(b: bytes, d: attribute_desc, e: uint3, w: float3) -> float3:
    return load_element_f3(b, d, e.x) * w.x + load_element_f3(b, d, e.y) * w.y + load_element_f3(b, d, e.z) * w.z

fun interpolate_f4(b: bytes, d: attribute_desc, e: uint3, w: float3) -> float4:
    return load_element_f4(b, d, e.x) * w.x + load_element_f4(b, d, e.y) * w.y + load_element_f4(b, d, e.z) * w.z

/// Barycentric blend of three unit quaternions, as a tangent frame: the corners' +z blended as normals are, and their +x as tangents.
///
/// Blending the quaternions themselves ties the normal to the tangent.
/// Corners whose tangents twist far apart around nearly equal normals blend into a normal off their blend by up to half the angle between them,
/// and a tangent picked as any perpendicular to the normal has to twist that far somewhere on every closed surface.
/// A turned glass drew it as a stripe down its side.
/// So each axis is blended on its own, and the frame rebuilt around the normal, which is then exactly what blending vertex normals gives.
/// The tangent keeps whatever twist the corners agree on, and a sign stored negated changes neither axis.
fun interpolate_rotation(b: bytes, d: attribute_desc, e: uint3, w: float3) -> float4:
    let q0 = load_element_f4(b, d, e.x)
    let q1 = load_element_f4(b, d, e.y)
    let q2 = load_element_f4(b, d, e.z)
    let z = float3(0.0, 0.0, 1.0)
    let x = float3(1.0, 0.0, 0.0)
    let n = rotate_by(q0, z) * w.x + rotate_by(q1, z) * w.y + rotate_by(q2, z) * w.z
    let t = rotate_by(q0, x) * w.x + rotate_by(q1, x) * w.y + rotate_by(q2, x) * w.z
    return frame_rotation(n, t)

/// `v` turned by the quaternion `q`, unit or not: a zero `q` is no rotation at all, which leaves `v` as it is.
fun rotate_by(q: float4, v: float3) -> float3:
    let u = float3(q.x, q.y, q.z)
    let c = 2.0 * cross(u, v)
    return v + q.w * c + cross(u, c)

/// The unit quaternion turning +z onto `n` and +x onto `t` made perpendicular to it.
/// A `t` along `n` keeps no direction to turn +x onto, so any perpendicular stands in.
fun frame_rotation(n_in: float3, t_in: float3) -> float4:
    let n = if dot(n_in, n_in) > 1e-16 => normalize(n_in) else float3(0.0, 0.0, 1.0)
    let projected = t_in - n * dot(n, t_in)
    let axis = if abs(n.z) < 0.9 => float3(0.0, 0.0, 1.0) else float3(1.0, 0.0, 0.0)
    let t = if dot(projected, projected) > 1e-12 => normalize(projected) else normalize(cross(axis, n))
    return quaternion_of_basis(t, cross(n, t), n)

/// The unit quaternion of the rotation whose matrix has the orthonormal columns `x`, `y` and `z`.
fun quaternion_of_basis(x: float3, y: float3, z: float3) -> float4:
    let trace = x.x + y.y + z.z
    if trace > 0.0:
        let s = 0.5 / sqrt(trace + 1.0)
        return float4((y.z - z.y) * s, (z.x - x.z) * s, (x.y - y.x) * s, 0.25 / s)
    if x.x > y.y and x.x > z.z:
        let s = 2.0 * sqrt(1.0 + x.x - y.y - z.z)
        return float4(0.25 * s, (y.x + x.y) / s, (z.x + x.z) / s, (y.z - z.y) / s)
    if y.y > z.z:
        let s = 2.0 * sqrt(1.0 + y.y - x.x - z.z)
        return float4((y.x + x.y) / s, 0.25 * s, (z.y + y.z) / s, (z.x - x.z) / s)
    let s = 2.0 * sqrt(1.0 + z.z - x.x - y.y)
    return float4((z.x + x.z) / s, (z.y + y.z) / s, 0.25 * s, (x.y - y.x) / s)

/// The three element indices a per_corner attribute reads, in the order `barycentrics` weighs them.
fun corner_elements(ctx: shading_context) -> uint3:
    let base = ctx.primitive * 3
    return uint3(base, base + 1, base + 2)

// A mesh attribute's frequency as data, for the one reader that is not generated per permutation: the cutout's.
// `sv::material_opacity::frequency` writes these.
const frequency_per_triangle = 0u
const frequency_per_vertex = 1u
const frequency_per_corner = 2u

/// One float of a mesh attribute at the hit, numbered at `frequency`.
fun load_f1_at(b: bytes, d: attribute_desc, frequency: uint, ctx: shading_context) -> float:
    if frequency == frequency_per_triangle => return load_element_f1(b, d, ctx.primitive)
    let e = if frequency == frequency_per_corner => corner_elements(ctx) else ctx.corner
    return interpolate_f1(b, d, e, ctx.barycentrics)

/// Two floats of a mesh attribute at the hit, numbered at `frequency` — a uv.
fun load_f2_at(b: bytes, d: attribute_desc, frequency: uint, ctx: shading_context) -> float2:
    if frequency == frequency_per_triangle => return load_element_f2(b, d, ctx.primitive)
    let e = if frequency == frequency_per_corner => corner_elements(ctx) else ctx.corner
    return interpolate_f2(b, d, e, ctx.barycentrics)

/// Three floats of a mesh attribute at the hit, numbered at `frequency` — an emission color.
fun load_f3_at(b: bytes, d: attribute_desc, frequency: uint, ctx: shading_context) -> float3:
    if frequency == frequency_per_triangle => return load_element_f3(b, d, ctx.primitive)
    let e = if frequency == frequency_per_corner => corner_elements(ctx) else ctx.corner
    return interpolate_f3(b, d, e, ctx.barycentrics)

/// The three vertex indices of triangle `primitive` on `inst`, relative to its base vertex, as its per-vertex attributes are numbered.
/// `index_buffer` is the central index pool; every mesh is indexed there.
fun triangle_corners(inst: scene.instance, index_buffer: bytes, primitive: uint) -> uint3:
    let base = inst.first_index + primitive * 3
    return uint3(index_buffer.load(4 * base), index_buffer.load(4 * (base + 1)), index_buffer.load(4 * (base + 2)))

/// Vertex `v` of `inst`'s mesh, relative to its base vertex, out of the central vertex pool.
fun position_of(inst: scene.instance, vertex_buffer: bytes, v: uint) -> float3:
    return reinterpret_as_float(vertex_buffer.load3((inst.base_vertex + v) * 12))

/// The shading context for a hit on `inst`, which is all a generated material needs to know about where it is.
/// `bary` is the two barycentrics a hit attribute carries; the third is what is left of one.
fun make_context(inst: scene.instance, index_buffer: bytes, primitive: uint, bary: float2) -> shading_context:
    let corner = triangle_corners(inst, index_buffer, primitive)
    return shading_context(inst.param_buffer, inst.param_offset, primitive, corner, float3(1.0 - bary.x - bary.y, bary.x, bary.y), no_footprint, no_footprint, float2(0.0, 0.0))

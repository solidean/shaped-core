// The wavefront path tracer's stages: what each kernel of shaders/wavefront.sgl does to the paths of its queue.
//
// A path's state lives in `traced`'s path buffers between dispatches, one slot per pixel, and a round moves every live path one segment.
// extend finds each segment's hit, segment settles everything the hit's material does not decide — a medium, an analytic light
// crossed, an escape — shade (one generated kernel per permutation) runs the material, connect tests the shadow rays shade left,
// and finalize folds the paths that ended into their pixel and starts the next sample in the slot.
// The integrator is the megakernel's (shaders/tracer_pipeline.sgl), split at those seams; docs/wavefront.md is the design.
module tracer

use material
use openpbr
use pt
use quadric
use scene
use slug

// ---- Names ----------------------------------------------------------------------------------------------------------

/// `path_state::flags`.
const path_flag_alive = 1u
/// the path's next segment is its camera ray, whose hit the guides describe
const path_flag_primary = 2u
/// next-event estimation at the vertex the segment left could have sampled its direction: a surface's upper hemisphere, never a medium scatter's
const path_flag_prev_nee_reachable = 4u
/// the path belongs to the specular signal, decided by the lobe its first continuation was drawn from
const path_flag_specular = 8u
/// ReSTIR split the path at its visible point: its own light is `L_i`, and its `restir_candidate` holds the rest.
/// A path a ReSTIR frame left unfinished is recombined by whichever frame finishes it.
const path_flag_split = 16u

/// `hit_record::kind`.
const hit_none = 0u
const hit_triangle = 1u
const hit_procedural = 2u

/// `traced.counters`: each queue's count, then from `counter_permutations` a count per permutation and after those a cursor per permutation.
const counter_queue_a = 0
const counter_queue_b = 1
const counter_hits = 2
const counter_shadow = 3
const counter_finished = 4
const counter_permutations = 5

/// `dispatch.args`: the round's segments, the hits to sort, the shadow rays, the finished paths, and from `dispatch_shade` one per permutation.
const dispatch_round = 0
const dispatch_hits = 1
const dispatch_shadow = 2
const dispatch_finished = 3
const dispatch_shade = 4

/// `frame_constants::wavefront_flags`: every path and every tally starts over, since the image describes something else now.
const wavefront_flag_restart = 1u

/// `frame_constants::wavefront_flags`: the frame keeps ReSTIR GI's records and shades its primary hits again after the drain.
const wavefront_flag_restir = 2u

/// `frame_constants::wavefront_flags`: the other half of the two-half records is the last ReSTIR frame's, which may be reused.
const wavefront_flag_restir_history = 4u
/// `frame_constants::wavefront_flags`: which half of the two-half records is this frame's.
const wavefront_flag_restir_parity = 8u
/// `frame_constants::wavefront_flags`: reuse also traces the reverse visibility, which leaves it unbiased on a Lambertian scene.
const wavefront_flag_restir_exact = 16u

/// `frame_constants::wavefront_flags`: a spatial pass resamples each pixel's temporal reservoir with its neighbors'.
const wavefront_flag_restir_spatial = 32u

/// How many neighbors the spatial pass draws: exactly two, since the pass holds two neighbors' records and weighs three domains.
const restir_spatial_neighbors = 2

/// The radius the spatial pass draws neighbors from: `wavefront_step::restir_radius` where set, else a fortieth of the image's diagonal, 2 to 16 pixels.
fun restir_spatial_radius(){wavefront_step} -> float:
    if wavefront_step.restir_radius > 0u => return wavefront_step.restir_radius as float
    return clamp(0.025 * length(image_size()), 2.0, 16.0)

/// `frame_constants::wavefront_flags`: the re-shade replaces the visible point's next-event light sample by ReSTIR DI's, at its half of the balance heuristic.
const wavefront_flag_restir_di = 64u
/// `frame_constants::wavefront_flags`: the other half of ReSTIR DI's reservoirs is the last ReSTIR frame's, which also ran DI.
const wavefront_flag_restir_di_history = 128u

/// How many light samples ReSTIR DI's initial resampling draws per pixel.
const restir_di_candidates = 8

/// `restir_surface::kinds`: the pixel had a visible point.
const restir_surface_visible = 1u
/// `restir_surface::kinds`: the visible point's continuation could have made a candidate.
/// One inside a medium, or on a material that collapses onto one wavelength, is never shifted: it neither gives nor takes a history.
/// That is the material's to decide, never a draw's, even where a reflection drawn there still makes a candidate of its own.
const restir_surface_shiftable = 2u
/// `restir_surface::kinds`: the visible point is rough enough to reconnect from, decided on its float roughness.
/// The stored roughness is a half, which would put a material authored at exactly the threshold below it.
const restir_surface_rough = 4u

/// How many candidates a reservoir's confidence counts at most, so an old history cannot outweigh every new candidate.
const restir_confidence_cap = 20.0

/// The temporal pass's acceptance of a reprojected visible point: a plane distance relative to view depth, and the cosine of 25°.
const restir_plane_tolerance = 0.05
const restir_normal_tolerance = 0.906

/// `wavefront_step::mode` of ReSTIR's re-shade of the persisted primary hits; 0 is a round of the paths.
const step_restir_shade = 1u

/// `restir_candidate::flags`.
/// The primary ray met a surface, which `traced.restir_visible` holds.
const restir_flag_visible = 1u
/// The continuation from `x_v` left it reflected and through vacuum, the only kind a reconnection can carry.
const restir_flag_reflected = 2u
/// That continuation met a surface `x_s` through vacuum.
const restir_flag_candidate = 4u
/// `x_s` is rough enough to reconnect to.
const restir_flag_reconnectable = 8u
/// The path finished, so `radiance` is all it gathered.
const restir_flag_finished = 16u
/// ReSTIR DI may replace the visible point's light sample: its material collapses onto no single wavelength.
/// So the closure the re-shade prepares weighs the two strategies as the path did.
const restir_flag_di = 32u

/// The least roughness `x_s` needs to be reconnected to, GRIS's criterion.
const restir_reconnect_roughness = 0.2

/// `wavefront_step::fill` that starts every free slot.
const fill_full = 65536u

/// `pixel_tally::primary_view_depth` of a primary ray that escaped: far enough that its clip depth is the far plane, 1.
const escaped_view_depth = 1e30

/// Where `segment_settle` sends a path: nowhere (a thread past the queue), the next round, finalize, or shade.
const route_none = 0u
const route_next = 1u
const route_finished = 2u
const route_hit = 3u

/// The workgroup size of every wavefront kernel over a queue.
const wavefront_group_size = 64u

/// What a shade dispatch's thread reads where its permutation's range has no path for it.
const no_slot = 0xffffffffu

// ---- Queues ---------------------------------------------------------------------------------------------------------

// The round's two queue counters are addressed by a computed index rather than chosen by a branch.
// With a branch, NVIDIA's dx12 driver (616.92 and 617.14) corrupts them once `round_slot` takes slots in pixel order — docs/wavefront.md.

/// The counter of the round's input queue, and of its output queue, which is the next round's input.
fun input_counter(){wavefront_step} -> int:
    let counter = if wavefront_step.parity == 0u => counter_queue_a else counter_queue_b
    return counter

fun output_counter(){wavefront_step} -> int:
    let counter = if wavefront_step.parity == 0u => counter_queue_b else counter_queue_a
    return counter

/// How many paths the round's input queue holds.
fun round_count(){traced, wavefront_step} -> uint:
    return traced.counters[input_counter()].load()

/// The slot at `index` of the round's input queue.
/// A full queue holds every slot once, in whatever order its appends landed, so a full round takes slot `index` itself instead.
/// A wave then reads its paths' state from adjacent memory, and those starting a new sample leave from adjacent pixels.
fun round_slot(index: uint){traced, wavefront_step} -> uint:
    if round_count() == wavefront_step.width * wavefront_step.height => return index
    if wavefront_step.parity == 0u => return traced.queue_a[index as int]
    return traced.queue_b[index as int]

/// Whether this frame keeps ReSTIR GI's records.
fun restir_on(){traced} -> bool:
    return (traced.frame[0].wavefront_flags & wavefront_flag_restir) != 0u

/// Where `slot`'s record sits in a two-half ReSTIR buffer: this frame's half, or with `history` the last ReSTIR frame's.
fun restir_index(slot: uint, history: bool){traced, wavefront_step} -> int:
    let parity = (traced.frame[0].wavefront_flags & wavefront_flag_restir_parity) != 0u
    let upper = if history => not parity else parity
    let base = if upper => wavefront_step.width * wavefront_step.height else 0u
    return (base + slot) as int

// ---- ReSTIR: the records as stored ----------------------------------------------------------------------------------

fun pack_candidate(c: restir_candidate) -> packed_candidate:
    return packed_candidate(c.rebase, c.source_pdf, c.direct, c.flags, c.direct_specular, c.x_s, pt.pack_unit(c.n_s), pt.pack_rgb(c.radiance), c.light_part, c.light_part_specular)

fun unpack_candidate(p: packed_candidate) -> restir_candidate:
    return restir_candidate(p.rebase, p.source_pdf, p.direct, p.flags, p.direct_specular, p.x_s, pt.unpack_unit(p.n_s), pt.unpack_rgb(p.radiance), p.light_part, p.light_part_specular)

fun pack_surface(s: restir_surface) -> packed_surface:
    let albedo = uint2(pt.pack_halves(s.albedo.x, s.albedo.y), pt.pack_halves(s.albedo.z, s.roughness))
    let specular = uint2(pt.pack_halves(s.specular_albedo.x, s.specular_albedo.y), (pt.pack_halves(s.specular_albedo.z, 0.0) & 0xffffu) | (s.kinds << 16u))
    return packed_surface(s.position, pt.pack_unit(s.normal), albedo, specular)

fun unpack_surface(p: packed_surface) -> restir_surface:
    let a_xy = unpack_half2x16(p.albedo_roughness.x)
    let a_zr = unpack_half2x16(p.albedo_roughness.y)
    let s_xy = unpack_half2x16(p.specular_kinds.x)
    let s_z = unpack_half2x16(p.specular_kinds.y & 0xffffu).x
    return restir_surface(p.position, p.specular_kinds.y >> 16u, pt.unpack_unit(p.normal), a_zr.y, float3(a_xy.x, a_xy.y, a_zr.x), float3(s_xy.x, s_xy.y, s_z))

fun pack_reservoir(r: restir_reservoir) -> packed_reservoir:
    return packed_reservoir(r.x_s, r.weight, pt.pack_unit(r.n_s), pt.pack_rgb(r.radiance), pt.pack_confidence(r.confidence) | (r.flags << 8u))

fun unpack_reservoir(p: packed_reservoir) -> restir_reservoir:
    return restir_reservoir(p.x_s, p.weight, pt.unpack_unit(p.n_s), (p.confidence_flags & 255u) as float, pt.unpack_rgb(p.radiance), p.confidence_flags >> 8u)

fun pack_di(r: di_reservoir) -> packed_di_reservoir:
    return packed_di_reservoir(r.point, r.weight, (r.light & 0xffffffu) | (pt.pack_confidence(r.confidence) << 24u))

fun unpack_di(p: packed_di_reservoir) -> di_reservoir:
    return di_reservoir(p.point, p.light_confidence & 0xffffffu, p.weight, (p.light_confidence >> 24u) as float)

/// A surface record of no visible point.
fun no_surface() -> restir_surface:
    let z3 = float3(0.0)
    return restir_surface(z3, 0u, z3, 0.0, z3, z3)

/// A reservoir that kept nothing, having seen `confidence` candidates.
fun empty_reservoir(confidence: float) -> restir_reservoir:
    let z3 = float3(0.0)
    return restir_reservoir(z3, 0.0, z3, confidence, z3, 0u)

/// The hit `slot` shades: its round's, or in ReSTIR's re-shade its persisted primary hit.
fun stored_hit(slot: uint){traced, wavefront_step} -> hit_record:
    if wavefront_step.mode == step_restir_shade => return traced.restir_visible[slot as int].hit
    return traced.hits[slot as int]

/// Appends `slot` to the round's output queue, which is the next round's input.
fun push_next(slot: uint){traced, wavefront_step}:
    let at = traced.counters[output_counter()].add(1u)
    if wavefront_step.parity == 0u:
        traced.queue_b[at as int] = slot
    else:
        traced.queue_a[at as int] = slot

fun push_finished(slot: uint){traced}:
    let at = traced.counters[counter_finished].add(1u)
    traced.queue_finished[at as int] = slot

fun push_shadow(slot: uint){traced}:
    let at = traced.counters[counter_shadow].add(1u)
    traced.queue_shadow[at as int] = slot

/// Appends `slot` to the hits waiting to shade, counted against the permutation its instance shades with.
fun push_hit(slot: uint, permutation: uint){traced}:
    let at = traced.counters[counter_hits].add(1u)
    traced.queue_hits[at as int] = slot
    traced.counters[counter_permutations + (permutation as int)].add(1u)

/// The workgroups that cover `count` threads, but never more than cover every slot: a corrupt count stays a valid dispatch.
fun groups_for(count: uint){wavefront_step} -> dispatch_args:
    let threads = min(count, wavefront_step.width * wavefront_step.height)
    return dispatch_args((threads + wavefront_group_size - 1u) / wavefront_group_size, 1u, 1u)

// ---- Pixels ---------------------------------------------------------------------------------------------------------

fun slot_pixel(slot: uint){wavefront_step} -> uint2:
    return uint2(slot % wavefront_step.width, slot / wavefront_step.width)

fun image_size(){wavefront_step} -> float2:
    return float2(wavefront_step.width as float, wavefront_step.height as float)

/// Component `i` of `v`, for an index known only at run time.
fun lane_of(v: float3, i: uint) -> float:
    if i == 0u => return v.x
    if i == 1u => return v.y
    return v.z

/// A tally with nothing in it.
fun empty_tally() -> pixel_tally:
    let z3 = float3(0.0)
    let z2 = float2(0.0)
    return pixel_tally(z3, 0.0, z3, 0.0, z3, 0.0, z3, 0.0, z3, 0.0, z3, 0.0, z3, -1.0, z2, z2, z2, z2)

/// A candidate with nothing in it: no light kept apart, and a continuation factor of 1.
fun empty_candidate() -> restir_candidate:
    let z3 = float3(0.0)
    return restir_candidate(float3(1.0), 0.0, z3, 0u, z3, z3, z3, z3, z3, z3)

// ---- Instances ------------------------------------------------------------------------------------------------------

/// `v` in world space, through the instance's placement rows.
fun instance_to_world(inst: scene.instance, v: float3) -> float3:
    return float3(dot(inst.to_world_x.xyz, v), dot(inst.to_world_y.xyz, v), dot(inst.to_world_z.xyz, v))

/// Normal `n` in world space: by the inverse transpose of the placement's linear part, so a non-uniform scale tilts it as it must.
/// The cofactor matrix is the inverse transpose up to the determinant, whose sign alone survives the normalization.
fun instance_normal_to_world(inst: scene.instance, n: float3) -> float3:
    let r0 = inst.to_world_x.xyz
    let r1 = inst.to_world_y.xyz
    let r2 = inst.to_world_z.xyz
    let c0 = cross(r1, r2)
    let det = dot(r0, c0)
    let m = float3(dot(c0, n), dot(cross(r2, r0), n), dot(cross(r0, r1), n))
    if det < 0.0 => return -m
    return m

// ---- Starting a sample ----------------------------------------------------------------------------------------------

/// Starts a new sample in `slot`: a jittered camera ray, and a path that has gathered nothing yet.
/// `rng` is the slot's random state, which continues from sample to sample so no two of a pixel's samples share a sequence.
fun start_sample(slot: uint, rng_in: uint){traced, wavefront_step}:
    let f = traced.frame[0]
    let px = slot_pixel(slot)
    let mut rng = rng_in
    let jitter_x = pt.rand(mut rng)
    let jitter_y = pt.rand(mut rng)
    let jitter = if f.fixed_jitter != 0u => f.jitter else float2(jitter_x, jitter_y)
    let cam = scene.camera(..f.camera)
    let pixel = float2(px.x as float, px.y as float) + jitter
    let dir = normalize(scene.camera_ray_offset(cam, pixel, image_size()))

    let s = slot as int
    traced.path_rays[s] = path_ray(cam.position, dir)
    traced.path_states[s] = path_state(float3(1.0), 0.0, rng, path_flag_alive | path_flag_primary | path_flag_prev_nee_reachable, 0u, 0u, f.generation, jitter, 0u)
    traced.path_media[s] = path_medium(float3(0.0), float3(0.0), 0.0, 3u)
    traced.path_lights[s] = path_light(float3(0.0), float3(0.0))
    if restir_on():
        traced.restir_candidates[s] = pack_candidate(empty_candidate())
        traced.restir_surfaces[restir_index(slot, false)] = pack_surface(no_surface())

/// Whether a free slot starts a sample now: always at a full fill, and below it with probability `fill / fill_full`.
/// Below a full fill the draw advances the slot's own stream `rng`, so a slot passed over draws afresh the next time.
fun fills(rng: mut uint){wavefront_step} -> bool:
    if wavefront_step.fill >= fill_full => return true
    return pt.rand(mut rng) < (wavefront_step.fill as float) / (fill_full as float)

// ---- begin: one thread per pixel, before the first round ------------------------------------------------------------

/// Clears what this frame tallies, kills every path on a restart, and starts a sample in every slot without one.
/// A carrying frame starts one only in the share of those slots `fill` asks for.
/// Every live slot is queued for the first round, whose input is `queue_a`.
fun wavefront_begin(slot: uint){traced, wavefront_step}:
    if slot >= wavefront_step.width * wavefront_step.height => return
    let f = traced.frame[0]
    let s = slot as int
    let restart = (f.wavefront_flags & wavefront_flag_restart) != 0u

    let mut tally = if restart => empty_tally() else traced.tallies[s]
    tally.frame_count = 0.0
    tally.frame_sum = float3(0.0)
    tally.frame_sum_specular = float3(0.0)
    tally.frame_primary_count = 0.0
    tally.frame_motion = float2(0.0)
    // The depth and the hit distances carry over a still frame, like the other guides: few of its slots start a primary ray.
    traced.tallies[s] = tally

    let st = traced.path_states[s]
    let alive = (st.flags & path_flag_alive) != 0u and st.generation == f.generation and not restart
    if not alive:
        let px = slot_pixel(slot)
        let mut rng = if restart => pt.hash(px.x + px.y * wavefront_step.width + f.rng_seed * 9781u) else st.rng
        let starts = restart or fills(mut rng)
        if not starts:
            let mut waiting = st
            waiting.flags = 0u
            waiting.rng = rng
            traced.path_states[s] = waiting
            return
        start_sample(slot, rng)

    let at = traced.counters[counter_queue_a].add(1u)
    traced.queue_a[at as int] = slot

// ---- extend: the round's segments, traced ---------------------------------------------------------------------------

/// Traces the segment of the round's path at `index` and records the nearest hit it accepted.
fun wavefront_extend(index: uint){traced, bindless, wavefront_step}:
    if index >= round_count() => return
    let slot = round_slot(index)
    let s = slot as int
    let r = traced.path_rays[s]
    let px = slot_pixel(slot)
    let launch = int3(px.x as int, px.y as int, 0)
    let pr = ray(origin = pos3(r.origin.x, r.origin.y, r.origin.z), direction = vec3(r.direction.x, r.direction.y, r.direction.z), t_min = 1e-3, t_max = 1e4)
    let h = traced.world.trace(pr, any_hit = c => cutout(c, launch, candidate_opacity(c)), intersection = intersect_quadric, procedural_any_hit = c => hit_decision.accept)

    if h.kind == hit_kind.triangle:
        traced.hits[s] = hit_record(h.instance_id as uint, h.primitive_index as uint, hit_triangle, h.t, float2(h.barycentrics.y, h.barycentrics.z), float3(0.0))
    else if h.kind == hit_kind.procedural:
        traced.hits[s] = hit_record(h.instance_id as uint, h.primitive_index as uint, hit_procedural, h.t, float2(0.0), h.procedural().attributes.normal)
    else:
        traced.hits[s] = hit_record(0u, 0u, hit_none, -1.0, float2(0.0), float3(0.0))

// ---- segment: what the hit's material does not decide ---------------------------------------------------------------

/// Settles the round's path at `index` up to its hit's material: the medium it crossed, the analytic lights it passed, and an escape.
/// A path that scattered goes on to the next round, one that ended to finalize, and one that reached a surface to shade.
/// Settles the round's path at `index` up to its hit's material: the medium it crossed, the analytic lights it passed, and an escape.
/// Returns the slot, its route and, for a hit, the permutation that shades it.
fun segment_settle(index: uint){traced, wavefront_step} -> uint3:
    if index >= round_count() => return uint3(0u, route_none, 0u)
    let slot = round_slot(index)
    let s = slot as int
    let f = traced.frame[0]
    let r = traced.path_rays[s]
    let mut st = traced.path_states[s]
    let md = traced.path_media[s]
    let mut light = traced.path_lights[s]
    let hit = traced.hits[s]

    let hit_t = if hit.kind == hit_none => -1.0 else hit.t
    let mut origin = r.origin
    let mut dir = r.direction
    let mut throughput = st.throughput
    let mut rng = st.rng
    let b = st.bounce
    let primary = (st.flags & path_flag_primary) != 0u
    let path_is_specular = (st.flags & path_flag_specular) != 0u
    let prev_nee_reachable = (st.flags & path_flag_prev_nee_reachable) != 0u

    // The primary segment reprojects, hit or miss; an escape is a point at infinity, so the sky moves with rotation alone.
    if primary:
        let px = slot_pixel(slot)
        let prev = scene.camera(..f.previous_camera)
        let offset = if hit_t >= 0.0 => origin + dir * hit_t - prev.position else dir
        let mut tally = traced.tallies[s]
        tally.frame_motion += (float2(px.x as float, px.y as float) + st.jitter) - scene.camera_project(prev, offset, image_size())
        tally.frame_primary_count += 1.0
        // An escaped primary ray describes no surface, which the guides read as zeros: counted, nothing summed.
        if hit_t < 0.0:
            tally.guide_count += 1.0
            st.flags = st.flags & ~path_flag_primary
            // The depth raster sees where the first primary ray since the restart landed; one that escaped is the far plane.
            if tally.primary_view_depth < 0.0 => tally.primary_view_depth = escaped_view_depth
        traced.tallies[s] = tally
    else if b == 1u:
        // The first SECONDARY hit's distance, which a split-signal denoiser sizes its reprojection from.
        // An escape is COUNTED rather than summed as zero, since zero is what REBLUR reads as contact.
        let mut tally = traced.tallies[s]
        let escaped = hit_t < 0.0
        let hit_add = if escaped => float2(0.0) else float2(hit_t, 1.0)
        let escape_add = if escaped => 1.0 else 0.0
        if path_is_specular:
            tally.hit_specular += hit_add
            tally.escaped.y += escape_add
        else:
            tally.hit_diffuse += hit_add
            tally.escaped.x += escape_add
        traced.tallies[s] = tally

    let inside = any(md.sigma_t > float3(0.0))
    let scattering = inside and any(md.albedo > float3(0.0))
    let mut ended = false
    let mut lit = false

    if scattering:
        // A scattering interior is walked rather than crossed: the segment may end at a particle instead of at the surface.
        // Distance is drawn against ONE channel's extinction and the estimate is corrected for all three.
        let u_channel = pt.rand(mut rng)
        let dc = min((u_channel * 3.0) as uint, 2u)
        let sigma_pick = max(lane_of(md.sigma_t, dc), 1e-6)
        let u_distance = pt.rand(mut rng)
        let t = -log(max(1.0 - u_distance, 1e-9)) / sigma_pick

        let reaches_surface = hit_t >= 0.0 and t >= hit_t
        let traveled = if reaches_surface => hit_t else t
        let transmittance = exp(-md.sigma_t * traveled)
        let pdf3 = if reaches_surface => transmittance else md.sigma_t * transmittance
        let dist_pdf = (pdf3.x + pdf3.y + pdf3.z) / 3.0

        if dist_pdf <= 1e-12:
            ended = true
        else if not reaches_surface:
            // A real scattering event: the phase function is its own pdf, so the turn carries no weight beyond the albedo.
            throughput *= (transmittance * md.sigma_t * md.albedo) / dist_pdf
            origin = origin + dir * t
            let u_phase_1 = pt.rand(mut rng)
            let u_phase_2 = pt.rand(mut rng)
            let scattered = pt.sample_hg(dir, md.g, u_phase_1, u_phase_2)
            st.prev_pdf = pt.hg_phase(dot(dir, scattered), md.g)
            st.flags = (st.flags & ~path_flag_prev_nee_reachable) & ~path_flag_primary
            dir = scattered
            st.scatters += 1u

            let mut continues = pt.is_finite(throughput)
            if continues and (st.scatters as int) > pt.roulette_after:
                let q = clamp(max(throughput.x, max(throughput.y, throughput.z)), 0.05, 1.0)
                let u_roulette = pt.rand(mut rng)
                if u_roulette >= q:
                    continues = false
                else:
                    throughput /= q
            if (st.scatters as int) > pt.scatter_cap => continues = false

            st.throughput = throughput
            st.rng = rng
            traced.path_states[s] = st
            traced.path_rays[s] = path_ray(origin, dir)
            let route = if continues => route_next else route_finished
            return uint3(slot, route, 0u)
        else:
            throughput *= transmittance / dist_pdf
    else if inside and hit_t > 0.0:
        // A purely absorbing interior needs no walk: Beer-Lambert over the whole segment.
        throughput *= exp(-md.sigma_t * hit_t)

    // A ray that escapes while still inside a solid traveled an unbounded distance through it, so nothing survives.
    let escaped_inside = inside and hit_t < 0.0

    // What the light held before this segment's lights, so the segment leaving ReSTIR's visible point can take its share back out.
    let before = light
    if not (ended or escaped_inside):
        // The BSDF strategy for every rect this segment crosses, and the camera's view of the ones it may see.
        let begin_area = f.path_offset.y
        let end_area = begin_area + f.path_count.y
        for i in (begin_area as int) ..< (end_area as int):
            let l = scene.light(..traced.lights[i])
            let mut t_light = 0.0
            let mut cos_light = 0.0
            if not pt.rect_intersect(l, origin, dir, mut t_light, mut cos_light) => continue
            let in_front = hit_t < 0.0 or t_light < hit_t
            let arriving = l.emission * scene.light_cone(l, cos_light)
            if b == 0u:
                if in_front and scene.light_visible_to_camera(l):
                    light.radiance += throughput * arriving
                    lit = true
            else if in_front or not scene.light_casts_shadows(l):
                let w = if prev_nee_reachable => pt.mis_weight(st.prev_pdf, pt.light_pdf(l, f.light_count, t_light * t_light, cos_light)) else 1.0
                let c = throughput * arriving * w
                light.radiance += c
                lit = true
                if path_is_specular => light.specular += c

        let begin_disc = f.path_offset.w
        let end_disc = begin_disc + f.path_count.w
        for i in (begin_disc as int) ..< (end_disc as int):
            let l = scene.light(..traced.lights[i])
            if not pt.in_disc(l, dir) => continue
            if b == 0u:
                if hit_t < 0.0 and scene.light_visible_to_camera(l):
                    light.radiance += throughput * l.emission
                    lit = true
            else if hit_t < 0.0 or not scene.light_casts_shadows(l):
                let w = if prev_nee_reachable => pt.mis_weight(st.prev_pdf, pt.disc_pdf(l, f.light_count)) else 1.0
                let c = throughput * l.emission * w
                light.radiance += c
                lit = true
                if path_is_specular => light.specular += c

    if hit_t < 0.0 and not (ended or escaped_inside):
        // Escaped to the SH environment: the primary ray sees it at full weight, a bounce ray as the BSDF strategy of the hit's own estimate.
        let emission = scene.background_radiance(background_sh(), normalize(dir))
        // The environment's sample reaches only the shading frame's upper hemisphere, and a medium scatter takes none.
        let w = if b == 0u or not prev_nee_reachable => 1.0 else pt.mis_weight(st.prev_pdf, pt.env_pdf())
        let c = throughput * emission * w
        light.radiance += c
        lit = true
        if path_is_specular and b > 0u => light.specular += c

    // The segment leaving ReSTIR's visible point: what it reaches directly is x_v's direct light, at the factor the path was rebased by.
    // A surface it meets through vacuum is the candidate's `x_s`.
    // A segment after a scatter, or one that left x_v by transmission, is part of `L_i` instead, and finalize folds it back into `direct`.
    if (st.flags & path_flag_split) != 0u and b == 1u and prev_nee_reachable:
        let mut cand = unpack_candidate(traced.restir_candidates[s])
        cand.direct += cand.rebase * (light.radiance - before.radiance)
        cand.direct_specular += cand.rebase * (light.specular - before.specular)
        light = before
        if (cand.flags & restir_flag_reflected) != 0u and hit_t >= 0.0 and not inside:
            cand.x_s = origin + dir * hit_t
            cand.flags = cand.flags | restir_flag_candidate
        traced.restir_candidates[s] = pack_candidate(cand)

    // Only what this segment changed goes back: off a medium the ray, the throughput and the random state are as extend left them.
    if inside or (primary and hit_t < 0.0):
        st.throughput = throughput
        st.rng = rng
        traced.path_states[s] = st
    if lit => traced.path_lights[s] = light

    if ended or hit_t < 0.0 => return uint3(slot, route_finished, 0u)

    let inst = scene.instance(..traced.instances[hit.instance as int])
    return uint3(slot, route_hit, inst.shade_group)

/// Settles the round's path at `index`, then appends it where `segment_settle` routed it.
///
/// Each queue is appended to from exactly one place, which NVIDIA's dx12 driver needs alongside `input_counter` (docs/wavefront.md).
fun wavefront_segment(index: uint){traced, wavefront_step}:
    let r = segment_settle(index)
    if r.y == route_next => push_next(r.x)
    if r.y == route_finished => push_finished(r.x)
    if r.y == route_hit => push_hit(r.x, r.z)

// ---- sort: the hits by permutation ----------------------------------------------------------------------------------

/// Places the hit at `index` into its permutation's range of `queue_sorted`.
fun wavefront_sort(index: uint){traced, wavefront_step}:
    if index >= traced.counters[counter_hits].load() => return
    let slot = traced.queue_hits[index as int]
    let hit = stored_hit(slot)
    let inst = scene.instance(..traced.instances[hit.instance as int])
    let permutation = inst.shade_group
    let cursor_index = counter_permutations + (traced.frame[0].permutation_count as int) + (permutation as int)
    let at = traced.shade_offsets[permutation as int] + traced.counters[cursor_index].add(1u)
    traced.queue_sorted[at as int] = slot

/// The slot thread `index` of a shade dispatch shades: an element of its permutation's range, or `no_slot` past its end.
fun shade_slot(index: uint){traced, wavefront_step} -> uint:
    let permutation = wavefront_step.permutation as int
    if index >= traced.counters[counter_permutations + permutation].load() => return no_slot
    return traced.queue_sorted[(traced.shade_offsets[permutation] + index) as int]

// ---- shade: what a generated kernel calls once its material has evaluated ------------------------------------------

/// The shading context of the triangle hit `slot` recorded.
fun stored_triangle_context(slot: uint){traced, bindless, wavefront_step} -> material.shading_context:
    let hit = stored_hit(slot)
    let inst = scene.instance(..traced.instances[hit.instance as int])
    let indices = inst.indices as int
    return material.make_context(inst, bindless.buffers[nonuniform indices], hit.primitive, hit.barycentrics)

/// The shading context of the quadric hit `slot` recorded.
fun stored_quadric_context(slot: uint){traced, wavefront_step} -> material.shading_context:
    let hit = stored_hit(slot)
    let inst = scene.instance(..traced.instances[hit.instance as int])
    return quadric.make_context(inst, hit.primitive)

/// Shades the triangle hit of `slot`, whose material evaluated to `surface` — the wavefront's `shade_triangle`.
fun shade_stored_triangle(slot: uint, ctx: material.shading_context, surface: openpbr.surface, supplied_tangent_frame: bool){traced, bindless, slug.tables, wavefront_step}:
    let hit = stored_hit(slot)
    let inst = scene.instance(..traced.instances[hit.instance as int])
    let v0 = instance_position(inst, ctx.corner.x)
    let v1 = instance_position(inst, ctx.corner.y)
    let v2 = instance_position(inst, ctx.corner.z)
    shade_stored(slot, inst, normalize(cross(v1 - v0, v2 - v0)), surface, supplied_tangent_frame)

/// Shades the quadric hit of `slot` from the normal its intersection reported — the wavefront's `shade_quadric`.
fun shade_stored_quadric(slot: uint, surface: openpbr.surface, supplied_tangent_frame: bool){traced, bindless, slug.tables, wavefront_step}:
    let hit = stored_hit(slot)
    let inst = scene.instance(..traced.instances[hit.instance as int])
    shade_stored(slot, inst, hit.normal, surface, supplied_tangent_frame)

/// Writes one next-event sample of `slot`: a shadowless one counts now, one with a shadow ray waits for connect.
/// `j` is which of the slot's two shadow rays it is.
/// `marker` sends what arrives to ReSTIR's direct light rather than the path's: 1 for it alone, 2 for its light part too.
fun defer_light(slot: uint, j: uint, sample: light_sample, throughput: float3, b: uint, path_is_specular: bool, marker: float, light: mut path_light){traced} -> bool:
    let radiance = throughput * (sample.diffuse + sample.specular)
    let specular = if b == 0u => throughput * sample.specular else (if path_is_specular => radiance else float3(0.0))
    let at = (2u * slot + j) as int
    if sample.tested == 0u:
        light.radiance += radiance
        light.specular += specular
        traced.shadow_rays[at] = shadow_ray(sample.origin, 0.0, sample.direction, 0u, float3(0.0), 0.0, float3(0.0), 0.0)
        return false
    traced.shadow_rays[at] = shadow_ray(sample.origin, sample.distance, sample.direction, 1u, radiance, marker, specular, 0.0)
    return true

/// The tail both geometry kinds share: the hit faced toward its ray, shaded, and the path moved on.
fun shade_stored(slot: uint, inst: scene.instance, n_obj: float3, surface: openpbr.surface, supplied_tangent_frame: bool){traced, bindless, slug.tables, wavefront_step}:
    if wavefront_step.mode == step_restir_shade:
        restir_shade_stored(slot, inst, n_obj, surface, supplied_tangent_frame)
        return
    let s = slot as int
    let f = traced.frame[0]
    let hit = traced.hits[s]
    let r = traced.path_rays[s]
    let mut st = traced.path_states[s]
    let md = traced.path_media[s]
    let mut light = traced.path_lights[s]

    let ray_origin = r.origin
    let ray_dir = r.direction
    let mut n = normalize(instance_normal_to_world(inst, n_obj))
    let v = -normalize(ray_dir)
    let exiting = dot(n, v) < 0.0
    if exiting => n = -n

    // The authored frame is in object space, so it moves with the instance the geometry does.
    let mut authored = openpbr.frame(float3(0.0), float3(0.0), float3(0.0))
    if supplied_tangent_frame:
        let local = openpbr.frame_from_quaternion(surface.geometry_tangent_frame, surface.geometry_handedness)
        authored = openpbr.frame(normalize(instance_to_world(inst, local.t)), normalize(instance_to_world(inst, local.b)), normalize(instance_to_world(inst, local.n)))

    let last_bounce = if st.bounce + 1u >= (f.max_bounces as uint) => 1u else 0u
    let mut p = surface_payload_for(st.rng, md.sigma_t, md.albedo, md.g, md.channel, last_bounce)
    let mut light_s = no_light_sample()
    let mut env_s = no_light_sample()
    shade_sampled(mut p, surface, n, v, exiting, ray_origin, ray_dir, hit.t, authored, supplied_tangent_frame, mut light_s, mut env_s)

    let b = st.bounce
    let throughput = st.throughput
    let mut path_is_specular = (st.flags & path_flag_specular) != 0u

    // ReSTIR's visible point `x_v`: its own light is kept apart from what the continuation gathers, and its hit is kept to shade again.
    let restir_here = restir_on() and (st.flags & path_flag_primary) != 0u
    let mut cand = if restir_here => unpack_candidate(traced.restir_candidates[s]) else empty_candidate()

    if (st.flags & path_flag_primary) != 0u:
        // Linear view depth rather than the distance along the ray, which grows toward the image's edges.
        let cam = scene.camera(..f.camera)
        let mut tally = traced.tallies[s]
        tally.normal_sum += p.normal
        tally.depth_sum += hit.t * dot(ray_dir, normalize(cam.forward))
        tally.albedo_sum += p.albedo
        tally.specular_albedo_sum += p.specular_albedo
        tally.roughness_sum += p.roughness
        tally.guide_count += 1.0

        // The depth raster sees at the pixel CENTER: the center ray met with the plane the first primary hit lies on.
        if tally.primary_view_depth < 0.0:
            let px = slot_pixel(slot)
            let center = normalize(scene.camera_ray_offset(cam, float2(px.x as float, px.y as float) + 0.5, image_size()))
            let facing = dot(p.normal, center)
            let t = if abs(facing) > 1e-6 => dot(p.normal, ray_dir * hit.t) / facing else hit.t
            let t_forward = if t > 0.0 => t else hit.t
            tally.primary_view_depth = t_forward * dot(center, normalize(cam.forward))
        traced.tallies[s] = tally

        // The lobe the continuation was drawn from is what this path IS, for the denoiser's purposes.
        path_is_specular = openpbr.bsdf_lobe_is_specular(p.lobe)
        st.flags = st.flags & ~path_flag_primary
        if path_is_specular => st.flags = st.flags | path_flag_specular

    // A surface's own emission reaches the camera directly and contributes nothing indirectly.
    if b == 0u => light.radiance += throughput * p.emission

    // At ReSTIR's visible point the light sample's shadow ray is marked as the light part of `direct`, the environment's as direct alone.
    // The light part is the next-event sample alone, and only toward the hemisphere ReSTIR DI's target covers; the rest stays the path's own.
    // A dispersive surface shaded one wavelength's closure, which the re-shade does not rebuild, so its light stays the path's own.
    let di_surface = not (surface.transmission_dispersion_scale > 0.0 and surface.transmission_weight > 0.0)
    let di_reaches = di_surface and dot(n, light_s.direction) > 0.0
    let light_marker = if restir_here => (if di_reaches => 2.0 else 1.0) else 0.0
    let env_marker = if restir_here => 1.0 else 0.0
    let light_waits = defer_light(slot, 0u, light_s, throughput, b, path_is_specular, light_marker, mut light)
    let env_waits = defer_light(slot, 1u, env_s, throughput, b, path_is_specular, env_marker, mut light)
    if light_waits or env_waits => push_shadow(slot)

    if restir_here:
        traced.restir_visible[s] = visible_hit(hit, ray_dir)
        // Decided by the material, never by this frame's sample, so the history's domain never depends on a draw.
        let collapses = surface.transmission_dispersion_scale > 0.0 and surface.transmission_weight > 0.0
        let shiftable = all(md.sigma_t <= float3(0.0)) and not collapses
        let rough = p.roughness >= restir_reconnect_roughness
        let kinds = restir_surface_visible | (if shiftable => restir_surface_shiftable else 0u) | (if rough => restir_surface_rough else 0u)
        traced.restir_surfaces[restir_index(slot, false)] = pack_surface(restir_surface(ray_origin + ray_dir * hit.t, kinds, n, p.roughness, p.albedo, p.specular_albedo))
        st.flags = st.flags | path_flag_split
        cand.flags = cand.flags | restir_flag_visible
        if di_surface => cand.flags = cand.flags | restir_flag_di
        cand.direct += light.radiance
        cand.direct_specular += light.specular
        // A light that casts no shadow added its sample at once rather than through a shadow ray.
        let untested_part = light_s.tested == 0u and di_reaches
        if untested_part:
            cand.light_part += throughput * (light_s.diffuse + light_s.specular)
            cand.light_part_specular += throughput * light_s.specular
        light = path_light(float3(0.0), float3(0.0))
    else if (st.flags & path_flag_split) != 0u and b == 1u:
        // ReSTIR's `x_s`: the normal a reconnection is weighed by, and whether it is rough enough to reconnect to at all.
        let mut at_s = unpack_candidate(traced.restir_candidates[s])
        if (at_s.flags & restir_flag_candidate) != 0u:
            at_s.n_s = p.normal
            if p.roughness >= restir_reconnect_roughness => at_s.flags = at_s.flags | restir_flag_reconnectable
            traced.restir_candidates[s] = pack_candidate(at_s)

    let mut rng = p.rng
    let mut continues = not all(p.throughput <= float3(0.0))
    if continues:
        let mut next_throughput = throughput * p.throughput
        if restir_here:
            // Past x_v the path gathers `L_i` alone: the continuation's factor is kept, and the throughput starts over at 1.
            cand.rebase = next_throughput
            cand.source_pdf = p.bsdf_pdf
            next_throughput = float3(1.0)
            let reflected = dot(p.direction, p.normal) > 0.0
            let vacuum = all(md.sigma_t <= float3(0.0)) and all(p.medium_sigma_t <= float3(0.0)) and p.channel >= 3u
            if reflected and vacuum => cand.flags = cand.flags | restir_flag_reflected
        st.prev_pdf = p.bsdf_pdf
        // The next segment's light hits weigh against next-event estimation only where it could have sampled this direction.
        if p.nee_reachable != 0u:
            st.flags = st.flags | path_flag_prev_nee_reachable
        else:
            st.flags = st.flags & ~path_flag_prev_nee_reachable
        st.bounce = b + 1u

        // The offset follows the direction rather than the normal: a refracted continuation leaves on the far side.
        let side = if dot(p.direction, p.normal) < 0.0 => -1e-3 else 1e-3
        traced.path_rays[s] = path_ray(ray_origin + ray_dir * hit.t + p.normal * side, p.direction)
        traced.path_media[s] = path_medium(p.medium_sigma_t, p.medium_albedo, p.medium_g, p.channel)

        if st.bounce >= (f.max_bounces as uint):
            continues = false
        else if f.roulette_after > 0u and st.bounce > f.roulette_after:
            // Russian roulette ends a path that carries little, without taking its energy with it.
            let q = clamp(max(next_throughput.x, max(next_throughput.y, next_throughput.z)), 0.05, 1.0)
            let u_roulette = pt.rand(mut rng)
            if u_roulette >= q:
                continues = false
            else:
                next_throughput /= q
        st.throughput = next_throughput

    st.rng = rng
    traced.path_states[s] = st
    traced.path_lights[s] = light
    if restir_here => traced.restir_candidates[s] = pack_candidate(cand)
    if continues:
        push_next(slot)
    else:
        push_finished(slot)

// ---- ReSTIR: the persisted primary hits, shaded again -----------------------------------------------------------------

/// ReSTIR's target function at the visible surface `surf` seen from `eye`, for a sample at `x_s` sending `radiance` toward it.
/// A diffuse lobe and one GGX lobe built from the surface's guides, never its material, so every pass evaluates it without material code.
/// A small floor keeps it positive over the whole reflected hemisphere of the geometric normal, which GRIS needs to stay unbiased.
/// Below that hemisphere a continuation is never a candidate: the pixel's own path keeps that light in `direct`.
fun restir_target(surf: restir_surface, eye: float3, x_s: float3, radiance: float3) -> float:
    // From the point lifted off the surface, as shade placed the continuation, so a candidate's own `x_s` is never below it.
    // The stored normal is octahedral, so a continuation within ~5e-5 radians of grazing may still read as below it and drop out.
    return restir_target_toward(surf, eye, normalize(x_s - (surf.position + surf.normal * 1e-3)), radiance)

/// `restir_target` for light arriving from the unit direction `wi`, which ReSTIR DI's samples give directly.
fun restir_target_toward(surf: restir_surface, eye: float3, wi: float3, radiance: float3) -> float:
    let cos_i = dot(surf.normal, wi)
    if cos_i <= 0.0 => return 0.0
    let wo = normalize(eye - surf.position)
    let cos_o = max(dot(surf.normal, wo), 1e-3)
    let h = normalize(wo + wi)
    let alpha = max(surf.roughness * surf.roughness, 1e-3)
    let a2 = alpha * alpha
    let nh = max(dot(surf.normal, h), 0.0)
    let lobe = nh * nh * (a2 - 1.0) + 1.0
    let d = a2 / (pt.pi * lobe * lobe)
    let f = surf.albedo / pt.pi + surf.specular_albedo * (d / (4.0 * cos_o * max(cos_i, 1e-3))) + float3(1e-3)
    let c = f * cos_i * radiance
    return dot(c, float3(0.2126, 0.7152, 0.0722))

/// How solid angle at the visible point `to` relates to solid angle at `from`, for a sample at `x_s` with normal `n_s`.
/// The reconnection shift keeps `x_s`, so it moves the sample's direction and nothing else: 0 where either point sees `x_s` from behind.
fun reconnection_jacobian(x_s: float3, n_s: float3, from: float3, to: float3) -> float:
    let a = from - x_s
    let b = to - x_s
    let a2 = dot(a, a)
    let b2 = dot(b, b)
    if a2 <= 0.0 or b2 <= 0.0 => return 0.0
    let cos_from = dot(n_s, a) / sqrt(a2)
    let cos_to = dot(n_s, b) / sqrt(b2)
    if cos_from <= 1e-4 or cos_to <= 1e-4 => return 0.0
    return (cos_to / cos_from) * (a2 / b2)

/// Whether nothing blocks the segment from the visible point `from`, lifted off along `n`, to `x_s`.
fun restir_unblocked(from: float3, n: float3, x_s: float3, launch: int3){traced, bindless} -> bool:
    let origin = from + n * 1e-3
    let to = x_s - origin
    let distance = length(to)
    if distance <= 2e-3 => return true
    let dir = to / distance
    let r = ray(origin = pos3(origin.x, origin.y, origin.z), direction = vec3(dir.x, dir.y, dir.z), t_min = 1e-3, t_max = distance - 1e-3)
    let h = traced.world.trace(r, any_hit = c => cutout(c, launch, candidate_opacity(c)), intersection = intersect_quadric, procedural_any_hit = c => hit_decision.accept, flags = ray_flags.accept_first_hit_and_end_search)
    return h.kind == hit_kind.none

/// ReSTIR's temporal reuse for `slot`: this frame's candidate merged with the reservoir its visible point kept last frame.
/// The history's sample moves to this visible point by reconnection, with its Jacobian and a visibility ray.
/// The two are weighed by the generalized balance heuristic, with the candidate's confidence 1 against the history's.
/// Writes this frame's half of the reservoirs, an empty one where the pixel has no visible point or its path did not finish.
fun wavefront_restir_temporal(slot: uint){traced, bindless, wavefront_step}:
    if slot >= wavefront_step.width * wavefront_step.height => return
    let f = traced.frame[0]
    let s = slot as int
    let at = restir_index(slot, false)
    let surf = unpack_surface(traced.restir_surfaces[at])
    let cand = unpack_candidate(traced.restir_candidates[s])
    if surf.kinds == 0u or (cand.flags & restir_flag_finished) == 0u:
        traced.restir_reservoirs[at] = pack_reservoir(empty_reservoir(0.0))
        return

    let cam = scene.camera(..f.camera)
    let eye = cam.position
    let px = slot_pixel(slot)
    let launch = int3(px.x as int, px.y as int, 0)
    let exact = (f.wavefront_flags & wavefront_flag_restir_exact) != 0u
    // A stream of its own: the pixel, the frame's seed and the pass, so no other pass draws the same numbers.
    let mut rng = pt.hash(slot ^ pt.hash(f.rng_seed * 7919u + 101u))

    // The candidate: every visible point has one, empty where its continuation found no `x_s`.
    let has_candidate = (cand.flags & restir_flag_candidate) != 0u
    let p_c = if has_candidate => restir_target(surf, eye, cand.x_s, cand.radiance) else 0.0
    let source_weight = if cand.source_pdf > 0.0 => 1.0 / cand.source_pdf else 0.0

    // The history: the reservoir of the surface this visible point reprojects onto, where it is the same surface.
    let mut confidence_h = 0.0
    let mut hist = empty_reservoir(0.0)
    let mut hist_surf = surf
    let mut hist_eye = eye
    let history_on = (f.wavefront_flags & wavefront_flag_restir_history) != 0u
    let takes = (surf.kinds & restir_surface_shiftable) != 0u and (surf.kinds & restir_surface_rough) != 0u
    if history_on and takes:
        let prev = scene.camera(..f.previous_camera)
        let ahead = dot(surf.position - prev.position, normalize(prev.forward))
        let q = scene.camera_project(prev, surf.position - prev.position, image_size())
        let inside = ahead > 0.0 and q.x >= 0.0 and q.y >= 0.0 and q.x < image_size().x and q.y < image_size().y
        if inside:
            let prev_slot = (q.y as uint) * wavefront_step.width + (q.x as uint)
            let hs = unpack_surface(traced.restir_surfaces[restir_index(prev_slot, true)])
            let hr = unpack_reservoir(traced.restir_reservoirs[restir_index(prev_slot, true)])
            let depth = dot(surf.position - eye, normalize(cam.forward))
            if restir_same_surface(surf, hs, depth):
                hist = hr
                hist_surf = hs
                hist_eye = prev.position
                confidence_h = min(hr.confidence, restir_confidence_cap)

    // The history's sample shifted here: its target here, the Jacobian into this domain, and its target where it was kept.
    let mut p_h_here = 0.0
    let mut jacobian_h = 0.0
    let mut p_h_there = 0.0
    if hist.weight > 0.0 and (hist.flags & restir_flag_reconnectable) != 0u:
        jacobian_h = reconnection_jacobian(hist.x_s, hist.n_s, hist_surf.position, surf.position)
        if jacobian_h > 0.0:
            p_h_there = restir_target(hist_surf, hist_eye, hist.x_s, hist.radiance)
            p_h_here = restir_target(surf, eye, hist.x_s, hist.radiance)
            let worth_a_ray = p_h_here > 0.0 and p_h_there > 0.0
            if worth_a_ray and not restir_unblocked(surf.position, surf.normal, hist.x_s, launch) => p_h_here = 0.0

    // The candidate as the history's domain would have produced it, in this domain's measure, for its MIS weight.
    // That domain shifts reconnectable samples alone, so a glossy `x_s` is the candidate's own whatever the history holds.
    let mut p_c_there = 0.0
    let shareable = has_candidate and (cand.flags & restir_flag_reconnectable) != 0u
    if confidence_h > 0.0 and shareable:
        let jacobian_c = reconnection_jacobian(cand.x_s, cand.n_s, surf.position, hist_surf.position)
        if jacobian_c > 0.0:
            p_c_there = restir_target(hist_surf, hist_eye, cand.x_s, cand.radiance) * jacobian_c
            if exact and p_c_there > 0.0 and not restir_unblocked(hist_surf.position, hist_surf.normal, cand.x_s, launch) => p_c_there = 0.0

    // Generalized balance heuristic over the two domains, then one pick in proportion to the resampling weights.
    let mis_c = if p_c > 0.0 => p_c / (p_c + confidence_h * p_c_there) else 0.0
    let w_c = mis_c * p_c * source_weight
    let mut w_h = 0.0
    if p_h_here > 0.0 and p_h_there > 0.0:
        let there = confidence_h * p_h_there / jacobian_h
        let mis_h = there / (p_h_here + there)
        w_h = mis_h * p_h_here * hist.weight * jacobian_h

    let confidence = min(1.0 + confidence_h, restir_confidence_cap)
    let total = w_c + w_h
    let mut kept = empty_reservoir(confidence)
    if total > 0.0:
        let u = pt.rand(mut rng)
        // Rounding can carry `u * total` up to `total`; with no history weight the candidate is the pick then.
        let takes_candidate = u * total < w_c or w_h <= 0.0
        if takes_candidate:
            kept = restir_reservoir(cand.x_s, total / p_c, cand.n_s, confidence, cand.radiance, cand.flags & restir_flag_reconnectable)
        else:
            kept = restir_reservoir(hist.x_s, total / p_h_here, hist.n_s, confidence, hist.radiance, hist.flags & restir_flag_reconnectable)
    traced.restir_reservoirs[at] = pack_reservoir(kept)

/// Whether the visible point `b` is the same surface as `a`, as both reuse passes accept one.
/// A plane distance relative to the view depth `depth` and normals within 25°, on a surface `b` a sample may be reused from at all.
fun restir_same_surface(a: restir_surface, b: restir_surface, depth: float) -> bool:
    if (b.kinds & restir_surface_shiftable) == 0u => return false
    if (b.kinds & restir_surface_rough) == 0u => return false
    return restir_same_point(a, b, depth)

/// Whether the visible point `b` lies on `a`'s surface: a plane distance relative to the view depth `depth`, and normals within 25°.
/// ReSTIR DI's test: a light sample moves to any visible point, so neither a medium nor roughness is in the way.
fun restir_same_point(a: restir_surface, b: restir_surface, depth: float) -> bool:
    if (b.kinds & restir_surface_visible) == 0u => return false
    let plane = abs(dot(a.normal, b.position - a.position))
    return plane < restir_plane_tolerance * depth and dot(b.normal, a.normal) > restir_normal_tolerance

/// The target of a sample at the visible point `from` as the domain of `to` would see it, in `from`'s solid-angle measure.
/// That is `to`'s target after the reconnection shift, times the shift's Jacobian from `from` to `to`.
/// It is 0 where `to` could not hold the sample: a non-reconnectable one, `x_s` seen from behind, or under `exact` a blocked segment.
fun restir_target_from(r: restir_reservoir, from: restir_surface, to: restir_surface, eye: float3, exact: bool, launch: int3){traced, bindless} -> float:
    if (r.flags & restir_flag_reconnectable) == 0u => return 0.0
    let jacobian = reconnection_jacobian(r.x_s, r.n_s, from.position, to.position)
    if jacobian <= 0.0 => return 0.0
    let target = restir_target(to, eye, r.x_s, r.radiance)
    if target <= 0.0 => return 0.0
    if exact and not restir_unblocked(to.position, to.normal, r.x_s, launch) => return 0.0
    return target * jacobian

/// ReSTIR's spatial reuse for `slot`: its temporal reservoir, the canonical one, merged with a few neighbors' of this frame.
/// Each neighbor's sample moves here by reconnection, with its Jacobian and a visibility ray.
/// The weights are the generalized balance heuristic over every domain taking part, each weighed by its confidence.
/// Writes `traced.restir_spatial`, which the re-shade shades; the temporal reservoir stays what the next frame reuses.
fun wavefront_restir_spatial(slot: uint){traced, bindless, wavefront_step}:
    if slot >= wavefront_step.width * wavefront_step.height => return
    let f = traced.frame[0]
    let s = slot as int
    let center = unpack_surface(traced.restir_surfaces[restir_index(slot, false)])
    let own = unpack_reservoir(traced.restir_reservoirs[restir_index(slot, false)])
    let takes = (center.kinds & restir_surface_shiftable) != 0u and (center.kinds & restir_surface_rough) != 0u
    if not takes:
        traced.restir_spatial[s] = pack_reservoir(own)
        return

    let cam = scene.camera(..f.camera)
    let eye = cam.position
    let px = slot_pixel(slot)
    let launch = int3(px.x as int, px.y as int, 0)
    let exact = (f.wavefront_flags & wavefront_flag_restir_exact) != 0u
    let depth = dot(center.position - eye, normalize(cam.forward))
    let mut rng = pt.hash(slot ^ pt.hash(f.rng_seed * 7919u + 202u))

    // The neighbors that are the same surface: their reservoirs and surfaces, at most `restir_spatial_neighbors` of them.
    let mut n_res_0 = empty_reservoir(0.0)
    let mut n_res_1 = empty_reservoir(0.0)
    let mut n_surf_0 = center
    let mut n_surf_1 = center
    let mut found = 0
    let mut first = slot
    let radius = restir_spatial_radius()
    let size = image_size()
    let angle0 = pt.rand(mut rng)
    for i in 0 ..< restir_spatial_neighbors:
        // The golden ratio's fraction between the draws' angles keeps them apart around the pixel.
        let a = 2.0 * pt.pi * (angle0 + (i as float) * 0.618034)
        let r = radius * sqrt(pt.rand(mut rng))
        let q = float2(px.x as float, px.y as float) + 0.5 + float2(cos(a), sin(a)) * r
        let inside = q.x >= 0.0 and q.y >= 0.0 and q.x < size.x and q.y < size.y
        if not inside => continue
        let other = (q.y as uint) * wavefront_step.width + (q.x as uint)
        // A second draw landing on the first neighbor's pixel would weigh one domain twice.
        let repeated = other == slot or (found > 0 and other == first)
        if repeated => continue
        let ns = unpack_surface(traced.restir_surfaces[restir_index(other, false)])
        if not restir_same_surface(center, ns, depth) => continue
        let nr = unpack_reservoir(traced.restir_reservoirs[restir_index(other, false)])
        // A neighbor whose path did not finish saw no candidate: it would take a draw and weigh nothing.
        if nr.confidence <= 0.0 => continue
        if found == 0:
            n_res_0 = nr
            n_surf_0 = ns
            first = other
        else:
            n_res_1 = nr
            n_surf_1 = ns
        found += 1

    // Each domain's confidence; a neighbor not found takes no part.
    let c_own = own.confidence
    let c_0 = if found > 0 => n_res_0.confidence else 0.0
    let c_1 = if found > 1 => n_res_1.confidence else 0.0

    // The canonical sample's weight: its target here against what each neighbor's domain would make of it.
    let mut w_own = 0.0
    let mut p_own = 0.0
    if own.weight > 0.0:
        p_own = restir_target(center, eye, own.x_s, own.radiance)
        if p_own > 0.0:
            let from_0 = if c_0 > 0.0 => restir_target_from(own, center, n_surf_0, eye, exact, launch) else 0.0
            let from_1 = if c_1 > 0.0 => restir_target_from(own, center, n_surf_1, eye, exact, launch) else 0.0
            let mis = c_own * p_own / (c_own * p_own + c_0 * from_0 + c_1 * from_1)
            w_own = mis * p_own * own.weight

    // A neighbor's sample, shifted here: its target here, behind a visibility ray, against every domain's view of it.
    let mut w_0 = 0.0
    let mut p_0 = 0.0
    if c_0 > 0.0 and n_res_0.weight > 0.0 and (n_res_0.flags & restir_flag_reconnectable) != 0u:
        let jacobian = reconnection_jacobian(n_res_0.x_s, n_res_0.n_s, n_surf_0.position, center.position)
        if jacobian > 0.0:
            let there = restir_target(n_surf_0, eye, n_res_0.x_s, n_res_0.radiance)
            p_0 = restir_target(center, eye, n_res_0.x_s, n_res_0.radiance)
            let worth_a_ray = p_0 > 0.0 and there > 0.0
            if worth_a_ray and not restir_unblocked(center.position, center.normal, n_res_0.x_s, launch) => p_0 = 0.0
            if p_0 > 0.0:
                // Every domain's target of this sample, in the center's measure: here, at its own neighbor, at the other one.
                let at_home = there / jacobian
                let at_other = if c_1 > 0.0 => restir_target_from(n_res_0, n_surf_0, n_surf_1, eye, exact, launch) / jacobian else 0.0
                let mis = c_0 * at_home / (c_own * p_0 + c_0 * at_home + c_1 * at_other)
                w_0 = mis * p_0 * n_res_0.weight * jacobian

    let mut w_1 = 0.0
    let mut p_1 = 0.0
    if c_1 > 0.0 and n_res_1.weight > 0.0 and (n_res_1.flags & restir_flag_reconnectable) != 0u:
        let jacobian = reconnection_jacobian(n_res_1.x_s, n_res_1.n_s, n_surf_1.position, center.position)
        if jacobian > 0.0:
            let there = restir_target(n_surf_1, eye, n_res_1.x_s, n_res_1.radiance)
            p_1 = restir_target(center, eye, n_res_1.x_s, n_res_1.radiance)
            let worth_a_ray = p_1 > 0.0 and there > 0.0
            if worth_a_ray and not restir_unblocked(center.position, center.normal, n_res_1.x_s, launch) => p_1 = 0.0
            if p_1 > 0.0:
                let at_home = there / jacobian
                let at_other = if c_0 > 0.0 => restir_target_from(n_res_1, n_surf_1, n_surf_0, eye, exact, launch) / jacobian else 0.0
                let mis = c_1 * at_home / (c_own * p_1 + c_0 * at_other + c_1 * at_home)
                w_1 = mis * p_1 * n_res_1.weight * jacobian

    let total = w_own + w_0 + w_1
    let confidence = min(c_own + c_0 + c_1, restir_confidence_cap)
    let mut kept = empty_reservoir(confidence)
    if total > 0.0:
        let u = pt.rand(mut rng) * total
        let mut choice = 0
        if u >= w_own => choice = 1
        if u >= w_own + w_0 => choice = 2
        // Rounding can carry `u` up to `total` itself, past every weight; the last nonzero one is the pick then.
        if choice == 2 and w_1 <= 0.0 => choice = 1
        if choice == 1 and w_0 <= 0.0 => choice = 0
        if choice == 0:
            kept = restir_reservoir(own.x_s, total / p_own, own.n_s, confidence, own.radiance, own.flags)
        else if choice == 1:
            kept = restir_reservoir(n_res_0.x_s, total / p_0, n_res_0.n_s, confidence, n_res_0.radiance, n_res_0.flags)
        else:
            kept = restir_reservoir(n_res_1.x_s, total / p_1, n_res_1.n_s, confidence, n_res_1.radiance, n_res_1.flags)
    traced.restir_spatial[s] = pack_reservoir(kept)

/// Queues every pixel whose candidate the re-shade can shade, by the permutation its primary hit shades with, and clears every result.
fun wavefront_restir_gather(slot: uint){traced, wavefront_step}:
    if slot >= wavefront_step.width * wavefront_step.height => return
    let s = slot as int
    traced.restir_results[s] = restir_result(float3(0.0), 0u, float3(0.0))
    let usable = restir_flag_visible | restir_flag_finished
    if (traced.restir_candidates[s].flags & usable) != usable => return
    let hit = traced.restir_visible[s].hit
    let inst = scene.instance(..traced.instances[hit.instance as int])
    push_hit(slot, inst.shade_group)

/// ReSTIR's re-shade of `slot`'s persisted primary hit, whose material evaluated to `surface_in`.
/// It builds the closure exactly as the hit's shade did, and evaluates it toward the kept sample's `x_s`.
/// Under `wavefront_flag_restir_di` it also evaluates it toward DI's kept light sample, behind one shadow ray.
/// With reuse and DI off the sample is the pixel's own, so the result is the path's own estimate to rounding.
fun restir_shade_stored(slot: uint, inst: scene.instance, n_obj: float3, surface_in: openpbr.surface, supplied_tangent_frame: bool){traced, bindless, slug.tables, wavefront_step}:
    let s = slot as int
    let f = traced.frame[0]
    let vis = traced.restir_visible[s]
    let cand = unpack_candidate(traced.restir_candidates[s])
    let spatial = (f.wavefront_flags & wavefront_flag_restir_spatial) != 0u
    let kept = if spatial => unpack_reservoir(traced.restir_spatial[s]) else unpack_reservoir(traced.restir_reservoirs[restir_index(slot, false)])

    let mut n = normalize(instance_normal_to_world(inst, n_obj))
    let v = -normalize(vis.direction)
    let exiting = dot(n, v) < 0.0
    if exiting => n = -n

    let mut authored = openpbr.frame(float3(0.0), float3(0.0), float3(0.0))
    if supplied_tangent_frame:
        let local = openpbr.frame_from_quaternion(surface_in.geometry_tangent_frame, surface_in.geometry_handedness)
        authored = openpbr.frame(normalize(instance_to_world(inst, local.t)), normalize(instance_to_world(inst, local.b)), normalize(instance_to_world(inst, local.n)))

    let x_v = scene.camera(..f.camera).position + vis.direction * vis.hit.t
    let mut surface = surface_in
    apply_decals(mut surface, x_v, n, f.pixel_spread * vis.hit.t)
    let frame = openpbr.shading_frame(mut surface, n, v, authored, supplied_tangent_frame)
    let closure = openpbr.bsdf_prepare(surface, exiting, 3u)

    // The kept sample seen from x_v lifted off the surface, as shade placed its continuation.
    // The pixel's own candidate then comes back in the very direction it was drawn in.
    let mut diffuse = float3(0.0)
    let mut specular = float3(0.0)
    if kept.weight > 0.0:
        let wi = normalize(kept.x_s - (x_v + n * 1e-3))
        let wo_local = openpbr.to_local(frame, v)
        let wi_local = openpbr.to_local(frame, wi)
        let mut f_diffuse = float3(0.0)
        let mut f_specular = float3(0.0)
        openpbr.bsdf_eval_split(closure, wo_local, wi_local, mut f_diffuse, mut f_specular)
        let weight = abs(wi_local.z) * kept.weight
        diffuse = f_diffuse * weight * kept.radiance
        specular = f_specular * weight * kept.radiance
    // ReSTIR DI replaces the light part of the visible point's own light by its kept sample, shaded exactly behind one shadow ray.
    let mut own_light = cand.direct
    let mut own_specular = cand.direct_specular
    let replaces_light = (f.wavefront_flags & wavefront_flag_restir_di) != 0u and (cand.flags & restir_flag_di) != 0u
    if replaces_light:
        own_light -= cand.light_part
        own_specular -= cand.light_part_specular
        let di = if spatial => unpack_di(traced.restir_di_spatial[s]) else unpack_di(traced.restir_di_reservoirs[restir_index(slot, false)])
        if di.weight > 0.0:
            let l = scene.light(..traced.lights[di.light as int])
            let mut wi = float3(0.0, 0.0, 1.0)
            let mut distance = 0.0
            let arriving = di_arriving(l, di.point, x_v, mut wi, mut distance)
            let wi_local = openpbr.to_local(frame, wi)
            let ahead = wi_local.z > 0.0 and any(arriving > float3(0.0))
            if ahead:
                let px = slot_pixel(slot)
                let launch = int3(px.x as int, px.y as int, 0)
                let lifted = x_v + n * 1e-3
                let mut arrives = true
                if scene.light_casts_shadows(l):
                    let r = ray(origin = pos3(lifted.x, lifted.y, lifted.z), direction = vec3(wi.x, wi.y, wi.z), t_min = 1e-3, t_max = distance)
                    let h = traced.world.trace(r, any_hit = c => cutout(c, launch, candidate_opacity(c)), intersection = intersect_quadric, procedural_any_hit = c => hit_decision.accept, flags = ray_flags.accept_first_hit_and_end_search)
                    arrives = h.kind == hit_kind.none
                if arrives:
                    let wo_local = openpbr.to_local(frame, v)
                    let mut f_diffuse = float3(0.0)
                    let mut f_specular = float3(0.0)
                    openpbr.bsdf_eval_split(closure, wo_local, wi_local, mut f_diffuse, mut f_specular)
                    // It replaces the next-event strategy, so it takes that strategy's half of the balance heuristic.
                    // The continuation's hits keep the other half in `direct`, which leaves a glossy reflection of a lamp to the BSDF.
                    let last_bounce = 1u >= (f.max_bounces as uint)
                    let mis = di_nee_weight(l, di.point, x_v, wi, f.light_count, openpbr.bsdf_pdf(closure, wo_local, wi_local), last_bounce)
                    let scale = arriving * (wi_local.z * di.weight * mis)
                    own_light += (f_diffuse + f_specular) * scale
                    own_specular += f_specular * scale
    let radiance = own_light + diffuse + specular
    let valid = if pt.is_finite(radiance) => 1u else 0u
    traced.restir_results[s] = restir_result(radiance, valid, own_specular + specular)

// ---- ReSTIR DI: a kept point on a light, resampled and reused --------------------------------------------------------

/// A DI reservoir that kept nothing, having seen `confidence` candidates.
fun empty_di(confidence: float) -> di_reservoir:
    return di_reservoir(float3(0.0), 0u, 0.0, confidence)

/// One light sample drawn for ReSTIR DI: the point, the light's index, and the density of both in the light's own measure.
struct di_draw:
    point: float3
    light: uint
    pdf: float

/// Draws a light by the table's probabilities and a point on it uniformly: an area on a rect, a direction in a disc's cone.
/// A point or a parallel light is its own one point, so its density is the probability of picking it alone.
fun di_sample(count: uint, rng: mut uint){traced} -> di_draw:
    let mut index = 0u
    if count != 1u => index = pick_light(pt.rand(mut rng), count)
    let l = scene.light(..traced.lights[index as int])
    let select = pt.light_select_pdf(l, count)
    if l.path == scene.light_path_area:
        let s = pt.rand(mut rng) * 2.0 - 1.0
        let t = pt.rand(mut rng) * 2.0 - 1.0
        return di_draw(l.position + s * l.u + t * l.v, index, select / max(l.area, 1e-12))
    if l.path == scene.light_path_distant_disc:
        let u1 = pt.rand(mut rng)
        let u2 = pt.rand(mut rng)
        let dir = pt.sample_cone(-l.normal, l.one_minus_cos_angular_radius, u1, u2)
        return di_draw(dir, index, select / max(2.0 * pt.pi * l.one_minus_cos_angular_radius, 1e-20))
    return di_draw(l.position, index, select)

/// What the light sample `point` on `l` sends toward the visible point `x`, in the light's measure: radiance times the geometry term.
/// Writes the direction toward it and how far a shadow ray goes; 0 where the light's face is turned away.
fun di_arriving(l: scene.light, point: float3, x: float3, wi: mut float3, distance: mut float) -> float3:
    if l.path == scene.light_path_area:
        let to = point - x
        let d2 = max(dot(to, to), 1e-12)
        let d = sqrt(d2)
        wi = to / d
        distance = d - 2e-3
        let cos_face = dot(l.normal, -wi)
        let cos_light = if (l.flags & scene.light_flag_two_sided) != 0u => abs(cos_face) else cos_face
        if cos_light <= 0.0 => return float3(0.0)
        return l.emission * scene.light_cone(l, cos_light) * (cos_light / d2)
    if l.path == scene.light_path_point:
        let to = l.position - x
        let d2 = max(dot(to, to), 1e-12)
        let d = sqrt(d2)
        wi = to / d
        distance = d - 2e-3
        return l.emission * (scene.light_cone(l, dot(l.normal, -wi)) / d2)
    if l.path == scene.light_path_distant_point:
        wi = -l.normal
        distance = 1e20
        return l.emission
    wi = point
    distance = 1e20
    return l.emission

/// The next-event half of the balance heuristic for a light sample toward `wi`, against the BSDF density `bsdf_pdf` there.
/// 1 for a point or a parallel light, which no sampled continuation can reach, and where no continuation follows.
fun di_nee_weight(l: scene.light, point: float3, x: float3, wi: float3, count: uint, bsdf_pdf: float, last_bounce: bool) -> float:
    if last_bounce => return 1.0
    if l.path == scene.light_path_area:
        let to = point - x
        let cos_face = dot(l.normal, -wi)
        let cos_light = if (l.flags & scene.light_flag_two_sided) != 0u => abs(cos_face) else cos_face
        return pt.mis_weight(pt.light_pdf(l, count, dot(to, to), cos_light), bsdf_pdf)
    if l.path == scene.light_path_distant_disc => return pt.mis_weight(pt.disc_pdf(l, count), bsdf_pdf)
    return 1.0

/// ReSTIR DI's target function: what the light sample sends, through the surface's guides' lobe, unshadowed.
/// Visibility is traced once, at the re-shade, which keeps every reuse free of rays and the estimate unbiased.
fun di_target(surf: restir_surface, eye: float3, light: uint, point: float3){traced} -> float:
    let l = scene.light(..traced.lights[light as int])
    let mut wi = float3(0.0, 0.0, 1.0)
    let mut distance = 0.0
    let arriving = di_arriving(l, point, surf.position, mut wi, mut distance)
    if all(arriving <= float3(0.0)) => return 0.0
    return restir_target_toward(surf, eye, wi, arriving)

/// ReSTIR DI's first pass for `slot`: `restir_di_candidates` light samples resampled into one, then merged with the reservoir its visible point kept last frame.
/// A light sample is the same sample at every visible point, so the history needs no shift: Jacobian 1, and no visibility ray.
fun wavefront_restir_di_temporal(slot: uint){traced, wavefront_step}:
    if slot >= wavefront_step.width * wavefront_step.height => return
    let f = traced.frame[0]
    let s = slot as int
    let at = restir_index(slot, false)
    let surf = unpack_surface(traced.restir_surfaces[at])
    let count = f.light_count
    let wanted = restir_flag_finished | restir_flag_di
    let finished = (traced.restir_candidates[s].flags & wanted) == wanted
    let lit = (surf.kinds & restir_surface_visible) != 0u and count > 0u
    let usable = lit and finished
    if not usable:
        traced.restir_di_reservoirs[at] = pack_di(empty_di(0.0))
        return

    let cam = scene.camera(..f.camera)
    let eye = cam.position
    let mut rng = pt.hash(slot ^ pt.hash(f.rng_seed * 7919u + 303u))

    // The candidates, by streaming resampled importance sampling.
    let mut kept = empty_di(1.0)
    let mut kept_target = 0.0
    let mut total = 0.0
    for k in 0 ..< restir_di_candidates:
        let d = di_sample(count, mut rng)
        if d.pdf <= 0.0 => continue
        let target = di_target(surf, eye, d.light, d.point)
        let w = target / ((restir_di_candidates as float) * d.pdf)
        if w <= 0.0 => continue
        total += w
        if pt.rand(mut rng) * total < w:
            kept = di_reservoir(d.point, d.light, 0.0, 1.0)
            kept_target = target
    let p_c = kept_target
    let weight_c = if p_c > 0.0 => total / p_c else 0.0

    // The history, where the visible point reprojects onto the same surface.
    let mut confidence_h = 0.0
    let mut hist = empty_di(0.0)
    let mut hist_surf = surf
    let mut hist_eye = eye
    if (f.wavefront_flags & wavefront_flag_restir_di_history) != 0u:
        let prev = scene.camera(..f.previous_camera)
        let ahead = dot(surf.position - prev.position, normalize(prev.forward))
        let q = scene.camera_project(prev, surf.position - prev.position, image_size())
        let inside = ahead > 0.0 and q.x >= 0.0 and q.y >= 0.0 and q.x < image_size().x and q.y < image_size().y
        if inside:
            let prev_slot = (q.y as uint) * wavefront_step.width + (q.x as uint)
            let hs = unpack_surface(traced.restir_surfaces[restir_index(prev_slot, true)])
            let depth = dot(surf.position - eye, normalize(cam.forward))
            let hr = unpack_di(traced.restir_di_reservoirs[restir_index(prev_slot, true)])
            // A light the table no longer holds is no sample: the history goes with it.
            let same = restir_same_point(surf, hs, depth) and hr.light < count
            if same:
                hist = hr
                hist_surf = hs
                hist_eye = prev.position
                confidence_h = min(hist.confidence, restir_confidence_cap)

    // Generalized balance heuristic over the two domains, with the identity shift.
    let mut w_c = 0.0
    if p_c > 0.0:
        let there = if confidence_h > 0.0 => di_target(hist_surf, hist_eye, kept.light, kept.point) else 0.0
        w_c = p_c / (p_c + confidence_h * there) * p_c * weight_c
    let mut w_h = 0.0
    let mut p_h = 0.0
    if confidence_h > 0.0 and hist.weight > 0.0:
        p_h = di_target(surf, eye, hist.light, hist.point)
        let there = di_target(hist_surf, hist_eye, hist.light, hist.point)
        if p_h > 0.0 and there > 0.0:
            w_h = confidence_h * there / (p_h + confidence_h * there) * p_h * hist.weight

    let confidence = min(1.0 + confidence_h, restir_confidence_cap)
    let all_weight = w_c + w_h
    let mut picked = empty_di(confidence)
    if all_weight > 0.0:
        // Rounding can carry the draw up to the total; with no history weight the candidate is the pick then.
        let takes_candidate = pt.rand(mut rng) * all_weight < w_c or w_h <= 0.0
        if takes_candidate:
            picked = di_reservoir(kept.point, kept.light, all_weight / p_c, confidence)
        else:
            picked = di_reservoir(hist.point, hist.light, all_weight / p_h, confidence)
    traced.restir_di_reservoirs[at] = pack_di(picked)

/// ReSTIR DI's spatial pass for `slot`: its temporal reservoir merged with two neighbors' of this frame, as GI's spatial pass.
/// It shifts by the identity and traces no visibility ray.
fun wavefront_restir_di_spatial(slot: uint){traced, wavefront_step}:
    if slot >= wavefront_step.width * wavefront_step.height => return
    let f = traced.frame[0]
    let s = slot as int
    let center = unpack_surface(traced.restir_surfaces[restir_index(slot, false)])
    let own = unpack_di(traced.restir_di_reservoirs[restir_index(slot, false)])
    if (center.kinds & restir_surface_visible) == 0u:
        traced.restir_di_spatial[s] = pack_di(own)
        return

    let cam = scene.camera(..f.camera)
    let eye = cam.position
    let px = slot_pixel(slot)
    let depth = dot(center.position - eye, normalize(cam.forward))
    let mut rng = pt.hash(slot ^ pt.hash(f.rng_seed * 7919u + 404u))

    let mut n_res_0 = empty_di(0.0)
    let mut n_res_1 = empty_di(0.0)
    let mut n_surf_0 = center
    let mut n_surf_1 = center
    let mut found = 0
    let mut first = slot
    let radius = restir_spatial_radius()
    let size = image_size()
    let angle0 = pt.rand(mut rng)
    for i in 0 ..< restir_spatial_neighbors:
        // The golden ratio's fraction between the draws' angles keeps them apart around the pixel.
        let a = 2.0 * pt.pi * (angle0 + (i as float) * 0.618034)
        let r = radius * sqrt(pt.rand(mut rng))
        let q = float2(px.x as float, px.y as float) + 0.5 + float2(cos(a), sin(a)) * r
        let inside = q.x >= 0.0 and q.y >= 0.0 and q.x < size.x and q.y < size.y
        if not inside => continue
        let other = (q.y as uint) * wavefront_step.width + (q.x as uint)
        let repeated = other == slot or (found > 0 and other == first)
        if repeated => continue
        let ns = unpack_surface(traced.restir_surfaces[restir_index(other, false)])
        if not restir_same_point(center, ns, depth) => continue
        let nr = unpack_di(traced.restir_di_reservoirs[restir_index(other, false)])
        if nr.confidence <= 0.0 => continue
        if found == 0:
            n_res_0 = nr
            n_surf_0 = ns
            first = other
        else:
            n_res_1 = nr
            n_surf_1 = ns
        found += 1

    let c_own = own.confidence
    let c_0 = if found > 0 => n_res_0.confidence else 0.0
    let c_1 = if found > 1 => n_res_1.confidence else 0.0

    // Each sample's weight: its target here against every domain's target of the same point, confidence-weighted.
    let mut w_own = 0.0
    let mut p_own = 0.0
    if own.weight > 0.0:
        p_own = di_target(center, eye, own.light, own.point)
        if p_own > 0.0:
            let at_0 = if c_0 > 0.0 => di_target(n_surf_0, eye, own.light, own.point) else 0.0
            let at_1 = if c_1 > 0.0 => di_target(n_surf_1, eye, own.light, own.point) else 0.0
            w_own = c_own * p_own / (c_own * p_own + c_0 * at_0 + c_1 * at_1) * p_own * own.weight
    let mut w_0 = 0.0
    let mut p_0 = 0.0
    if c_0 > 0.0 and n_res_0.weight > 0.0:
        p_0 = di_target(center, eye, n_res_0.light, n_res_0.point)
        let at_home = di_target(n_surf_0, eye, n_res_0.light, n_res_0.point)
        if p_0 > 0.0 and at_home > 0.0:
            let at_other = if c_1 > 0.0 => di_target(n_surf_1, eye, n_res_0.light, n_res_0.point) else 0.0
            w_0 = c_0 * at_home / (c_own * p_0 + c_0 * at_home + c_1 * at_other) * p_0 * n_res_0.weight
    let mut w_1 = 0.0
    let mut p_1 = 0.0
    if c_1 > 0.0 and n_res_1.weight > 0.0:
        p_1 = di_target(center, eye, n_res_1.light, n_res_1.point)
        let at_home = di_target(n_surf_1, eye, n_res_1.light, n_res_1.point)
        if p_1 > 0.0 and at_home > 0.0:
            let at_other = if c_0 > 0.0 => di_target(n_surf_0, eye, n_res_1.light, n_res_1.point) else 0.0
            w_1 = c_1 * at_home / (c_own * p_1 + c_0 * at_other + c_1 * at_home) * p_1 * n_res_1.weight

    let total = w_own + w_0 + w_1
    let confidence = min(c_own + c_0 + c_1, restir_confidence_cap)
    let mut picked = empty_di(confidence)
    if total > 0.0:
        let u = pt.rand(mut rng) * total
        let mut choice = 0
        if u >= w_own => choice = 1
        if u >= w_own + w_0 => choice = 2
        // Rounding can carry `u` up to `total` itself, past every weight; the last nonzero one is the pick then.
        if choice == 2 and w_1 <= 0.0 => choice = 1
        if choice == 1 and w_0 <= 0.0 => choice = 0
        if choice == 0:
            picked = di_reservoir(own.point, own.light, total / p_own, confidence)
        else if choice == 1:
            picked = di_reservoir(n_res_0.point, n_res_0.light, total / p_0, confidence)
        else:
            picked = di_reservoir(n_res_1.point, n_res_1.light, total / p_1, confidence)
    traced.restir_di_spatial[s] = pack_di(picked)

// ---- connect: the shadow rays ---------------------------------------------------------------------------------------

/// Tests the shadow rays of the slot at `index` of `queue_shadow` and adds what arrives to its path.
/// One thread per slot rather than per ray, so the slot's radiance has one writer.
fun wavefront_connect(index: uint){traced, bindless, wavefront_step}:
    if index >= traced.counters[counter_shadow].load() => return
    let slot = traced.queue_shadow[index as int]
    let px = slot_pixel(slot)
    let launch = int3(px.x as int, px.y as int, 0)
    let mut light = traced.path_lights[slot as int]
    let mut direct = path_light(float3(0.0), float3(0.0))
    let mut light_part = path_light(float3(0.0), float3(0.0))
    let mut to_direct = false
    for j in 0 ..< 2:
        let sr = traced.shadow_rays[((2u * slot) as int) + j]
        if sr.tested == 0u => continue
        let r = ray(origin = pos3(sr.origin.x, sr.origin.y, sr.origin.z), direction = vec3(sr.direction.x, sr.direction.y, sr.direction.z), t_min = 1e-3, t_max = sr.distance)
        let h = traced.world.trace(r, any_hit = c => cutout(c, launch, candidate_opacity(c)), intersection = intersect_quadric, procedural_any_hit = c => hit_decision.accept, flags = ray_flags.accept_first_hit_and_end_search)
        if h.kind == hit_kind.none:
            if sr.to_direct > 0.5:
                direct.radiance += sr.radiance
                direct.specular += sr.specular
                to_direct = true
                if sr.to_direct > 1.5:
                    light_part.radiance += sr.radiance
                    light_part.specular += sr.specular
            else:
                light.radiance += sr.radiance
                light.specular += sr.specular
    traced.path_lights[slot as int] = light
    if to_direct:
        let mut cand = unpack_candidate(traced.restir_candidates[slot as int])
        cand.direct += direct.radiance
        cand.direct_specular += direct.specular
        cand.light_part += light_part.radiance
        cand.light_part_specular += light_part.specular
        traced.restir_candidates[slot as int] = pack_candidate(cand)

// ---- finalize: the paths that ended ---------------------------------------------------------------------------------

/// Folds the path at `index` of `queue_finished` into its pixel, then starts the slot's next sample where the frame still takes them
/// and the slot's draw against `fill` lets it.
fun wavefront_finalize(index: uint){traced, wavefront_step}:
    if index >= traced.counters[counter_finished].load() => return
    let slot = traced.queue_finished[index as int]
    let s = slot as int
    let f = traced.frame[0]
    let st = traced.path_states[s]
    let mut light = traced.path_lights[s]

    // A path ReSTIR split gathered `L_i` alone after its rebase, and x_v's direct light was kept apart.
    // The pixel's estimate puts the two back together in whatever frame the path ends, with the plain path tracer's expectation.
    // Not its sample: roulette then weighs the rebased throughput, which leaves out `T_1`.
    if (st.flags & path_flag_split) != 0u:
        let mut cand = unpack_candidate(traced.restir_candidates[s])
        cand.radiance = light.radiance
        light = path_light(cand.direct + cand.rebase * light.radiance, cand.direct_specular + cand.rebase * light.specular)
        // A continuation no shift can carry, a transmission or one through a medium, stays the pixel's own: its light joins `direct`.
        if (cand.flags & restir_flag_candidate) == 0u:
            cand.direct = light.radiance
            cand.direct_specular = light.specular
            cand.radiance = float3(0.0)
        // A path the mean drops as non-finite below is never re-shaded either, or it would poison the denoiser's history instead.
        if pt.is_finite(light.radiance) => cand.flags = cand.flags | restir_flag_finished
        traced.restir_candidates[s] = pack_candidate(cand)

    // One non-finite path would poison its pixel for good, since the sum is never re-derived: dropping it costs one sample.
    if st.generation == f.generation and pt.is_finite(light.radiance):
        let specular = clamp(light.specular, float3(0.0), max(light.radiance, float3(0.0)))
        let mut tally = traced.tallies[s]
        tally.sum += light.radiance
        tally.sum_specular += specular
        tally.count += 1.0
        tally.frame_sum += light.radiance
        tally.frame_sum_specular += specular
        tally.frame_count += 1.0
        traced.tallies[s] = tally

    let mut rng = st.rng
    let starts = wavefront_step.regenerate != 0u and fills(mut rng)
    if starts:
        start_sample(slot, rng)
        push_next(slot)
    else:
        let mut dead = st
        dead.flags = 0u
        dead.rng = rng
        traced.path_states[s] = dead

// ---- resolve: one thread per pixel, after the last round ------------------------------------------------------------

/// Writes the pixel's estimate and the images that describe it out of its tally.
fun wavefront_resolve(slot: uint){traced, wavefront_step}:
    if slot >= wavefront_step.width * wavefront_step.height => return
    let f = traced.frame[0]
    let px = slot_pixel(slot)
    let xy = int2(px.x as int, px.y as int)
    let tally = traced.tallies[slot as int]

    let mean = if tally.count > 0.0 => tally.sum / tally.count else float3(0.0)
    traced.output[xy] = float4(..mean, 1.0)

    // ReSTIR's re-shade replaces what the frame hands the denoiser wherever it shaded the pixel; the mean stays the paths'.
    // A frame without ReSTIR binds one-slot stand-ins, so the results are read only under the branch.
    let mut result = restir_result(float3(0.0), 0u, float3(0.0))
    if restir_on() => result = traced.restir_results[slot as int]
    let reshaded = result.valid != 0u

    if f.write_temporal != 0u:
        // A pixel that finished no path this frame has no estimate of its own, so it hands the denoiser its mean.
        let own = if tally.frame_count > 0.0 => tally.frame_sum / tally.frame_count else mean
        let frame = if reshaded => result.radiance else own
        traced.frame_output[xy] = float4(..frame, 1.0)
        traced.guide_motion[xy] = if tally.frame_primary_count > 0.0 => tally.frame_motion / tally.frame_primary_count else float2(0.0)

    if f.write_split != 0u:
        // The specular share was clamped to the total per path, so the difference is never negative.
        let own_specular = if tally.frame_count > 0.0 => tally.frame_sum_specular / tally.frame_count else (if tally.count > 0.0 => tally.sum_specular / tally.count else float3(0.0))
        let own = if tally.frame_count > 0.0 => tally.frame_sum / tally.frame_count else mean
        let frame_specular = if reshaded => clamp(result.specular, float3(0.0), max(result.radiance, float3(0.0))) else own_specular
        let frame = if reshaded => result.radiance else own
        traced.frame_specular[xy] = float4(..frame_specular, 1.0)
        traced.frame_diffuse[xy] = float4(..(frame - frame_specular), 1.0)

        // A mean over the paths of each kind: some path hit, every path escaped (the ray's own `t_max`), or no path of this lobe (0).
        let escaped_distance = 1e4
        let diffuse_none = if tally.escaped.x > 0.0 => escaped_distance else 0.0
        let specular_none = if tally.escaped.y > 0.0 => escaped_distance else 0.0
        let diffuse = if tally.hit_diffuse.y > 0.0 => tally.hit_diffuse.x / tally.hit_diffuse.y else diffuse_none
        let specular = if tally.hit_specular.y > 0.0 => tally.hit_specular.x / tally.hit_specular.y else specular_none
        traced.guide_hit_distance[xy] = float2(diffuse, specular)

    // The near plane is applied here rather than stored, since a drawing that starts needing depth changes it without a restart.
    // The projection sv::matrices_of builds has w as the view depth, so z / w is 1 - near / depth.
    if f.write_primary_depth != 0u => traced.primary_depth[xy] = if tally.primary_view_depth < 0.0 => 1.0 else max(1.0 - f.near_plane / tally.primary_view_depth, 0.0)

    if f.write_guides != 0u:
        traced.sample_counts[xy] = tally.count
        let g = max(tally.guide_count, 1.0)
        traced.guide_normal[xy] = float4(..(tally.normal_sum / g), 0.0)
        traced.guide_depth[xy] = tally.depth_sum / g
        traced.guide_albedo[xy] = float4(..(tally.albedo_sum / g), 0.0)
        if f.write_specular_guides != 0u:
            traced.guide_specular_albedo[xy] = float4(..(tally.specular_albedo_sum / g), 0.0)
            traced.guide_roughness[xy] = tally.roughness_sum / g

// ---- The counting kernels, one thread each --------------------------------------------------------------------------

/// Zeroes every counter, before begin fills the first round's queue.
fun wavefront_reset(){traced}:
    let total = counter_permutations + 2 * (traced.frame[0].permutation_count as int)
    for i in 0 ..< total:
        traced.counters[i].store(0u)

/// The round's arguments from its input queue's count, and every queue it fills emptied.
fun wavefront_args_round(){traced, dispatch, wavefront_step}:
    dispatch.args[dispatch_round] = groups_for(round_count())
    let next = if wavefront_step.parity == 0u => counter_queue_b else counter_queue_a
    traced.counters[next].store(0u)
    traced.counters[counter_hits].store(0u)
    traced.counters[counter_shadow].store(0u)
    traced.counters[counter_finished].store(0u)
    for p in 0 ..< (traced.frame[0].permutation_count as int):
        traced.counters[counter_permutations + p].store(0u)

/// Each permutation's range of the sorted hits and its shade arguments, and the sort's own.
fun wavefront_args_shade(){traced, dispatch, wavefront_step}:
    let count = traced.frame[0].permutation_count as int
    let mut offset = 0u
    for p in 0 ..< count:
        let n = traced.counters[counter_permutations + p].load()
        traced.shade_offsets[p] = offset
        traced.counters[counter_permutations + count + p].store(0u)
        dispatch.args[dispatch_shade + p] = groups_for(n)
        offset += n
    dispatch.args[dispatch_hits] = groups_for(traced.counters[counter_hits].load())

/// The arguments of connect and finalize, from what shade and segment queued.
fun wavefront_args_connect(){traced, dispatch, wavefront_step}:
    dispatch.args[dispatch_shadow] = groups_for(traced.counters[counter_shadow].load())
    dispatch.args[dispatch_finished] = groups_for(traced.counters[counter_finished].load())

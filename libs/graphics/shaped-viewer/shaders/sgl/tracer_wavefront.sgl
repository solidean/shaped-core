// The wavefront path tracer's stages: what each kernel of shaders/wavefront.sgl does to the paths of its queue.
//
// A path's state lives in `traced`'s path buffers between dispatches, one slot per pixel, and a round moves every live path one segment.
// extend finds each segment's hit, segment settles everything the hit's material does not decide — a medium, an analytic light
// crossed, an escape — shade (one generated kernel per permutation) runs the material, connect tests the shadow rays shade left,
// and finalize folds the paths that ended into their pixel and starts the next sample in the slot.
// The integrator is the megakernel's (shaders/tracer_pipeline.sgl), split at those seams; docs/wavefront.md is the design.
module tracer

use material
use openpbr
use pt
use quadric
use scene
use slug

// ---- Names ----------------------------------------------------------------------------------------------------------

/// `path_state::flags`.
const path_flag_alive = 1u
/// the path's next segment is its camera ray, whose hit the guides describe
const path_flag_primary = 2u
/// the vertex the segment left ran next-event estimation, which a surface hit does and a medium scatter does not
const path_flag_prev_did_nee = 4u
/// the path belongs to the specular signal, decided by the lobe its first continuation was drawn from
const path_flag_specular = 8u

/// `hit_record::kind`.
const hit_none = 0u
const hit_triangle = 1u
const hit_procedural = 2u

/// `traced.counters`: each queue's count, then from `counter_permutations` a count per permutation and after those a cursor per permutation.
const counter_queue_a = 0
const counter_queue_b = 1
const counter_hits = 2
const counter_shadow = 3
const counter_finished = 4
const counter_permutations = 5

/// `dispatch.args`: the round's segments, the hits to sort, the shadow rays, the finished paths, and from `dispatch_shade` one per permutation.
const dispatch_round = 0
const dispatch_hits = 1
const dispatch_shadow = 2
const dispatch_finished = 3
const dispatch_shade = 4

/// `frame_constants::wavefront_flags`: every path and every tally starts over, since the image describes something else now.
const wavefront_flag_restart = 1u

/// Where `segment_settle` sends a path: nowhere (a thread past the queue), the next round, finalize, or shade.
const route_none = 0u
const route_next = 1u
const route_finished = 2u
const route_hit = 3u

/// The workgroup size of every wavefront kernel over a queue.
const wavefront_group_size = 64u

/// What a shade dispatch's thread reads where its permutation's range has no path for it.
const no_slot = 0xffffffffu

// ---- Queues ---------------------------------------------------------------------------------------------------------

// The round's two queue counters are addressed by a computed index rather than chosen by a branch.
// With a branch, NVIDIA's dx12 driver (616.92 and 617.14) corrupts them once `round_slot` takes slots in pixel order — docs/wavefront.md.

/// The counter of the round's input queue, and of its output queue, which is the next round's input.
fun input_counter(){wavefront_step} -> int:
    let counter = if wavefront_step.parity == 0u => counter_queue_a else counter_queue_b
    return counter

fun output_counter(){wavefront_step} -> int:
    let counter = if wavefront_step.parity == 0u => counter_queue_b else counter_queue_a
    return counter

/// How many paths the round's input queue holds.
fun round_count(){traced, wavefront_step} -> uint:
    return traced.counters[input_counter()].load()

/// The slot at `index` of the round's input queue.
/// A full queue holds every slot once, in whatever order its appends landed, so a full round takes slot `index` itself instead.
/// A wave then reads its paths' state from adjacent memory, and those starting a new sample leave from adjacent pixels.
fun round_slot(index: uint){traced, wavefront_step} -> uint:
    if round_count() == wavefront_step.width * wavefront_step.height => return index
    if wavefront_step.parity == 0u => return traced.queue_a[index as int]
    return traced.queue_b[index as int]

/// Appends `slot` to the round's output queue, which is the next round's input.
fun push_next(slot: uint){traced, wavefront_step}:
    let at = traced.counters[output_counter()].add(1u)
    if wavefront_step.parity == 0u:
        traced.queue_b[at as int] = slot
    else:
        traced.queue_a[at as int] = slot

fun push_finished(slot: uint){traced}:
    let at = traced.counters[counter_finished].add(1u)
    traced.queue_finished[at as int] = slot

fun push_shadow(slot: uint){traced}:
    let at = traced.counters[counter_shadow].add(1u)
    traced.queue_shadow[at as int] = slot

/// Appends `slot` to the hits waiting to shade, counted against the permutation its instance shades with.
fun push_hit(slot: uint, permutation: uint){traced}:
    let at = traced.counters[counter_hits].add(1u)
    traced.queue_hits[at as int] = slot
    traced.counters[counter_permutations + (permutation as int)].add(1u)

/// The workgroups that cover `count` threads, but never more than cover every slot: a corrupt count stays a valid dispatch.
fun groups_for(count: uint){wavefront_step} -> dispatch_args:
    let threads = min(count, wavefront_step.width * wavefront_step.height)
    return dispatch_args((threads + wavefront_group_size - 1u) / wavefront_group_size, 1u, 1u)

// ---- Pixels ---------------------------------------------------------------------------------------------------------

fun slot_pixel(slot: uint){wavefront_step} -> uint2:
    return uint2(slot % wavefront_step.width, slot / wavefront_step.width)

fun image_size(){wavefront_step} -> float2:
    return float2(wavefront_step.width as float, wavefront_step.height as float)

/// Component `i` of `v`, for an index known only at run time.
fun lane_of(v: float3, i: uint) -> float:
    if i == 0u => return v.x
    if i == 1u => return v.y
    return v.z

/// A tally with nothing in it.
fun empty_tally() -> pixel_tally:
    let z3 = float3(0.0)
    let z2 = float2(0.0)
    return pixel_tally(z3, 0.0, z3, 0.0, z3, 0.0, z3, 0.0, z3, 0.0, z3, 0.0, z3, -1.0, z2, z2, z2, z2)

// ---- Instances ------------------------------------------------------------------------------------------------------

/// `v` in world space, through the instance's placement rows.
fun instance_to_world(inst: scene.instance, v: float3) -> float3:
    return float3(dot(inst.to_world_x.xyz, v), dot(inst.to_world_y.xyz, v), dot(inst.to_world_z.xyz, v))

/// Normal `n` in world space: by the inverse transpose of the placement's linear part, so a non-uniform scale tilts it as it must.
/// The cofactor matrix is the inverse transpose up to the determinant, whose sign alone survives the normalization.
fun instance_normal_to_world(inst: scene.instance, n: float3) -> float3:
    let r0 = inst.to_world_x.xyz
    let r1 = inst.to_world_y.xyz
    let r2 = inst.to_world_z.xyz
    let c0 = cross(r1, r2)
    let det = dot(r0, c0)
    let m = float3(dot(c0, n), dot(cross(r2, r0), n), dot(cross(r0, r1), n))
    if det < 0.0 => return -m
    return m

// ---- Cutouts -------------------------------------------------------------------------------------------------------

/// What tells the cutout coins of one segment's traces apart: extend's, then connect's per shadow ray.
const cutout_salt_extend = 0x9e3779b9u
const cutout_salt_shadow = 0x85ebca6bu

/// The cutout seed of a trace inline in a path's segment, from the path's own random state.
///
/// The state advances every segment and every sample, so each draws its own coins, which the megakernel's frame seed cannot.
/// Hashed rather than drawn, so the path's own sequence is left as it was; the salt keeps the seed off the stream's next draw.
fun path_cutout_seed(rng: uint, salt: uint) -> uint:
    return pt.hash(rng + salt)

// ---- Starting a sample ----------------------------------------------------------------------------------------------

/// Starts a new sample in `slot`: a jittered camera ray, and a path that has gathered nothing yet.
/// `rng` is the slot's random state, which continues from sample to sample so no two of a pixel's samples share a sequence.
fun start_sample(slot: uint, rng_in: uint){traced, wavefront_step}:
    let f = traced.frame[0]
    let px = slot_pixel(slot)
    let mut rng = rng_in
    let jitter_x = pt.rand(mut rng)
    let jitter_y = pt.rand(mut rng)
    let jitter = if f.fixed_jitter != 0u => f.jitter else float2(jitter_x, jitter_y)
    let cam = scene.camera(..f.camera)
    let pixel = float2(px.x as float, px.y as float) + jitter
    let dir = normalize(scene.camera_ray_offset(cam, pixel, image_size()))

    let s = slot as int
    traced.path_rays[s] = path_ray(cam.position, dir)
    traced.path_states[s] = path_state(float3(1.0), 0.0, rng, path_flag_alive | path_flag_primary | path_flag_prev_did_nee, 0u, 0u, f.generation, jitter, 0u)
    traced.path_media[s] = path_medium(float3(0.0), float3(0.0), 0.0, 3u)
    traced.path_lights[s] = path_light(float3(0.0), float3(0.0))

// ---- begin: one thread per pixel, before the first round ------------------------------------------------------------

/// Clears what this frame tallies, kills every path on a restart, and starts a sample in every slot without one.
/// Every live slot is queued for the first round, whose input is `queue_a`.
///
/// The primary depth and the hit distances are cleared by a restart alone, as the estimate's sums are.
/// A still frame of few rounds starts no sample in most pixels, so a guide cleared every frame would read as escaped there.
fun wavefront_begin(slot: uint){traced, wavefront_step}:
    if slot >= wavefront_step.width * wavefront_step.height => return
    let f = traced.frame[0]
    let s = slot as int
    let restart = (f.wavefront_flags & wavefront_flag_restart) != 0u

    let mut tally = if restart => empty_tally() else traced.tallies[s]
    tally.frame_count = 0.0
    tally.frame_sum = float3(0.0)
    tally.frame_sum_specular = float3(0.0)
    tally.frame_primary_count = 0.0
    tally.frame_motion = float2(0.0)
    traced.tallies[s] = tally

    let st = traced.path_states[s]
    let alive = (st.flags & path_flag_alive) != 0u and st.generation == f.generation and not restart
    if not alive:
        let px = slot_pixel(slot)
        let rng = if restart => pt.hash(px.x + px.y * wavefront_step.width + f.rng_seed * 9781u) else st.rng
        start_sample(slot, rng)

    let at = traced.counters[counter_queue_a].add(1u)
    traced.queue_a[at as int] = slot

// ---- extend: the round's segments, traced ---------------------------------------------------------------------------

/// Traces the segment of the round's path at `index` and records the nearest hit it accepted.
fun wavefront_extend(index: uint){traced, bindless, wavefront_step}:
    if index >= round_count() => return
    let slot = round_slot(index)
    let s = slot as int
    let r = traced.path_rays[s]
    let seed = path_cutout_seed(traced.path_states[s].rng, cutout_salt_extend)
    let pr = ray(origin = pos3(r.origin.x, r.origin.y, r.origin.z), direction = vec3(r.direction.x, r.direction.y, r.direction.z), t_min = 1e-3, t_max = 1e4)
    let h = traced.world.trace(pr, any_hit = c => cutout_with_seed(c, candidate_opacity(c), seed), intersection = intersect_quadric, procedural_any_hit = c => hit_decision.accept)

    if h.kind == hit_kind.triangle:
        traced.hits[s] = hit_record(h.instance_id as uint, h.primitive_index as uint, hit_triangle, h.t, float2(h.barycentrics.y, h.barycentrics.z), float3(0.0))
    else if h.kind == hit_kind.procedural:
        traced.hits[s] = hit_record(h.instance_id as uint, h.primitive_index as uint, hit_procedural, h.t, float2(0.0), h.procedural().attributes.normal)
    else:
        traced.hits[s] = hit_record(0u, 0u, hit_none, -1.0, float2(0.0), float3(0.0))

// ---- segment: what the hit's material does not decide ---------------------------------------------------------------

/// Settles the round's path at `index` up to its hit's material: the medium it crossed, the analytic lights it passed, and an escape.
/// A path that scattered goes on to the next round, one that ended to finalize, and one that reached a surface to shade.
/// Settles the round's path at `index` up to its hit's material: the medium it crossed, the analytic lights it passed, and an escape.
/// Returns the slot, its route and, for a hit, the permutation that shades it.
fun segment_settle(index: uint){traced, wavefront_step} -> uint3:
    if index >= round_count() => return uint3(0u, route_none, 0u)
    let slot = round_slot(index)
    let s = slot as int
    let f = traced.frame[0]
    let r = traced.path_rays[s]
    let mut st = traced.path_states[s]
    let md = traced.path_media[s]
    let mut light = traced.path_lights[s]
    let hit = traced.hits[s]

    let hit_t = if hit.kind == hit_none => -1.0 else hit.t
    let mut origin = r.origin
    let mut dir = r.direction
    let mut throughput = st.throughput
    let mut rng = st.rng
    let b = st.bounce
    let primary = (st.flags & path_flag_primary) != 0u
    let path_is_specular = (st.flags & path_flag_specular) != 0u
    let prev_did_nee = (st.flags & path_flag_prev_did_nee) != 0u

    // The primary segment reprojects, hit or miss; an escape is a point at infinity, so the sky moves with rotation alone.
    if primary:
        let px = slot_pixel(slot)
        let prev = scene.camera(..f.previous_camera)
        let offset = if hit_t >= 0.0 => origin + dir * hit_t - prev.position else dir
        let mut tally = traced.tallies[s]
        tally.frame_motion += (float2(px.x as float, px.y as float) + st.jitter) - scene.camera_project(prev, offset, image_size())
        tally.frame_primary_count += 1.0
        // An escaped primary ray describes no surface, which the guides read as zeros: counted, nothing summed.
        if hit_t < 0.0:
            tally.guide_count += 1.0
            st.flags = st.flags & ~path_flag_primary
            // The depth raster sees where the estimate's first primary ray landed; one that escaped is the far plane.
            if tally.primary_depth < 0.0 => tally.primary_depth = 1.0
        traced.tallies[s] = tally
    else if b == 1u:
        // The first SECONDARY hit's distance, which a split-signal denoiser sizes its reprojection from.
        // An escape is COUNTED rather than summed as zero, since zero is what REBLUR reads as contact.
        let mut tally = traced.tallies[s]
        let escaped = hit_t < 0.0
        let hit_add = if escaped => float2(0.0) else float2(hit_t, 1.0)
        let escape_add = if escaped => 1.0 else 0.0
        if path_is_specular:
            tally.hit_specular += hit_add
            tally.escaped.y += escape_add
        else:
            tally.hit_diffuse += hit_add
            tally.escaped.x += escape_add
        traced.tallies[s] = tally

    let inside = any(md.sigma_t > float3(0.0))
    let scattering = inside and any(md.albedo > float3(0.0))
    let mut ended = false
    let mut lit = false

    if scattering:
        // A scattering interior is walked rather than crossed: the segment may end at a particle instead of at the surface.
        // Distance is drawn against ONE channel's extinction and the estimate is corrected for all three.
        let u_channel = pt.rand(mut rng)
        let dc = min((u_channel * 3.0) as uint, 2u)
        let sigma_pick = max(lane_of(md.sigma_t, dc), 1e-6)
        let u_distance = pt.rand(mut rng)
        let t = -log(max(1.0 - u_distance, 1e-9)) / sigma_pick

        let reaches_surface = hit_t >= 0.0 and t >= hit_t
        let traveled = if reaches_surface => hit_t else t
        let transmittance = exp(-md.sigma_t * traveled)
        let pdf3 = if reaches_surface => transmittance else md.sigma_t * transmittance
        let dist_pdf = (pdf3.x + pdf3.y + pdf3.z) / 3.0

        if dist_pdf <= 1e-12:
            ended = true
        else if not reaches_surface:
            // A real scattering event: the phase function is its own pdf, so the turn carries no weight beyond the albedo.
            throughput *= (transmittance * md.sigma_t * md.albedo) / dist_pdf
            origin = origin + dir * t
            let u_phase_1 = pt.rand(mut rng)
            let u_phase_2 = pt.rand(mut rng)
            let scattered = pt.sample_hg(dir, md.g, u_phase_1, u_phase_2)
            st.prev_pdf = pt.hg_phase(dot(dir, scattered), md.g)
            st.flags = (st.flags & ~path_flag_prev_did_nee) & ~path_flag_primary
            dir = scattered
            st.scatters += 1u

            let mut continues = pt.is_finite(throughput)
            if continues and (st.scatters as int) > pt.roulette_after:
                let q = clamp(max(throughput.x, max(throughput.y, throughput.z)), 0.05, 1.0)
                let u_roulette = pt.rand(mut rng)
                if u_roulette >= q:
                    continues = false
                else:
                    throughput /= q
            if (st.scatters as int) > pt.scatter_cap => continues = false

            st.throughput = throughput
            st.rng = rng
            traced.path_states[s] = st
            traced.path_rays[s] = path_ray(origin, dir)
            let route = if continues => route_next else route_finished
            return uint3(slot, route, 0u)
        else:
            throughput *= transmittance / dist_pdf
    else if inside and hit_t > 0.0:
        // A purely absorbing interior needs no walk: Beer-Lambert over the whole segment.
        throughput *= exp(-md.sigma_t * hit_t)

    // A ray that escapes while still inside a solid traveled an unbounded distance through it, so nothing survives.
    let escaped_inside = inside and hit_t < 0.0

    if not (ended or escaped_inside):
        // The BSDF strategy for every rect this segment crosses, and the camera's view of the ones it may see.
        let begin_area = f.path_offset.y
        let end_area = begin_area + f.path_count.y
        for i in (begin_area as int) ..< (end_area as int):
            let l = scene.light(..traced.lights[i])
            let mut t_light = 0.0
            let mut cos_light = 0.0
            if not pt.rect_intersect(l, origin, dir, mut t_light, mut cos_light) => continue
            let in_front = hit_t < 0.0 or t_light < hit_t
            let arriving = l.emission * scene.light_cone(l, cos_light)
            if b == 0u:
                if in_front and scene.light_visible_to_camera(l):
                    light.radiance += throughput * arriving
                    lit = true
            else if in_front or not scene.light_casts_shadows(l):
                let w = if prev_did_nee => pt.mis_weight(st.prev_pdf, pt.light_pdf(l, f.light_count, t_light * t_light, cos_light)) else 1.0
                let c = throughput * arriving * w
                light.radiance += c
                lit = true
                if path_is_specular => light.specular += c

        let begin_disc = f.path_offset.w
        let end_disc = begin_disc + f.path_count.w
        for i in (begin_disc as int) ..< (end_disc as int):
            let l = scene.light(..traced.lights[i])
            if not pt.in_disc(l, dir) => continue
            if b == 0u:
                if hit_t < 0.0 and scene.light_visible_to_camera(l):
                    light.radiance += throughput * l.emission
                    lit = true
            else if hit_t < 0.0 or not scene.light_casts_shadows(l):
                let w = if prev_did_nee => pt.mis_weight(st.prev_pdf, pt.disc_pdf(l, f.light_count)) else 1.0
                let c = throughput * l.emission * w
                light.radiance += c
                lit = true
                if path_is_specular => light.specular += c

    if hit_t < 0.0 and not (ended or escaped_inside):
        // Escaped to the SH environment: the primary ray sees it at full weight, a bounce ray as the BSDF strategy of the hit's own estimate.
        let emission = scene.background_radiance(background_sh(), normalize(dir))
        let w = if b == 0u => 1.0 else pt.mis_weight(st.prev_pdf, pt.env_pdf())
        let c = throughput * emission * w
        light.radiance += c
        lit = true
        if path_is_specular and b > 0u => light.specular += c

    // Only what this segment changed goes back: off a medium the ray, the throughput and the random state are as extend left them.
    if inside or (primary and hit_t < 0.0):
        st.throughput = throughput
        st.rng = rng
        traced.path_states[s] = st
    if lit => traced.path_lights[s] = light

    if ended or hit_t < 0.0 => return uint3(slot, route_finished, 0u)

    let inst = scene.instance(..traced.instances[hit.instance as int])
    return uint3(slot, route_hit, inst.shade_group)

/// Settles the round's path at `index`, then appends it where `segment_settle` routed it.
///
/// Each queue is appended to from exactly one place, which NVIDIA's dx12 driver needs alongside `input_counter` (docs/wavefront.md).
fun wavefront_segment(index: uint){traced, wavefront_step}:
    let r = segment_settle(index)
    if r.y == route_next => push_next(r.x)
    if r.y == route_finished => push_finished(r.x)
    if r.y == route_hit => push_hit(r.x, r.z)

// ---- sort: the hits by permutation ----------------------------------------------------------------------------------

/// Places the hit at `index` into its permutation's range of `queue_sorted`.
fun wavefront_sort(index: uint){traced}:
    if index >= traced.counters[counter_hits].load() => return
    let slot = traced.queue_hits[index as int]
    let hit = traced.hits[slot as int]
    let inst = scene.instance(..traced.instances[hit.instance as int])
    let permutation = inst.shade_group
    let cursor_index = counter_permutations + (traced.frame[0].permutation_count as int) + (permutation as int)
    let at = traced.shade_offsets[permutation as int] + traced.counters[cursor_index].add(1u)
    traced.queue_sorted[at as int] = slot

/// The slot thread `index` of a shade dispatch shades: an element of its permutation's range, or `no_slot` past its end.
fun shade_slot(index: uint){traced, wavefront_step} -> uint:
    let permutation = wavefront_step.permutation as int
    if index >= traced.counters[counter_permutations + permutation].load() => return no_slot
    return traced.queue_sorted[(traced.shade_offsets[permutation] + index) as int]

// ---- shade: what a generated kernel calls once its material has evaluated ------------------------------------------

/// The shading context of the triangle hit `slot` recorded.
fun stored_triangle_context(slot: uint){traced, bindless} -> material.shading_context:
    let hit = traced.hits[slot as int]
    let inst = scene.instance(..traced.instances[hit.instance as int])
    let indices = inst.indices as int
    return material.make_context(inst, bindless.buffers[nonuniform indices], hit.primitive, hit.barycentrics)

/// The shading context of the quadric hit `slot` recorded.
fun stored_quadric_context(slot: uint){traced} -> material.shading_context:
    let hit = traced.hits[slot as int]
    let inst = scene.instance(..traced.instances[hit.instance as int])
    return quadric.make_context(inst, hit.primitive)

/// Shades the triangle hit of `slot`, whose material evaluated to `surface` — the wavefront's `shade_triangle`.
fun shade_stored_triangle(slot: uint, ctx: material.shading_context, surface: openpbr.surface, supplied_tangent_frame: bool){traced, bindless, slug.tables, wavefront_step}:
    let hit = traced.hits[slot as int]
    let inst = scene.instance(..traced.instances[hit.instance as int])
    let v0 = instance_position(inst, ctx.corner.x)
    let v1 = instance_position(inst, ctx.corner.y)
    let v2 = instance_position(inst, ctx.corner.z)
    shade_stored(slot, inst, normalize(cross(v1 - v0, v2 - v0)), surface, supplied_tangent_frame)

/// Shades the quadric hit of `slot` from the normal its intersection reported — the wavefront's `shade_quadric`.
fun shade_stored_quadric(slot: uint, surface: openpbr.surface, supplied_tangent_frame: bool){traced, bindless, slug.tables, wavefront_step}:
    let hit = traced.hits[slot as int]
    let inst = scene.instance(..traced.instances[hit.instance as int])
    shade_stored(slot, inst, hit.normal, surface, supplied_tangent_frame)

/// Writes one next-event sample of `slot`: a shadowless one counts now, one with a shadow ray waits for connect.
/// `j` is which of the slot's two shadow rays it is.
fun defer_light(slot: uint, j: uint, sample: light_sample, throughput: float3, b: uint, path_is_specular: bool, light: mut path_light){traced} -> bool:
    let radiance = throughput * (sample.diffuse + sample.specular)
    let specular = if b == 0u => throughput * sample.specular else (if path_is_specular => radiance else float3(0.0))
    let at = (2u * slot + j) as int
    if sample.tested == 0u:
        light.radiance += radiance
        light.specular += specular
        traced.shadow_rays[at] = shadow_ray(sample.origin, 0.0, sample.direction, 0u, float3(0.0), 0.0, float3(0.0), 0.0)
        return false
    traced.shadow_rays[at] = shadow_ray(sample.origin, sample.distance, sample.direction, 1u, radiance, 0.0, specular, 0.0)
    return true

/// The tail both geometry kinds share: the hit faced toward its ray, shaded, and the path moved on.
fun shade_stored(slot: uint, inst: scene.instance, n_obj: float3, surface: openpbr.surface, supplied_tangent_frame: bool){traced, bindless, slug.tables, wavefront_step}:
    let s = slot as int
    let f = traced.frame[0]
    let hit = traced.hits[s]
    let r = traced.path_rays[s]
    let mut st = traced.path_states[s]
    let md = traced.path_media[s]
    let mut light = traced.path_lights[s]

    let ray_origin = r.origin
    let ray_dir = r.direction
    let mut n = normalize(instance_normal_to_world(inst, n_obj))
    let v = -normalize(ray_dir)
    let exiting = dot(n, v) < 0.0
    if exiting => n = -n

    // The authored frame is in object space, so it moves with the instance the geometry does.
    let mut authored = openpbr.frame(float3(0.0), float3(0.0), float3(0.0))
    if supplied_tangent_frame:
        let local = openpbr.frame_from_quaternion(surface.geometry_tangent_frame, surface.geometry_handedness)
        authored = openpbr.frame(normalize(instance_to_world(inst, local.t)), normalize(instance_to_world(inst, local.b)), normalize(instance_to_world(inst, local.n)))

    let last_bounce = if st.bounce + 1u >= (f.max_bounces as uint) => 1u else 0u
    let mut p = surface_payload_for(st.rng, md.sigma_t, md.albedo, md.g, md.channel, last_bounce)
    let mut light_s = no_light_sample()
    let mut env_s = no_light_sample()
    shade_sampled(mut p, surface, n, v, exiting, ray_origin, ray_dir, hit.t, authored, supplied_tangent_frame, mut light_s, mut env_s)

    let b = st.bounce
    let throughput = st.throughput
    let mut path_is_specular = (st.flags & path_flag_specular) != 0u

    if (st.flags & path_flag_primary) != 0u:
        // Linear view depth rather than the distance along the ray, which grows toward the image's edges.
        let cam = scene.camera(..f.camera)
        let mut tally = traced.tallies[s]
        tally.normal_sum += p.normal
        tally.depth_sum += hit.t * dot(ray_dir, normalize(cam.forward))
        tally.albedo_sum += p.albedo
        tally.specular_albedo_sum += p.specular_albedo
        tally.roughness_sum += p.roughness
        tally.guide_count += 1.0

        // The depth raster sees at the pixel CENTER: the center ray met with the plane the estimate's first primary hit lies on.
        // The projection sv::matrices_of builds has w as the view depth, so z / w is 1 - near / depth.
        if tally.primary_depth < 0.0:
            let px = slot_pixel(slot)
            let center = normalize(scene.camera_ray_offset(cam, float2(px.x as float, px.y as float) + 0.5, image_size()))
            let facing = dot(p.normal, center)
            let t = if abs(facing) > 1e-6 => dot(p.normal, ray_dir * hit.t) / facing else hit.t
            let t_forward = if t > 0.0 => t else hit.t
            let view_depth = t_forward * dot(center, normalize(cam.forward))
            tally.primary_depth = max(1.0 - f.near_plane / view_depth, 0.0)
        traced.tallies[s] = tally

        // The lobe the continuation was drawn from is what this path IS, for the denoiser's purposes.
        path_is_specular = openpbr.bsdf_lobe_is_specular(p.lobe)
        st.flags = st.flags & ~path_flag_primary
        if path_is_specular => st.flags = st.flags | path_flag_specular

    // A surface's own emission reaches the camera directly and contributes nothing indirectly.
    if b == 0u => light.radiance += throughput * p.emission

    let light_waits = defer_light(slot, 0u, light_s, throughput, b, path_is_specular, mut light)
    let env_waits = defer_light(slot, 1u, env_s, throughput, b, path_is_specular, mut light)
    if light_waits or env_waits => push_shadow(slot)

    let mut rng = p.rng
    let mut continues = not all(p.throughput <= float3(0.0))
    if continues:
        let mut next_throughput = throughput * p.throughput
        st.prev_pdf = p.bsdf_pdf
        st.flags = st.flags | path_flag_prev_did_nee
        st.bounce = b + 1u

        // The offset follows the direction rather than the normal: a refracted continuation leaves on the far side.
        let side = if dot(p.direction, p.normal) < 0.0 => -1e-3 else 1e-3
        traced.path_rays[s] = path_ray(ray_origin + ray_dir * hit.t + p.normal * side, p.direction)
        traced.path_media[s] = path_medium(p.medium_sigma_t, p.medium_albedo, p.medium_g, p.channel)

        if st.bounce >= (f.max_bounces as uint):
            continues = false
        else if f.roulette_after > 0u and st.bounce > f.roulette_after:
            // Russian roulette ends a path that carries little, without taking its energy with it.
            let q = clamp(max(next_throughput.x, max(next_throughput.y, next_throughput.z)), 0.05, 1.0)
            let u_roulette = pt.rand(mut rng)
            if u_roulette >= q:
                continues = false
            else:
                next_throughput /= q
        st.throughput = next_throughput

    st.rng = rng
    traced.path_states[s] = st
    traced.path_lights[s] = light
    if continues:
        push_next(slot)
    else:
        push_finished(slot)

// ---- connect: the shadow rays ---------------------------------------------------------------------------------------

/// Tests the shadow rays of the slot at `index` of `queue_shadow` and adds what arrives to its path.
/// One thread per slot rather than per ray, so the slot's radiance has one writer.
fun wavefront_connect(index: uint){traced, bindless, wavefront_step}:
    if index >= traced.counters[counter_shadow].load() => return
    let slot = traced.queue_shadow[index as int]
    let rng = traced.path_states[slot as int].rng
    let mut light = traced.path_lights[slot as int]
    for j in 0 ..< 2:
        let sr = traced.shadow_rays[((2u * slot) as int) + j]
        if sr.tested == 0u => continue
        let seed = path_cutout_seed(rng, cutout_salt_shadow + (j as uint))
        let r = ray(origin = pos3(sr.origin.x, sr.origin.y, sr.origin.z), direction = vec3(sr.direction.x, sr.direction.y, sr.direction.z), t_min = 1e-3, t_max = sr.distance)
        let h = traced.world.trace(r, any_hit = c => cutout_with_seed(c, candidate_opacity(c), seed), intersection = intersect_quadric, procedural_any_hit = c => hit_decision.accept, flags = ray_flags.accept_first_hit_and_end_search)
        if h.kind == hit_kind.none:
            light.radiance += sr.radiance
            light.specular += sr.specular
    traced.path_lights[slot as int] = light

// ---- finalize: the paths that ended ---------------------------------------------------------------------------------

/// Folds the path at `index` of `queue_finished` into its pixel, then starts the slot's next sample where the frame still takes them.
fun wavefront_finalize(index: uint){traced, wavefront_step}:
    if index >= traced.counters[counter_finished].load() => return
    let slot = traced.queue_finished[index as int]
    let s = slot as int
    let f = traced.frame[0]
    let st = traced.path_states[s]
    let light = traced.path_lights[s]

    // One non-finite path would poison its pixel for good, since the sum is never re-derived: dropping it costs one sample.
    if st.generation == f.generation and pt.is_finite(light.radiance):
        let specular = clamp(light.specular, float3(0.0), max(light.radiance, float3(0.0)))
        let mut tally = traced.tallies[s]
        tally.sum += light.radiance
        tally.sum_specular += specular
        tally.count += 1.0
        tally.frame_sum += light.radiance
        tally.frame_sum_specular += specular
        tally.frame_count += 1.0
        traced.tallies[s] = tally

    if wavefront_step.regenerate != 0u:
        start_sample(slot, st.rng)
        push_next(slot)
    else:
        let mut dead = st
        dead.flags = 0u
        traced.path_states[s] = dead

// ---- resolve: one thread per pixel, after the last round ------------------------------------------------------------

/// Writes the pixel's estimate and the images that describe it out of its tally.
fun wavefront_resolve(slot: uint){traced, wavefront_step}:
    if slot >= wavefront_step.width * wavefront_step.height => return
    let f = traced.frame[0]
    let px = slot_pixel(slot)
    let xy = int2(px.x as int, px.y as int)
    let tally = traced.tallies[slot as int]

    let mean = if tally.count > 0.0 => tally.sum / tally.count else float3(0.0)
    traced.output[xy] = float4(..mean, 1.0)

    if f.write_temporal != 0u:
        // A pixel that finished no path this frame has no estimate of its own, so it hands the denoiser its mean.
        let frame = if tally.frame_count > 0.0 => tally.frame_sum / tally.frame_count else mean
        traced.frame_output[xy] = float4(..frame, 1.0)
        traced.guide_motion[xy] = if tally.frame_primary_count > 0.0 => tally.frame_motion / tally.frame_primary_count else float2(0.0)

    if f.write_split != 0u:
        // The specular share was clamped to the total per path, so the difference is never negative.
        let frame_specular = if tally.frame_count > 0.0 => tally.frame_sum_specular / tally.frame_count else (if tally.count > 0.0 => tally.sum_specular / tally.count else float3(0.0))
        let frame = if tally.frame_count > 0.0 => tally.frame_sum / tally.frame_count else mean
        traced.frame_specular[xy] = float4(..frame_specular, 1.0)
        traced.frame_diffuse[xy] = float4(..(frame - frame_specular), 1.0)

        // A mean over the paths of each kind: some path hit, every path escaped (the ray's own `t_max`), or no path of this lobe (0).
        let escaped_distance = 1e4
        let diffuse_none = if tally.escaped.x > 0.0 => escaped_distance else 0.0
        let specular_none = if tally.escaped.y > 0.0 => escaped_distance else 0.0
        let diffuse = if tally.hit_diffuse.y > 0.0 => tally.hit_diffuse.x / tally.hit_diffuse.y else diffuse_none
        let specular = if tally.hit_specular.y > 0.0 => tally.hit_specular.x / tally.hit_specular.y else specular_none
        traced.guide_hit_distance[xy] = float2(diffuse, specular)

    if f.write_primary_depth != 0u => traced.primary_depth[xy] = if tally.primary_depth < 0.0 => 1.0 else tally.primary_depth

    if f.write_guides != 0u:
        traced.sample_counts[xy] = tally.count
        let g = max(tally.guide_count, 1.0)
        traced.guide_normal[xy] = float4(..(tally.normal_sum / g), 0.0)
        traced.guide_depth[xy] = tally.depth_sum / g
        traced.guide_albedo[xy] = float4(..(tally.albedo_sum / g), 0.0)
        if f.write_specular_guides != 0u:
            traced.guide_specular_albedo[xy] = float4(..(tally.specular_albedo_sum / g), 0.0)
            traced.guide_roughness[xy] = tally.roughness_sum / g

// ---- The counting kernels, one thread each --------------------------------------------------------------------------

/// Zeroes every counter, before begin fills the first round's queue.
fun wavefront_reset(){traced}:
    let total = counter_permutations + 2 * (traced.frame[0].permutation_count as int)
    for i in 0 ..< total:
        traced.counters[i].store(0u)

/// The round's arguments from its input queue's count, and every queue it fills emptied.
fun wavefront_args_round(){traced, dispatch, wavefront_step}:
    dispatch.args[dispatch_round] = groups_for(round_count())
    let next = if wavefront_step.parity == 0u => counter_queue_b else counter_queue_a
    traced.counters[next].store(0u)
    traced.counters[counter_hits].store(0u)
    traced.counters[counter_shadow].store(0u)
    traced.counters[counter_finished].store(0u)
    for p in 0 ..< (traced.frame[0].permutation_count as int):
        traced.counters[counter_permutations + p].store(0u)

/// Each permutation's range of the sorted hits and its shade arguments, and the sort's own.
fun wavefront_args_shade(){traced, dispatch, wavefront_step}:
    let count = traced.frame[0].permutation_count as int
    let mut offset = 0u
    for p in 0 ..< count:
        let n = traced.counters[counter_permutations + p].load()
        traced.shade_offsets[p] = offset
        traced.counters[counter_permutations + count + p].store(0u)
        dispatch.args[dispatch_shade + p] = groups_for(n)
        offset += n
    dispatch.args[dispatch_hits] = groups_for(traced.counters[counter_hits].load())

/// The arguments of connect and finalize, from what shade and segment queued.
fun wavefront_args_connect(){traced, dispatch, wavefront_step}:
    dispatch.args[dispatch_shadow] = groups_for(traced.counters[counter_shadow].load())
    dispatch.args[dispatch_finished] = groups_for(traced.counters[counter_finished].load())

# Shell scripts must keep LF line endings regardless of a contributor's
# core.autocrlf: a trailing CR on the shebang line makes the interpreter path
# invalid under POSIX shells, which silently breaks the diag-launcher wrapper
# used as a CMake compiler/linker launcher on Linux/macOS.
*.sh text eol=lf

# SGL sources are compared byte for byte: prelude/builtins.sgl against the text the C++ builtin registry generates,
# and a diagnostic names a byte offset. A CRLF checkout would break both.
*.sgl text eol=lf

# slib's impl/pipeline_fields.hh is compared byte for byte against what `sgl pipeline-fields` generates, like builtins.sgl.
libs/graphics/shaped-shader-library/src/shaped-shader-library/impl/pipeline_fields.hh text eol=lf

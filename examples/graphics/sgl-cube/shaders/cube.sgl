// One cube, six colored faces, two fixed lights.
// The SGL twin of examples/graphics/rotating-cube/shaders: one file here for what takes cube.hlsl, cube_vs.wgsl and cube_fs.wgsl there.
// No address is written: member order is the location, and an @inline binding goes where sg keeps inline constants.

// one matrix, and small enough to ride as inline constants
@inline binding constants:
    view_projection: mat4

// the order is the vertex layout's: sgl_cube.cc writes the same three attributes
@vertex struct cube_vertex:
    position: pos3
    normal: vec3
    color: float3

// no @format here: the shader is compatible with every float target, and the pipeline says which one it is
@pixel struct target:
    color: float4

// what the vertex stage hands to the pixel stage
struct pixel_input:
    @position position: hpos4
    normal: vec3
    color: float3

@vertex fun main_vs(v: cube_vertex){constants} -> pixel_input:
    return {
        position = constants.view_projection * v.position
        normal = v.normal
        color = v.color
    }

// what a light gives a surface that faces `n`
fun lambert(n: vec3, towards: vec3) -> float => saturate dot(n, normalize towards)

// two fixed lights: a key light, and a weaker fill light from the other side
fun towards_light(i: int) -> vec3:
    if i == 0 => return vec3(0.45, 0.8, -0.4)
    return vec3(-0.7, 0.15, 0.6)

fun strength_of_light(i: int) -> float:
    if i == 0 => return 0.8
    return 0.25

// An ambient floor and the lights on top: enough that a face's orientation reads at a glance.
fun shade(color: float3, normal: vec3) -> float3:
    // a normal that vanished faces no light, and the floor is all it gets
    if dot(normal, normal) < 0.5 => return color * 0.25

    let n = normalize normal
    let mut light = 0.25
    for i in 0 ..< 2:
        light += strength_of_light(i) * lambert(n, towards_light i)
        // fully lit, and no further light adds to that
        if light >= 1.0 => return color
    return color * light

@pixel fun main_ps(p: pixel_input) -> target:
    let lit = shade(p.color, p.normal)
    return {
        color = float4(..lit, 1.0)
    }

// Solid geometry: back faces culled, and depth tested and written, so a face drawn late cannot cover a nearer one.
// The target's format is the swapchain's, which only the host knows.
pipeline:
    vertex = main_vs
    pixel = main_ps
    cull = .back
    depth_test = true
    depth_write = true
    depth_stencil_format = .depth32_float
    format = .host

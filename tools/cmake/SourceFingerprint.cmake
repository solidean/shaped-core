# A build-time fingerprint of a set of source files, compiled into a target as one function returning it.
#
# A cache whose value a library computes from its inputs must also key on the library itself.
# A version string bumped by hand is forgotten exactly when it matters, so this hashes the library's own sources instead.
# Any edit to one of them changes the fingerprint at the next build, and a stale entry is never read.
#
#   sc_add_source_fingerprint(<target>
#       FUNCTION <qualified function name>   # declared by the caller as `cc::string_view name();`
#       HEADER   <header declaring it>        # included by the generated file, as `#include <...>`
#       FILES    <file>...)                    # what the fingerprint covers, as absolute paths
#
# The generated file is rewritten only when the fingerprint changes, so an edit elsewhere recompiles nothing.

set(_SC_SOURCE_FINGERPRINT_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")

function(sc_add_source_fingerprint target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "FUNCTION;HEADER" "FILES")
    if(NOT arg_FUNCTION OR NOT arg_HEADER OR NOT arg_FILES)
        message(FATAL_ERROR "sc_add_source_fingerprint(${target}) needs FUNCTION, HEADER and FILES")
    endif()

    # The list goes through a file: a library's sources would overflow a command line on Windows.
    set(_dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
    set(_list "${_dir}/${target}.fingerprint-files.txt")
    set(_out "${_dir}/${target}.fingerprint.cc")
    list(SORT arg_FILES)
    string(REPLACE ";" "\n" _lines "${arg_FILES}")
    file(GENERATE OUTPUT "${_list}" CONTENT "${_lines}\n")

    add_custom_command(
        OUTPUT "${_out}"
        COMMAND "${CMAKE_COMMAND}"
                "-DSC_FINGERPRINT_LIST=${_list}"
                "-DSC_FINGERPRINT_OUT=${_out}"
                "-DSC_FINGERPRINT_FUNCTION=${arg_FUNCTION}"
                "-DSC_FINGERPRINT_HEADER=${arg_HEADER}"
                -P "${_SC_SOURCE_FINGERPRINT_SCRIPT}"
        DEPENDS ${arg_FILES} "${_list}" "${_SC_SOURCE_FINGERPRINT_SCRIPT}"
        COMMENT "Fingerprinting the sources of ${target}"
        VERBATIM)
    target_sources(${target} PRIVATE "${_out}")
endfunction()

# Script mode: what the custom command above runs.
if(CMAKE_SCRIPT_MODE_FILE AND DEFINED SC_FINGERPRINT_LIST)
    # Contents only, in the sorted order the list holds: two checkouts of the same sources share one fingerprint.
    file(STRINGS "${SC_FINGERPRINT_LIST}" _files)
    set(_digests "")
    foreach(_file IN LISTS _files)
        file(SHA256 "${_file}" _digest)
        string(APPEND _digests "${_digest}\n")
    endforeach()
    string(SHA256 _fingerprint "${_digests}")

    set(_text "// Generated by tools/cmake/SourceFingerprint.cmake. Do not edit.
#include <${SC_FINGERPRINT_HEADER}>

cc::string_view ${SC_FINGERPRINT_FUNCTION}() { return \"${_fingerprint}\"; }
")
    set(_existing "")
    if(EXISTS "${SC_FINGERPRINT_OUT}")
        file(READ "${SC_FINGERPRINT_OUT}" _existing)
    endif()
    if(NOT _existing STREQUAL _text)
        file(WRITE "${SC_FINGERPRINT_OUT}" "${_text}")
    endif()
endif()
